{"v":1,"segs":[{"s":1.32,"e":2.5,"src":"No, not surprised.","ko":"아니, 안 놀랐어"},{"s":3.08,"e":4.12,"src":"I have a lot of threats.","ko":"협박 많이 받아"},{"s":4.22,"e":6.02,"src":"I have a lot of threats that you don't know about.","ko":"너희가 모르는 협박도 많고"},{"s":7.12,"e":10.06,"src":"Any consequential president has a lot of threats.","ko":"영향력 있는 대통령은 다 그래"},{"s":10.6,"e":13.24,"src":"Non-consequential presidents don't get threatened,","ko":"존재감 없는 대통령은 협박도 안 받아"},{"s":14.32,"e":15.32,"src":"and I think that I'm","ko":"그리고 내 생각엔"},{"s":16.3,"e":18.3,"src":"maybe the most consequential president.","ko":"내가 제일 영향력 있는 대통령일걸"},{"s":19.24,"e":20.78,"src":"There's nobody who's done more than me","ko":"나보다 더 해낸 사람 없어"},{"s":20.82,"e":23.44,"src":"in a period of almost six years.","ko":"거의 6년 동안"},{"s":23.74,"e":24.5,"src":"There's nobody.","ko":"아무도 없어"},{"s":25.26,"e":27.58,"src":"Do you worry about an assault by a missile?","ko":"미사일 공격은 안 무서워요?"},{"s":27.62,"e":30.34,"src":"Uh, I don't worry about anything, to be honest.","ko":"솔직히 난 아무것도 안 무서워"},{"s":30.38,"e":30.98,"src":"Whatever it is.","ko":"그게 뭐든"},{"s":31.02,"e":32.3,"src":"You know my attitude?","ko":"내 마인드 알지?"},{"s":32.36,"e":33.04,"src":"Whatever.","ko":"뭐 어쩌라고"},{"s":33.7,"e":34.72,"src":"Okay.","ko":"됐어"}]}