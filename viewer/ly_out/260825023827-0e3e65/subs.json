{"v":1,"segs":[{"s":0.28,"e":2.06,"src":"Iran now faces","ko":"이란 앞엔 이제"},{"s":2.26,"e":3.32,"src":"a very clear choice","ko":"선택지가 명확해"},{"s":3.82,"e":5.54,"src":"with only two paths before them","ko":"길은 딱 두 개뿐"},{"s":6.6,"e":8.18,"src":"Complete global isolation","ko":"완전한 국제적 고립"},{"s":8.64,"e":10.3,"src":"and a subsistence economy","ko":"그리고 밑바닥 경제"},{"s":10.88,"e":12.62,"src":"or a path back to normalcy","ko":"아니면 정상으로 복귀"},{"s":13.04,"e":15.9,"src":"with an opportunity to rejoin the global economy","ko":"세계 경제에 다시 낄 기회"},{"s":16.62,"e":18.7,"src":"Today, we are launching Operation","ko":"오늘 우리는 작전을 시작한다"},{"s":18.88,"e":20.36,"src":"Economic Outcast","ko":"이름은 경제적 아웃캐스트"},{"s":20.42,"e":25.34,"src":"to foreclose every other option available to the Iranian regime","ko":"이란 정권의 다른 길을 다 막는다"}]}