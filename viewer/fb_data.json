+ as_of 갱신.", "pinned": true, "gender": {"M_norm": 73, "F_norm": 27, "_est": "막대 눈대중 추정(여성 파랑 조각 ≈27%) — 정확값 확인 시 교체"}, "age_full": [{"k": "35-44", "pct": 28.3}, {"k": "45-54", "pct": 24.9}, {"k": "25-34", "pct": 18.6}, {"k": "기타", "pct": 28.2}], "as_of": "2026-07-24", "src": "manual(fb_audience.json)"}}