      //   lm 원문을 그대로 실어야 「본문의 건물인가 / 말미 발신 서명인가」를 리포트만 보고 가를 수 있다.
      why: 'lm="' + d.lm + '" ∧ crit(' + (d.kind || '') + ') — 둘 다 참이어야 발동(∧ 12h 이내)',
      text: (d.title || '화재') + ' · ' + d.lm + ' — ' + (d.area || '') + (d.text ? '\n' + d.text : '') });
  }
  return out;
}
const allMsgs = () => { const out = MSGS.slice(); const h = healthMsg(); if (h) out.unshift(h); const s = shellUpdMsg(); if (s) out.unshift(s); sysErrMsgs().forEach(e => out.unshift(e)); demoStaleMsgs().forEach(e => out.unshift(e)); quakeMsgs().forEach(e => out.unshift(e)); fireMsgs().forEach(e => out.unshift(e)); const d = staleDataMsg(); if (d) out.unshift(d); return out; };   // 클라 알림(맞춤법·새버전·수집고장·갱신실패)을 서버 메시지 앞에 병합(갱신실패가 최상단 = 화면 전체가 낡았다는 뜻이라 다른 알림보다 먼저 읽혀야)
async function loadHealth(force) {
  try { SHC = JSON.parse(localStorage.getItem('nomute_shc') || 'null'); } catch { SHC = null; }
  if (force || !SHC || (Date.now() - (SHC.ts || 0)) > SHC_PROBE_TTL) {   // 능동 백스톱(force=수동 새로고침=즉시 재확인) — 검사기 명시 healthy:false일 때만 불건강(거짓경보 방지)
    try {
      const c = new AbortController(); const t = setTimeout(() => c.abort(), 12000);
      let d; try { const r = await fetch('/api/spellcheck?selftest=1', { signal: c.signal }); if (r.ok) d = await r.json(); } finally { clearTimeout(t); }
      if (d && typeof d.healthy === 'boolean') { SHC = { healthy: d.healthy, ts: Date.now(), reason: d.error || '' }; try { localStorage.setItem('nomute_shc', JSON.stringify(SHC)); } catch {} }
    } catch {}   // 프로브 실패(네트워크 등) = 모호 → 상태 유지(거짓경보 안 냄)
  }
  renderMsgBadge();
}
async function loadMessages() {
  try {
    const r = await fetch('messages.json?_=' + Date.now());
    MSGS = await r.json();
    if (!Array.isArray(MSGS)) MSGS = [];
    const cut = Date.now() - 24 * 3600e3;   // 24h 지난 항목 숨김(운영자 260623 · 파일 정리는 msg.py prune·표시는 여기서 즉시)
    MSGS = MSGS.filter(m => m && (m.t == null || m.t >= cut));
  } catch { MSGS = []; }   // 없으면 조용히 빈 배열(배지·테두리 숨김)
  renderMsgBadge();
}
function renderMsgBadge() {
  const dis = msgDismissed(), read = msgReadSet();
  const visible = allMsgs().filter(m => !(m.id && dis.has(String(m.id))));   // 목록 표시분(삭제 제외)
  const unread = visible.filter(m => m.id && !read.has(String(m.id)));        // 안 읽음 = id 있고 읽음기록 없음(healthMsg=id없음은 shc-bad로 별도 점등)
  const n = unread.length;   // 배지·링 = 안 읽은 수(운영자 260704: 읽으면 사라짐)
  const warn = unread.some(m => m && m.level === 'warn');   // 수집 실패 등 = 노란 점등(haswarn) · 안 읽은 것만
  const prof = $('#profile'), badge = $('#pbadge');
  if (prof) { prof.classList.toggle('hasmsg', n > 0); prof.classList.toggle('haswarn', warn); prof.classList.toggle('shc-bad', shcBad()); }
  document.body.classList.toggle('has-sysbad', unread.some(m => m._sys));   // 미확인 시스템 알림 = 기어 픽토 극보수색 상주(운영자 260725) — 소등 축 = **읽음(mr)**: 알림메세지함을 열기만 하면(openMsgbox→msgMarkAllRead) 액션 0으로 꺼진다(운영자 260725 개정 "메세지함까지만 가면 읽은거로 · 뭐 클릭하고 액션 안 해도" — 구 축 = md 치움[✓]) · ✓(md dismiss)도 unread⊂visible이라 종전대로 소등 · 배지·haswarn과 같은 unread 축 계승(신규 부품 0) · 다음 날 새 id면 재점등(영구 묵음 금지 불변) · has-freshbad와 동일 CSS 사다리 공유
  if (badge) badge.textContent = n > 99 ? '99+' : String(n);
  const bc = $('#msgbtncnt'); if (bc) bc.textContent = visible.length ? `(${visible.length})` : '';   // pmenu 라벨 = 전체 표시 수(읽음 무관)
}
// 메시지 삭제(치움) = 로컬 즉시 + 계정 md축 동기(260717 소급 감사 — 구 "이 기기에서만 숨김"은 계정 종속 룰[CLAUDE.md [4]] 확립 전 결정 → 전 기기 숨김으로 승격) · 서버 메시지 원본(md 파일)은 불변
const MSG_DISMISS_KEY = 'nomute_msg_dismissed';
function msgDismissed() { try { const s = new Set(JSON.parse(localStorage.getItem(MSG_DISMISS_KEY) || '[]')); TF_SRV.md.forEach(id => s.add(id)); return s; } catch { return new Set(TF_SRV.md); } }   // 로컬(즉시성 캐시) ∪ 계정(md축 — 폰에서 치우면 PC도 · 계정 종속 소급 감사 260717 · CLAUDE.md [4] 룰)
function msgDismiss(id) { if (!id) return; const s = msgDismissed(); s.add(String(id)); try { localStorage.setItem(MSG_DISMISS_KEY, JSON.stringify([...s])); } catch {} postSeenIds('md', [String(id)]); }
// 메시지 읽음 = 로컬 즉시 + 계정 mr축 동기(260717) — 메시지함 열면 표시분 일괄 읽음 → 배지·링 소등이 전 기기 전파(운영자 260704 "읽으면 사라짐"의 계정 완성형)
const MSG_READ_KEY = 'nomute_msg_read';
function msgReadSet() { try { const s = new Set(JSON.parse(localStorage.getItem(MSG_READ_KEY) || '[]')); TF_SRV.mr.forEach(id => s.add(id)); return s; } catch { return new Set(TF_SRV.mr); } }   // 로컬 ∪ 계정(mr축 — 폰에서 읽으면 PC 배지도 소등 · 260717)
function msgMarkAllRead() { const dis = msgDismissed(), read = msgReadSet(); const fresh = []; allMsgs().forEach(m => { if (m.id && !dis.has(String(m.id)) && !read.has(String(m.id))) fresh.push(String(m.id)); if (m.id && !dis.has(String(m.id))) read.add(String(m.id)); }); try { localStorage.setItem(MSG_READ_KEY, JSON.stringify([...read])); } catch {} postSeenIds('mr', fresh); }
function unreadCount() { const dis = msgDismissed(), read = msgReadSet(); return allMsgs().filter(m => m.id && !dis.has(String(m.id)) && !read.has(String(m.id))).length; }   // 안 읽은 메시지 수(프로필 클릭 시 메뉴→메시지함 촤르륵 판정 · 운영자 260704)
// 리스트 행 삭제 = 접힘+페이드 후 실제 제거(운영자 260704: 확 사라지지 말고 자연스럽게·.24s). reduced-motion=즉시. 발행본·메시지함·향후 다른 삭제 버튼 공용(.qrow).
function animateRowOut(row, done) {
  if (!row || (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) { done(); return; }
  row.style.maxHeight = row.offsetHeight + 'px';   // 현재 높이 고정(접힘 기준)
  row.classList.add('qrow-out');
  requestAnimationFrame(() => { row.style.maxHeight = '0px'; });   // → 0으로 접힘(아래 항목 자연스럽게 올라옴)
  setTimeout(done, 260);   // 접힘 .24s 완주 후 실제 제거(transitionend 조기발동 회피 = 단순·확실)
}
function msgKind(m) {   // 알림구분 라벨(운영자 260704 '알림구분' 열) — 종류별 색
  if (m._health || m._sys) return { t: '시스템', c: 'mk-sys' };   // _sys = 수집 고장(260725) — 서버발이지만 성격은 동일 시스템 고지라 같은 구분·색 계승
  if (m.level === 'warn' || String(m.id || '').startsWith('fail-')) return { t: '경고', c: 'mk-warn' };
  return { t: '알림', c: 'mk-info' };
}
function msgAgo(m) {   // 대기열·발행본과 동일 상대시간(qAgo) — t(ms) 우선, 없으면 ts 문자열 KST 파싱
  if (m.t) return qAgo(m.t);
  if (m.ts) { const s = String(m.ts).replace(' ', 'T'); const p = Date.parse(s + (/([+-]\d{2}:?\d{2}|Z)$/i.test(s) ? '' : '+09:00')); return isNaN(p) ? String(m.ts) : qAgo(p); }   // 오프셋 판정 = **형태 전체**([+-]HH:MM∥HHMM∥Z · 260725 봉인) — 구 `/[+Z]$/`는 끝 글자만 봐서 "…+09:00"의 마지막 '0'에 걸려 "타임존 없음"으로 오판 → +09:00을 한 번 더 붙여 NaN → 원문 ISO가 시간 칸에 그대로 노출되던 버그(Q552 실측) · 날짜만("2026-07-25")은 종전대로 미매치 = 동작 불변
  return '';
}
// 메시지함 = 대기열·발행본 표 미러(운영자 260704): 시간 | 구분 | 내용(…축약) | 삭제(헤더 X 아래 중앙정렬)
function renderMsgList() {
  const dis = msgDismissed();
  const msgs = allMsgs().filter(m => !(m.id && dis.has(String(m.id))));
  const cnt = $('#msgpopcnt'); if (cnt) cnt.textContent = '';   // (도먼트 260725 운영자 "저기에 건수 없어도되고") 헤더 N건 소등 — 요소는 존치(.msgpop .qc margin-left:auto = X를 우변에 붙이는 스페이서 · 제거하면 X가 타이틀 옆으로 붙음) · 복원 = 구 표현식(msgs.length 있으면 "N건", 없으면 빈칸)
  const dlb = $('#msgDlAll'); if (dlb) { dlb.hidden = !msgRptRows().length; dlb.classList.remove('dl-done'); }   // 헤더 ↓ = 조치 대상(경고·시스템·조치형)이 있을 때만 노출(reuse-ok: 판정 = msgRptRows 정본 재사용) · 목록 재렌더 = 받음 표식 리셋(내용이 바뀐 새 리포트라 '이미 받음'이 거짓이 됨)
  const list = $('#msglist'); if (!list) return;
  if (!msgs.length) { list.innerHTML = '<div class="qempty">새 메시지 없음</div>'; return; }
  list.innerHTML = msgs.map(m => {
    const k = msgKind(m), body = m.text || '', cp = [...body], bodyS = cp.length > 60 ? cp.slice(0, 60).join('') + '…' : body;
    const canDel = !!m.id && !m._health;   // 시스템·id없는 알림 = 삭제 불가
    // 액션 = **버튼마다 .qact 고정폭 셀**(발행본 pubRowHtml 정본 문법 그대로 = 잠금|공유|삭제 3셀) — 배열이라 2개 이상도 무수정 정합:
    //   실측(260725 4함 감사) = 액션 2개 합성 시 최우측 버튼 중심이 헤더 X 중심과 Δ0.00 유지 · 셀 간격 10 · 제목 우변만 정확히 40(30+10) 좌측으로 밀림.
    //   ⚠ 삭제 불가 행도 **빈 셀 금지** = 비활성 버튼(발행본 만료 행 `pub-share disabled` 문법 계승) — 빈 셀은 버튼 높이(34)를 못 만들어 행이 51→36px로 주저앉아 표 리듬·5행 캡(max-height 5*51)이 깨진다(실측).
    const acts = [canDel
      ? '<button class="pub-ico ' + (m._sys ? 'msg-ok' : 'pub-rm') + ' msg-del" type="button" title="' + (m._sys ? '확인' : '삭제') + '" data-id="' + qEsc(String(m.id)) + '">' + (m._sys ? CHECK_SVG : _TRASHSVG) + '</button>'   // 수집 고장 알림 = ✓(확인 · 운영자 260725 "체크 표시 누르면 없어지고") — 버튼 부품·자리·애니(animateRowOut)는 삭제 버튼 100% 계승, 픽토만 CHECK_SVG(nm-svg 정본) · 색축만 분기 = ✓는 msg-ok(rest 무채·hover accent·press 그대로), 휴지통은 pub-rm(상시 danger) 불변(운영자 260725 "체크 보수색일 필요 없고")
      : '<button class="pub-ico pub-rm" type="button" disabled title="상주 알림 — 해결되면 저절로 사라져요">' + _TRASHSVG + '</button>'];   // 비활성 = .qpop .pub-ico:disabled(무채·opacity .4·cursor default·누름 없음) 정본 그대로 = "왜 못 지우나"까지 어포던스로 설명
    return '<div class="qrow msgrow' + ((m._health || m.level === 'warn') ? ' q-warn' : '') + '"' + (m.id ? ' data-id="' + qEsc(String(m.id)) + '"' : '') + '>'
      + '<span class="qt">' + qEsc(msgAgo(m)) + '</span>'
      + '<span class="qst mkind ' + k.c + '">' + k.t + '</span>'
      + '<span class="qmain" title="' + qEsc(body) + '">' + qEsc(bodyS) + '</span>'
      + acts.map(a => '<span class="qact">' + a + '</span>').join('') + '</div>';
  }).join('');
  list.querySelectorAll('.msg-del').forEach(b => b.onclick = (e) => { e.stopPropagation(); animateRowOut(b.closest('.qrow'), () => { msgDismiss(b.dataset.id); renderMsgList(); renderMsgBadge(); }); });
  [...list.querySelectorAll('.msgrow')].forEach((row, i) => { row.onclick = (e) => { if (e.target.closest('button')) return; openMsgDetail(msgs[i]); }; });   // 행 클릭(삭제버튼 제외) = 전문 상세 '다음 화면' 열기(운영자 260704 '메시지 눌렀을때 안 뜸' 버그 수정)
}
// 메시지 상세(전문) 화면 — 목록 대신 표시. 구분·시간·전문(잘림 없음) + 뒤로(목록).
function msgShowList() { const d = $('#msgdetail'), l = $('#msglist'); if (d) d.hidden = true; if (l) l.hidden = false; }
// 조치형 알림 = 메시지 상세에서 '무엇을 할 수 있나'를 버튼으로 노출(운영자 260723 "눌러도 할 게 없다" 봉합).
//   msg.py action 태그 → build 보존 → 여기서 라벨·핸들러 매핑. 알 수 없는 action = 버튼 없음(구 동작 불변).
const _RECOLLECT_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg>';
async function snsRecollect(btn) {   // SNS 트렌드 정체(wd-sns) → sns-trends 워크플로 재발사(수동 하트비트 · /api/snsretry)
  if (!btn || btn.disabled) return;
  const span = btn.querySelector('span');
  btn.disabled = true; if (span) span.textContent = '요청 중…';
  try {
    const r = await fetch('/api/snsretry', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
    const d = await r.json().catch(() => ({}));
    if (r.ok && d.ok) { btn.classList.add('ok'); if (span) span.textContent = '요청됨 · 1~2분 뒤 갱신돼'; }   // 재수집은 러너 스핀업+수집+커밋 = ~1~2분(즉시 갱신 아님 = 정직 고지)
    else { if (span) span.textContent = (d.error || '요청 실패 — 잠시 뒤 다시'); btn.disabled = false; }
  } catch { if (span) span.textContent = '네트워크 오류 — 다시'; btn.disabled = false; }
}
async function shellApply(btn) {   // 새 버전 반영 = 최신 셸 재확보 후 새로고침(applyShellUpdate 재사용 · 토스트 버전과 동일 경로)
  if (btn) { btn.disabled = true; const s = btn.querySelector('span'); if (s) s.textContent = '반영중…'; }
  return applyShellUpdate(null);   // t=null = 토스트 텍스트 갱신 스킵 · fetch→SW 캐시 갱신→reload 는 동일
}
async function dataRetry(btn) {   // 갱신 실패 조치 = 라이브 소스 재시도(loadCandidates가 api → 정적 순으로 다시 탐색) · 버튼 문법 = shellApply 그대로
  if (btn) { btn.disabled = true; const s = btn.querySelector('span'); if (s) s.textContent = '받는 중…'; }
  await loadCandidates();
  if (candFresh()) { try { renderMsgList(); msgShowList(); } catch {} return; }   // 회복 = 항목 자체가 사라짐(syncStaleMsg) → 목록으로 복귀 · 판정축은 syncStaleMsg의 `bad`와 **반드시 동일**(260731: CAND_LIVE만 보던 구식은 재시도가 실패했는데도 CAND_LIVE 잔류값 때문에 '회복'으로 오판 → 항목은 그대로인데 목록으로 튕겨 버튼이 거짓말을 했다)
  if (btn) { btn.disabled = false; const s = btn.querySelector('span'); if (s) s.textContent = '아직 안 돼 — 다시'; }   // 실패 = 재시도 여지 남김(snsRecollect '네트워크 오류 — 다시' 문법 계승)
}
const MSG_ACTIONS = {
  'sns-recollect': { label: '다시 받아오기', svg: _RECOLLECT_SVG, fn: snsRecollect },
  'shell-apply': { label: '반영하기', svg: _RECOLLECT_SVG, fn: shellApply },
  'data-retry': { label: '다시 받아오기', svg: _RECOLLECT_SVG, fn: dataRetry },
  'quake-go': { label: '안전 탭 열기', svg: ARROW_R_SVG, fn: goDisSec },   // ⑭ 지진 경고 → 안전(재난문자) 섹션 이동(운영자 260802) · 아이콘 = 공유 정본 ARROW_R_SVG 계승(새 픽토 0)
};
// ⑭ 안전(재난문자) 섹션으로 이동 — 경고 알림 조치 버튼 · 기기 알림 탭(/?dis=1) 공통 착지점(운영자 260802 "누르면 저기 안전 탭으로 이동하면 됨").
//   ⚠ 새 탭·새 화면 0 — 이미 있는 showTab('trend') + 그 섹션 열기·스크롤만 한다.
function goDisSec() {
  try {
    closeOverlays(); showTab('trend');
    setTimeout(() => {
      const g = document.getElementById('tg-sf');
      if (g && !g.open) g.open = true;   // 대분류 '안전'부터 펼친다(운영자 260818 항상 접힘 계약 = GFOLD_ALWAYS) — 이 줄이 없으면 접힌 대분류 안에 갇혀 소분류를 펴도 화면엔 아무것도 안 뜬다
      const s = document.querySelector('details.trend-sec[data-sec="dis"]');
      if (!s) return;
      s.open = true;   // 접혀 있어도 펼쳐서 착지(TFOLD 사용자 접기 상태 무관 = '눌렀는데 아무것도 없음' 차단)
      s.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }, 260);   // 탭 전환 촤르륵(showTab _tabIn) 뒤 측정 = 좌표 튐 방지
  } catch (_) {}
}
function openMsgDetail(m) {
  if (!m) return;
  const d = $('#msgdetail'), l = $('#msglist'); if (!d || !l) return;
  const k = msgKind(m), kn = $('#mdKind');
  if (kn) { kn.className = 'md-kind ' + k.c; kn.textContent = k.t; }   // 무슨 알림인지(구분) 상단 표시(운영자 260704 '무슨 표시인지 떠야')
  const tt = $('#mdTime'); if (tt) tt.textContent = msgAgo(m);
  const bd = $('#mdBody'); if (bd) bd.textContent = m.text || '(내용 없음)';
  const act = $('#mdAct'), cfg = m.action && MSG_ACTIONS[m.action];   // 조치형이면 버튼 렌더(어포던스: 이 알림에 대해 지금 할 수 있는 것)
  if (act) {
    if (cfg) { act.hidden = false; act.innerHTML = '<button class="md-actbtn" type="button">' + cfg.svg + '<span>' + qEsc(cfg.label) + '</span></button>'; const b = act.querySelector('.md-actbtn'); if (b) b.onclick = () => cfg.fn(b); }
    else { act.hidden = true; act.innerHTML = ''; }
  }
  l.hidden = true; d.hidden = false; d.scrollTop = 0;
}
// 메시지함 열고(필요시) 특정 메시지로 스크롤·강조 — 푸시 알림 탭(/?msg=<id>) 진입점.
function openMsgbox(highlightId) {
  hidePmenu();   // 프로필 메뉴 닫음(촤르륵 접힘 · 메시지함 뒤에 안 남음 · 다음 프로필 클릭 정상 토글 · 운영자 260704)
  closeOverlays('msg'); renderMsgList(); msgShowList(); pushRefresh(); msgpop.hidden = false; placeMsgpop();   // 열 때 항상 목록 화면(상세에 갇혀있지 않게) · hidden 해제 → 배치(placePopNearMenu 폭 측정 요건)
  msgMarkAllRead(); renderMsgBadge();   // 메시지함 열면 = 읽음 → 배지·링 제거(운영자 260704)
  // 딥링크(푸시 탭) 진입 = **그 건을 펼친 상태로** 보여준다(운영자 260816 「감시 이상 알림은 누르면 알림 메세지창에 해당 건이 열린 상태가 보이게」).
  //   구판은 목록에서 스크롤+flash 강조만 했는데 두 가지로 무력했다 — ⓐ 알림이 길면(감시·진단서 계열) 목록은 60자에서 잘려
  //   정작 읽어야 할 사유가 안 보인다 ⓑ **강조가 살아남지 못한다**: 부팅 뒤 로컬 합성 알림(갱신 지연 등)이 붙으면서
  //   renderMsgList가 다시 돌면 flash를 얹은 DOM이 통째로 교체된다(실측 260816 = 목록 2행 정상인데 .flash 0건).
  //   → 그 행의 click을 그대로 태운다 = 기존 행 핸들러(openMsgDetail)가 돈다 = 새 로직·새 부품 창작 0이고
  //     목록↔상세 짝이 어긋날 여지도 없다. 상세는 별도 화면이라 목록 재렌더에 안 지워진다(ⓑ도 같이 해소).
  //   ⚠ 스코프 = highlightId 있을 때만 = 푸시 딥링크 전용. 설정 메뉴로 연 경우(인자 없음)는 종전대로 목록 화면
  //     ("열 때 항상 목록 화면" 계약 보존).
  if (highlightId) requestAnimationFrame(() => {
    const el = $('#msglist .msgrow[data-id="' + (window.CSS && CSS.escape ? CSS.escape(highlightId) : highlightId) + '"]');
    if (el) { el.scrollIntoView({ block: 'nearest' }); el.classList.add('flash'); el.click(); }
  });
}
// ── 알림 진단 리포트 다운로드(운영자 260727 "문제 내용을 html로 요약하게끔 틀이랑 지금 메세지의 해결해야될 내용들만 모아서 다운로드해서 너한테 전달") ──
//   왜 = 고장 알림은 스샷으로 넘기면 전문이 잘리고(목록 60자 컷) 진단 상태(폰 하트비트·커버·빌드 도장)가 안 딸려온다 → 사람이 다시 받아쓰는 손실 구간.
//     한 파일에 {문제 전문 + 조치문 + 그 판정을 만든 소스값 + 버전 도장}을 굳혀 세션에 첨부하면 재질문 0회로 착수 가능.
//   대상 = **지금 알림함에 떠 있는 것 중 문제/조치 축만**(경고·시스템·조치버튼 보유 · 순수 정보 알림 제외) = 화면 목록과 같은 소스(allMsgs∖dismissed) = 새 데이터 0.
//   색·모양 = :root 토큰을 **실측 주입**(getComputedStyle) — 산출 HTML은 var()가 안 닿는 별도 문서라 값을 박아야 하는데, 박는 값이 index 토큰 실측치라 새 hex 창작 0(팔레트 계승 유지).
const MSG_RPT_TOKENS = ['--bg', '--fg', '--mut', '--line', '--accent', '--warn', '--glass2', '--r-m', '--r-s', '--sp-1', '--sp-2', '--sp-3', '--sp-4', '--fs-h1', '--fs-h2', '--fs-body', '--fs-label', '--fs-sm', '--fs-xs', '--lh-base', '--fw-b', '--fw-x'];   // 산출 문서에 실어 보낼 토큰 = index :root 실측(getComputedStyle) → 리포트 CSS는 var()만 쓴다 = 화면과 같은 팔레트·같은 리듬
const _rptTodo = t => { const p = String(t || '').split(/\n{2,}/).find(x => x.includes('👉')); return p ? p.replace(/^👉\s*/, '').replace(/^네가 할 일:\s*/, '').trim() : ''; };   // 조치문 = 본문 안 '👉 네가 할 일:' 문단(sysErrMsgs 정본 문법) · 없으면 빈칸 = 서버발 알림(조치문 규약 밖)
const _rptAct = m => { const c = m && m.action && MSG_ACTIONS[m.action]; return c ? '앱 안에서 「' + c.label + '」 버튼으로 조치 가능(알림 상세 화면).' : ''; };   // 조치문 규약(👉) 밖 = 서버발 조치형 알림 → 이미 붙어 있는 버튼 라벨(MSG_ACTIONS 정본)을 대신 싣는다 = 새 문구 창작 0
function msgRptRows() {
  const dis = msgDismissed();
  return allMsgs().filter(m => !(m.id && dis.has(String(m.id))))
    .filter(m => m._sys || m._health || m.level === 'warn' || m.action || String(m.id || '').startsWith('fail-'));   // 문제/조치 축 = msgKind '경고'·'시스템' + 조치형(m.action) — 판정식은 msgKind·renderMsgBadge(haswarn)와 같은 필드만 본다(새 플래그 0)
}
// ── 리포트 v2 = **조치 주체로 가른다**(운영자 260727 "가장 정보가 이렇게 와야 좋겠다 싶을정도로") ──
//   받은 쪽이 제일 먼저 알아야 하는 건 "이거 누가 고치나"다. 뭉쳐 오면 세션이 못 고치는 폰·쿠키 건까지 붙잡고,
//   반대로 코드로 고칠 건을 "기다리면 된다"로 흘린다. 판정은 **이미 있는 문구 규약**을 읽어서 한다(새 필드·새 분류 데이터 0):
//     · '네가 할 일: 없어요' = 서버·플랫폼이 알아서 복구 → 대기        · '👉' 문단에 할 일이 있음 = 폰·쿠키·계정 = 운영자
//     · m.action 보유 = 앱 안 버튼 한 번으로 끝                        · 조치문 없음 = 규약 밖 = 세션이 코드로 판단할 몫
const RPT_WHO = { op: '운영자가 할 일', cc: '클로드가 볼 일', app: '앱 버튼 한 번', auto: '자동 복구 대기' };
// ⚠ 260805 봉합 — 조치문이 **「이 리포트를 클로드에게 넘겨 줘」**인 알림은 op가 아니라 cc다.
//   구판은 「👉 문단이 있으면 무조건 op」라, 스스로 "계정이 아니라 수집 경로 문제야 · 클로드에게 넘겨 줘"라고
//   말하는 알림이 **운영자 칸**에 앉았다(실측 260805_2043 리포트 1번 = 틱톡 403 3계정 묶음 · sysErrMsgs _proTodo).
//   그 칸의 정의는 이 파일 위 규약대로 「폰·쿠키·계정 = 코드로 못 고침」인데 이 건은 정반대 = **분류가 뜻을 뒤집는다**.
//   비용 = 운영자가 리포트를 열어 "내가 할 일 2건"을 보고 할 수 있는 게 실제로는 1건뿐 · 나머지는 매일 새 id로
//   재점등(id에 날짜가 박혀 ✓ 해도 다음 날 부활) = 조치 불가 알림이 상주하며 진짜 운영자 건(폰 크론)을 가린다.
//   판정 술어 = **여전히 문구 규약뿐**(새 필드·새 분류 데이터 0 = 위 규약 계승): 조치문이 클로드를 부르면,
//   그 조치는 리포트가 클로드 손에 닿은 시점에 **이미 소진된 행동**이라 남은 몫이 코드 축밖에 없다.
//   ⚠ 단건 문구(「이 계정이 지금도 열리는지 한 번만 확인해 줘」)는 클로드를 안 부른다 = op 유지 = 회귀 0.
const _RPT_CC_RE = /클로드/;
function _rptWho(m) {
  const todo = _rptTodo(m.text);
  if (todo) return /^없(어요|음)/.test(todo) ? 'auto' : (_RPT_CC_RE.test(todo) ? 'cc' : 'op');
  if (m.action && MSG_ACTIONS[m.action]) return 'app';
  return 'cc';
}
// 출처 = 이 알림을 만든 **코드 위치와 판정 소스**(id 접두어가 곧 생산자 · sysErrMsgs·demoStaleMsgs 정본 대응) — 세션이 파일을 바로 열게 하는 값
function _rptSrc(m) {
  const id = String(m.id || '');
  if (id.startsWith('sys:subs:')) return { fn: 'viewer/index.html sysErrMsgs()', src: 'TRENDS.health.subs.stale', up: 'scraper/sns_trends.py' };
  if (id.startsWith('sys:acct:')) return { fn: 'viewer/index.html sysErrMsgs()', src: 'TRENDS.health.subs.cover[플랫폼].why[계정]', up: 'scraper/sns_trends.py _sfail()' };
  if (id.startsWith('sys:src:reddit:')) return { fn: 'viewer/index.html sysErrMsgs()', src: 'TRENDS.reddit 길이 0 + health.phone.ok', up: 'scraper/sns_trends.py reddit_hot()/_reddit_rss()' };
  if (id.startsWith('sys:demo:')) return { fn: 'viewer/index.html demoStaleMsgs()', src: 'CHAN/CHAN_FB.audience_sample.as_of vs generated_kst', up: 'scraper 인구통계 수집' };
  // ⚠ 재난 2축(fire·quake)은 **뷰어가 만든다** — 분기가 없으면 아래 폴백으로 떨어져 「서버 발행 메시지 · messages/<id>.json」이라는
  //   **거짓 경로**를 준다(실측 260805: 그 파일은 존재조차 안 하는데 세션이 그걸 믿고 messages/를 뒤졌다 = 오정보가 진단을 늦춘 실사고).
  //   리포트의 계약은 "세션이 파일을 바로 열게 하는 값"이라, 없는 값보다 **틀린 값**이 더 비싸다.
  if (id.startsWith('sys:fire:')) return { fn: 'viewer/index.html fireMsgs()', src: 'TRENDS.disaster[].lm ∧ disCrit(d) (⑭-e 랜드마크 즉시 긴급알림 · 12h TTL)', up: 'scraper/sns_trends.py disaster_landmark() → lm 필드 · 추적 = scraper/fire_watch.py · 게이트 = check_disaster_landmark_sign',
    cmd: 'python3 -c "import json;[print(x[\'kind\'],x[\'time\'],repr(x.get(\'lm\')),x[\'text\'][:40]) for x in json.load(open(\'viewer/sns_trends.json\'))[\'disaster\']]"' };
  if (id.startsWith('sys:quake:')) return { fn: 'viewer/index.html quakeMsgs()', src: 'TRENDS.disaster[] 규모 ≥ quakeMinMag(d) (국내 QUAKE_MIN_KR / 해외 QUAKE_MIN_INTL · 규모 미상 = fail-open)', up: 'scraper/sns_trends.py disaster_label()/disaster_intl() → intl 필드',
    cmd: 'python3 -c "import json;[print(x[\'kind\'],x[\'time\'],x.get(\'intl\'),x[\'title\']) for x in json.load(open(\'viewer/sns_trends.json\'))[\'disaster\'] if x[\'kind\']==\'지진\']"' };
  // _health 계열은 3종(새버전·갱신실패·맞춤법)이 같은 플래그를 공유 → 플래그별로 갈라야 한다. 뭉치면 "새 버전" 알림에 CAND_LIVE가 찍혀
  //   세션이 없는 고장(진단 스냅샷 후보라이브=true인데 적재 실패라고 지목)을 쫓는다(실증 260730 리포트 1번 항목).
  // 콘티 영상 실패 = 러너가 발행한다(뷰어 생산 아님). 폴백으로 두면 상류가 scraper/msg.py 로 잘못 찍혀
  //   세션이 진짜 생산자(.github/scripts/grok_sb_video.py notify())를 못 찾는다 — sys:fire: 오귀속과 같은 축.
  if (id.startsWith('sb-video-fail-')) return { fn: '.github/scripts/grok_sb_video.py notify()', src: 'sb_out/<id>/video.json cuts[].video 결손(자동 1회 재시도 후에도 실패한 편)', up: '.github/workflows/sb-make.yml Grok video 스텝 → shared/msg.py',
    cmd: 'python3 -c "import json;d=json.load(open(\'viewer/sb_out/<콘티id>/video.json\'));[print(c[\'n\'],c.get(\'retried\'),c.get(\'fail\')) for c in d[\'cuts\'] if not c.get(\'video\')]"' };
  // 열쇠 되쓰기 실패 = 러너가 발행한다. 폴백으로 두면 상류가 scraper/msg.py 로 잘못 찍혀
  //   세션이 진짜 생산자(shared/grok_api.py _persist_alarm())를 못 찾는다 — sb-video-fail- 과 같은 축.
  if (id.startsWith('key-persist-')) return { fn: 'shared/grok_api.py _persist_alarm()', src: '_persist_secret() 실패(권한 토큰 부재·봉인 도구 부재·공개키 실패·쓰기 거절·예외)', up: '.github/workflows/sb-make.yml 촬영 스텝 · hf-check.yml → shared/msg.py',
    cmd: 'gh run list --workflow sb-make.yml --limit 5   # 해당 런 로그에서 "되쓰기" 경고 줄 확인 · 조치는 판정기 재실행(코드 축 아님)' };
  if (m._shellupd) return { fn: 'viewer/index.html shellUpdMsg()', src: '_shellUpdPending(SW nm-shell-updated → flagShellUpdate)', up: 'sw.js 셸 SWR 재검증 + viewer/index.html 배포' };
  if (m._stale) return { fn: 'viewer/index.html staleDataMsg()', src: 'candStale() = 소스축 CAND_LIVE(정적 폴백) ∪ 시간축 CAND_TS(수신 경과 > CAND_STALE_MS)', up: 'functions/api + viewer/candidates.json' };   // 260731: src를 'CAND_LIVE' 단독으로 두면 새 조건(라이브인데 수신이 낡음 = CAND_LIVE **true**)에서 진단이 원인을 잘못 지목한다 — 260730 리포트 1번 항목("후보라이브=true인데 적재 실패로 지목")과 같은 모양의 재발이라 두 축을 병기(원값은 msgRptDiag.후보수신경과분)
  if (m._health) return { fn: 'viewer/index.html healthMsg()', src: "SHC(localStorage 'nomute_shc').healthy=false", up: 'thumb.html 맞춤법 검사기 + ?selftest 프로브' };
  return { fn: '서버 발행 메시지', src: 'messages/' + (id || '<id>') + '.json', up: 'scraper/msg.py' };
}
const _rptAbs = m => (m.t ? new Date(m.t).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : (m.ts ? String(m.ts) : '(시각 없음)'));   // 절대 KST — 상대시간("2시간 전")만으론 며칠째인지 판별이 안 된다(D4 KST 고정)
function msgRptEnv() {   // 환경 = "안 보인다·안 고쳐졌다"의 진위를 파일 하나로 가르는 값(옛 셸 열람 vs 실미해결 · 버전 도장 주석과 같은 목적)
  return {
    빌드도장: BUILD_STAMP,
    셸출처: (navigator.serviceWorker && navigator.serviceWorker.controller) ? 'SW 캐시 셸(옛 코드일 수 있음 → 강제 새로고침으로 확인)' : '네트워크 셸(최신)',
    주소: location.href,
    화면: window.innerWidth + '×' + window.innerHeight + ' @' + (window.devicePixelRatio || 1) + 'x',
    브라우저: navigator.userAgent,
    온라인: navigator.onLine,
  };
}
function msgRptDiag() {   // 진단 스냅샷 = 알림을 띄운 **판정 소스 원값**(sysErrMsgs가 읽는 필드 그대로) — "왜 떴나"를 리포트 안에서 되짚을 수 있게
  const h = (TRENDS && TRENDS.health) || {};
  return {
    생성KST: new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }),
    빌드도장: BUILD_STAMP,
    데이터갱신: (TRENDS && TRENDS.updated) || '',
    폰수집기: h.phone ? { ok: h.phone.ok === true, age_min: h.phone.age_min } : null,
    구독정체: (h.subs || {}).stale || [],
    계정커버: (h.subs || {}).cover || {},
    레딧건수: ((TRENDS && TRENDS.reddit) || []).length,
    후보라이브: typeof CAND_LIVE === 'undefined' ? null : !!CAND_LIVE,
    후보수신경과분: typeof CAND_TS === 'undefined' || !CAND_TS ? null : Math.round((Date.now() - CAND_TS) / 60000),   // 260731 신설 — 경보 자격검사(candFresh)의 시간축 원값. 이게 없으면 "왜 떴나/왜 안 떴나"를 사후에 추측으로만 갈라야 한다(리포트 = 판정 소스 원값 스냅샷이라는 이 함수의 계약 그대로)
  };
}
function msgRptHtml() {
  const cs = getComputedStyle(document.documentElement), tk = n => cs.getPropertyValue(n).trim();
  const rows = msgRptRows(), diag = msgRptDiag(), env = msgRptEnv();
  let n = 0;
  const card = m => {
    const k = msgKind(m), who = _rptWho(m), s = _rptSrc(m), todo = _rptTodo(m.text) || _rptAct(m);
    n++;
    return '<li class="it' + (k.c === 'mk-warn' ? ' warn' : '') + '">'
      + '<div class="ih"><span class="no">' + n + '</span><span class="kind">' + qEsc(k.t) + '</span><span class="ago">' + qEsc(_rptAbs(m)) + ' (' + qEsc(msgAgo(m)) + ')</span></div>'
      + '<div class="tx">' + qEsc(m.text || '') + '</div>'
      + (todo ? '<div class="todo"><b>' + qEsc(RPT_WHO[who]) + '</b> ' + qEsc(todo) + '</div>' : '<div class="todo"><b>' + qEsc(RPT_WHO[who]) + '</b> 조치문 규약(👉) 밖 — 코드로 원인 판단 필요.</div>')
      + '<table class="meta"><tr><th>알림 id</th><td><code>' + qEsc(String(m.id || '(id없음)')) + '</code></td></tr>'
      // 발화 근거 = **조건을 통과시킨 값 자체**(260805 신설) — 판정 소스는 "어느 필드를 보나"까지만 말해서, 그 필드가
      //   *무엇이었길래* 울렸는지는 세션이 라이브 데이터를 따로 떠서 맞춰봐야 했다(실측: 서명 오탐 진단 20분의 대부분).
      //   why 없는 알림은 행을 안 그린다(빈 행 = 잡음 · 생산자가 실어준 것만 표시).
      + (m.why ? '<tr><th>발화 근거</th><td><code>' + qEsc(String(m.why)) + '</code></td></tr>' : '')
      + '<tr><th>만든 곳</th><td><code>' + qEsc(s.fn) + '</code></td></tr>'
      + '<tr><th>판정 소스</th><td><code>' + qEsc(s.src) + '</code></td></tr>'
      + '<tr><th>상류</th><td><code>' + qEsc(s.up) + '</code></td></tr>'
      + (s.cmd ? '<tr><th>재현</th><td><code>' + qEsc(s.cmd) + '</code></td></tr>' : '') + '</table>'
      + '</li>';
  };
  // 그룹 = 조치 주체 순서 = **사람이 할 일 먼저**(운영자 → 앱 버튼 → 클로드 → 자동 대기) — 위에서부터 읽으면 곧 실행 순서
  const grp = ['op', 'app', 'cc', 'auto'].map(w => {
    const g = rows.filter(m => _rptWho(m) === w);
    return g.length ? '<h2>' + qEsc(RPT_WHO[w]) + ' · ' + g.length + '건</h2><ol>' + g.map(card).join('') + '</ol>' : '';
  }).join('');
  // ── 「지금 네가 할 일」 = 맨 위 한 상자(운영자 260813 "알림이 오면 뭐 조치를 해야 되는건데, 내가 해야되는게 뭔지를 모르니 매번 당황스럽네") ──
  //   왜: 조치 주체로 4칸 가르는 것까지는 됐는데, **그래서 손으로 뭘 하나**는 각 카드 본문을 열어 읽어야 나왔다.
  //   카드엔 사유·근거·출처표가 같이 실려 있어 조치 한 줄이 그 사이에 묻힌다 → 스크롤하며 3~4건을 읽고 나서야
  //   "아 저거 두 개만 하면 되는구나"가 나온다. 그 사이 시간이 곧 "매번 당황스럽다"의 실체다.
  //   → 사람이 **손으로** 해야 하는 것(op·app)만 뽑아 번호로 세운다. 코드·자동 축은 건수만 말하고 끝낸다.
  // ⚠ 판정은 `_rptWho` 정본 그대로 재사용(사본 0) — 여기서 따로 세면 본문 칸과 다른 말을 하는 순간
  //   이 상자가 거짓말이 되고, 그건 아무 안내도 없는 것보다 나쁘다(260813 콘티 조치문 고정 문구 사고와 같은 축).
  // ⚠ 부품 = `.lead`·`.no` 계승(새 클래스·새 값 0 · CSS 추가 0줄) = [4] 창작 금지.
  const _hands = rows.filter(m => ['op', 'app'].includes(_rptWho(m)));
  const _ccN = rows.filter(m => _rptWho(m) === 'cc').length;
  const _autoN = rows.filter(m => _rptWho(m) === 'auto').length;
  const doNow = '<p class="lead">' + (_hands.length
    ? '<b>지금 네가 할 일 — ' + _hands.length + '건</b><br>'
      + _hands.map((m, i) => '<span class="no">' + (i + 1) + '</span> '
          + qEsc(_rptTodo(m.text) || _rptAct(m) || '(조치문 없음 — 아래 본문 참조)')
          + (_rptWho(m) === 'app' ? ' <b>(앱 알림 상세에서 버튼 한 번)</b>' : '')).join('<br>')
    : '<b>지금 네가 손으로 할 일은 없어.</b>')
    + (_ccN ? '<br><br>그리고 <b>이 파일을 클로드에게 주면</b> 나머지 ' + _ccN + '건은 코드 축이라 그쪽에서 처리돼.' : '')
    + (_autoN ? '<br>' + (_ccN ? '' : '<br>') + '나머지 ' + _autoN + '건은 저절로 풀려 — 그냥 두면 돼.' : '')
    + '</p>';
  const SHORT = { op: '운영자', app: '앱버튼', cc: '클로드', auto: '자동대기' };
  const cnt = ['op', 'app', 'cc', 'auto'].map(w => SHORT[w] + ' ' + rows.filter(m => _rptWho(m) === w).length).join(' · ');
  const tbl = o => Object.entries(o).map(([k, v]) => '<tr><th>' + qEsc(k) + '</th><td><code>' + qEsc(typeof v === 'object' && v !== null ? JSON.stringify(v) : String(v)) + '</code></td></tr>').join('');
  const dl = tbl(diag), ev = tbl(env);
  // 틀 = 알림함 표(시간·구분·내용) 세로 전개 + 하단 진단표 · 토큰 실측 주입(위 ⚠) · 스크립트 태그엔 원본 JSON = 사람은 위를 읽고 세션은 아래를 파싱
  return '<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
    + '<title>노뮤트 알림 리포트 · ' + qEsc(diag.생성KST) + '</title><style>'
    + ':root{' + MSG_RPT_TOKENS.map(n => n + ':' + tk(n)).join(';') + '}'   // 토큰 실측 주입 = 산출 문서 안에서도 index :root 값 그대로(색·여백·글자 전부 계승 · 새 값 창작 0)
    + 'body{margin:0;padding:var(--sp-4) var(--sp-3);background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;font-size:var(--fs-h2);line-height:var(--lh-base)}'
    + '.wrap{max-width:860px;margin:0 auto}h1{font-size:var(--fs-h1);font-weight:var(--fw-x);margin:0 0 var(--sp-1)}'
    + '.sub{color:var(--mut);font-size:var(--fs-sm);margin:0 0 var(--sp-3)}'
    + '.lead{background:var(--glass2);border:1px solid var(--line);border-radius:var(--r-m);padding:var(--sp-2);margin:0 0 var(--sp-3);font-size:var(--fs-label)}'
    + 'ol{list-style:none;margin:0;padding:0}'
    + '.it{background:var(--glass2);border:1px solid var(--line);border-radius:var(--r-m);padding:var(--sp-2);margin:0 0 var(--sp-2)}'
    + '.it.warn{border-color:var(--warn)}'
    + '.ih{display:flex;align-items:center;gap:var(--sp-1);flex-wrap:wrap;margin-bottom:var(--sp-1)}'
    + '.no{font-size:var(--fs-xs);font-weight:var(--fw-x);color:var(--accent)}'
    + '.kind{font-size:var(--fs-xs);font-weight:var(--fw-x);color:var(--mut)}.it.warn .kind{color:var(--warn)}'
    + '.ago{font-size:var(--fs-xs);font-weight:var(--fw-x);color:var(--mut)}'
    + '.tx{white-space:pre-wrap;font-size:var(--fs-body)}'
    + '.todo{margin-top:var(--sp-2);padding:var(--sp-2);border-radius:var(--r-s);background:var(--bg);border:1px solid var(--line);font-size:var(--fs-label)}'
    + '.todo b{color:var(--accent)}'
    + 'h2{font-size:var(--fs-h2);font-weight:var(--fw-x);margin:var(--sp-4) 0 var(--sp-1)}'
    + 'table{width:100%;border-collapse:collapse;font-size:var(--fs-sm)}'
    + 'th,td{text-align:left;vertical-align:top;padding:var(--sp-1);border-bottom:1px solid var(--line)}'
    + 'th{width:110px;color:var(--mut);font-weight:var(--fw-b)}code{word-break:break-all}'
    + 'table.meta{margin-top:var(--sp-2)}table.meta th{width:90px}table.meta td,table.meta th{border-bottom:0;padding:2px var(--sp-1)}'   /* raw-ok: 2px = 카드 안 메타표만 행간 압축(본문 표 리듬 유지 · 토큰 사다리 최소값 6도 과함) */
    + '</style></head><body><div class="wrap">'
    + '<h1>노뮤트 알림 리포트 — ' + rows.length + '건</h1>'
    + '<p class="sub">' + qEsc(cnt) + ' · 생성 ' + qEsc(diag.생성KST) + ' KST · 빌드 ' + qEsc(String(env.빌드도장)) + '</p>'
    + doNow
    + '<p class="lead"><b>클로드에게 이렇게 주면 돼</b> — 이 파일 첨부 + "알림 리포트야. <b>클로드가 볼 일</b>부터 고쳐줘." '
    + '아래는 조치 주체로 갈라 놨어: <b>운영자가 할 일</b>=폰·쿠키·계정(코드로 못 고침) · <b>앱 버튼 한 번</b>=알림 상세에서 누르면 끝 · <b>클로드가 볼 일</b>=코드 축 · <b>자동 복구 대기</b>=아무것도 안 해도 됨.</p>'
    + (grp || '<ol><li class="it">지금 해결할 문제 없음</li></ol>')
    + '<h2>환경(이 화면이 뭘 돌리고 있었나)</h2><table>' + ev + '</table>'
    + '<h2>진단 스냅샷(판정 소스 원값)</h2><table>' + dl + '</table>'
    + '<script type="application/json" id="nomute-report">' + JSON.stringify({ env, diag, items: rows.map(m => ({ id: m.id || null, kind: msgKind(m).t, who: _rptWho(m), who_ko: RPT_WHO[_rptWho(m)], at_kst: _rptAbs(m), ago: msgAgo(m), text: m.text || '', todo: _rptTodo(m.text) || _rptAct(m), action: m.action || null, why: m.why || null, origin: _rptSrc(m) })) }).replace(/</g, '\\u003c') + '<\/script>'   // ⚠ script 안은 **원문 JSON**(qEsc 금지 — HTML 파서가 script 내용을 디코딩 안 해 &quot;가 그대로 남아 JSON.parse가 죽는다 · 260727 실측) · 닫는 태그 조기 종료만 `<`→<로 봉쇄
    + '</div></body></html>';
}
function msgRptDl(btn) {   // 저장 = Blob a[download](같은-출처라 네이티브 저장 · downloadImg의 프록시 경유는 외부 URL 축이라 여기선 불필요) · 받은 표식 = .dl-done(다운로드 표준 mut)
  const blob = new Blob([msgRptHtml()], { type: 'text/html;charset=utf-8' }), url = URL.createObjectURL(blob);
  const a = document.createElement('a'); a.href = url; a.download = 'nomute-alert-' + dlStamp() + '.html';   // ⚠ ASCII 파일명 고정 — blob 저장에 **한글 이름을 주면 확장자째 날아가 'download'로 떨어진다**(260727 실측: 같은 코드로 한글 → "download" / ASCII → 정상). 확장자 유실 = 첨부해도 HTML로 안 열림 = 이 기능의 목적 파손 · 시각 프리픽스는 dlStamp() 전 앱 규칙 계승
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 4000);
  if (btn) btn.classList.add('dl-done');
}

// ── 배포 버전 도장(운영자 Q44 "도장 ㄱ") — .github/workflows/stamp-version.yml이 배포 시 커밋SHA·KST로 치환(로컬·미배포 = 'dev').
//    화면 표시 = #linkpop(설정 메뉴) 하단 .lp-ver → 설정 열면 스샷에 찍혀 '지금 돌아가는 버전'이 자증됨.
//    SW 셸(sw.js)에 통째로 구워지므로 캐시된 옛 셸은 '자기 옛 도장'을 그대로 보여줌 = "고쳤는데 그대로"의 진위(구버전 열람 vs 실미해결)를 스샷만으로 판별. ⚠️ 아래 /*BUILDSTAMP*/ 마커 = 워크플로 sed 앵커(삭제·이동 금지).
const BUILD_STAMP = '0cb76c4 · 260908_2305';  /*BUILDSTAMP*/
(function stampVer(){
  const el = document.getElementById('lpVer'); if (!el) return;
  const dev = (BUILD_STAMP === 'dev');
  el.textContent = dev ? 'dev · 미배포' : ('버전 ' + BUILD_STAMP);
  el.title = dev ? '로컬/미배포 빌드' : '탭하면 버전 복사 — 버그 제보 때 이 값을 붙여줘';
  if (!dev) el.onclick = async () => {   // 탭 = 복사(클립보드 관례 계승) → 제보 시 붙여넣기 = 구버전/미해결 10초 판별
    try { await navigator.clipboard.writeText(BUILD_STAMP); const o = el.textContent; el.textContent = '복사됨 ✓'; setTimeout(() => { el.textContent = o; }, 1200); } catch {}
  };
})();

// ── SW 상시 등록 = HTML 셸 캐시(콜드부트 즉시 페인트 → OS 스플래시 한 깜빡·운영자 승인 260706) ──
// 옛날엔 푸시 켤 때만 등록 → 캐시 SW가 전 사용자에 안 깔림. 등록은 멱등(같은 sw.js = no-op)·푸시 플로우 재등록과 충돌 0.
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('sw.js').catch(() => {});
  // ── 알림 아이콘 테마 통지(운영자 260727 "어두운 테마 알림판에서는 반대색으로") ──
  // 서비스워커에는 matchMedia가 없어 OS 테마를 스스로 못 본다 → 페이지가 1비트를 알려주고 SW가 Cache에 적재,
  // push 수신 때 그 값으로 아이콘을 고른다(라이트=파랑 / 다크=시그니처 = favicon-globe-260724.svg 매핑 계승).
  // 부팅 1회 + 테마 변경 시 재통지 = 폰 다크모드 토글이 다음 알림부터 반영.
  try {
    const _mq = matchMedia('(prefers-color-scheme: dark)');
    const _sendTheme = () => navigator.serviceWorker.ready
      .then(r => r.active && r.active.postMessage({ type: 'nm-theme', dark: _mq.matches })).catch(() => {});
    _sendTheme(); _mq.addEventListener('change', _sendTheme);
  } catch {}
  // Access 세션 만료 자가치유 — SW 재검증이 로그인 리다이렉트를 감지하면 통지 → ?nosw=1(캐시 우회) 재진입 = 로그인 화면 정상 노출.
  // ?nosw=1로 정상 착지(재로그인 복귀) = 가드 해제 → 같은 탭에서 Access가 *재*만료돼도 자가치유 재무장(평의회 1 지적).
  try { if (new URL(location.href).searchParams.has('nosw')) sessionStorage.removeItem('nmAuthKick'); } catch {}
  navigator.serviceWorker.addEventListener('message', e => {
    try {   // sessionStorage 자체가 막힌 웹뷰(쿠키 차단 등)에서 getItem throw로 핸들러 침묵사 방지(평의회 2·5)
      if (e.data && e.data.type === 'nm-auth-stale' && !sessionStorage.getItem('nmAuthKick')) {
        window._nmAuthKicked = true;   // 새버전 적용(applyShellUpdate)의 reload가 이 nosw replace를 밟는 레이스 차단 표식 — kick 소진 후 nosw 미착지 = 자가치유 영구 침묵 방지(평의회 260717-7)
        sessionStorage.setItem('nmAuthKick', '1');   // 세션 1회 가드 = 리로드 루프 차단(SW의 nosw 조기 return이 1차 방어)
        const u = new URL(location.href); u.searchParams.set('nosw', '1'); location.replace(u.href);
      }
      if (e.data && e.data.type === 'nm-shell-updated') { if (autoApplyUpdate()) return; flagShellUpdate(); showUpdateToast(); }   // 한가하면 묻지 않고 그 자리 반영(운영자 260810→260811 상시화) · 바쁘면 이월 + 종전 2채널 = 새 index 셸 배포 감지(SW SWR 백그라운드 재검증이 옛≠새 감지) → 메시지함 점등(260724 조용한 채널 유지) + 보라 토스트 재점등(운영자 260802 "새버전은 보라색 토스트 하면 됨") — 두 채널 병행 · 억제는 각자 보유
    } catch {}
  });
}

// 강제(하드) 새로고침 = SW 셸 캐시(SWR) 우회 → 옛 셸(직전판) 아닌 최신 index를 즉시 로드(§파이프라인 5-a · sw.js `?nosw=1` 탈출구). Access 자가치유(위 nosw replace 6767)와 동일 검증된 패턴 재사용 · 상단 강제새로고침 버튼·당겨서새로고침 공용(운영자 260713 "위 잡아당기면 강제 새로고침"). replace = 히스토리 미적재(뒤로가기 스택 청결) · 탭은 localStorage로 복원.
function hardReload() {
  try { const u = new URL(location.href); u.searchParams.set('nosw', '1'); location.replace(u.href); }
  catch { location.reload(); }   // URL 파싱 불가 등 = 일반 리로드 폴백(SWR 캐시 맞을 수 있음)
}

// ── 새 버전 토스트(운영자 260717) — SW가 백그라운드로 새 index 셸을 받아 캐시 갱신할 때(옛≠새) 통지 → "새 버전 · 탭하면 반영" 안내.
//    SWR 특성상 배포가 *다음 진입*까지 지연 노출되던 것(§파이프라인 5-a · 시각 튜닝마다 '옛 화면' 헷갈림)을 가시화. sw.js nm-shell-updated postMessage와 한 쌍(nm-auth-stale 패턴 계승).
//    탭 = applyShellUpdate(최신 셸 '지금' 재확보 → SW 캐시 갱신 → reload = 중첩 배포 N건도 한 탭 일괄 해소 · 운영자 260717 "5건이면 5번 눌러야되네") · ✗ = 이번 접속만 숨김(다음 배포 감지 시 재알림) · 긴급/경보 토스트 표시 중 = 양보(같은 자리·z 겹침 차단 = checkFreshLane 양보 패턴 계승) · 접속당 1회.
let _shellUpdShown = false, _shellUpdT = 0, _shellUpdApplying = false;
// 탭 = 통지 시점 캐시가 아니라 '탭 시점 네트워크 최신'으로 직행 — 통지 후 배포가 더 쌓이면(중첩) reload마다 재검증이 또 옛≠새를 감지해
//   토스트가 배포 수만큼 반복되던 것(1탭=1세대 전진)을, 최신 셸을 직접 fetch→SW 캐시에 꽂고 reload = 몇 건이든 1탭 종결로 교정(운영자 260717).
async function applyShellUpdate(t) {
  if (_shellUpdApplying) return; _shellUpdApplying = true;   // 더블탭 = fetch 중복 발사 차단(reload 직전 짧은 창 · 리셋 불요 = 어차피 reload)
  try { sessionStorage.setItem('nmUpdScrollY', String(Math.round(window.scrollY || (document.scrollingElement || {}).scrollTop || 0))); } catch {}   // 탭 시점 스크롤 저장 → reload 후 복원(시각 튜닝 시 맨위 튕김 방지 · 복원 = 아래 restoreUpdScroll · 운영자 260717)
  const m = t && t.querySelector('.ft-msg'); if (m) m.innerHTML = '반영중…';   // 처리중 = gdots 점모션 정본 계승(§디자인 g · pushToggle '변경중' 문법 = 붙여쓰기 가족 표기 동일 · 평의회 260717-8) — 느린 망에서 탭이 먹통처럼 안 보이게
  try {
    const res = await fetch(location.pathname, { cache: 'no-store', signal: (typeof AbortSignal !== 'undefined' && AbortSignal.timeout) ? AbortSignal.timeout(4000) : undefined });   // 비내비게이션 fetch = SW fetch 핸들러 불간섭(mode≠navigate) = 순수 네트워크 최신 · 4s 상한 = 무한 대기 차단
    if (res.ok && !res.redirected && res.type === 'basic') {   // 가드 = sw.js ⓐ 동일(Access 로그인 리다이렉트로 캐시 오염 차단) · 'nm-shell-v2' = sw.js SHELL_CACHE와 짝(check_refs 셸캐시 패리티 게이트가 기계 감시 · 260717)
      // 절단 검문(260802 '상단만 렌더' 재발 실사고 봉합) — sw.js put에만 검문을 달고 이 페이지측 put이 무검문이라,
      // '탭하면 반영' 중 전송 절단(청크 스트림 = content-length 없음 = res.ok 그대로)이 잘린 셸을 두 키에 동시에 꽂았다.
      // 꼬리 </html> 확인 후에만 캐시 자격(sw.js intact 술어와 동일 축 · check_refs check_shell_put_integrity가 기계 감시).
      // 절단이면 put 생략 = 기존 정상 사본 보존 → 아래 reload는 종전 셸 서빙 · 수렴은 다음 진입 SWR 재검증이 담당(fail-soft).
      const body = await res.text().catch(() => null);
      if (body != null && /<\/html>\s*$/i.test(body)) {
        const c = await caches.open('nm-shell-v2');
        await Promise.all(['/', '/index.html'].map(p => c.put(location.origin + p, new Response(body, { status: 200, statusText: 'OK', headers: res.headers }))));   // sw.js SHELL_PATHS 두 키 동시 갱신 — 현재 경로만 put하면 형제 키가 옛 세대로 남아 그 경로 진입 때 토스트 재발(평의회 260717-9) · 키 = 쿼리 제거 정규화 동일 · Response 재조립 = 검문서 본문을 이미 소비(헤더 원본 계승)
      }
    }
  } catch {}   // 오프라인·quota·타임아웃 = 캐시 무접촉 → 아래 reload가 통지 시점 셸로 종전과 동일 동작(fail-soft · 최소 1세대는 전진)
  if (window._nmAuthKicked) return;   // fetch 창(≤4s)에 Access 만료 자가치유(nosw replace)가 발사됐으면 reload로 밟지 않음(평의회 260717-7)
  try { sessionStorage.setItem('nmUpdCoolT', String(Date.now())); } catch {}   // 반영 직후 90s 재알림 억제 도장(무한루프 회로차단기 · 운영자 260717) — 그 사이 실배포가 와도 SWR 재검증 put이 캐시를 조용히 갱신 = 다음 진입 반영(수렴 보장 · 억제 = 표시만)
  softShellReenter();   // 성공 = 베일 페이드 후 방금 꽂은 '현재 최신' 셸 즉시 서빙(아래 봉합 — 구 location.reload()는 그 캐시를 두고 네트워크를 기다려 흰 공백이 떴다) + SWR 재검증도 동일 바이트 = 재알림 없음
}
// ── 부드러운 재진입(운영자 260821 «버전 업데이트가 자동으로 되긴하는데 화면이 너무 심하게 번쩍여 · 아예 흰색이 번쩍이면서 하니까 오류같음») ──
//    흰 번쩍의 실체 = location.reload()는 req.cache='reload'라 sw.js의 「명시적 새로고침 = 네트워크 우선 3s 캡」(260720 F6 =
//    Ctrl+R·당겨서 새로고침 전용 계약)에 걸린다 — applyShellUpdate가 **방금 최신 셸을 캐시에 꽂아 놓고도** 그걸 안 쓰고
//    네트워크 응답을 기다렸고, 그 0.3~3s 공백 동안 브라우저 기본 캔버스(폰 = 흰색)가 그대로 드러났다(위 구상 주석
//    「방금 꽂은 현재 최신 셸 즉시 서빙」과 실동작이 어긋나 있던 자리 = 두 계약의 충돌). 봉합 2축 =
//    ⓐ 나가는 쪽 = 부팅 베일(#bootveil) 재사용 — 같은 색·같은 .5s 전이로 앱 → 어두운 베일을 덮고 나서 문서를 교체
//       (인라인 opacity가 body.booted #bootveil{opacity:0}를 이긴다 · 값·색 창작 0 = 들어오는 쪽 부팅 크로스페이드와 한 벌 = '촤르르' 왕복)
//    ⓑ 재진입 = SW가 이 페이지를 쥐고 있으면 replace(기본 캐시 모드) → sw.js '캐시 즉시 응답' 경로 = 공백 거의 0.
//       SW 미제어(첫 방문·nosw 모드)면 종전 reload 유지 — 그 경로는 네트워크 재검증이 정본이라 기본 모드로 가면 HTTP 캐시 낡은 판 위험.
//       해시는 떼고 간다(같은 해시로 replace = 문서 교체가 아니라 조각 이동 = 갱신 불발) · replace = 히스토리 무증식(뒤로가기 오염 0).
function softShellReenter() {
  try {
    let v = document.getElementById('bootveil');   // 부팅 후 _bootReveal이 DOM서 제거했으므로 재생성(셀렉터·CSS는 부팅 정본 그대로)
    if (!v) { v = document.createElement('div'); v.id = 'bootveil'; v.setAttribute('aria-hidden', 'true'); document.body.appendChild(v); }
    v.style.opacity = '0'; void v.offsetWidth; v.style.opacity = '1';
  } catch {}
  setTimeout(() => {   // 베일 페이드(.5s)와 물려 덮인 뒤 교체(reduced-motion = 베일 즉시 표시라 대기만 남음 = 무해)
    if (window._nmAuthKicked) return;   // 대기 창에 Access 자가치유(nosw replace)가 발사됐으면 밟지 않음(applyShellUpdate 가드 연장)
    try { if (navigator.serviceWorker && navigator.serviceWorker.controller) { location.replace(location.pathname + location.search); return; } } catch {}
    location.reload();
  }, 460);
}
// ── 새 버전 자동 반영(운영자 260811 "새 버전이 있는 경우, 알아서 이를 갱신해서 내가 갱신 버튼을 눌러서 새로고침 할 필요가 없게해줘") ──
//    구판(260810) = '진입 직후 15s 창'에서만 자동 → **화면을 열어 둔 채 배포가 오는 실제 경로는 영영 수동이었다**:
//      스탬프 자기확인(checkNewVersion)의 첫 발사가 부팅 45s라 그 호출부의 autoApplyUpdate는 `performance.now() > 15000`에 걸려
//      **구조적으로 항상 false**였고(10분 주기·복귀 즉검도 전부 창 밖), 운영자에게 남는 건 보라 토스트 탭뿐이었다 = 이번 지시의 "갱신 버튼".
//    이제 창 조건을 버리고 **한가 판정**으로 간다 = nm-sync ③ '한가할 때만 리로드' 계약과 같은 축(강제 이탈 0 · 값·문법 창작 0).
//    바쁨 = 입력 중 ∨ 열린 모달(dialog[open] = 쓰는 중·읽는 중 공통) → 미루고 종전 토스트는 그대로 띄운다(운영자가 원하면 즉시 탭)
//      + 한가해지는 순간 대기 틱이 자동 반영. 스크롤은 applyShellUpdate가 저장·복원(맨위 튕김 0).
//    ⚠ 무한 리로드 회로차단 3중(260717 '탭하면 반영 무한루프' 실기록 계승) = ⓐ **배포 도장별 1회**(구 '세션 1회' 대체 — 세션 1회면
//      두 번째 배포부터 다시 수동이 되어 이번 지시가 반나절 만에 되돌아간다. 반영 뒤에도 같은 도장이 새 것으로 보이면 = 수렴 실패
//      = 그 판은 2회째부터 토스트로 내려 사람이 판단 = '자동은 한 판당 한 번, 못 고치면 조용히 안 고침이 아니라 보이게'는 그대로)
//      ⓑ 반영 직후 90s 쿨다운(nmUpdCoolT 공용) ⓒ 적용 중 재진입 차단(_shellUpdApplying).
const AUTO_UPD_RETRY = 60000;   // 미룬 건 재시도 주기 — 바쁠 때만 켜지고 반영·해소되면 스스로 끈다(nm-rail 경과 틱 관례 계승 · document.hidden 가드 = C16 유휴 정숙 동축)
let _updWaitKey = '', _updWaitT = 0;
function updBusy() {   // 한가 판정 = nm-sync busy 술어(입력 중) + 이 셸 고유축(열린 모달 = 작업·독서 중)
  const a = document.activeElement;
  if (a && (a.tagName === 'INPUT' || a.tagName === 'TEXTAREA' || a.isContentEditable)) return true;
  try { if (document.querySelector('dialog[open]')) return true; } catch {}
  return false;
}
function updWait(key) {   // 바쁨 = 이월(강제 이탈 0) · 한가해지는 순간 자동 반영
  _updWaitKey = key;
  if (_updWaitT) return;
  _updWaitT = setInterval(() => {
    if (!_updWaitKey || _shellUpdApplying) { clearInterval(_updWaitT); _updWaitT = 0; return; }   // 해소·반영 중 = 자기 소등
    if (document.hidden || updBusy()) return;                                                    // 아직 바쁨 = 다음 틱(DOM 무접촉)
    const k = _updWaitKey; _updWaitKey = ''; clearInterval(_updWaitT); _updWaitT = 0;
    autoApplyUpdate(k);
  }, AUTO_UPD_RETRY);
}
function autoApplyUpdate(stamp) {   // true = 자동 반영이 이 건을 맡음(호출부는 토스트를 띄우지 않는다)
  if (_shellUpdApplying) return true;                                          // 이미 반영 중 = 곧 reload
  const key = stamp || 'sw';                                                   // SW 통지 경로는 도장을 모른다 = 고정 키(그 경로만 종전대로 세션 1회 강도 유지)
  try { if (Date.now() - (+sessionStorage.getItem('nmUpdCoolT') || 0) < 90000) return false; } catch {}   // ⓑ 반영 직후 억제(토스트 경로와 동값)
  try { if (sessionStorage.getItem('nmAutoUpd') === key) return false; } catch {}   // ⓐ 같은 도장 2회째 = 수렴 실패 → 토스트로 내려 사람이 판단
  if (updBusy()) { updWait(key); return false; }                               // 바쁨 = 미룸 + 토스트 병행(선택지 보존) · 한가해지면 위 틱이 이어받는다
  try { sessionStorage.setItem('nmAutoUpd', key); } catch {}
  console.log('[update] 새 버전 자동 반영 — 한가 · 최신 셸 재확보 후 재진입');   // 계측 = 조용한 리로드 금지(nm-sync ③ 관례)
  applyShellUpdate(null);                                                      // 정본 재사용 = 최신 셸 fetch → SW 캐시 두 키 갱신 → reload(중첩 배포 N건 일괄 해소 · 신규 경로 0)
  return true;
}
// 새 버전 감지 → 메시지함 항목 점등(운영자 260724 "UI 바뀔 때마다 알림도 메시지함으로"). 구 showUpdateToast(튀는 토스트 팝)
//   대신 조용한 채널 = 화면 안 가리고, 메시지함에서 '반영하기'로 조치. 억제·중복 흡수 로직은 토스트 버전 계승.
