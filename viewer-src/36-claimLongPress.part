  try { localStorage.setItem('nomute_tab', tab); } catch {}   // 새로고침 복원용

  setViewhead(tab);
  const _vh = $('#viewhead'); if (_vh && document.body.classList.contains('booted')) { _vh.classList.remove('vh-enter'); void _vh.offsetWidth; _vh.classList.add('vh-enter'); }   // 탭 전환 = 검색·필터 픽토그램이 콘텐츠 촤르륵 초반 슬롯에 동승(vh-enter 애니 .06s 지연 · 운영자 260707 2차 "따로 편성 말고 같이" — 구 .3s 후행 갱신 · reflow로 애니 재시작) · ⚠ booted 가드 = 부팅 초기 showTab(booted 전)엔 vh-enter 스킵 → 검색·필터가 booted 게이트(opacity 0→1 + viewhead 딜레이 .06s)로 콘텐츠와 동승(운영자 260706 "로딩할 때 미리 떠버림" 수정 — vh-enter 애니 opacity가 게이트를 이겨 먼저 뜨던 것 차단)
  $('#bnav').querySelectorAll('.bnav-i[data-tab]').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));
  if (tab === 'scrap') enterScrap();   // 탭 진입 = 4소스 병렬 로드 후 renderScrap 1회(깜빡임 다수 방지 · 아래 enterScrap). 강제 재요청·cross-device·토스트 de-dup 전부 보존.
