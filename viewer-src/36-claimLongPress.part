async function enterScrap() {
  ratedKeep.clear();                         // 탭 진입 갱신 = 별점 매긴 카드 리스트서 비움(원래 loadCandidates(!quiet)가 하던 것 — 단일렌더 위해 여기로 이관)
  markPickFailSeen();    // 픽실패 본 것 처리 · 긴급 토스트는 seen 폐지(체크 전까지 유지·운영자 260702) → 수집함 진입만으론 안 끔
  await Promise.allSettled([ loadCandidates(true), loadPickFails(), loadPending(false), loadTriage(false) ]);
  if (CURTAB === 'scrap' && SCRAP_LOADED) renderScrap();   // 모든 데이터 확보 후 1회만 렌더 = 깜빡임 0(탭 이탈했으면 스킵)
}

// 소스(커뮤니티) 정치 성향 색 틴트 — 통념·근사(운영자 요청 '조금'). 진보=파랑·보수=빨강·중도/취미/미분류=중립(시안).
// ⚠️ 성향은 논쟁적·근사치 → 조정 가능. 미등록 소스는 중립 유지.
// 정치성향 5단(웹검색 8회·통념근사·운영자 260704): ll=강진보 · l=약진보 · mid=중립 · r=약보수 · rr=강보수. 네이버(블로그·카페·지식iN)는 중립(lean-mid · 운영자 260705). ⚠️ 성향은 논쟁적·근사 → 조정가능.
// 🔧 정본 = viewer/soc_lean.json (loadSocLean이 로드하며 이 맵을 덮음) · 성향 조정 편집은 soc_lean.json에서만(코드·게이트 무접촉 · 운영자 260717). 아래 리터럴 = 폴백 스냅샷(json 유실·fetch 실패 시 현 동작 보존 = fail-soft §[4]).
let SOC_LEAN_MAP = {
  '클리앙':'ll','보배드림':'ll','82쿡':'ll','더쿠':'ll','오유':'ll','인스티즈':'ll','루리웹':'ll','뽐뿌':'ll',   // 강진보(뽐뿌 = 운영자 260717 극좌 재분류: 약진보 l → 강진보 ll)
  'SLR':'l','이토랜드':'l','웃대':'l',   // 약진보(친민주 다수)
  '인벤':'mid',   // 중립(2022 맵 중도·게임 위주)
  '엠팍':'r','와이고수':'r',   // 약보수(엠팍=조국 후 反與·와이고수=우경화)
  '에펨코리아':'rr','디시':'rr','일베':'rr',   // 강보수
};
const socLean = s => { const v = SOC_LEAN_MAP[s] || (NAVER_CHIP[s] ? 'mid' : ''); return v ? 'lean-' + v : ''; };   // 네이버 계열 = 중립(lean-mid) — 운영자 260705 "네이버 블로그·카페 다 중립으로"
// SNS 소스 플랫폼 분류 — 네이버 계열 = 중립 칩 + 픽토(카페/블로그 · 옛 약진보 시안 폐지 260705). 소스명 = social_burst.py NAVER_QUERIES 표시이름 1:1.
// 픽토 + 짧은 라벨(운영자 260704): 카페=☕컵·블로그=✒️펜(ico=flex), 지식iN=픽토 없이 이름만. 색은 .src-naver로 통일.
const NAVER_CHIP = {
  '네이버카페':   { cls: 'src-naver src-naver-cafe ico', icon: CAFE_SVG, label: '카페' },
  '네이버블로그': { cls: 'src-naver src-naver-blog ico', icon: BLOG_SVG, label: '블로그' },
  '지식iN':       { cls: 'src-naver src-naver-kin',       icon: '',       label: '지식iN' },
};
const socSrc = s => (NAVER_CHIP[s] ? NAVER_CHIP[s].cls : '');
// 출처성향 게이지값 — 소스 → 정치성향(1~10축·biasZoneCol 정합). SOC_LEAN_MAP 우선·네이버=중립(칩 동축 · 옛 약진보 폐지 · 운영자 260705)·미등록=불명(회색). LLM 0.
const LEAN_VAL = { ll:1, l:3, mid:5, r:7, rr:9 };
const socVal = s => { const k = SOC_LEAN_MAP[s]; if (k) return LEAN_VAL[k]; if (NAVER_CHIP[s]) return LEAN_VAL.mid; return null; };
// (socValKey 제거 — 동그라미 흰색 통일로 편향 등급 클래스 불요·260704)
let SOC_LEAN_LOADED = false;   // soc_lean.json 1회 로드 가드(성공 시에만 set = 실패 시 다음 탭 진입 재시도 · loadTrends 철학 계승)
async function loadSocLean() {   // 소스 성향 정본(soc_lean.json) 로드 → SOC_LEAN_MAP 덮어씀. loadSocial이 렌더 전 await(깜빡임 0) · 실패 = 폴백 스냅샷 유지(fail-soft) · SPA폴백 가드 = loadTrends 동일.
  if (SOC_LEAN_LOADED) return;
  try {
    const r = await fetch('soc_lean.json?_=' + Date.now());
    if (!r.ok) return;
    const tx = await r.text();
    if (/^\s*</.test(tx)) return;   // SPA 폴백(HTML 200) 가드 = loadTrends·loadSocial 동일
    const j = JSON.parse(tx);
    if (j && typeof j === 'object' && !Array.isArray(j)) { SOC_LEAN_MAP = j; SOC_LEAN_LOADED = true; }   // 정본 오버라이드(_help 키 = 소스명 조회 무해)
  } catch (e) { /* 폴백 스냅샷 유지 */ }
}
// SNS 뷰 — 소셜 버스트(커뮤니티 비정치 공론화 이슈) 레인. social_burst.py → social_candidates.json 렌더.
// 행 = {title,url,sources[],source_count,posts,age_h,burst}. 시안 테마. 정본 설계 = docs/social-burst.md §35.3.
let _snsSig = '';   // 직전 SNS 렌더 시그니처(동일 구성 재렌더 = 스태거 생략 게이트 · renderScrap 패턴 · 운영자 260622)
// 🔥 SNS burst 색 티어 임계 — 7일치(14d 5스냅샷·고유 22사건) 분포: p90≈23.9(보라)·p70≈11.8(강조). 표시 전용(랭킹·정렬·진입 무관). 정본 = docs/social-burst.md.
const SOC_HOT10 = 24, SOC_HOT30 = 12;
// 국내 커뮤니티 카드 입장 하한(운영자 260818 "sns 소스 10.0 미만은 안뜨게 해줘") — 카드 좌상단 🔥 공론 강도(burst)가 이 값 미만이면 목록에서 뺀다.
//   ⚠ 판정은 **화면에 적히는 값 기준**(표시 = `_b.toFixed(1)` 소수 1자리) — 값 9.96은 화면에 "10.0"으로 적히므로 남긴다.
//     원값(>=10)으로 자르면 "10.0이라고 적힌 카드가 사라진다"가 되어 화면과 규칙이 어긋난다.
//   ⚠ 검색 결과에도 동일 적용(목록 자체에서 배제 = "안 뜨게" 계약) · 전건 미달이면 조용한 공백(§디자인 e-가).
//   되돌림 = 이 상수를 0으로.
const SOC_MIN = 10;
const socPass = r => Math.round(((+(r && r.burst) || 0)) * 10) / 10 >= SOC_MIN;   // 표시값(소수 1자리 반올림) 기준 하한 통과 판정
// ── 트렌드 레인(메뉴2 상단) — sns_trends.json 렌더(수집 = sns-trends.yml 30분 주기 · 운영자 260710 "ㄱㄱ" 배치 승인). 있는 소스만 그림·전무 = 조용한 공백(§디자인 e-가). ──
let TRENDS = null, BRIEF = null, _trFetched = 0, _trPainted = 0;   // _trPainted = 첫 실검 도착 후 수집함 1회 재렌더 도장(대세 GX·1.2배가 부팅 첫 화면에 반영되게 · 4496행 「첫 DATA 도착 = 1회 재렌더」 관용구 계승)
// ⚠️ 소스 순서 = **api/trends(GitHub main 직독 · 빌드 우회) → 정적 sns_trends.json**(loadCandidates 정본 문법 그대로 계승 · 운영자 260803).
//    정적 파일 = Cloudflare Pages **빌드 시점 스냅샷**인데 main 커밋이 3시간에 192건(봇·세션)이라 빌드(500/월 한도)가 구조적으로 못 따라온다
//    → 실측 260803 19:29: 레포 updated 18:40(49분 전) vs 라이브 정적 15:18(**4h11m 전**) = "SNS가 3시간씩 밀린다"의 진범(수집 워크플로는 무결).
//    수동 재수집 픽토(#snsFreshBtn)도 이 줄이 없으면 반쪽 = 수집은 도는데 화면 JSON이 안 바뀌어 완료 판정(updated 변화)이 영영 안 온다.
//    정적 폴백은 그대로 보존 = 로컬 렌더·스모크(python http.server = Functions 없음)와 Functions 장애 시 종전 동작 유지(품질 손실 0).
// force = 수동 재수집 감시 폴 전용 캐시버스터(api는 max-age 60s·엣지 30s 캐시라 무버스터면 완료 감지가 최대 1분 늦는다 · 평시 폴은 무버스터 = 엣지 캐시 이득 보존)
async function loadTrends(force) {
  if (Date.now() - _trFetched < 5 * 60e3) return;   // 5분 TTL(수집 30분 주기 = 충분·탭 재진입 남발 방지)
  try {
    let tx = null;
    for (const u of ['api/trends' + (force ? '?_=' + Date.now() : ''), 'sns_trends.json?t=' + Date.now()]) {
      try {
        const sig = (typeof AbortSignal !== 'undefined' && AbortSignal.timeout) ? AbortSignal.timeout(12000) : null;   // 시도마다 새 시그널 = loadCandidates 관용구(하나를 재사용하면 1차 타임아웃이 2차 폴백까지 즉사시킨다)
        const r = await fetch(u, sig ? { signal: sig } : undefined);
        if (!r.ok) continue;
        const t0 = await r.text();
        if (/^\s*</.test(t0)) continue;   // SPA 폴백(HTML 200) 가드 = rszLoad·freeLoad 동일
        const j = JSON.parse(t0);
        if (!j || !j.updated) continue;   // updated 없는 응답 = 서빙 실패 신호 → 다음 소스(candidates 빈배열 SPOF 교훈 미러 · 260714)
        tx = t0; TRENDS = j; break;
      } catch { /* 다음 소스 */ }
    }
    if (tx === null) return;   // 전 소스 실패 = last-good 유지(종전 동작 그대로)
    if (!_trPainted) { _trPainted = 1; try { if (CURTAB === 'scrap' && SCRAP_LOADED) renderScrap(); } catch { /* 렌더 실패가 트렌드 로드를 죽이지 않는다 */ } }   // 첫 실검 도착 = 수집함 1회 재렌더 — 실검은 비동기라 부팅 첫 렌더가 대개 이 앞에 온다(실측: 그 화면은 대세 승격이 빠진 카드 목록) · 1회 도장이라 5분 TTL 재로드마다 깜빡이지 않는다
    _trFetched = Date.now();   // TTL 스탬프 = 성공 시에만(선-set이면 첫 로드 blip 한 번에 트렌드 레인 5분 공백 · 평의회 260713 ⑤)
  } catch (e) { return; }
  try {   // AI 브리프(비서 페르소나 · 운영자 260712) — 없거나 실패 = 블록 미표시(조용한 공백) · 소스 순서 = 본체와 동축(api 우선 → 정적 폴백)
    for (const ub of ['api/trends?f=brief' + (force ? '&_=' + Date.now() : ''), 'sns_brief.json?t=' + Date.now()]) {
      try {
        const rb = await fetch(ub);
        if (!rb.ok) continue;
        const tb = await rb.text();
        if (/^\s*</.test(tb)) continue;
        const jb = JSON.parse(tb);
        if (!jb || !jb.updated) continue;
        BRIEF = jb; break;
      } catch { /* 다음 소스 */ }
    }
  } catch (e2) {}
  try {   // ⑭-i 화재·지진 추적 상태(운영자 260803 "기계가 이 건을 놓쳤나를 화면에서") — 없거나 실패 = 칩 미표시(조용한 공백 · 문법 = 위 브리프 그대로)
    const rf = await fetch('fire_watch.json?t=' + Date.now());
    if (rf.ok) { const tf = await rf.text(); if (!/^\s*</.test(tf)) FWATCH = JSON.parse(tf) || []; }
  } catch (e2b) {}
  try { renderSnsTrends(); } catch (e3) {}   // 렌더 예외 격리 — loadTrends 프로미스 reject로 형제 배선까지 전파 차단(평의회 260713 ②)
  try { renderMsgBadge(); const mp = $('#msgpop'); if (mp && !mp.hidden) renderMsgList(); } catch (e4) {}   // 수집 고장(health.subs.stale) 반영 = 기어 색·알림메세지 목록 갱신(syncStaleMsg 본문 문법 계승 · 260725)
  try { quakeNotify(); } catch (e5) {}   // ⑭ 지진 = 기기 알림(운영자 260802) — 알림함 경고(quakeMsgs)는 위 renderMsgBadge가 이미 반영
}
// ── SNS 수동 재수집 상태머신(운영자 260803 "2시간씩 밀릴 때 수동 개선 · 누르면 즉각 받아오고 텀도 그 시점 기준 재갱신") — #snsFreshBtn(#vhTime 우측 픽토).
//    상태: idle(mut) → pend(골드레몬 · 연속 회전 · 발사 후 updated 변화 감시) → done(강조색 15분 유지) → idle.
//    발사 = /api/snsretry(메시지함 wd-sns '다시 받아오기' snsRecollect와 동일 축) → 서버가 sns-trends.yml workflow_dispatch(brief=1·force=1 = 28분 신선도 게이트 우회).
//    ⚠ 즉시 반영 아님(정직 고지) — 러너 픽업+수집+커밋+Pages 배포 ≈ 3~8분 · 그 구간을 pend 회전이 표시. 429(이미 수집 중) = pend 유지(그 런의 착지를 감시가 줍는다).
//    완료 판정 = TRENDS.updated 변화(1차 커밋 = 수집분) → 브리프(2차 커밋)는 완료 후 +90s/+180s 따라잡기 폴 2회가 줍는다 · 25분 무변화 = 타임아웃 idle 복귀 + fail 토스트(정직).
//    텀 재앵커 = 감시 폴 loadTrends 성공이 _trFetched 갱신 → 완료 시점 기준 5분 TTL 재시작(livePoll 1분 주기는 불변).
//    리로드 생존 = localStorage(nm_snsfresh) — 폰 백그라운드·재진입에도 pend 감시·done 잔여 유지 복원.
// ── 260803 2차(운영자 "채널 요약도 새로고침 가능하게") = **2표면 공용 팩토리**로 일반화. 로직 1벌 · 인스턴스 2개(복제 금지 — 한쪽만 고쳐지는 드리프트 차단).
//    표면 = ⓐ SNS 다이제스트(#snsFreshBtn · /api/snsretry → sns-trends) ⓑ 채널 요약(#chanFreshBtn · /api/chanretry → insta-fetch|fb-fetch · 활성 소스만).
//    ctx = 클릭 시점 문맥 스냅샷(채널 = IG/FB 소스) — 감시 중 토글해도 **누른 그 소스**의 시각으로만 완료 판정(토글이 만드는 가짜 완료 차단).
const FRESH_HOLD = 15 * 60e3, FRESH_CAP = 25 * 60e3, FRESH_IV = 30e3;
function freshToast(msg) {   // 실패·지연 정직 보고 = .nm-toast fail 계승(nmFailToast 문법 · 전용 id = 속보/픽실패 채널과 비간섭) · 자동닫힘 7s · 2표면 공용
  let t = document.getElementById('nmSnsfToast');
  if (!t) { t = document.createElement('div'); t.id = 'nmSnsfToast'; t.className = 'nm-toast fail'; t.setAttribute('role', 'status'); t.setAttribute('aria-live', 'polite'); document.body.appendChild(t); }
  t.textContent = msg; requestAnimationFrame(() => t.classList.add('show')); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 7000);
}
function mkFresh(cfg) {   // cfg = { ls, btn, noun, post(ctx)→url, ctx()→문맥스냅, upd(ctx)→서버시각, reload(ctx) 강제 재fetch }
  let S = { st: 'idle', t0: 0, base: '', ctx: '', doneAt: 0 }, timer = null, hold = null;
  try { const s = JSON.parse(localStorage.getItem(cfg.ls) || 'null'); if (s && s.st) S = s; } catch {}
  const save = () => { try { localStorage.setItem(cfg.ls, JSON.stringify(S)); } catch {} };
  // ⚠️ 점등은 **문맥이 일치할 때만** — 채널은 IG/FB 두 소스가 버튼 1개를 공유해서, ctx 무시하고 칠하면 IG 재수집 중에 FB로 토글했을 때
  //   FB 화면 위에서 골드레몬이 돌고 완료 시 FB 시각 옆에 강조색이 켜진다 = **가짜 'FB 갱신 완료'**(260803 평의회 지적).
  const ctxOk = () => !cfg.ctx || !S.ctx || S.ctx === cfg.ctx();
  const paint = () => { const b = document.getElementById(cfg.btn); if (b) { const on = ctxOk(); b.classList.toggle('pend', on && S.st === 'pend'); b.classList.toggle('done', on && S.st === 'done'); } };
  const idle = () => { S = { st: 'idle', t0: 0, base: '', ctx: '', doneAt: 0 }; save(); paint(); if (timer) { clearInterval(timer); timer = null; } };
  const done = () => {
    if (timer) { clearInterval(timer); timer = null; }
    const cx = S.ctx;
    S = { st: 'done', t0: 0, base: '', ctx: '', doneAt: Date.now() }; save(); paint();
    setTimeout(() => cfg.reload(cx), 90e3); setTimeout(() => cfg.reload(cx), 180e3);   // 2차 커밋(AI 브리프·번역 = LLM 스텝 분리 착지) 따라잡기
    if (hold) clearTimeout(hold);
    hold = setTimeout(() => { if (S.st === 'done') idle(); }, FRESH_HOLD);
  };
  const tick = async () => {
    if (S.st !== 'pend' || document.visibilityState !== 'visible') return;   // 백그라운드 = 폴 쉼(livePoll 문법) — 복귀 다음 틱이 따라잡음
    if (Date.now() - S.t0 > FRESH_CAP) { idle(); freshToast(cfg.noun + ' 재수집이 아직 안 끝났어 — 러너 지연. 다음 자동 주기가 이어받아'); return; }
    await cfg.reload(S.ctx);   // TTL 우회 강제 재fetch(api 캐시버스터 동반 = 완료 감지 지연 0)
    const up = String(cfg.upd(S.ctx) || '');
    if (up && up !== S.base) done();
  };
  const resume = () => {   // 부팅 복원 — pend 만료면 idle · done 잔여면 남은 시간만 유지
    if (S.st === 'pend') { if (Date.now() - S.t0 > FRESH_CAP) return idle(); paint(); if (!timer) timer = setInterval(tick, FRESH_IV); }
    else if (S.st === 'done') { const left = S.doneAt + FRESH_HOLD - Date.now(); if (left <= 0) return idle(); paint(); if (hold) clearTimeout(hold); hold = setTimeout(() => { if (S.st === 'done') idle(); }, left); }
  };
  const click = async () => {
    if (S.st === 'pend') { if (!ctxOk()) freshToast('다른 소스 재수집이 진행 중이야 — 끝나면 눌러줘'); return; }   // 연타 무시(발사 중복 = 서버 rateGate 2중 방어) · 문맥 불일치(IG 도는 중 FB 클릭) = 무반응 대신 정직 고지(상태머신 1개는 두 소스를 동시에 못 추적)
    const cx = cfg.ctx ? cfg.ctx() : '';
    S = { st: 'pend', t0: Date.now(), base: String(cfg.upd(cx) || ''), ctx: cx, doneAt: 0 }; save(); paint();   // 즉시 점등(체감 반응 0ms) — base는 발사 뒤 실시각으로 재앵커
    if (!timer) timer = setInterval(tick, FRESH_IV);
    try {
      // 발사 = 최대 2회(260817 실사고 봉합) — 함수 **앞단**(엣지)이 죽으면 응답이 우리 JSON이 아니라 사유 없는 502 한 장이고
      //   (실측 = 채널 토스트 "잠시 뒤 다시 (502)" = j.error 부재의 예비 문구 · 같은 시각 함수·발사·수집·라이브 서빙은 전건 정상),
      //   1발 포기 구조라 일시 장애 한 발이 통째로 실패 UX가 됐다. 재발사는 **사유 없는 실패·네트워크 예외만**(서버가 사유를 준
      //   실패는 재시도 무익 = 즉시 고지) · 중복 발사 0 = 1차가 실제로 접수됐다면 2차는 서버 rateGate가 429로 받아 pend 유지.
      let r = null, j = {};
      for (let att = 0; att < 2; att++) {
        try { r = await fetch(cfg.post(cx), { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' }); }   // snsRecollect 발사 문법 그대로 · **발사가 1순위**(러너 스핀업이 전체 소요를 지배 = 재앵커를 앞세우면 그만큼 늦게 출발)
        catch { r = null; }
        j = r ? await r.json().catch(() => ({})) : {};
        if (r && (r.ok || r.status === 429 || j.error)) break;   // 접수·수집중·사유 있는 실패 = 확정(재발사 비대상)
        if (!att) await new Promise(w => setTimeout(w, 2500));
      }
      if (!r) { idle(); freshToast('재수집 발사 실패 — 네트워크'); }
      else if (r.status === 429) freshToast(j.error || '이미 수집이 돌고 있어 — 끝나면 자동 반영돼');   // 진행 중 런 존재 = pend 유지(그 런의 착지를 감시가 줍는다)
      else if (!r.ok || !j.ok) { idle(); freshToast(j.error || ('재수집 발사 실패 — 잠시 뒤 다시 (' + r.status + ')')); }
    } catch { idle(); freshToast('재수집 발사 실패 — 네트워크'); }
    if (S.st !== 'pend') return;   // 발사 실패로 idle 복귀 = 재앵커 금지(꺼진 상태를 되살려 유령 pend가 되는 것 차단)
    try { await cfg.reload(cx); if (S.st === 'pend') { S.base = String(cfg.upd(cx) || S.base); save(); } } catch (_) {}   // ⚠️ base = **클릭 시점 서버 실제값**으로 재앵커(첫 틱 30s 전 여유): 화면 데이터는 TTL만큼 묵을 수 있고, 그 사이 정기 런이 이미 갱신했다면 첫 틱이 "내 클릭으로 완료"라고 오판정한다(가짜 완료 차단 · 260803)
  };
  const btn = document.getElementById(cfg.btn);
  if (btn) { btn.addEventListener('click', click); resume(); }
  return { get st() { return S.st; }, get base() { return S.base; }, set base(v) { S.base = v; save(); }, save, paint, idle, tick, done, resume, click };
}
const SNSF = mkFresh({   // ⓐ SNS 다이제스트 — 완료 판정 = TRENDS.updated 변화(수집 1차 커밋)
  ls: 'nm_snsfresh', btn: 'snsFreshBtn', noun: 'SNS',
  post: () => '/api/snsretry',
  upd: () => (TRENDS && TRENDS.updated) || '',
  reload: async () => { _trFetched = 0; await loadTrends(true); },
});
const CHANF = mkFresh({   // ⓑ 채널 요약 — 소스별(IG/FB) 발사·판정 · 완료 판정 = generated_kst 변화
  ls: 'nm_chanfresh', btn: 'chanFreshBtn', noun: '채널',
  ctx: () => (CHAN_SRC === 'fb' ? 'fb' : 'ig'),
  post: cx => '/api/chanretry?src=' + cx,
  upd: cx => { const d = cx === 'fb' ? CHAN_FB : CHAN; return (d && d.generated_kst) || ''; },
  reload: async () => { CHAN_AT = 0; await loadChan(true); },
});
