function claimLongPress(el, ms, fn, ctxFn) {
  let t = null, x = 0, y = 0, at = 0;
  const cancel = () => { clearTimeout(t); t = null; };
  el.addEventListener('pointerdown', e => {
    if (e.button || MERGE_MODE) return;
    e.stopPropagation();
    if (_mergeLpT) { clearTimeout(_mergeLpT); _mergeLpT = null; }   // 부모 타이머가 이미 걸린 경로(캡처·타 바인딩) 이중 안전
    x = e.clientX; y = e.clientY; cancel();
    t = setTimeout(() => { at = Date.now(); fn(); }, ms);
  });
  ['pointerup', 'pointercancel', 'pointerleave'].forEach(ev => el.addEventListener(ev, cancel));
  el.addEventListener('pointermove', e => { if (t && Math.abs(e.clientX - x) + Math.abs(e.clientY - y) > 10) cancel(); });
  el.addEventListener('click', e => { if (Date.now() - at < 350) { e.preventDefault(); e.stopPropagation(); } });
  el.addEventListener('contextmenu', e => { e.preventDefault(); e.stopPropagation(); at = Date.now(); (ctxFn || fn)(); });
}
// 배지 1개 배선 — 수집함(.sc-badge.brk)·피드(.urg.brk) **두 표면 공용**. 한쪽만 달면 똑같이 생긴 '긴급'을
// 다른 화면에서 눌렀을 때 무반응 = 운영자가 신고했다고 믿는데 데이터가 0인 사고(배지 패리티 계약과 동축).
function brkClaimBadge(badgeEl, obj) { claimLongPress(badgeEl, 480, () => brkNotUrgent(obj, badgeEl)); }
// 신고 전송 — ratings.jsonl 은 append-only 라 이 행은 **신고 전용 스냅샷**(현 상태 동봉·reason만 예약키)이고
// 카드의 기존 사유 행은 그대로 남는다. 피드백 = 배지 텍스트 1.2s 스왑(BUILD_STAMP '복사됨 ✓' 관용구 계승·신규 부품 0).
function brkNotUrgent(obj, badgeEl) {
  let id = '';
  try { id = candId(obj) || ''; } catch { id = String(obj && obj.id || ''); }
  const cur = (typeof scRT === 'object' && scRT[id]) || {};
  postRate({ id, url: obj.url || '', title: obj.title || '', score: cur.score || 0, picked: !!cur.picked, dismissed: !!cur.dismissed, acked: !!cur.acked, action: cur.action || '', reason: 'brkno' });
  if (badgeEl && !badgeEl._brkBusy) {
    badgeEl._brkBusy = true;
    const o = badgeEl.textContent;
    badgeEl.textContent = '신고됨 ✓';
    setTimeout(() => { badgeEl.textContent = o; badgeEl._brkBusy = false; }, 1200);
  }
}
const _rateTimers = {};
function rateCard(c, n) {
  const id = candId(c); ratedKeep.add(id);
  // 진행 중 메모 입력 보존 — 별점 변경 재렌더로 텍스트·포커스·커서 유실 방지
  const af = document.activeElement, editing = (af && af.classList && af.classList.contains('sc-memo-in')) ? af : null;
  const mid = editing ? editing.dataset.id : null, mpos = editing ? (editing.selectionStart != null ? editing.selectionStart : (editing.value || '').length) : 0;
  if (editing) saveRating(mid, { memo: (editing.value || '').trim().slice(0, 200) });
  saveRating(id, { score: n }); renderScrap();   // ratedKeep = 이번 세션 유지(다음 갱신 때 제외)
  if (mid) { const mi2 = [...document.querySelectorAll('.sc-memo-in')].find(x => x.dataset.id === mid); if (mi2) { mi2.focus({ preventScroll: true }); try { mi2.setSelectionRange(mpos, mpos); } catch {} } }
  clearTimeout(_rateTimers[id]);   // 빠른 재평가(3→4→5)는 묶어 1회만 발사(커밋 스팸 방지)
  _rateTimers[id] = setTimeout(() => { const s = ratingsAll()[id] || {}; postRate({ id, url: c.url || '', title: c.title || '', score: s.score || n, picked: !!s.picked, memo: s.memo || '' }); }, 1000);
}
// 실패 응답 → 사람이 읽는 사유 1줄(운영자 260728 지시 ③ · Q976 후속). 260728 실사고에서 화면엔 `HTTP 502`만 뜨고
// **GitHub이 준 진짜 사유가 증발**해, 원인 찾는 데 Actions 기록 대조가 필요했다. 원인 = 우리 함수의 JSON({error})이
// 아닌 응답(엣지가 만든 502 HTML 등)이면 `r.json()`이 깨져 `{}`가 되고, 남는 게 상태코드뿐이었던 것.
// ∴ ⓐ JSON이면 error ⓑ 아니면 본문 앞머리(태그 제거·200자) ⓒ 어느 쪽이든 **상태코드는 항상 뒤에 붙인다**(유실 0).
async function failWhy(r) {
  let raw = ''; try { raw = await r.text(); } catch {}
  let why = '';
  try { why = String((JSON.parse(raw) || {}).error || ''); } catch { why = raw.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 200); }
  return (why ? why + ' ' : '') + '(HTTP ' + r.status + ')';
}
async function pickCard(c) {
  const id = candId(c); const cur = ratingsAll()[id] || {};
  if (cur.picked) return;                                  // 한 번만(중복 발사 방지)
  if (!c.url) { alert('원문 url이 없어 큐레이션 불가'); return; }
  saveRating(id, { picked: true, pickedAt: Date.now(), pickCross: c.cross || 0 }); renderScrap();   // 낙관적 표시 + 픽 시점 cross 스냅 · pickedAt=타임아웃 기준(없으면 즉시 거짓-Failed, applyTriage와 대칭·260620 분신술)
  clearTimeout(_rateTimers[id]);
  postRate({ id, url: c.url, title: c.title || '', score: cur.score || 0, picked: true });   // 관심도 원장(데이터)
  try {   // 큐레이션 발동 = pending 적재 → 분석 → 카드(피드에 등장). 실패 시 되돌려 재시도 가능.
    // alt = 같은 사건 타매체(cluster_members) — 분석기 대체fetch + 썸네일 검색이미지 '유사' 보강 소스(applyTriage와 동일·주 픽 경로 누락 복구)
    const alt = pickAlt(c).slice(0, 8);
    const r = await fetch('api/pick', { method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ url: c.url, title: c.title || '', alt, event_key: c.event_key || '' }) });
    if (!r.ok) throw new Error(await failWhy(r));
    qOptAdd(c.url, c.title || '');   // 접수 확정(디스패치 200) = 대기열·배지에 그 자리에서 등장 — pending 파일 착지(러너 ~1분)를 안 기다린다(운영자 260816 "바로 꽂혀야")
  } catch (e) {
    qOptDrop(c.url);   // 접수 실패 = 낙관 행 회수(아래 로컬·서버 원장 롤백과 한 묶음 = 유령 대기열 항목 0)
    saveRating(id, { picked: false }); renderScrap();
    postRate({ id, url: c.url, title: c.title || '', score: cur.score || 0, picked: false });   // 서버 원장도 롤백(로컬만 되돌리면 영구 불일치)
    alert('큐레이션 발동 실패 — 다시 시도해줘\n' + (e.message || e));
  }
}
// 👎 관심없음 = 별점 1점 미만(취향 부정신호) → dismissed 기록(이유=메모) → 풀에서 제외. DB(ratings.jsonl)에 누적.
// 카드 자연스럽게 접혀 사라짐(인박스 클리어 공용 — 👎·pass·pick 후).
function collapseCard(el) {
  if (!el) { renderScrap(); return; }
  el.style.height = el.offsetHeight + 'px'; el.style.overflow = 'hidden';
  el.getBoundingClientRect();
  el.classList.add('removing');
  el.style.height = '0'; el.style.marginTop = '0'; el.style.marginBottom = '0';
  el.style.paddingTop = '0'; el.style.paddingBottom = '0';
  let done = false; const fin = () => { if (done) return; done = true; el.remove(); };
  el.addEventListener('transitionend', fin, { once: true }); setTimeout(fin, 440);
}
// ── 트리아지(신규·누적) = [👎][PASS][PICK] + 무조건 사유(객관식) 선택 ──
// 사유 = 나중 알고리즘이 '왜 제꼈나'를 정량화할 지표. 의미 기준 정본 = docs/curation-rubric.md.
const TRIAGE = {
  pass: { q: '이유는?', reasons: [
    { k: '스팸', d: '(0점) 기사로서 가치가 가장 없음 · 애초에 수집 필요 없는 기사' },
    { k: '홍보성', d: '(1점) 지방·지자체·기업·주가 띄우기·산하 행정단체 홍보성 보도자료' },
    { k: '가치없음', d: '(2점) 화제성은 있지만 콘텐츠화 시 다수 유의미한 반응 이끌기 어려움' },
    { k: '직접입력', input: true } ] },
  pick: { q: '이유는?', reasons: [
    { k: '속보/사건', d: '빠르게 전달하면 모두가 감정적 격동을 느낄 것이라 판단' },
    { k: '토픽/논란', d: '범국민적 토픽·주제라고 판단' },
    { k: '대세픽', d: '국민적 인기 — 지금 다수가 주목하는 대세 흐름(트렌드·화제성)' },
    { k: '지식', d: '효과적 콘텐츠면 팔로워가 유용하다고 느낄 것이라 판단' },
    { k: '직접입력', input: true } ] },
};
// 사유 메뉴 = 버튼 위치 기준 위/아래로 뜨는 플로팅 팝오버. 버튼이 화면 위쪽이면 아래로, 아래쪽이면 위로(운영자 260626).
function placeRsn(p, anchor) {
  const r = anchor.getBoundingClientRect();
  const vw = window.innerWidth, vh = (window.visualViewport ? window.visualViewport.height : window.innerHeight);
  const pr = p.getBoundingClientRect(), w = pr.width, h = pr.height;
  const below = (r.top + r.height / 2) < vh / 2;   // 버튼 중심이 화면 위쪽 절반 = 아래로 펼침 / 아래쪽 = 위로
  let top = below ? r.bottom + 6 : r.top - h - 6;
  top = Math.max(6, Math.min(top, vh - h - 6));
  let left = Math.max(6, Math.min(r.left, vw - w - 6));
  p.style.top = top + 'px'; p.style.left = left + 'px';
  p.classList.toggle('up', !below); p.classList.toggle('down', below);
}
function closeRsn(p) {
  if (!p) return;
  if (p._cleanup) { try { p._cleanup(); } catch (e) {} }
  const o = p._owner; if (o && o._rsn === p) o._rsn = null;
  p.remove();
}
// ── grade 교정 팝(운영자 260807 "번호 토글할 때마다 선택지 — PASS 누르면 나오는 것처럼") — .sc-rsn 정본 100% 계승(앵커 메뉴 문법·placeRsn/closeRsn 공용 · 신규 CSS 0) ──
function askGrade(c, el) {
  if (!el) return;
  const ex = el._rsn;
  if (ex) { const same = ex.dataset.act === 'grade'; closeRsn(ex); if (same) return; }
  document.querySelectorAll('.sc-rsn').forEach(closeRsn);
  const cur = gEff(c), fixed = !!gfixOf(c);
  const p = document.createElement('div'); p.className = 'sc-rsn rsn-grade'; p.dataset.act = 'grade';
  const opts = [[0, '0 비뉴스'], [1, '1 경미'], [2, '2 주목'], [3, '3 대형']];
  p.innerHTML = `<div class="sc-rsn-q"><b>경중 교정 — AI ${c.grade == null ? '미채점' : 'G' + c.grade}${fixed ? ' → 교정 G' + cur : ''}</b><button type="button" class="sc-rsn-x" aria-label="취소"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
    <div class="sc-rsn-chips">${opts.map(([n, k]) => `<button type="button" class="sc-rsn-c" data-g="${n}">${cur === n ? '✓ ' : ''}${k}</button>`).join('')}${fixed ? '<button type="button" class="sc-rsn-c" data-g="x">AI 원복</button>' : ''}</div>`;
  document.body.appendChild(p);
  el._rsn = p; p._owner = el;
  placeRsn(p, el.querySelector('.sc-top') || el);
  const onDown = e => { if (!p.contains(e.target) && !el.contains(e.target)) closeRsn(p); };
  const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); closeRsn(p); } };
  setTimeout(() => document.addEventListener('pointerdown', onDown), 0);
  document.addEventListener('keydown', onKey);
  p._cleanup = () => { document.removeEventListener('pointerdown', onDown); document.removeEventListener('keydown', onKey); };
  p.querySelector('.sc-rsn-x').onclick = () => closeRsn(p);
  p.querySelectorAll('.sc-rsn-c').forEach(b => b.onclick = () => {
    const v = b.dataset.g; closeRsn(p);
    const id = candId(c), all = gfixAll();
    if (v === 'x') delete all[id]; else all[id] = { g: +v, ai: c.grade ?? null, ts: Date.now() };
    try { localStorage.setItem(GFIX_KEY, JSON.stringify(all)); } catch {}
    postRate({ id, url: c.url || '', title: c.title || '', score: 0, picked: false, action: 'grade', reason: (v === 'x' ? 'x' : v) + ':' + (c.grade == null ? 'x' : c.grade) });   // 원장 적재 = rate.yml → rate_record(action='grade' 분기) → scraper/grade_votes.jsonl → 12h 소비(grade_fix_report)
    _scrapSig = ''; renderScrap();   // 시그니처 리셋 = 칩 텍스트·순위 즉시 재렌더
  });
}
function askReason(act, c, el) {
  if (!el) return;
  const ex = el._rsn;   // 이미 열린 사유 메뉴: 같은 액션=토글 닫기 / 다른 액션=갈아끼움
  if (ex) { const same = ex.dataset.act === act; closeRsn(ex); if (same) return; }
  document.querySelectorAll('.sc-rsn').forEach(closeRsn);   // 다른 카드 메뉴는 1개만 유지
  const A = TRIAGE[act];
  const p = document.createElement('div'); p.className = 'sc-rsn rsn-' + act; p.dataset.act = act;
  // 제목 띠 안에 X 배치 = 대기열 `.qpop .qh` 마크업 정본 사본(구 절대배치 X → 띠 flex 우측 · 운영자 260806 창 분류로 대기열 계열 편입)
  p.innerHTML = `<div class="sc-rsn-q"><b>${A.q}</b><button type="button" class="sc-rsn-x" aria-label="취소"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
    <div class="sc-rsn-chips">${A.reasons.map(r => `<button type="button" class="sc-rsn-c${r.input ? ' inp' : ''}" data-k="${esc(r.k)}"${r.d ? ` title="${esc(r.d)}"` : ''}>${esc(r.k)}</button>`).join('')}</div>`;
  document.body.appendChild(p);
  el._rsn = p; p._owner = el;
  const anchor = el.querySelector('.sc-bot') || el;
  placeRsn(p, anchor);
  let _rpRaf = 0;
  const reposition = () => { if (_rpRaf) return; _rpRaf = requestAnimationFrame(() => { _rpRaf = 0; if (p.isConnected) placeRsn(p, anchor); }); };   // 프레임당 1회로 코얼레스(운영자 260803 "다른 창에도 보완할 부분" 점검 산출) — 이 핸들러는 window scroll(passive)·window resize·visualViewport resize 3곳에 물려 있어 스크롤·키보드 상승 중 발화가 가장 잦은데, 발화마다 getBoundingClientRect 2회 + top/left 인라인 쓰기를 했다(= 스튜디오 셸 클램프와 정확히 같은 축 · '직접입력' 칩이 입력칸을 띄우면 키보드 경로도 실재). 참조는 const 그대로라 removeEventListener 3줄 무접촉 · 제거 후 남은 콜백은 기존 p.isConnected 가드가 흡수
  const onDown = e => { if (!p.contains(e.target) && !el.contains(e.target)) closeRsn(p); };   // 바깥 탭 = 닫기
  const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); closeRsn(p); } };
  window.addEventListener('scroll', reposition, { passive: true });
  window.addEventListener('resize', reposition);
  if (window.visualViewport) window.visualViewport.addEventListener('resize', reposition);
  setTimeout(() => document.addEventListener('pointerdown', onDown), 0);   // 여는 클릭 자기차단 방지(다음 틱부터)
  document.addEventListener('keydown', onKey);
  p._cleanup = () => {
    window.removeEventListener('scroll', reposition); window.removeEventListener('resize', reposition);
    if (window.visualViewport) window.visualViewport.removeEventListener('resize', reposition);
    document.removeEventListener('pointerdown', onDown); document.removeEventListener('keydown', onKey);
  };
  const inpK = (A.reasons.find(r => r.input) || {}).k || '직접입력';
  const applyInput = input => { if (el.dataset.fired) return; applyTriage(act, c, el, inpK, input.value); };   // Enter(IME 조합 제외) OR 전송 픽토그램
  p.querySelector('.sc-rsn-x').onclick = () => closeRsn(p);
  p.querySelectorAll('.sc-rsn-c').forEach(b => b.onclick = () => {
    if (b.classList.contains('inp')) {   // 직접입력 = 칩 줄이 즉석에서 입력칸 + 전송 픽토그램(강조색 X)으로 변신
      const chips = p.querySelector('.sc-rsn-chips'); chips.classList.add('inp-mode');
      chips.innerHTML = `<input class="sc-rsn-in" type="text" maxlength="200" enterkeyhint="send" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" placeholder="이유 한 줄"><button type="button" class="sc-rsn-send" aria-label="전송">${SEND_SVG}</button>`;
      const input = chips.querySelector('.sc-rsn-in'), send = chips.querySelector('.sc-rsn-send');
      send.onclick = () => applyInput(input);
      input.onkeydown = e => { if (e.key === 'Enter' && !e.isComposing) { e.preventDefault(); applyInput(input); } else if (e.key === 'Escape') { e.preventDefault(); closeRsn(p); } };
      setTimeout(() => { input.focus({ preventScroll: true }); placeRsn(p, anchor); }, 20);   // 높이 바뀜 → 재배치(방향 유지·키보드에 안 가리게)
      return;
    }
    applyTriage(act, c, el, b.dataset.k, '');
  });
}
// 트리아지 확정 — action(down/pass/pick)+reason 기록(DB 누적·정량화) → 인박스서 접힘. pick은 큐레이션 디스패치.
function applyTriage(act, c, el, reason, text) {
  if (el) { if (el.dataset.fired) return; el.dataset.fired = '1'; if (el._rsn) closeRsn(el._rsn); }   // 사유칩 연타 = 중복 발사 차단 + 플로팅 메뉴 닫기
  const id = candId(c); const memo = (text || '').trim();
  const patch = { action: act, reason }; if (memo) patch.memo = memo;
  if (act === 'pass') patch.dismissed = true;   // PASS = 👎 통합 = 제외(부정 취향신호) · 사유=스팸(0)/홍보성(1)/가치없음(2) · 점수는 reason명에 내재(나중 알고리즘 반영)
  if (act === 'pick') { patch.picked = true; patch.pickedAt = Date.now(); }
  saveRating(id, patch);
  const cur = ratingsAll()[id] || {};
  postRate({ id, url: c.url || '', title: c.title || '', score: cur.score || 0, picked: !!cur.picked, memo: cur.memo || memo, dismissed: !!cur.dismissed, action: act, reason });
  if (act === 'pick' && c.url) {   // PICK = 큐레이션 발동(pending→분석→카드)
    // alt = 같은 사건 다른 매체 url(cluster_members) — 원매체가 막힌 매체(403)면 분석기가 접근 가능한
    // 대체매체로 본문 확보(item3). 원 url 제외·정규화 중복제거·최대 8개(dispatch 페이로드 절제).
    const alt = pickAlt(c).slice(0, 8);
    fetch('api/pick', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: c.url, title: c.title || '', alt, event_key: c.event_key || '' }) })
      .then(async r => { if (r.ok) return;   // 서버 거절 = 낙관 Picking 회수 + 표면화(시크릿 회귀 시 전 픽 무통보 유실 차단 · pickCard 패턴 · 평의회 260713 ⑦)
        const why = await failWhy(r);   // 사유 유실 0(JSON error → 본문 앞머리 → 상태코드 항상 동봉 · 260728)
        saveRating(id, { picked: false }); postRate({ id, url: c.url || '', title: c.title || '', score: cur.score || 0, picked: false });
        if (CURTAB === 'scrap' && SCRAP_LOADED) renderScrap();
        alert('큐레이션 발동 실패 — 다시 시도해줘\n' + why); })
      .catch(() => {});   // 네트워크 예외 = 종전대로 조용히(pickTimedOut 감시가 Failed 복귀 커버)
  }
  if (act === 'pick') {   // 픽 = 사라지지 말고 제자리서 초록 게이지→✓ 체크→'Picking…'(분석 중) → 피드 진입 시 PICKED (운영자 260702·재시도 패턴 계승 · api/pick은 위서 이미 발사=모션 순수 시각)
    if (el) {
      el.classList.add('picked'); if (el._rsn) closeRsn(el._rsn);
      const bot = el.querySelector('.sc-bot');
      const _pk = () => { if (bot && bot.isConnected) bot.innerHTML = '<div class="sc-got picking" aria-label="분석 중"><span>Picking…</span></div>'; };
      if (bot) {
        const _red = matchMedia('(prefers-reduced-motion:reduce)').matches;
        bot.innerHTML = '<div class="sc-got firing" aria-label="픽 발사"><span>전송</span></div>';   // 초록 게이지 풀필(goFill .72s)
        const go = bot.querySelector('.sc-got');
        setTimeout(() => {
          if (!go || !go.isConnected) return;   // 그새 재렌더면 중단(무해)
          go.classList.remove('firing'); go.classList.add('okdone'); go.innerHTML = '<svg class="gck" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7"/></svg>';   // ✓ 체크(goTick)
          setTimeout(_pk, _red ? 60 : 440);   // ✓ 잠깐 보인 뒤 Picking
        }, _red ? 90 : 740);   // goFill .72s 채움 후
      }
    }
    pollPicking();   // 분석 완료(피드 등장)까지 폴 → 떴으면 PICKED, 실패면 분석 실패 (모션과 독립·즉시 시작)
  } else {
    collapseCard(el);   // down/pass = 접혀 사라짐
  }
  detectBreaking();   // 리액션(픽/패스/관심없음) = 긴급이면 프로필 점등 재평가(처리분은 breakingNow서 빠짐)
}
function postRate(p) { fetch('api/rate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(p) }).catch(() => {}); }
// 확인(ack) 토글 — '이 기사 봤음'을 수동 표시(신규와 구분·흐려짐 · 로컬 localStorage). 결정(PICK)은 아님. ⚠️ 긴급 배지는 안 끔(유지·운영자 260620) · 핀 해제는 유지.
function toggleAck(c, el) {
  const id = candId(c); const acked = !((ratingsAll()[id] || {}).acked);
  saveRating(id, { acked });
  const cur = ratingsAll()[id] || {};
  postRate({ id, url: c.url || '', title: c.title || '', acked, score: cur.score || 0, picked: !!cur.picked, dismissed: !!cur.dismissed, action: cur.action || '', reason: cur.reason || '' });   // 서버 ledger → triage-state.json = 확인 cross-device 동기화(운영자 260620)
  if (el) { el.classList.toggle('acked', acked); const b = el.querySelector('.sc-tg.ack'); if (b) b.classList.toggle('on', acked);
    if (acked && scRT[id]) scRT[id].acked = true;   // 정렬 스냅샷도 갱신(다음 핀 재평가서 즉시 반영 · 핀 해제는 유지)
  }
  detectBreaking();   // 확인✓ = 토스트 재평가(breakingNow서 acked 제외 → 재알림 차단). 긴급 배지·프로필은 안 건드림(점등 폐지·배지 유지).
}
// ── 탭 전환 (피드 · 스크랩 · SNS) ── 기본=피드. FAB(제작도구)·X는 외부/팝업이라 여기서 안 다룸.
// 탭별 공유 헤더바(주제+짧은 설명) — 펫이 그 위로 걷는 상단바. 설명은 임시(짧게 · 나중 수정).
const VIEWHEAD = {   // 메뉴명 리네임(운영자 260706 3차 5번 · 정본 = CLAUDE.md §표기표준 뷰어 메뉴 용어집): 메뉴1=Legacy News(구 스크랩 큐레이션 - 레거시) · 메뉴2=Social Digest(구 - SNS) · 메뉴3=Top Picks(구 뉴스 요약) — 표시 = 워드마크 서브(PGSans)라 영문
  feed:  ['뉴스 요약', ''],
  scrap: ['LEGACY MEDIA', ''],
  trend: ['SNS DIGEST', ''],   // 운영자 260713 쌍 구조 — 구 Trends+구 메뉴2(Social Digest) 합체 · 내비 라벨도 'SNS DIGEST'(운영자 260714 승격)
  chan:  ['채널 요약', ''],   // 메뉴4 = 인스타 직결 신호(운영자 260713 · 문구 = 운영자 지정 그대로)
};
let _lastTabShown = null;   // 직전 표시 탭 — 실제 전환 판정(탭 전환 촤르륵 게이트 · null = 다음 showTab 무조건 촤르륵 = 언락 복귀용)
function setViewhead(tab) {
  const [t, s] = VIEWHEAD[tab] || VIEWHEAD.feed;
  const vt = $('#vhTitle'), vs = $('#vhSub');
  if (vt) vt.textContent = t;
  if (vs) vs.textContent = s;
}
// ── [260804 운영자 「메뉴마다 넘어갈 때 이렇게」] 하단 네비 메뉴 전환 = 디졸브 3박자 ────────────────────
//   ① 나가는 뷰·뷰헤드를 --dur(.18s)에 걸쳐 지운다 → ② **안 보이는 동안** 종전 showTab 본문이 그대로 돈다
//   → ③ 들어오는 화면은 손 안 댐 = 종전 촤르륵(cardIn 스태거·vh-enter).
//   구판은 ①이 없어 나가는 뷰가 hidden으로 한 프레임에 꺼졌다(실측 표본 ["1.000","hidden"]) = 「번쩍」.
//   ⚠ 적용 범위 = **하단 네비 클릭 한 경로뿐**(운영자 지시 "메뉴마다 넘어갈 때"). 토스트·딥링크·부팅 복원·잠금 해제 등
//     프로그램 호출은 종전대로 `showTab` 직행(동기) — 그 경로들은 호출 직후 `open()`/`pickedOpen()`처럼
//     **탭이 이미 바뀐 것을 전제로** 이어서 도는 코드가 있어, 지연을 끼우면 순서가 어긋난다(회귀 0을 위해 분리).
const TAB_VIEW_SEL = { feed: '.wrap', scrap: '#scrapview', trend: '#trendview', chan: '#chanview' };
let _tabDzT = null, _tabDzTo = null;
// 교체 시점 = CSS 전이가 끝나는 순간. 지속을 여기 숫자로 베끼면 토큰과 어긋난다(값 복붙 = 드리프트원) →
//   `--dur` 토큰을 **읽어서** 쓴다(값 SSOT = `:root` 하나). 토큰이 없거나 파싱 실패면 전이 없이 즉시 교체로 안전 낙하.
function tabDzMs() {
  try {
    const v = getComputedStyle(document.documentElement).getPropertyValue('--dur').trim();
    const n = parseFloat(v); if (!isFinite(n) || n <= 0) return 0;
    return /ms$/.test(v) ? n : n * 1000;
  } catch { return 0; }
}
function showTabFx(tab) {
  const cur = CURTAB;
  const pend = _tabDzTo;                                   // 디졸브 진행 중이면 목적지 = 그 탭
  if (tab === (pend || cur)) { showTab(tab); return; }     // 같은 탭 재탭 = 종전 경로(재렌더 게이트가 알아서 판정)
  let reduce = false; try { reduce = !!(window.matchMedia && matchMedia('(prefers-reduced-motion:reduce)').matches); } catch {}
  const outEl = $(TAB_VIEW_SEL[cur] || ''), vh = $('#viewhead');
  const els = [outEl, vh].filter(el => el && !el.hidden);
  const ms = tabDzMs();
  if (!document.body.classList.contains('booted') || reduce || !els.length || !ms) { showTab(tab); return; }   // 부팅 전·전정계·대상 없음·토큰 없음 = 즉시 교체(회귀 0)
  if (_tabDzT) clearTimeout(_tabDzT);                      // 연타 = 앞 디졸브 취소, 마지막 탭으로 한 번만
  _tabDzTo = tab;
  $('#bnav').querySelectorAll('.bnav-i[data-tab]').forEach(b => b.classList.toggle('active', b.dataset.tab === tab));   // 점등은 기다리지 않는다 = 탭 반응 0ms 유지(showTab 끝에서 같은 값으로 다시 동기)
  els.forEach(el => el.classList.add('tab-dz', 'tab-out'));
  _tabDzT = setTimeout(() => {
    _tabDzT = null; _tabDzTo = null;
    els.forEach(el => el.classList.remove('tab-dz', 'tab-out'));   // 같은 태스크 안에서 해제 = 페인트 없음(1프레임 불투명 튐 0) · 나가는 뷰는 바로 hidden, 뷰헤드는 vh-enter가 0부터 다시 올린다
    try { showTab(tab); } catch (e) { console.warn('[tab dissolve]', e); }
  }, ms);
}
function showTab(tab) {
  const _tabIn = _lastTabShown !== tab && document.body.classList.contains('booted'); _lastTabShown = tab;   // 실제 탭 전환(부팅 후)만 촤르륵 — 동일 탭 재호출·부팅 첫 진입(booted 게이트가 등장 담당)은 불변
  CURTAB = tab;
  closeFailMenu();   // 탭 전환 시 Failed 칩 컨텍스트 메뉴도 닫음(토스트→showTab 직행 경로는 closeOverlays 안 거침)
  closeFilterPop();   // 탭 전환 시 필터 오버레이도 닫음(토스트·딥링크 등 closeOverlays 미경유 showTab 직행 포함 — 피드 재방문 시 도로 열림 차단 · 운영자 260628)
  if (MERGE_MODE) exitMerge();   // 병합모드 중 탭 전환 = 모드 해제 + pushState 칸 회수(back 삼킴 방지·분신술3). exitMerge 가드로 closeOverlays 중복 호출도 무해.
  const wp = $('.wrap'), sv = $('#scrapview'), snv = $('#snsview'), tv = $('#trendview');   // 옛 .filterbar 제거(칩→필터 오버레이) · 필터 버튼(#filterBtn·우측 클러스터)은 CSS body[data-tab=feed]로 표시(260706 3차 8)
  if (wp) wp.hidden = (tab !== 'feed');
  if (sv) sv.hidden = (tab !== 'scrap');
  if (snv) snv.hidden = (tab !== 'trend') || !snv.closest('#snsHost');   // 구 메뉴2 = 트렌드 그룹① 국내 커뮤니티로 reparent(운영자 260713) · 신규 구조(#snsHost) 장착 전 = 계속 숨김(운영자 260716 "이전 버전이 안뜨게" — 트렌드 도착 전 구버전 맨몸 노출 차단 · 해금 = renderSnsTrends 장착 시)
  if (tv) tv.hidden = (tab !== 'trend');
  const cv = $('#chanview'); if (cv) cv.hidden = (tab !== 'chan');   // 메뉴4 채널 요약(운영자 260713)
  if (tab === 'trend' || tab === 'chan') requestAnimationFrame(() => chuFit(document));   // 숨김(hidden) 중 렌더된 헤더 칩은 offsetWidth=0이라 예약 미측정 → 가시화 직후 재실측(평의회 260717-⑥ ③ 봉합 · 시그니처 가드 무접촉)
  // 배너(2겹)·프로필 컬러 = body.tab-scrap가 CSS로 구동(스크랩=앰버 디졸브 / 그 외=초록). SNS 전용 배너는 추후.
  document.body.classList.toggle('tab-scrap', tab === 'scrap');
  document.body.dataset.tab = tab;   // 카드만 토글 = 피드 탭에서만 표시(CSS body[data-tab=feed])
  // 메뉴 1↔2↔3 전환 = 들어오는 콘텐츠 즉시 촤르륵(운영자 260707): 시그니처 리셋 → 스태거 생략 게이트 해제 + 캐시 데이터로 동기 재렌더(fetch 대기 0).
  // 이어지는 fetch 재렌더(enterScrap/loadSocial/load)는 구성이 같으면 sig 일치 = 재애니 0(이중 깜빡임 없음) · 바뀌었으면 종전대로 촤르륵.
  if (_tabIn) {
    try {
      if (tab === 'scrap') { ratedKeep.clear(); _scrapSig = ''; if (SCRAP_LOADED) renderScrap(); }   // ratedKeep 선비움 = enterScrap와 동일 의미(탭 진입 = 별점 카드 정리) — 즉시렌더가 별점 카드를 잠깐 보였다 지우는 flicker 차단(평의회6)
      else if (tab === 'trend') { _snsSig = ''; renderSnsTrends(); if (SOCIAL_LOADED) renderSns(); }   // SNS DIGEST = 트렌드+국내 커뮤니티 캐시 즉시 렌더(fetch는 아래 dispatch)
      else if (tab === 'chan') { renderChan(); }   // 채널 요약 = 캐시 즉시(loadChan은 아래)
