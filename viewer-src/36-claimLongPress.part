};
const TR_PCOL = { gg: 'var(--cat-eco)', yt: 'var(--cat-intl)', tk: 'var(--cat-soc)', ig: 'var(--cat-cul)', x: 'var(--cat-pol)' };   // 플랫폼 구분자 색 = cat 팔레트 재지정(운영자 260712 플레이그라운드 회신 = 기틀 갱신 승인 · 구글=레몬 --cat-eco[260712 2차 · 구 코랄서 분리 — 유튜브와 색 구분]·유튜브=코랄·틱톡=민트·인스타=핑크·X=스카이) — §디자인 d 캡슐 예외 등재·CII 정합
function fmtK12(s) { s = String(s || ''); const mo = +s.slice(5, 7), dd = +s.slice(8, 10), H = +s.slice(11, 13); return (mo && dd && Number.isFinite(H)) ? `${mo}/${dd} ${String(H % 12 || 12).padStart(2, '0')}:${s.slice(14, 16)}${H < 12 ? 'AM' : 'PM'}` : ''; }   // 단위 헤더 시각 공통 표기 = "7/16 02:18PM"(시 2자리 0채움 — 운영자 260720 후속 "09:00PM 이런식" · 12시간제·AM/PM 유지 · 채널요약↔트렌드 동일 fmtK12 = 5곳 동시 통일) · Q309 "7/20 9:40PM 이렇게 · 모바일 겹침 방지 축약" — 구 "7월 16일" M월D일 → M/D 슬래시 · 메뉴3 AI 요약·TOP 10 + 메뉴4 AI 요약·프로필 공용 5곳 일괄) · KST ISO 문자열 직파싱(naive new Date() 금지 = 기기 TZ 무관 · CLAUDE.md [12]) · 무효 = '' fail-soft
let TR_TOPF = 'all';   // TOP 10 플랫폼 필터(운영자 260716 "선택하면 top10 플랫폼별로") — 'all' = 종합(종전) · mono 키 = 플랫폼별 풀 TOP 10 · 세션 한정(CHAN_BSEC 문법 미러)
// 헤더 우측 칩(.chu>.tb-seg = absolute 오버레이)이 좌측 시각(.tdash-time)을 덮는 겹침 방지(운영자 260717 폰 실측 — "전체 틱톡 토글 안겹치게") —
//   칩 실폭 + 48(칩 우측 앵커 원문) + 10(광학 간격)만큼 summary 우측 패딩 예약(--chu-r) · 시각은 부족 시 말줄임(.tdash-time #775) · 칩 부재 = 12px 폴백 · 렌더 직후 1회 실측(칩 폭 = 렌더당 상수)
const chuFit = (box = document) => box.querySelectorAll('.chu').forEach(w => {
  const tg = w.querySelector(':scope > details[data-g="top"] > .tgroup-h');   // TOP 10 = 좌측 클러스터 실측 예약(--chu-lr) — 구 정적 208(150+10+48)이 실측 타이틀(폰 390 = 159)에 미달해 광학 갭 10 → 1px 붕괴 = '전체' 칩이 제목에 붙어 헤더 탭을 먹던 것 봉합(운영자 260801) · 측정 문법 = smoke_chan measure/titleEnd·--tpm-l Range 정본 계승(텍스트노드 = Range · 요소 = rect) · seg 실폭(--chu-r)보다 **먼저** = 아래 offsetWidth 읽기가 새 창폭을 반영
  if (tg) { let tR = 0; tg.childNodes.forEach(n => { let r = null; if (n.nodeType === 3 && n.textContent.trim()) { const rg = document.createRange(); rg.selectNodeContents(n); r = rg.getBoundingClientRect(); } else if (n.nodeType === 1) r = n.getBoundingClientRect(); if (r && r.width) tR = Math.max(tR, r.right); });
    if (tR) w.style.setProperty('--chu-lr', Math.round(tR - w.getBoundingClientRect().left + 10 + 48) + 'px'); }   /* raw-ok: 10 = .chseg-row 원문 주석의 광학 간격 정본(#969) · 48 = right 앵커 짝 */
  const s = w.querySelector(':scope > details > .chseg-row > .ch-rangeseg'); if (s && s.offsetWidth) w.style.setProperty('--chu-r', (48 + s.offsetWidth + 10) + 'px');
  const m = w.querySelector(':scope > details > .ch-hdrmore'); if (m) { const hd = w.querySelector(':scope > details > .tgroup-h'); let tR = 0; hd && hd.childNodes.forEach(n => { if (n.nodeType === 3 && n.textContent.trim()) { const rg = document.createRange(); rg.selectNodeContents(n); const r = rg.getBoundingClientRect(); if (r.width) tR = Math.max(tR, r.right); } }); if (tR) w.style.setProperty('--tpm-l', (tR - w.getBoundingClientRect().left + 16) + 'px'); } });   /* raw-ok: 48 = .chseg-row right 앵커 원문 짝 · 10 = 1회성 광학 간격 — 측정 = 전 세그(.ch-rangeseg · 구 tb-seg 한정 → 260720 기간 세그 모바일 헤더행 편입으로 ch-hdrseg도 예약 필요: prof 채널명 ellipsis 겹침 차단) · 소비 = PC 전 유닛 + 모바일 4유닛(brief·prof·daily·tpost) 규칙 · +260722 내역 ▶(.ch-hdrmore) 좌측 fit = 타이틀 잉크 우변(Range) + 갭 16(운영자 260723 "좀 더 우측으로" · 구 7[배지↔타이틀 균일]서 확대) → --tpm-l(폰트 스왑에 갭 불변 — 정적 left가 웹폰트/폴백 편차로 smoke_all서 흔들린 실측 봉합 · 재실측 3훅 동승 · 잉크 0 = 무설정 폴백 153) */
// 재실측 3훅(평의회 260717-⑥ ①~③) — 회전·리사이즈(칩 %클램프 폭 변동), 폰트 스왑(측정 시점 폴백 메트릭), 숨김 렌더(showTab 가시화 직후는 showTab 쪽 훅). offsetWidth=0 가드로 숨김 뷰는 무접촉 = 비용 미미.
try { if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => chuFit(document)); } catch {}
let _chuRz = 0;
window.addEventListener('resize', () => { clearTimeout(_chuRz); _chuRz = setTimeout(() => chuFit(document), 150); });   /* raw-ok: 150ms = 리사이즈 디바운스 관용값(연속 이벤트 합침 · 1회성) */
