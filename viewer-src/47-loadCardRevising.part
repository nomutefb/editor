    const slots = _pimgs.map((u, i) => '<div class="nm-imslot"><img loading="lazy" referrerpolicy="no-referrer" src="' + escUrl(u) + '" alt="" onerror="this.closest(\'.nm-imslot\').style.display=\'none\'"><span class="nm-imno">' + (i + 1) + '/' + _pimgs.length + '</span>'
