<script>%SCRIPT%<\/script>
</body>
</html>`;
let _nmFontCss = null;   // Pretendard base64 캐시(세션 1회 fetch·재사용)
async function nmFontFace() {   // woff2 → @font-face(base64) 임베드용 CSS. 실패 시 '' → CDN 폴백.
  if (_nmFontCss !== null) return _nmFontCss;
  try {
    const r = await fetch('assets/fonts/pretendard.woff2', { cache: 'force-cache' });
    if (!r.ok) throw 0;
    const bytes = new Uint8Array(await r.arrayBuffer());
    let bin = ''; const CH = 0x8000;
    for (let i = 0; i < bytes.length; i += CH) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + CH));
    _nmFontCss = "@font-face{font-family:'Pretendard Variable';font-weight:45 920;font-style:normal;font-display:swap;src:url(data:font/woff2;base64," + btoa(bin) + ") format('woff2-variations')}";
  } catch (e) { _nmFontCss = ''; }
  return _nmFontCss;
}
async function buildSummaryHtml(full, opts) {   // full=true('전체'): IG·스레드+카드뉴스 · opts.embedFont=false면 폰트 CDN링크(발행=크기↓·600KB초과 방지·검증7/10)
  const src = document.createElement('div');
  src.innerHTML = (($('#mdbody') || {}).innerHTML) || '';
  src.querySelectorAll('button, .copy, .ovmeta').forEach(el => el.remove());   // 뷰어 복사·더보기 + 개요칩(.ovmeta=매체·기자·IN 적재시각 등 내부 운영메타) 제거 — 공유 요약엔 불필요·출처줄과 중복·IN 유출 방지
  src.querySelectorAll('pre.clip').forEach(p => p.classList.remove('clip'));   // 클립 해제(전문 표시)
  src.querySelectorAll('.thumbsec').forEach(el => el.remove());                // 썸네일 후보 박스(검색·AI생성) 제거 — 다운로드 요약엔 잡음(운영자 260621)
  src.querySelectorAll('.md-orig').forEach(el => el.remove());                 // 원문 영문 제목 = 본문 박스 아님 → 헤더 제목 바로 아래로 이관(%ORIG% · 운영자 요청)
  src.querySelectorAll('.md-srct').forEach(el => el.remove());                 // 기사 원래 타이틀(뷰어 화면 전용 · 260805) = 다운로드·발행 HTML은 종전 그대로(제목은 아래 h1 제거와 짝으로 헤더가 담당) — 본문 맨 위 제목 2줄 방지
  src.querySelectorAll('pre').forEach(p => { p.textContent = p.textContent.replace(/ /g, ' '); });   // nbsp→일반공백 = 자유요약 줄바꿈 막던 비분리공백 제거(가로 잘림 방지 · 운영자 260621)
  src.querySelectorAll('img').forEach(el => el.remove());                      // 본문 이미지 제거(텍스트 요약)
  src.querySelectorAll('h1').forEach(el => el.remove());                       // 제목 h1은 헤더로 따로
  src.querySelectorAll('[style]').forEach(el => el.removeAttribute('style'));  // 뷰어 인라인 스타일 제거(서식 CSS만 적용)
  const SECBTN = '<button type="button" class="nm-secbtn" title="이 항목 복사"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px;display:block"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path></svg></button>';
  const tipRe = /시사점|💡/;
  const snsRe = /^\s*\[?\s*(IG|Thread|인스타|스레드|쓰레드)/i;   // 인스타·스레드(SNS) 소주제 = 다운로드 HTML서 배제 — [자유요약]은 유지(운영자 260620)
  const card = (name, inner, tip) => '<div class="nm-sec' + (tip ? ' nm-tip' : '') + '" data-sec>'
    + (name ? '<h2 class="nm-h">' + (tip ? '' : '<span class="nm-dot"></span>') + esc(name) + '</h2>' : '')   // 시사점(tip)=●말머리 제거·💡만(운영자 260621)
    + inner + SECBTN + '</div>\n';
  const kids = [...src.children], isH = el => /^H[2-6]$/.test(el.tagName);
  let boxes = '', i = 0;
  while (i < kids.length) {                                                    // 헤딩 경계로 항목 분할
    if (isH(kids[i])) {
      const name = kids[i].textContent.trim();
      const parts = []; let j = i + 1;
      while (j < kids.length && !isH(kids[j])) { parts.push(kids[j]); j += 1; }
      if (!full && snsRe.test(name)) { i = j; continue; }   // 인스타·스레드 섹션 = 기본 제외 · '전체' 체크 시 포함(운영자 260621)
      if (!parts.length) { i = j; continue; }   // 본문 없는 그룹 헤더(예: 콘텐츠 초안) = 표기 안 함 — 잡음(운영자 260621)
      // '편향' 줄 = 복사 대상(본문)서 분리 → data-body 밖 .nm-ref 글래스 영역(읽기전용 참고·복사 제외 · 운영자 260621)
      const _refRe = /^[\s•·📊]*편향\s*[:：]/;
      const _ref = parts.filter(p => _refRe.test((p.textContent || '').trim()));
      const _cont = parts.filter(p => !_refRe.test((p.textContent || '').trim()));
      const _refHtml = _ref.length ? '<div class="nm-ref" data-ref>' + _ref.map(p => p.outerHTML).join('') + '</div>' : '';
      if (_cont.length === 1 && _cont[0].tagName === 'PRE') {   // 자유요약 등 단일 코드블록 = 텍스트→<p>문단(빈 줄 기준)·단일 줄바꿈→<br>·공백 정규화(nbsp·전각·탭→일반)
        const _t = _cont[0].textContent.replace(/[ 　\t]/g, ' ').replace(/ +\n/g, '\n').trim();
        const _ps = _t.split(/\n{2,}/).map(s => s.trim()).filter(Boolean).map(s => '<p>' + esc(s).replace(/\n/g, '<br>') + '</p>').join('') || ('<p>' + esc(_t) + '</p>');
        boxes += card(name, '<div class="nm-body draft-scroll" data-body>' + _ps + '</div>' + _refHtml, tipRe.test(name));
      }
      else if (_cont.length)
        boxes += card(name, '<div class="nm-body draft-scroll" data-body>' + _cont.map(p => p.outerHTML).join('') + '</div>' + _refHtml, tipRe.test(name));
      else if (_refHtml)   // 본문 없이 참고(편향)줄만 = 빈 본문칸 없이 참고영역만
