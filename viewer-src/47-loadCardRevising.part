    const _tg = Array.isArray(CUR_A.cards.thumb_gen) ? CUR_A.cards.thumb_gen : [];
    [..._ts, ..._tg].forEach(it => { const u = it && it.img; if (u && /^https:\/\//i.test(u) && !_pimgs.includes(u)) _pimgs.push(u); });   // 검색 먼저·썸네일 뒤 · 중복 제거
