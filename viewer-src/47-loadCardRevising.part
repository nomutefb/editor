    mbits.push(_su ? '<a class="nm-media nm-srclink" href="' + _su + '" target="_blank" rel="noopener">' + LINK_SVG + ' ' + esc(CUR_A.media) + '</a>' : '<span class="nm-media">' + esc(CUR_A.media) + '</span>');   // 매체명 = 출처 하이퍼링크(🔗+밑줄 강조색 → 원문 · 출처를 상단으로 · 운영자 260621)
  }
