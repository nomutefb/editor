    // 검색 헤더 = 제목검색 돋보기 + 키워드 K검색(한/영 토글) · 자기완결(구글 이미지검색 링크만·API 0) — 뷰어 thumbStatic 계승(운영자 요청)
    const _chip = q => String(q || '').trim().split(/\s+/).filter(Boolean).join(', ');
    const _gis = (q, en) => 'https://www.google.com/search?tbm=isch&' + (en ? 'hl=en&gl=us&' : '') + 'tbs=qdr:d&q=' + encodeURIComponent((q || '').slice(0, 100));
    const _kwko = (CUR_A && (CUR_A.image_query || '')).trim(), _kwen = (CUR_A && (CUR_A.image_query_en || '')).trim();
