  if (dt) mbits.push('<span class="nm-date"><span class="nm-dlabel">보도:</span> ' + dt + '</span>');   // "보도:" 라벨(mut) + 날짜(흰)·운영자 260621
  const mline = mbits.length ? '<span class="nm-mline">' + mbits.join('<span class="nm-dotsep"></span>') + '</span>' : '';
