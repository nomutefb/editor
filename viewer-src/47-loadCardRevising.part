  if (!dt && CUR_A) dt = (inDateTime(CUR_A).txt || '');   // 보도일(a.date) 없으면 적재(스크랩) 일시로 폴백 — 일시 항상 표기(운영자 260621)
  // 기자명 = frontmatter(reporter/byline) 우선, 없으면 본문 '출처: 매체 (기자)' 패턴 추출 → fmtReporter로 「000 기자 / 000 기자 외 N명」 통일(개요칩과 동일 · 운영자 260621)
  const rpRaw = (CUR_A && (CUR_A.reporter || CUR_A.byline)) || (((CUR_A && CUR_A.body) || '').match(/출처[:：]\s*[^()\n]*\(([^)]+)\)/) || [, ''])[1].trim();
  const rpFmt = CUR_A ? fmtReporter(rpRaw, CUR_A.media) : '';
