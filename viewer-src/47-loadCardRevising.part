    }
  }
  // 검색 이미지 + AI 썸네일 슬라이드 = 발행본 상단(운영자 260702). 자기완결 유지 = R2 https URL만 인라인(상대경로 git폴백은 apps.nomute.kr/Access 뒤라 공개 뷰어서 못 뜸 → 제외). API 호출 0.
  const _pimgs = [];
