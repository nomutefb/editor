        cds.forEach(cd => {
          let inner = '';
          if (cd.caption) inner += '<pre>' + esc(cd.caption).replace(/\*([^*\n]+)\*/g, '<span class="cem">$1</span>') + '</pre>';   // *강조* → 형광(카드와 동일 톤)
          if (cd.prompt) inner += '<p class="nm-sublbl">이미지 프롬프트</p><pre>' + esc(cd.prompt) + '</pre>';
