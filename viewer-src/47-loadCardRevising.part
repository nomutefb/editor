    const _kwrow = _hasKw ? '<div class="nm-kwrow"><span class="nm-kw" title="키워드 복사">' + esc(_initEn ? _chip(_kwen) : _chip(_kwko)) + '</span></div>' : '';
    boxes = '<div class="nm-sec nm-imsec"><div class="nm-imhead"><h2 class="nm-h"><span class="nm-dot"></span>검색 이미지</h2><span class="nm-imacts">' + _tsrch + _kwbox + '</span></div>' + _kwrow + '<div class="nm-imtrack">' + slots + '</div></div>\n' + boxes;   // 맨 위(요약 카드 위) · data-sec 없음 = 복사버튼 미부착
  }
  const now = new Date(), pz = n => String(n).padStart(2, '0');
  const ymd = now.getFullYear() + '-' + pz(now.getMonth() + 1) + '-' + pz(now.getDate());
  const mdh1 = ($('#mdbody') ? $('#mdbody').querySelector('h1') : null);
  const title = (CUR_A && CUR_A.title) || (mdh1 ? mdh1.textContent.trim() : '') || '뉴스 요약';
  const _orig = (CUR_A && (CUR_A.title_orig || '')).trim();   // 외신 원문 영문 제목 — 제목 바로 아래 mut 1줄로 이관(%ORIG% · 운영자 요청)
  const cat = catBucket(CUR_A && CUR_A.category);
