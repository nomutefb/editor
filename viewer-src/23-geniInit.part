function geniFollowNewest() {   // 스튜디오 전체 최신 1묶음을 결과로(부팅 전 제작 포함 = thumb 부팅 복원 동문 · 세션분이 이미 최신이면 무동작 · tr trFollowNewest 동문)
  let clr = 0; try { clr = +localStorage.getItem(GENI_HCLEAR_KEY) || 0; } catch {}
  const cut = Math.max(clr, GENI_SRV_CLEAR);   // 기록 지우기 존중 = renderGeniPrev 동문
  const pool = geniHistPrune(geniHistLoad()).concat(GENI_SRV_HIST || [], GENI_LIVE || []).filter(e => e && e.url && (e.ts || 0) > cut && !_geniDeadUrls.has(geniHistKey(e.url)));
  let newest = null; pool.forEach(e => { if (!newest || (e.ts || 0) > (newest.ts || 0)) newest = e; });
  const resK = new Set(geniResSess().map(x => geniHistKey(x.url)));
  let grp = [];
  if (newest && !resK.has(geniHistKey(newest.url))) {
    const bid = geniBidOf(newest); grp = bid ? pool.filter(e => geniBidOf(e) === bid) : [newest];   // 묶음(bid) 통째 = 1/2·2/2 한 결과(thumb findResultById 동문)
    const seen = new Set(); grp = grp.filter(e => { const k = geniHistKey(e.url); if (seen.has(k) || resK.has(k)) return false; seen.add(k); return true; });
  }
  const sig = grp.map(e => geniHistKey(e.url)).join('|');
  if (sig === _geniNewestSig) return false;   // 무변경 = 재렌더 0(sig 게이트 관례)
  _geniNewestSig = sig; GENI_NEWEST = grp;
  renderGeniRes(); renderGeniPrev();   // 결과 합류 + 이전 제작 제외 동시 반영(파티션 한 값)
  return true;
}
/* ── 결과 레일 진행 행 = 발사 즉시(운영자 260821 «생성버튼을 눌러도 대기열 큐에 안들어가는데 · 다른 이미지 스튜디오의 세부 화면들은 가능하거든») ──
   정본 = tr.html `TR_JOBS` 블록 100% 계승(마크업 `.job > .jlab + .jst` · 문구 · orb · `.nm-shim` · `.jretry`/`.jdel`)
   + 상태 문구는 thumb `renderJob` 정본 3갈래 exact(「제작중 · 46s · 0/1장」 / 「지연 · …」 / 「실패 · 사유」) = 신규 클래스·값 0.
   ⚠ 왜 이 판만 화면에 대기열이 없었나 = AI 생성 탭은 geniMount가 thumb 프레임을 통째로 숨기고(.toolfr active 제거 = display:none)
     부모가 폼을 그린다 → 대기열 `#jobs` 가 **그 숨은 문서 안**에 있어 화면에 물리적으로 없다(잡 카드 자체는 정상 생성 = 260821 실측).
     번역 탭은 260817에 같은 봉합을 받았고 이 판만 안 따라왔다 = 「형제는 가진 걸 자기만 안 가졌다」 축의 재현.
   ⚠ 판정(완료·실패·경과·장수)은 **thumb 정본 단독** — 여기는 그 상태를 받아 그리기만 한다(판정 사본 0).
     그래서 이 대기열은 AI 생성분만이 아니라 **그 문서의 대기열 전체**다(카드 생성·편집·특수 = 한 문서 한 대기열 계약 그대로). */
let GENI_JOBS = [], _geniJobTick = 0;
const GENI_XCLOSE_SVG = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 18 18M18 6 6 18"/></svg>';   // raw-ok: thumb `XCLOSE_SVG` 정본 exact 사본(취소·닫기 X = CII 「닫기 X」 path · 신규 창작 0)
function geniJobDur(sec) { return sec < 60 ? sec + 's' : Math.floor(sec / 60) + 'm ' + (sec % 60) + 's'; }   // raw-ok: 경과 표기 = thumb `jobDur` 정본 exact 사본(tr 동문 · 값 창작 0)
function geniJobStat(job) {   // 상태 span 안쪽 = thumb renderJob 조립 문법 동일(사용자 조각은 esc 통과분뿐)
  if (job.status === 'err') return WARN_SVG + '<span>실패 · ' + esc(String(job.msg || '').slice(0, 60)) + '</span>';
  const sec = Math.round((Date.now() - job.t0) / 1000);
  const orb = window.nmOrbHTML ? nmOrbHTML('solving', 14) : '';
  return orb + '<span class="nm-shim">' + (job.queued ? '지연' : '제작중') + ' · <b class="jsec">' + geniJobDur(sec) + '</b> · ' + (job.dn || 0) + '/' + (job.tot || '?') + '장</span>';   // 「지연」 = 러너 배정 대기(thumb 260809 통일 문법)
}
function geniJobAct(uid, act) {   // [재시도]·[취소] = 그 문서의 같은 버튼을 누른다(동작 사본 0)
  document.querySelectorAll('#tooldlg .toolfr').forEach(f => { try { f.contentWindow.postMessage({ nm: 'jobs-act', uid, act }, location.origin); } catch (e) {} });
}
function geniJobRow(job) {
  const row = document.createElement('div'); row.className = 'job' + (job.status === 'err' ? ' err' : '');
  const lab = document.createElement('span'); lab.className = 'jlab'; lab.textContent = (job.label || '제작') + ' #' + job.n;
  const st = document.createElement('span'); st.className = 'jst'; st.innerHTML = geniJobStat(job);
  row.append(lab, st);
  if (job.status === 'err') {
    row.title = job.msg || '';
    const rt = document.createElement('button'); rt.type = 'button'; rt.className = 'jretry'; rt.title = '같은 설정으로 다시 제작';   // 재시도 = thumb 실패 행 정본 부품(.jretry + RETRY_SVG)
    rt.innerHTML = (window.RETRY_SVG || '') + '<span>재시도</span>';
    rt.onclick = () => { rt.disabled = true; geniJobAct(job.uid, 'retry'); };
    row.append(rt);
    const del = document.createElement('button'); del.type = 'button'; del.className = 'jdel'; del.title = '이 실패 기록 삭제'; del.setAttribute('aria-label', '삭제');
    del.innerHTML = (window.TRASH_SVG || '');
    del.onclick = () => geniJobAct(job.uid, 'del');
    row.append(del);
  } else {
    const cx = document.createElement('button'); cx.type = 'button'; cx.className = 'jdel jcancel' + (job.arm ? ' arm' : '');   // 취소 = thumb 진행 행 정본 부품(.jdel.jcancel) · 2단 탭(1탭 무장 → 2탭 확정)도 정본 그대로 — 무장 상태는 그 문서가 쥐고 미러로 따라온다
    if (job.arm) { cx.innerHTML = CHECK_SVG; cx.title = '한 번 더 누르면 취소'; cx.setAttribute('aria-label', '취소 확정'); }
    else { cx.innerHTML = GENI_XCLOSE_SVG; cx.title = '이 제작 취소'; cx.setAttribute('aria-label', '제작 취소'); }
    cx.onclick = () => geniJobAct(job.uid, 'del');
    row.append(cx);
  }
  return row;
}
/* 경과 1초 틱 = **진행 중 행이 있을 때만** 켜지고 없으면 스스로 끈다 + 가려진 동안 정지(유휴 정숙 C16 동축 · tr trTickOn 정본 동문). */
function geniTickOn() {
  if (_geniJobTick) return;
  _geniJobTick = setInterval(() => {
    if (!GENI_JOBS.some(j => j.status === 'run')) { clearInterval(_geniJobTick); _geniJobTick = 0; return; }
    if (!document.hidden) geniJobPaint();
  }, 1000);
}
function geniJobPaint() {   // 1초 틱 = 진행 행 상태 span만 교체(타일·요약 통째 재렌더 0 = 깜빡임·GC 0 · tr trJobPaint 동문)
  const host = $('#geniResJobs'); if (!host) return;
  const rows = host.querySelectorAll('.job:not(.done)');
  if (rows.length !== GENI_JOBS.length) { renderGeniRes(); return; }   // 개수 어긋남 = 통째 재렌더(부분 갱신이 남의 행을 칠하는 것 차단)
  GENI_JOBS.forEach((j, i) => { if (j.status !== 'run') return; const st = rows[i] && rows[i].querySelector('.jst'); if (st) st.innerHTML = geniJobStat(j); });
}
window.addEventListener('message', e => {   // 이미지 스튜디오 문서(thumb) → 대기열 상태 수신 = 이 판의 진행 행 원천
  if (e.origin !== location.origin) return;
  if (!e.data || e.data.nm !== 'jobs-mirror') return;
  if (![...document.querySelectorAll('#tooldlg .toolfr')].some(f => f.contentWindow === e.source)) return;   // 우리 도구 프레임만 신뢰(genfree 리스너 출처 검증 동문)
  GENI_JOBS = (e.data.jobs || []).filter(j => j && j.status !== 'done');   // 완료 행은 결과 요약 줄이 그 자리를 대신한다(tr trJobEnd 계약 동문)
  renderGeniRes();
  if (GENI_JOBS.some(j => j.status === 'run')) geniTickOn();
});
/* 결과 요약 줄 = 「완료 · N장 · 시각」 + [수정][전체 다운로드](운영자 260806 "이 두부분에도 적용하셈 · 왜 저게 계속 따로노는지 모르겟으유") ──
   정본 = thumb `renderJob` 완료 행(.job.done > .jlab + .jst + .jsave-row) 마크업 그대로 · 부품 CSS = nm-job.css 공동 정본(index는 이미 링크 보유) · 신규 클래스·값 0.
   재료 = 결과 배열 그 자체 = 새 상태 신설 0(tr resJobRow 동문 — 두 판 같은 문법). */
