    if (GENI_ALL_STYLES.some(([v]) => v === g.style)) _geniSel.style = g.style;
    _geniSel.sub = (GENI_SUB[_geniSel.style] || []).some(([v]) => v === g.sub) ? g.sub : 'auto';
    ['size', 'count'].forEach(k => { if (GENI_DICT[k].some(([v]) => v === String(g[k]))) _geniSel[k] = String(g[k]); });
    const asp = String(g.aspect || '');
    if (GENI_DICT.aspect.some(([v]) => v === asp)) { _geniSel.aspect = asp; }
    else { const m = /^(\d{1,2}):(\d{1,2})$/.exec(asp); if (m) { _geniSel.arW = m[1]; _geniSel.arH = m[2]; _geniSel.aspect = geniArVal() ? 'custom' : _geniSel.aspect; } }   // 발사분은 '직접'이 이미 W:H로 해소돼 온다 → 되돌려 직접 칩 + 두 칸으로(미유효 = 종전 비율 유지 = 안전 강하)
    _geniSel.mood = g.mood === 'axes' ? 'axes' : 'auto';
    GENI_MOOD_AX.forEach(([k]) => { const v = parseInt(g.moodAx && g.moodAx[k], 10); _geniSel.moodAx[k] = Number.isFinite(v) ? Math.max(-2, Math.min(2, v)) : 0; });
    _geniSel.engine = g.engine === 'gpt' ? 'gpt' : 'gemini'; _geniSel.engineTouched = true;   // 복원 = 그 발사가 쓴 엔진이 정답(복제 모드 자동전환이 되덮지 않게)
    const _sa = parseInt(g.satAdj, 10), _br = parseInt(g.briAdj, 10);
    _geniSel.colorAx.sat = Number.isFinite(_sa) ? Math.max(-50, Math.min(50, _sa)) : 0;
    _geniSel.colorAx.bri = Number.isFinite(_br) ? Math.max(-50, Math.min(50, _br)) : 0;
    _geniSel.colorTouched = !!(_geniSel.colorAx.sat || _geniSel.colorAx.bri);
    if (typeof g.kweb === 'boolean') _geniSel.kweb = g.kweb;
    if (typeof g.textOn === 'boolean') _geniSel.textOn = g.textOn;
    GENI_CAM_KEYS.forEach(k => { if (GENI_DICT[k].some(([v]) => v === g[k])) _geniSel[k] = g[k]; });
    const w = $('#geniWish'); if (w) { w.value = String(g.wish || '').slice(0, 300); w.dispatchEvent(new Event('input', { bubbles: true })); geniWishShow(!!w.value.trim(), false); }   // 주문 글 = 복원도 '입력'으로(클립 리드백 동기 = geniPrep 동문)
    geniApply();
    const _camOpen = GENI_CAM_KEYS.some(k => _geniSel[k] && _geniSel[k] !== 'auto');   // 카메라군 복원값 있으면 자동 펼침 = geniPrep 동문(무엇이 복원됐는지 보이게)
