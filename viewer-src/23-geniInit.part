function renderGeniPrev() {   // 이전 제작 = 서버+로컬 병합 · 지우기 존중(로컬·서버 공용 중 큰 것) — 데이터 산출 = tr renderTrHist 동문
  const grid = $('#geniPrevGrid'); if (!grid) return;
  const local = geniHistPrune(geniHistLoad());
  let clr = 0; try { clr = +localStorage.getItem(GENI_HCLEAR_KEY) || 0; } catch {}
  const cut = Math.max(clr, GENI_SRV_CLEAR);
  const localF = local.filter(e => (e.ts || 0) > cut);
  const seen = new Set(localF.map(e => geniHistKey(e.url)));
  const srv = (GENI_SRV_HIST || []).filter(e => e && e.url && !seen.has(geniHistKey(e.url)) && (e.ts || 0) > GENI_SRV_CLEAR);
  srv.forEach(e => seen.add(geniHistKey(e.url)));
  const live = (GENI_LIVE || []).filter(e => e && e.url && !seen.has(geniHistKey(e.url)) && (e.ts || 0) > cut);   // 즉시 축 = 셋째 소스(로컬·정식 인덱스가 이미 가진 건 스킵 = 정식 도착 시 자연 교체 · 지우기 컷 동일 존중 · tr renderTrHist 동문)
  const resK = new Set(geniResList().map(e => geniHistKey(e.url)));   // '결과'에 실제로 뜬 것만 이전 제작서 제외 = 결과와 **같은 산출**(260817 최신 1묶음) — 구판처럼 세션분 전체를 빼면 결과 축소분이 어느 칸에도 안 뜨는 유실이 된다(thumb renderHist CARSLIDES 제외 동문 = 5탭 카운트 한 값)
  const a = localF.concat(srv, live).sort((x, y) => (y.ts || 0) - (x.ts || 0)).filter(e => !_geniDeadUrls.has(geniHistKey(e.url)) && !resK.has(geniHistKey(e.url)));
  if (window.nmSeq) nmSeq.tag(a);   // 이미지 스튜디오 공용 순번 도장(운영자 260818 12차 «이미지 스튜디오 안에 있는거는 모두 같은 인덱싱을 공유») — 목록을 통째로 넘기면 표에 없는 산출물만 제작 시각 오름차순으로 발번한다(도입 첫 회 = 과거분 무표기)
  const cc = $('#geniPrevCnt'); if (cc) cc.textContent = '(' + a.length + ')';
  const em = $('#geniPrevEmpty'); if (em) em.hidden = !!a.length;
  grid.innerHTML = '';
  a.forEach(e => grid.appendChild(geniHistItem(e, grid, '#geniPrevCnt')));
}
function geniResSess() {   // 결과 세션분(T0 이후) — renderGeniRes·renderGeniPrev·최신 추종 공용 산출(구 renderGeniRes 인라인 승격 · 로직 무변경)
  const loc = geniHistPrune(geniHistLoad()).filter(e => (e.ts || 0) >= GENI_T0 && !_geniDeadUrls.has(geniHistKey(e.url)));
  const seen = new Set(loc.map(e => geniHistKey(e.url)));
  const live = (GENI_LIVE || []).filter(e => e && e.url && (e.ts || 0) >= GENI_T0 && !seen.has(geniHistKey(e.url)) && !_geniDeadUrls.has(geniHistKey(e.url)));   // 부팅 이후 타 기기 제작 = 결과에도 합류(thumb 결과 최신 추종 동문 — 운영자 260803 "결과 부분 모든 기기에서 언제든 동기화" · 260804 "다른 메뉴들과 싱크")
  return loc.concat(live);
