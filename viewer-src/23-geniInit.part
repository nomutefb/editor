function geniRestoreOpts(g) {   // AI 생성 발사 옵션(gopts) → 폼 복원 = geniPrep의 GENI_OPTS2 복원 블록 문법 그대로(축별 사전 검증 · 값 창작 0)
  if (!g || typeof g !== 'object') return;
