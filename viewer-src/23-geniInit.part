  const vv = window.visualViewport;
  [$('#genidlg'), $('#pubdlg')].forEach(dlg => {
    if (!dlg || !dlg.open) return;
    if (vv.height < window.innerHeight - 60) {   /* raw-ok: 60 = toolVV 4826 게이트 상수 문자 계승(JS 키보드 괴리 임계 · CSS 토큰 비대상) */   // 시각 뷰포트 < 레이아웃 −60px = 키보드류 괴리일 때만(평시·PC = 인라인 0 = 현행 CSS 그대로 → 출렁 0)
      vvSet(dlg, Math.round(vv.height * 0.92) + 'px',   /* raw-ok: vv 기하 산식 = toolVV 4828 문자 계승(런타임 픽셀 계산 · CSS 토큰 비대상) */   // 보이는 영역 상단 기준 배치 · top만 오버라이드 = 좌우 중앙 유지
        Math.round(vv.offsetTop + vv.height * 0.04) + 'px');
    } else { vvSet(dlg, '', ''); }                                               // 키보드 내려감 = 즉시 원복(CSS dvh 복귀)
  });
}
function toolVV() {   // 스튜디오 셸(tooldlg) 키보드 클램프 — geniVV의 셸 일반화(260713 B 회귀 봉합: 프롬프팅·요약이 팝업→이식 탭이 되며 geniVV의 genidlg.open 게이트 밖 = 88/90dvh 하단이 키보드에 가림 · 평의회 260713 ③) · geniVV(팝업 경로)와 독립 병존
  if (!tooldlg || !tooldlg.open || !window.visualViewport) return;
  const vv = window.visualViewport;
  const full = tooldlg.classList.contains('tool-full');                                  // 전체창(이미지 스튜디오) = 여백 없이 '보이는 영역'을 그대로 채운다(팝업 셸의 92%+4% 인셋은 최대화 계약과 모순 · 운영자 260801)
  if (vv.height < window.innerHeight - 60) {   // 시각 뷰포트 < 레이아웃 −60px = 키보드류 괴리일 때만(평시·PC = 인라인 0 = 현행 CSS 그대로 → 출렁 0)
    vvSet(tooldlg, Math.round(vv.height * (full ? 1 : 0.92)) + 'px',                     // height:dvh 고정은 max-height가 클램프 · 전체창 = 배율 1(키보드 위 잔여 영역 전부)
      Math.round(vv.offsetTop + (full ? 0 : vv.height * 0.04)) + 'px');                  // 보이는 영역 상단 기준 배치(margin:auto는 layout viewport 중앙 = 키보드 위 아님) · top만 오버라이드 = 좌우 중앙 유지 · 전체창 = 인셋 0(margin:0 CSS와 동일선)
  } else { vvSet(tooldlg, '', ''); }                                                     // 키보드 내려감 = 즉시 원복(CSS dvh 복귀)
}
function geniPrep(file, wrap, btn) {   // 상태 준비 공통부(팝업 openGenIdlg·이식 geniMount 겸용 분리 · 운영자 260713 B)
  geniInit();
  _geniCtx = { file, wrap, btn, free: !file };   // free = 기사 컨텍스트 없음(이미지 제작 도구 /6 생성 탭 · 운영자 260707)
  const _free = !file;
  $('#geniWish').placeholder = _free ? '' : '선택 · 자유 요청 한 줄';   // 자유모드 = 설명 산문 제거(운영자 260713 "필수·그릴 장면·상황 설명 문구 없애") = 빈 플레이스홀더(§디자인 e 어포던스 · 발사 게이트가 미입력 방어) · 기사모드는 보조 힌트 유지
  $('#geniMore5').hidden = !file;       // 실사진 재검색 = 기사 카러셀 전용(자유 모드 숨김)
  try {   // 최근 사용 옵션 복원(GENI_OPTS2 · 축별 사전 검증 — 스키마 개편 260710이라 구 GENI_OPTS 키는 무시)
    const s = JSON.parse(localStorage.getItem('GENI_OPTS2') || 'null');
    if (s) {
      if (GENI_ALL_STYLES.some(([v]) => v === s.style)) _geniSel.style = s.style;
      _geniSel.sub = (GENI_SUB[_geniSel.style] || []).some(([v]) => v === s.sub) ? s.sub : 'auto';
      ['size', 'count', 'aspect'].forEach(k => { if (GENI_DICT[k].some(([v]) => v === s[k])) _geniSel[k] = s[k]; });   // ⚠ 'fmt' 제거(260805 포맷 고정) — 사전에서 지운 축을 여기 남겨두면 GENI_DICT.fmt가 undefined라 `.some`에서 TypeError = 옵션 복원 전체가 죽는다(구 21:9·1:1은 사전엔 없어도 축은 살아 있어 조용히 강하했지만, 축 자체를 지울 땐 이 목록이 짝)
      _geniSel.arW = /^\d{1,2}$/.test(String(s.arW || '')) ? String(s.arW) : '';
      _geniSel.arH = /^\d{1,2}$/.test(String(s.arH || '')) ? String(s.arH) : '';
      if (_geniSel.aspect === 'custom' && !geniArVal()) _geniSel.aspect = '4:5';   // 미완성 직접값 복원 = 안전 강하
      _geniSel.mood = s.mood === 'axes' ? 'axes' : 'auto';
      GENI_MOOD_AX.forEach(([k]) => { const v = parseInt(s.moodAx && s.moodAx[k], 10); _geniSel.moodAx[k] = Number.isFinite(v) ? Math.max(-2, Math.min(2, v)) : 0; });
      _geniSel.engine = s.engine === 'gpt' ? 'gpt' : 'gemini';
      if (s.colorAx && typeof s.colorAx === 'object') { GENI_COLOR_AX.forEach(([k]) => { const v = parseInt(s.colorAx[k], 10); _geniSel.colorAx[k] = Number.isFinite(v) ? Math.max(-50, Math.min(50, v)) : 0; }); _geniSel.colorTouched = !!s.colorTouched; }   // 색 보정 복원(미조정 스냅샷 = 프리셋 추종 유지)   // 렌더 엔진 복원(미지정·구 스냅샷 = Gemini 기본 강하)
      if (typeof s.kweb === 'boolean') _geniSel.kweb = s.kweb;
      if (typeof s.textOn === 'boolean') _geniSel.textOn = s.textOn;
      GENI_CAM_KEYS.forEach(k => { if (GENI_DICT[k].some(([v]) => v === s[k])) _geniSel[k] = s[k]; });
    }
  } catch {}
  if (_free) {   // 자유 모드 = 직전 장면 복원(이어쓰기·실수 이탈 복구 · 260709) — 기사 모드는 기사별이라 비움(현행 유지)
    const t = nmDraftLoad('GENI_FREE_TXT');   // 30분 만료(draft.js SSOT · 운영자 260801) — 예전 테스트 문구가 영구 복원되던 것 차단 · 만료분은 로드가 키까지 폐기
    $('#geniWish').value = (t && t.wish) ? String(t.wish).slice(0, 300) : '';
  } else { $('#geniWish').value = ''; }
  $('#geniWish').dispatchEvent(new Event('input', { bubbles: true }));   // 클립 리드백 동기(운영자 260803 클립 편입) — value 직접 대입은 attachCopyPaste의 refresh를 안 태워, 복원 글이 있는데 [복사]가 숨어 있거나 비운 뒤에도 남는 stale이 난다(updateRevClip·updatePasteClip이 같은 사유로 쓰는 input 디스패치 문법 그대로) · 되돌리기 창도 여기서 종료 = 새 장면 로드가 옛 undo 값을 물고 가지 않는다
  geniWishShow(!!$('#geniWish').value.trim(), false);   // 복원 글 있으면 행 노출·없으면 숨김(운영자 260721 반갈 — 숨은 값이 발사에 몰래 실리는 것 차단 · 빈 상태 진입점 = 미리보기 픽토그램)
  geniApply();
  // 카메라군에 복원값 있으면 자동 펼침(적대검증B: 개수 배지만으론 "무엇이" 안 보임 → 발사 전 열어 보이게) · 없으면 접힘+inert
  const _camOpen = GENI_CAM_KEYS.some(k => _geniSel[k] && _geniSel[k] !== 'auto');
  const _fold = $('#geniCamHead'), _sub = $('#geniCamSub');
  if (_fold) _fold.setAttribute('aria-expanded', _camOpen ? 'true' : 'false');
  if (_sub) { if (_camOpen) _sub.removeAttribute('inert'); else _sub.setAttribute('inert', ''); }
  geniHistBoot();   // 결과·이전 제작 공유 이력 개시(팝업·이식 두 홈의 공통 경유점 = 단일 개시점 · 260803 실데이터 배선)
  return _free;
}
function openGenIdlg(file, wrap, btn) {   // 기사 카러셀 + = 팝업 홈(이중 홈 정본 · 운영자 260713 B — 스튜디오 탭 홈 = geniMount)
  geniUnmount();   // 이식 잔류 방어 — 폼 노드가 호스트에 남았으면 회수(다이얼로그 = 보관함)
  const _free = geniPrep(file, wrap, btn);
  openComposeDlg($('#genidlg'));   // showModal + 폰 뒤로가기 칸(컴포즈 모달 표준)
  geniRailHome();   // 개막 = 레일 좌측 정렬선 시작(평의회⑦ 260714)
  if (_free) setTimeout(() => { try { const w = $('#geniWish'); w.focus(); if (w.value) w.select(); } catch {} }, 80);   // 자유모드 = 주문칸 진입점(필수 입력이 곧 시작점 · 지연 = 모달 애니 후) · 복원값 전체선택 = 새 장면은 즉시 덮어쓰기·이어쓰기는 탭 한 번(260709)
}
/* (결과 레일 거처 판정 JS = 폐지 · 260803 6차 평의회7 ALT-A2 — 폭에 따라 `#geniOut`을 재부모화하던 13줄(matchMedia + geniOutPlace + mount/unmount 훅)을
   CSS 절대배치 containing-block 탈출로 대체했다. reparent가 만들던 계열 결함 2종{폭 왕복 시 레일 내부 스크롤 소실 · 거처 질의가 남의 창을 무는 사고}이 원천 소멸.
   `check_geni_scope` 게이트는 존치 = 다른 geni JS의 전역 질의를 계속 막는다. 롤백 = 이 자리 + CSS 블록. */
function geniMount() {   // 프롬프팅 탭 = genidlg 폼을 탭 콘텐츠로 이식(운영자 260713 B "B로 간다" — askMount 선례 미러 · 팝업 한 겹 없이 폼이 바로 화면 · 발사·이탈·닫힘 = 원복)
  const h = $('#geniHost'), gdlg = $('#genidlg'); if (!h || !gdlg || gdlg.open || !h.hidden) return;   // 팝업(모달) 열림 중 = 불가(뒤 탭 클릭 물리 불가 — 방어선) · 이미 이식 표시 중(!hidden) = 재진입 no-op — geniPrep 재실행이 타이핑 중 장면을 GENI_FREE_TXT stale 스냅샷으로 덮던 것 차단(탭 재클릭 가드와 이중 방어 · 평의회 260713 fable)
  geniPrep(null);   // 자유 모드 상태 준비(옵션·장면 복원·placeholder·게이트) — 재진입 복원값 = 이탈 시점 스냅샷이라 왕복 무손실
  while (gdlg.firstChild) h.appendChild(gdlg.firstChild);   // 통째 이식(무복제 = 드리프트 0 · askwrap 선례) — 노드 거처 불변식: 호스트에 있음 ⇔ 호스트 표시 중
  document.querySelectorAll('#tooldlg .toolfr').forEach(f => f.classList.remove('active'));   // iframe 숨김(보존 · askMount 동일)
  const ah = $('#askHost'); if (ah) ah.hidden = true;   // 호스트 슬롯 상호 배타(방어)
  if (toolMeta.thumb) delete toolMeta.thumb.geniFired;   // 재이식 = 발사 마킹 해제(다음 최소화→복원은 다시 폼 · fable 260713)
  h.hidden = false;
  geniRailHome();   // 개막 = 레일 좌측 정렬선 시작(평의회⑦ 260714 · 팝업 홈과 대칭)
  // 자동 포커스 폐지(운영자 260803 "ai생성 메뉴를 클릭하면 자동으로 글을 입력하게끔 활성화가 되어버리는데, 그렇지 않게 해줘") — 탭 진입 = '보러 들어오는' 동작이라 입력 개시로 단정하지 않는다(구 동작 실측: 탭 클릭 84ms에 document.activeElement=#geniWish). 폰에선 그 포커스가 곧 키보드 상승 → visualViewport 연속 resize → toolVV()가 발화마다 tooldlg의 maxHeight·marginTop을 새 픽셀로 다시 써서 전체창이 계단식으로 떨렸다(= 운영자 "드드득 거리는 창 열림"). 입력 개시 = 운영자가 주문칸을 탭할 때(칸 자체는 geniWishShow가 상시 노출 = 어포던스 무손실 · 260802 "입력창을 그냥 고정값으로 박아놔") · 발사 게이트의 소재 0 경로(geniWishShow(true,true))는 종전 포커스 유지 = 막힘 피드백 무접촉 · 기사 카러셀 팝업 홈(openGenIdlg)은 별 진입점이라 종전 유지
}
function geniUnmount() {   // 원복(탭 이탈·닫기·최소화·발사·팝업 열기 직전) — DOM 이동 = 입력값 보존 · 기사 팝업 경로가 폼을 되찾음(askUnmount 선례)
  const h = $('#geniHost'); if (!h) return;
  if (!h.hidden && _geniCtx && _geniCtx.free) { nmDraftSave('GENI_FREE_TXT', { wish: $('#geniWish').value }); }   // 보이던 이식 폼 = 장면 스냅샷(다이얼로그 close 저장점 미러 — 재진입 geniPrep 복원과 한 쌍)
  if (!h.hidden) geniRefClear();   // 보이던 이식 폼 = 참고 이미지 정리(발사·이탈 후 유령 첨부가 다음 발사에 조용히 재전송되는 것 차단 · 평의회5 — 팝업 close 정리와 대칭 · reparent 직전이라 노드 ID 질의 유효)
  _geniMoodScrollY = null;   // 이식 사이클 넘어 stale 무드 스크롤 복원값 잔존 방지(평의회1)
  geniDDClose();
  const gdlg = $('#genidlg');
  while (h.firstChild) gdlg.appendChild(h.firstChild);
  h.hidden = true;
}
function geniLeave() { const h = $('#geniHost'); if (h && !h.hidden) { geniUnmount(); activateToolFrame(curToolKey); } }   // 셸 유지 이탈(타 탭 클릭·발사) = 원복 + 이 도구 iframe 재활성(ask 이탈 선례)

/* ── AI 생성 결과·이전 제작 실데이터 배선(운영자 260803 "다른 곳처럼 배선이 안되어있어" — 구 '정적 빈 상태(실데이터 미배선)' 해소) ──
   = tr.html 공유 이력 합류 문법 그대로 이식(운영자 260802 "편집·번역·AI생성에도 결과·이전제작 일맥상통 공유"의 마지막 미배선 표면).
   이전 제작 = thumb-hist.json(전 기기 공통 인덱스) + 로컬 12h 브리지(nomute_thumb_hist = thumb·tr 공유 키) 병합 · 읽기 전용(다운로드만 = tr 규약 · 기록 지우기·수정 복원 = 카드 생성 탭 전속).
   결과 = 이번 세션 완료분(T0 이후 브리지 유입 · thumb .out 캐러셀의 세션 축 등가) — 완료 감지 = genfree-fired → thumb genJob → carAppend/histAdd(localStorage) 체인의 종점을 storage 이벤트로 수신(이 판은 부모 문서라 iframe 완료를 직접 못 봄 = 브리지 키가 유일한 실시간 신호 · 같은 브리지라 카드·편집·특수 완료도 같이 흐름 = thumb 공유 .out과 동일 데이터).
   브리지 키·스키마·병합 문법 = thumb/tr 정본 동값(공유 키라 값 불일치 = 상호 절단 사고 — 개정 시 세 문서 동시에). */
const GENI_HKEY = 'nomute_thumb_hist', GENI_HMS = 12 * 3600e3;   // thumb/tr 정본 동값(로컬 12h 브리지)
const GENI_HCLEAR_KEY = 'nomute_thumb_hist_cleared';
const geniHistKey = u => String(u || '').split('?')[0].replace(/^https?:\/\/[^/]+\//, '');   // 중복판정 키 = tr histKey 동문(호스트 제거 = R2 절대·상대 통일)
function geniHistLoad() { try { const a = JSON.parse(localStorage.getItem(GENI_HKEY) || '[]'); return Array.isArray(a) ? a : []; } catch { return []; } }
function geniHistPrune(a) { const cut = Date.now() - GENI_HMS; return a.filter(e => e && e.ts && e.ts >= cut); }
function geniHistTime(ts) { const d = new Date(ts); let h = d.getHours(); const m = d.getMinutes(); const ap = h < 12 ? 'AM' : 'PM'; h = h % 12 || 12;
  const now = new Date(); const dayDiff = Math.round((new Date(now.getFullYear(), now.getMonth(), now.getDate()) - new Date(d.getFullYear(), d.getMonth(), d.getDate())) / 86400000);
  const pre = dayDiff === 0 ? '오늘 ' : dayDiff === 1 ? '어제 ' : (d.getMonth() + 1) + '/' + d.getDate() + ' ';
  return pre + h + ':' + String(m).padStart(2, '0') + ' ' + ap; }   // 시각 표기 = 카드 제작(thumb histTime) 정본 동문 — 오늘/어제 H:MM AM/PM(운영자 260818 11차 «번역칸 등 다른 이미지 스튜디오 칸도 통일» · 10차에 카드 제작만 바뀌어 갈렸던 자리 · 오늘/어제/월일 접두는 무접촉)
function geniDlBlob(url, name) {   // tr dlBlob 정본 동문 — R2(교차출처)는 api/dl 프록시로 강제 저장·비R2는 download 직접
  const a = document.createElement('a');
  a.href = /\/\/pub-[0-9a-fA-F]+\.r2\.dev\//.test(url) ? ('api/dl?u=' + encodeURIComponent(url) + '&n=' + encodeURIComponent(name || 'gen.png')) : url;
  a.download = name || 'gen.png';
  document.body.appendChild(a); a.click(); a.remove();
}
let GENI_SRV_HIST = [], GENI_SRV_CLEAR = 0; const _geniDeadUrls = new Set(); const GENI_T0 = Date.now();   // 죽은 404 항목 = 세션 내 재표시 차단(tr _deadUrls 동축) · T0 = 이 문서 부팅(= '이번 세션' 경계)
const geniBidOf = e => { const s = e && e.src; return (s && typeof s === 'object' && typeof s.bid === 'string') ? s.bid : ''; };   // 묶음 키 = thumb bidOf 정본 동문(구 이력 = '' = 낱장)
let GENI_NEWEST = [], _geniNewestSig = '';   // 최신 추종 = 스튜디오 전체 최신 제작 1묶음(thumb followNewestRestored 동문 · 운영자 260805 "편집·번역이 다른 세부 메뉴하고 동기화가 안 됨" — 구판 결과 축은 T0 이후·AI생성분만이라 형제 탭 제작이 결과에 안 떴다)
let GENI_LIVE = [];   // 즉시 축(운영자 260804 "번역·AI생성만 결과랑 이전제작 동기화를 안 물어 — 다른 메뉴들과 싱크") = api/genihist(free.json@main 라이브 서빙)가 준 최신 인덱스 — Pages(thumb-hist) 빌드·배포 랙을 건너뛰어 형제 탭 R2 즉시 축과 같은 박자 · 정식 도착 시 renderGeniPrev url dedup 자연 교체
try { GENI_SRV_CLEAR = +localStorage.getItem('nomute_thumb_srvclr') || 0; } catch {}
/* ── 수정(연필) 복원 = 이 제작을 만든 **세부 메뉴로 되돌아가** 그 설정으로 폼을 채운다(운영자 260806 "ai 생성에서 수정버튼을 눌렀는데, 해당 수정 건이 카드 제작 세부메뉴면 그 메뉴로 자동으로 변경후 수정") ──
