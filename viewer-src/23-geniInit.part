function geniInit() {
  if (_geniInited) return; _geniInited = true;
  geniRoot().querySelectorAll('.geni-opts[data-k]').forEach(box => {
    const k = box.dataset.k;
    box.innerHTML = GENI_DICT[k].map(([v, ko]) => '<button type="button" class="geni-opt"' + (k === 'aspect' || k === 'size' || k === 'count' ? ' data-num="1"' : '') + ' data-v="' + v + '">' + ko + '</button>').join('');
    box.addEventListener('click', e => {
      const b = e.target.closest('.geni-opt'); if (!b) return;
      if (k === 'aspect' && b.dataset.v === 'custom' && _geniSel.aspect === 'custom') { _geniSel.aspect = '4:5'; _geniSel.arW = '1'; _geniSel.arH = '1'; geniApply(); return; }   // 켜진 「직접」 재탭 = 프리셋으로 복귀(인라인 전환의 되돌아가기 정문 · 운영자 260727 "순간 바껴서"의 왕복 축)
      _geniSel[k] = b.dataset.v;
      if (k === 'aspect' && b.dataset.v === 'custom') setTimeout(() => { try { const w = $('#geniArW'); w.focus(); w.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch {} }, 280);   // 직접 = 아코디언 펼침 뒤 W 포커스 + 키보드 가림 구제(주문칸과 동일 처리 · 6인 검증)
      geniApply();
    });
  });
  // 화풍 = 상용 3칩 + '기타' 선택박스 / 세부 화풍 = 자동 + '직접' 선택박스 / 무드 = 자동 + 직접(게이지) — 운영자 260710
  $('#geniStyle').innerHTML = geniFreqSort('style', GENI_ALL_STYLES).map(([v, ko], i) => '<span class="geni-subit">' + (i ? '<span class="geni-sep" aria-hidden="true">|</span>' : '') + '<button type="button" class="geni-opt" data-v="' + v + '">' + ko + '</button></span>').join('');   // 9화풍 전량 = 제작빈도순 가로 레일(운영자 260713 전광판 · 좌측=자주 쓰는 화풍) · 정적 목록 = 촤르륵 비대상(인/아웃 애니는 #geniSub 스코프)
  $('#geniStyle').addEventListener('click', e => {
    const b = e.target.closest('.geni-opt'); if (!b) return;
    geniPickStyle(b.dataset.v);   // 부수효과(미보유 세부 자동 강하 · 레고→GPT 기본) = geniPickStyle 단일점 — 요약바 글자 탭과 공유(복제 모드 GPT 자동 전환[geniRefMode]과 동일 문법)
    geniApply();
  });
  geniSubRender();   // 세부 화풍 = 현 화풍 목록 인라인 즉시 구축(운영자 260713 — 구 자동+'직접' 선택박스 폐지 · 클릭은 아래 위임 1핸들러)
  $('#geniSub').addEventListener('click', e => {
    const b = e.target.closest('.geni-opt'); if (!b) return;
    _geniSel.sub = b.dataset.v; geniApply();
  });
  // ── 요약바(#geniSum) 글자 탭 = 그 옵션 바꾸기(운영자 260728 "옵션바에 해당 비율 또는 토글되는 글자 클릭하면 옵션이 바뀌게 · 각 옵션에 따라 귀속") ──
  //   레퍼런스 = #askStrip .gs-tog 정본 그대로(클릭 + Enter/Space · role=button · press-m 눌림) · 값 축은 「다음 값으로 순환」, ON/OFF 축은 뒤집기 = 각 옵션 성격에 귀속.
  //   순환 순서 = 본문 나열 순서 계승(비율 = GENI_DICT.aspect · 화풍·세부 = 레일 표시 순서) → 요약바로 넘겨도 본문 레일이 같은 순서로 따라온다(반영은 geniApply 단일점).
  const GENI_SUM_TG = {
    engine: () => { _geniSel.engine = _geniSel.engine === 'gpt' ? 'gemini' : 'gpt'; _geniSel.engineTouched = true; },   // 모델 = 두 모델 교대(본문 칩과 같은 손댐 도장 = 복제 자동 전환이 덮지 않는다)
    aspect: () => { const ps = GENI_DICT.aspect.filter(([v]) => v !== 'custom').map(([v]) => v); _geniSel.aspect = ps[(ps.indexOf(_geniSel.aspect) + 1) % ps.length]; },   // 비율 = 프리셋만 순환('직접'은 N:N 입력이라 순환 대상 아님 · 직접 상태에서 탭하면 첫 프리셋으로 복귀 = indexOf -1)
    style: () => { const ls = geniFreqSort('style', GENI_ALL_STYLES).map(([v]) => v); geniPickStyle(ls[(ls.indexOf(_geniSel.style) + 1) % ls.length]); },   // 화풍 = 레일 순서 순환 + 부수효과 공유
    sub: () => { const ls = geniSubList().map(([v]) => v); _geniSel.sub = ls[(ls.indexOf(_geniSel.sub) + 1) % ls.length]; },   // 세부 화풍 = 현 화풍 목록 순환(자동 포함 · 세부 없는 화풍[레고]은 자동 1개라 제자리)
    kweb: () => { _geniSel.kweb = !_geniSel.kweb; },
    textOn: () => { _geniSel.textOn = !_geniSel.textOn; },
  };
  const sumEl = $('#geniSum');
  if (sumEl) {
    const sumFire = e => {
      const t = e.target.closest('.gs-tog'); if (!t) return;
      const fn = GENI_SUM_TG[t.dataset.tg]; if (!fn) return;
      e.preventDefault();
      const k = t.dataset.tg;
      fn(); geniApply();
      if (document.activeElement === document.body || !sumEl.contains(document.activeElement)) { const n = document.querySelector('#geniEngRail [data-tg="' + k + '"], #geniSum [data-tg="' + k + '"]'); if (n && e.type === 'keydown') n.focus(); }   // 매 반영마다 innerHTML 재작성 = 노드 교체 → 키보드 경로만 같은 항목으로 포커스 재착지(마우스는 원복 불필요) · 탐색 = 두 거처(모델 칩 = #geniEngRail 승격분 260803)
    };
    sumEl.addEventListener('click', sumFire);
    const engEl = $('#geniEngRail');   // 모델 칩 거처(260803 픽토 자리 승격) = 같은 위임 1벌 재사용(재구현 0)
    if (engEl) { engEl.addEventListener('click', sumFire); engEl.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') sumFire(e); }); }
    sumEl.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') sumFire(e); });   // 바인딩 = #askStrip 토글 정본 문법(클릭 + Enter/Space)
  }
  geniRailSetup('#geniStyle'); geniRailSetup('#geniSub');   // 레일 = 드래그·화살표·끝선 페이드 배선(운영자 260713 전광판)
  $('#geniMood').innerHTML = '<button type="button" class="geni-opt" data-v="auto">자동</button><button type="button" class="geni-opt" data-v="axes">직접</button>';
  $('#geniMood').addEventListener('click', e => {
    const b = e.target.closest('.geni-opt'); if (!b) return;
    const nv = b.dataset.v === 'axes' ? 'axes' : 'auto';
    const changed = nv !== _geniSel.mood;
    _geniSel.mood = nv; geniApply();
    if (changed) requestAnimationFrame(() => geniMoodScroll(nv === 'axes'));   // 무드 직접/자동 토글 = 게이지 아코디언 열림·닫힘에 맞춰 개수 행 정렬 스크롤(운영자 260713 "장수까지 이징하며 올라오고 닫으면 내려감") · geniApply 아코디언 반영 뒤(rAF)
  });
  $('#geniGauges').innerHTML = GENI_MOOD_AX.map(([k, name, lo, hi]) =>
    '<div class="geni-gg" data-ax="' + k + '"><div class="geni-gg-h"><span class="geni-gg-name">' + name + '</span><span class="geni-gg-val">0</span></div>' +
    '<div class="geni-gg-bar"><span class="geni-gg-end">' + lo + '</span><input type="range" min="-2" max="2" step="1" value="0" aria-label="' + name + ' (' + lo + ' ↔ ' + hi + ')"><span class="geni-gg-end">' + hi + '</span></div></div>').join('');
  $('#geniColorGauges').innerHTML = GENI_COLOR_AX.map(([k, name, lo, hi]) =>
    '<div class="geni-gg" data-ax="' + k + '"><div class="geni-gg-h"><span class="geni-gg-name">' + name + '</span><span class="geni-gg-val">0</span></div>' +
    '<div class="geni-gg-bar"><span class="geni-gg-end">' + lo + '</span><input type="range" min="-50" max="50" step="5" value="0" aria-label="' + name + ' (' + lo + ' ↔ ' + hi + ')"><span class="geni-gg-end">' + hi + '</span></div></div>').join('');   // 셸·문법 = 무드 게이지 정본 그대로(범위만 ±50% step 5)
  $('#geniColorGauges').addEventListener('input', e => {
    const r = e.target.closest('input[type=range]'); if (!r) return;
    _geniSel.colorAx[r.closest('.geni-gg').dataset.ax] = Math.max(-50, Math.min(50, parseInt(r.value, 10) || 0));
    _geniSel.colorTouched = true;   // 손댄 뒤엔 엔진·모드가 바뀌어도 운영자 값이 이긴다
    geniApply();
  });
  const crst = $('#geniColorReset'); if (crst) crst.addEventListener('click', () => { _geniSel.colorTouched = false; _geniSel.colorAx = geniColorPreset(); geniApply(); });   // 실측 프리셋 복귀
  $('#geniGauges').addEventListener('input', e => {
    const r = e.target.closest('input[type=range]'); if (!r) return;
    const k = r.closest('.geni-gg').dataset.ax;
    _geniSel.moodAx[k] = Math.max(-2, Math.min(2, parseInt(r.value, 10) || 0));
    geniApply();
  });
  [['#geniArW', 'arW'], ['#geniArH', 'arH']].forEach(([sel, key]) => {   // 비율 직접 N:N — 숫자만 · 환산 표시는 geniApply
    const el = $(sel); if (!el) return;
    el.addEventListener('input', () => { const v = el.value.replace(/\D/g, '').slice(0, 2); if (el.value !== v) el.value = v; _geniSel[key] = v; geniApply(); });
    el.addEventListener('focus', () => el.select());   // 탭하면 그 자리가 비는 느낌(운영자 260727 "1:1이였다가 자릿수가 비는 느낌") = 값 전체 선택 → 첫 타건이 바로 덮어쓴다
    el.addEventListener('blur', () => { if (!el.value) { el.value = '1'; _geniSel[key] = '1'; geniApply(); } });   // 비운 채 떠나면 1로 복귀 = '값이 앉아 있는' 상태 유지(빈 칸 = 발사 게이트 차단 상태로 방치되는 것 방지)
  });
  const kwbtn = $('#geniKweb'); if (kwbtn) kwbtn.addEventListener('click', () => { _geniSel.kweb = !_geniSel.kweb; geniApply(); });   // 웹툰화 = 독립 on/off 토글(기본 ON · 운영자 260710 · 260728 토글 유지 재확인)
  const engbtn = $('#geniEngine'); if (engbtn) engbtn.addEventListener('click', e => { const b = e.target.closest('.geni-opt'); if (!b) return; _geniSel.engine = b.dataset.v === 'gpt' ? 'gpt' : 'gemini'; _geniSel.engineTouched = true; geniApply(); });   // 손댄 뒤엔 복제 자동 전환이 덮지 않는다   // 탭 = 누른 모델 즉시 선택(운영자 260728 · 구 교대 토글) · 위임 문법 = #geniRefMode 정본 그대로
  const tonbtn = $('#geniTextOn'); if (tonbtn) tonbtn.addEventListener('click', () => { _geniSel.textOn = !_geniSel.textOn; geniApply(); });   // 문구 살리기 = on/off 토글(260728 한국웹툰화와 한 쌍 회수) — 문구 자체는 Opus가 주문(장면 설명)에서 정해 자연스럽게 살림(운영자 260710)
  const rfBtn = $('#geniRefBtn'), rfFile = $('#geniRefFile'), rfBox = $('#geniPrevBox'), rfSwap = $('#geniRefSwap'), rfX = $('#geniRefX');   // 참고 이미지 첨부 = 미리보기 쉘 이주(운영자 260719 — 빈 상태 픽토그램 진입점 #geniRefBtn 승계 · 교체/삭제 = .cpv-tool · thumb 편집 미리보기 입구 문법 동일)
  // ── 미리보기 확대(돋보기) + 레일 생성 칩 = thumb 정본 동문(운영자 260802 2차) — 창은 상시 52%·확대는 버튼만 · 생성 칩은 정본 발사 버튼(#geniGo) 대리클릭(상태·비활성 1벌) ──
  //   확대 상태 = 표면 공용 키 1벌(운영자 260802 3차 승인 = 보고 6-4) — thumb·tr과 같은 `nm.pvzoom`이라 4탭이 한 크기로 열린다
  const zmBtn = $('#geniZoom'), zmPv = $('#geniPrev');
  if (zmBtn && zmPv) {
    const paint = on => { zmPv.classList.toggle('dockzoom', on); zmBtn.classList.toggle('on', on); zmBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      zmBtn.setAttribute('aria-label', on ? '미리보기 원상복귀' : '미리보기 확대'); zmBtn.title = on ? '탭=원상복귀' : '탭=미리보기 확대 · 다시 탭=원상복귀'; };
    geniZoomPaint = on => { paint(on); geniPrevSize(); };   // 탭 진입 재도색 = 폭 전환 후 실폭 1:1 높이 재산출 동반(아래 클릭 배선과 같은 짝 · 쉘 높이 단일출처 = geniPrevSize)
    paint(PVZOOM.get());
    zmBtn.addEventListener('click', () => { const on = !zmPv.classList.contains('dockzoom'); paint(on); PVZOOM.set(on); setTimeout(geniPrevSize, 280); });   // 폭 전환 후 실폭 1:1 높이 재산출(쉘 높이 단일출처 = geniPrevSize)
  }
  if (rfBtn && rfFile) {
    rfBtn.addEventListener('click', () => { if (!_geniRef) rfFile.click(); });   // 빈 상태 = 파일 선택(네이티브 button = 키보드 Enter/Space 자동 페어 — 구 div role 키다운 폐지)
    if (rfSwap) rfSwap.addEventListener('click', () => rfFile.click());   // 교체 = 파일 선택 재진입(thumb #cpImgSwap → #cFile 위임 동일)
    if (rfX) rfX.addEventListener('click', () => { geniRefClear(); geniApply(); });   // 삭제(휴지통) = 빈 상태 복귀(thumb #cpImgDel → _reset 위임 동일)
    rfFile.addEventListener('change', () => { const f = rfFile.files && rfFile.files[0]; if (f) geniRefPick(f); rfFile.value = ''; });   // value 리셋 = 같은 파일 재선택 허용
    bindImgPaste($('#geniWish'), geniRefPick);   // 붙여넣기(Ctrl+V) = 주문칸에 클립보드 이미지 → 참고 이미지(askText 선례 이식 · 운영자 260713 "모든 곳에 다")
    if (rfBox) {
      bindImgPaste(rfBox, geniRefPick);          // 미리보기 박스 포커스 상태 붙여넣기(구 슬롯 바인딩 승계)
      ['dragover', 'dragenter'].forEach(t => rfBox.addEventListener(t, e => { e.preventDefault(); rfBox.classList.add('dropping'); }));   // 드롭 첨부 = thumb .cpprev-box.dropping 힌트 동일(운영자 260716 "드롭 ㄱ" 축 계승)
      ['dragleave', 'drop'].forEach(t => rfBox.addEventListener(t, e => { if (t === 'drop') { e.preventDefault(); const f = [...((e.dataTransfer && e.dataTransfer.files) || [])].find(x => /^image\//.test(x.type || '')); if (f) geniRefPick(f); } rfBox.classList.remove('dropping'); }));
    }
  }
  const rfMode = $('#geniRefMode'); if (rfMode) rfMode.addEventListener('click', e => { const b = e.target.closest('.geni-opt'); if (!b) return; _geniSel.refMode = GENI_REFMODES.includes(b.dataset.v) ? b.dataset.v : 'ref'; if (_geniSel.refMode === 'clone') { geniCloneAspect(); if (!_geniSel.engineTouched) _geniSel.engine = 'gpt'; } geniApply(); });   // 복제 = 엔진도 GPT로 자동 전환(운영자 260727 한 수 채택 · 근거 = Gemini엔 input_fidelity가 없어 선 강도 축을 구조적으로 못 잡음 · 260727 실측 GPT+fidelity+채도-20% = 문서 §4 전지표 합격) · 엔진 칩을 한 번이라도 손댔으면 그 선택이 이긴다   // 복제 선택 = 비율을 첨부 원본비로 스냅(운영자 260726 · 문서 §L3) — 다른 모드로 되돌리면 비율은 그대로 남는다(운영자가 다시 고르면 그 값 승)
  geniRoot().querySelectorAll('.geni-fold').forEach(fold => fold.addEventListener('click', () => {   // 소머리 접이 = 카메라·구도 단독 배선을 .geni-fold 전체로 일반화(운영자 260727 "개요에도 화살표" — 개요·표현 폴드 편입 · 대상은 aria-controls가 지목 = 구 #geniCamSub 하드코딩 해소 · 동작 문법·CSS 신설 0)
    const open = fold.getAttribute('aria-expanded') !== 'true';
    fold.setAttribute('aria-expanded', open ? 'true' : 'false');
    const sub = document.getElementById(fold.getAttribute('aria-controls')); if (sub) { if (open) { sub.removeAttribute('inert'); setTimeout(() => { try { fold.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch {} }, 60); } else sub.setAttribute('inert', ''); }   // inert = 접힘 시 tab-order·SR 제거(적대검증B P1: 구 max-height:0만 = 안 보이는 37칩이 tab-order 잔류 = 거짓 계승 · 원본 .pmenu-sub[hidden] 핵심 복원)
  }));
  geniRoot().querySelectorAll('.geni-histfold').forEach(btn => { let _cT = null; btn.addEventListener('click', () => {   /* ⚠ 스코프 = 폼 뿌리(geniRoot) — 구 전역 질의는 **다운로드 창(#dlgrab)의 같은 클래스 폴드 2개**까지 물어 남의 창 버튼에 geni 핸들러를 덧바인딩했다(재검증관 CDP 실측: dg 폴드 리스너 0→1 · 재현 = 다운로드 창을 최소화로 남긴 뒤 AI 생성 첫 진입). 지금은 dg가 본문을 통째 재구축해 덮어 증상이 잠복이지만, 부분 갱신으로 바뀌는 날 바로 터진다 — 260803 6차 `geniOutPlace` 전역 `.geni-body` 사고와 **같은 계열**이라 같은 처방으로 동봉 봉합 */   // AI 생성 결과·이전 제작 접이 = thumb/tr #histH 정본 동문(hidden+closing 촤르륵 · 운영자 260803 Q1249 "접이 애니메이션도 적용" — 구 grid-rows 슬라이드+inert 폐지 · dg 다운로드 창 폴드는 자기 재렌더 문법 = 무접촉)
    const sub = document.getElementById(btn.getAttribute('aria-controls')); if (!sub) return;
    const open = sub.hidden;
    clearTimeout(_cT); sub.classList.remove('closing');
    btn.setAttribute('aria-expanded', String(open));
    if (open) { sub.hidden = false; }
    else if (matchMedia('(prefers-reduced-motion:reduce)').matches) { sub.hidden = true; }
