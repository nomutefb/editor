function vvSet(dlg, mh, mt) {   // 동일값 재대입 금지 — style 문자열이 그대로면 브라우저가 리플로우를 안 하지만, 대입 자체가 스타일 무효화를 트리거하는 경로(인라인 CSSOM 쓰기)라 '값이 안 변한 프레임'을 건너뛰는 게 실제 이득
