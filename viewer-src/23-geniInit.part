// ── 키보드 클램프 공용부(운영자 260803 "아이디어까지 적용") — 구조: vv 이벤트 폭주 → **다음 프레임 1회**로 합치고(vvSchedule), 계산값이 직전과 같으면 **스타일을 아예 안 쓴다**(vvSet).
//   왜: 폰 키보드는 250ms 안팎에 걸쳐 올라오며 visualViewport의 resize·scroll을 수십 번 발화한다. 구 배선은 발화마다 곧장 dialog의 maxHeight·marginTop을 문자열로 다시 써서, 같은 값이어도 매번 레이아웃 재계산이 걸렸다(= 운영자 "드드득"의 근본 축 — 260803 1차는 AI 생성 탭의 자동 포커스만 막아 '창 열림 순간'만 덮었고, 운영자가 직접 입력칸을 탭하면 그대로 재현됐다).
//   합치기 = 프레임당 최대 1회 계산 · 동일값 skip = 실제 값이 바뀐 프레임에서만 리플로우. 두 축 다 **값·산식 무변경**(클램프 결과 픽셀은 종전과 1:1 동일) = 시각 회귀 0.
let _vvRaf = 0;
function vvSchedule() {   // vv 이벤트 → 다음 프레임 1회로 코얼레스(가드 = 큐에 콜백 1개만 · 콜백은 발화 시점의 최신 vv를 읽으므로 중간 값을 건너뛰어도 최종 상태는 정확)
  if (_vvRaf) return;
