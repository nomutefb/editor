<script>setTimeout(function(){document.body.classList.add('booted');},2500);</script><!-- 최종 안전망(독립 스크립트) — 메인 앱 스크립트가 통째로 죽어도 2.5s 후 반드시 노출(영구 블랙 차단·운영자 260626). 정상 경로는 메인의 allSettled가 ~0.3s에 먼저 노출. -->
<div class="bgfx"></div><canvas id="wavebg" aria-hidden="true"></canvas><div id="bootveil" aria-hidden="true"></div><!-- OS 스플래시→앱 배경 교차 베일(운영자 260707) — manifest background_color 단색을 첫 페인트가 그대로 이어받고 booted 시 페이드아웃(콘텐츠 페이드인과 크로스페이드) · 제거 = _bootReveal -->
<!-- wavebg 셰이더 = 캔버스 직후로 호이스팅(분신7 260706 — 스크립트 말미(1MB 메인 파싱 뒤) 초기화라 콜드 스타트 내내 배경이 워시뿐이던 것 → 파싱 초입에 물결 가동 · 의존 = 캔버스+:root 토큰뿐(실측 5항 체크) · 로직 무변경 순수 이동) --><script>
/* ── 무채색 물결 배경 (#wavebg) — paper mesh-gradient 무채색 이식. 색=:root --bg에 흰색 알파(무채색 명암)·raw hex 없음. 정적 아님(천천히 흐름). 성능=백그라운드·reduced-motion 정지, WebGL 실패=.bgfx 워시 폴백(.off · 구 feed_bg 제거 260706). 운영자 260705 ── */
(function(){
  var canvas=document.getElementById('wavebg'); if(!canvas) return;
  var MAX=10, FRAME_MS=8;                                             // ~120fps 상한(운영자 요청 부드러움) · 가림/백그라운드/reduced-motion 정지로 배터리 방어 유지
  var VERT='#version 300 es\n'+
    'in vec2 a_position; out vec2 v_objectUV; uniform float u_scale;\n'+
    'void main(){ gl_Position=vec4(a_position,0.,1.); vec2 uv=a_position*0.5; v_objectUV=uv/max(0.001,u_scale); }';
  var FRAG='#version 300 es\n'+
    'precision mediump float;\n'+
    'uniform float u_time; uniform vec4 u_colors['+MAX+']; uniform float u_colorsCount;\n'+
    'uniform float u_distortion; uniform float u_swirl; uniform float u_grainMixer; uniform float u_grainOverlay; uniform vec3 u_floor;\n'+
    'in vec2 v_objectUV; out vec4 fragColor;\n'+
    'vec2 rotate(vec2 uv,float th){ return mat2(cos(th),sin(th),-sin(th),cos(th))*uv; }\n'+
    'float hash21(vec2 p){ p=fract(p*vec2(0.3183099,0.3678794))+0.1; p+=dot(p,p+19.19); return fract(p.x*p.y); }\n'+
    'float valueNoise(vec2 st){ vec2 i=floor(st),f=fract(st); float a=hash21(i),b=hash21(i+vec2(1,0)),c=hash21(i+vec2(0,1)),d=hash21(i+vec2(1,1)); vec2 u=f*f*(3.-2.*f); return mix(mix(a,b,u.x),mix(c,d,u.x),u.y); }\n'+
    'float noise(vec2 n,vec2 s){ return valueNoise(n+s); }\n'+
    'vec2 getPosition(int i,float t){ float a=float(i)*.37,b=.6+fract(float(i)/3.)*.9,c=.8+fract(float(i+1)/4.); float x=sin(t*b+a),y=cos(t*c+a*1.5); return .5+.5*vec2(x,y); }\n'+
    'void main(){ vec2 uv=v_objectUV; uv+=.5; vec2 grainUV=uv*1000.; float grain=noise(grainUV,vec2(0.)); float mixerGrain=.4*u_grainMixer*(grain-.5);\n'+
    ' float t=.5*(u_time+41.5); float radius=smoothstep(0.,1.,length(uv-.5)); float center=1.-radius;\n'+
    ' for(float i=1.;i<=2.;i++){ uv.x+=u_distortion*center/i*sin(t+i*.4*smoothstep(.0,1.,uv.y))*cos(.2*t+i*2.4*smoothstep(.0,1.,uv.y)); uv.y+=u_distortion*center/i*cos(t+i*2.*smoothstep(.0,1.,uv.x)); }\n'+
    ' vec2 uvR=uv-vec2(.5); uvR=rotate(uvR,-3.*u_swirl*radius); uvR+=vec2(.5);\n'+
    ' vec3 color=vec3(0.); float tw=0.;\n'+
    ' for(int i=0;i<'+MAX+';i++){ if(i>=int(u_colorsCount)) break; vec2 pos=getPosition(i,t)+mixerGrain; float dist=pow(length(uvR-pos),3.5); float w=1./(dist+1e-3); color+=u_colors[i].rgb*u_colors[i].a*w; tw+=w; }\n'+
    ' color/=max(1e-4,tw); color=max(color,u_floor);\n'+   /* 최저 밝기 플로어(운영자 260707 "카드 우측 칸이 검정으로 비어 보임") — 블롭 5개가 멀어진 보이드가 --bg 근접 검정까지 떨어져 반투명 카드(글래스 .18/.20) 뒤로 '빈 검정 칸'처럼 비치던 것 → 채널별 max로 어디서든 딥블루(u_floor) 아래로 안 떨어짐 · 밝은 영역 무변 · 그레인은 플로어 뒤에 얹혀 질감 유지 */
    ' float go=valueNoise(rotate(grainUV,1.)+vec2(3.)); go=mix(go,valueNoise(rotate(grainUV,2.)+vec2(-1.)),.5); go=pow(go,1.3); float gV=go*2.-1.; float gS=pow(u_grainOverlay*abs(gV),.8); color=mix(color,vec3(step(0.,gV)),.35*gS);\n'+
    ' fragColor=vec4(color,1.0); }';
  // 색 = :root 토큰 tint(--bg에 시안·파랑) — 오션 프리셋 · 컨텍스트 무관·1회·raw hex 없음
  var cs=getComputedStyle(document.documentElement);
  function hx(h){ h=(h||'').trim()||'#121212'; return [parseInt(h.slice(1,3),16)/255,parseInt(h.slice(3,5),16)/255,parseInt(h.slice(5,7),16)/255]; }   // 폴백 #121212 = --bg 미해결 시만(정상 경로 미발동)
  var BG=hx(cs.getPropertyValue('--space-bg')), CY=hx(cs.getPropertyValue('--bias-l1')), BL=hx(cs.getPropertyValue('--bias-l2'));   // 우주톤 통일(운영자 260723) — 물결 base = --space-bg(#070a12) · 시안/파랑 틴트는 은은한 우주 시머로 잔존(INT↓) · 구 base=--bg(오션 청록 강도)
  function mixc(base,c,t){ t=Math.min(1,t); return [base[0]+(c[0]-base[0])*t, base[1]+(c[1]-base[1])*t, base[2]+(c[2]-base[2])*t, 1.0]; }
  var WAVE_ON=true;                                                  // 렉 신고 스위치(운영자 260820 "렉걸린다고 내가 말하면 워시만 하게 미리 적용") — false 한 글자면 물결 통째 정지(그래픽 컨텍스트 미생성 = GPU 점유 0) + .bgfx 워시만 노출. 값 되돌림 없이 이 줄만 바꾼다.
  var INT=0.13, WT=[1,1,1];                                           // 물결 세기 = 260723 우주톤 0.13 유지(운영자 260820 2차 선택값 — 1차 0.42는 되돌림 · "안 보인다"의 해소는 세기가 아니라 아래 FLOOR 한 축으로 간다) · WT=흰색(무채 스팟)
  var COLORS=[ mixc(BG,CY,0.55*INT), mixc(BG,BL,0.8*INT), mixc(BG,CY,1.1*INT), mixc(BG,BL,0.45*INT), mixc(BG,WT,0.2*INT) ];   // 시안(--bias-l1)·파랑(--bias-l2) 틴트(오션 · 260705 재배선)
  var P={dist:0.53,swirl:0.34,speed:0.33,scale:0.86,grain:0.12};      // 260705 확정 세팅 유지(운영자 260820 2차 선택값 — 1차 속도 0.52·입자 0.07은 되돌림)
  var FLOOR=mixc(BG,BL,0.68*INT);                                     // 물결 최저 밝기 플로어(운영자 260820 2차 선택값 0.90→0.68 · 1차 0.60에서 상향) — 바닥이 높으면 어두운 자리가 안 어두워져 물결 폭이 위아래로 눌린다("안 보인다"의 진범 축 · 다른 4값은 260705·260723 정본 그대로) · 260707 보이드 검정 봉합 취지는 유지 = 딥블루(--bias-l2) 틴트 21.6% — 보이드 검정 박멸(운영자 260707) · 토큰 파생 = raw hex 0 · 실측 = docs/작업이력 260707 물결플로어
  var GRAIN_MIX=0.15;                                                 // getPosition 흔들림(확정 6종 밖 고정값)
  var flat=new Float32Array(MAX*4); COLORS.forEach(function(c,i){ flat.set(c,i*4); });

  var gl=null, prog=null, uni={}, glbuf=null;
  var simTime=0, lastRender=0, raf=0, running=false, lost=false;
  var reduceMq=matchMedia('(prefers-reduced-motion:reduce)');
  function isReduce(){ return reduceMq.matches; }
  function sh(ty,src){ var o=gl.createShader(ty); gl.shaderSource(o,src); gl.compileShader(o); if(!gl.getShaderParameter(o,gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(o)); return o; }
  // GL 리소스 초기화 = 최초 + 컨텍스트 로스트 복원 시 재호출. 실패면 .off(.bgfx 워시 폴백)
  function initGL(){
    try{ gl=canvas.getContext('webgl2',{antialias:false,premultipliedAlpha:false}); }catch(e){ gl=null; }   // antialias 불필요(그라디언트)·일부 브라우저 throw 대비 try
    if(!gl){ canvas.classList.add('off'); return false; }             // WebGL2 미지원 = 폴백
    try{ prog=gl.createProgram(); gl.attachShader(prog,sh(gl.VERTEX_SHADER,VERT)); gl.attachShader(prog,sh(gl.FRAGMENT_SHADER,FRAG)); gl.linkProgram(prog);
      if(!gl.getProgramParameter(prog,gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(prog)); }
    catch(e){ canvas.classList.add('off'); return false; }             // 컴파일/링크 실패 = 폴백
    gl.useProgram(prog);
    glbuf=gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER,glbuf); gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1,3,-1,-1,3]),gl.STATIC_DRAW);
    var loc=gl.getAttribLocation(prog,'a_position'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);
    uni={}; ['u_time','u_colors','u_colorsCount','u_distortion','u_swirl','u_grainMixer','u_grainOverlay','u_scale','u_floor'].forEach(function(n){ uni[n]=gl.getUniformLocation(prog,n); });
    canvas.classList.remove('off');
    sizeBuffer(true);
    return true;
  }
  function sizeBuffer(force){ if(!gl) return; var dpr=Math.min(window.devicePixelRatio||1,2); var w=Math.round(innerWidth*dpr),h=Math.round(innerHeight*dpr);
    if(force || canvas.width!==w || canvas.height!==h){ canvas.width=w; canvas.height=h; gl.viewport(0,0,w,h); if(gl && !lost) render();   /* 리사이즈 즉시 동기 1프레임(분신4 260706 — 버퍼 재할당 후 다음 rAF까지 투명 → 아래 워시 비침 플리커 차단·reduce 한정이던 것 전 경로 확대) */ } }   // 치수 변화 시만 버퍼 재할당(잰크 방지) + reduce는 리사이즈/회전 시 재도색
  function render(){ if(!gl||lost) return;
    gl.uniform1f(uni.u_time,simTime); gl.uniform1f(uni.u_distortion,P.dist); gl.uniform1f(uni.u_swirl,P.swirl);
    gl.uniform1f(uni.u_grainMixer,GRAIN_MIX); gl.uniform1f(uni.u_grainOverlay,P.grain); gl.uniform1f(uni.u_scale,P.scale);
    gl.uniform4fv(uni.u_colors,flat); gl.uniform1f(uni.u_colorsCount,COLORS.length); gl.uniform3f(uni.u_floor,FLOOR[0],FLOOR[1],FLOOR[2]);
    gl.drawArrays(gl.TRIANGLES,0,3); }
  function loop(now){ raf = running ? requestAnimationFrame(loop) : 0;
    var _fm = document.body.classList.contains('scr-locked') ? 33 : FRAME_MS;   // 잠금화면(유휴·사용자 부재 = dialog/visibility 배터리 가드 안 걸리는 유일 상태)만 30fps로 다운시프트 = 배터리(평의회7 260705) · 평소 ~120fps(FRAME_MS=8)
    if(now-lastRender < _fm) return;
    var dt=Math.min(0.05,(now-lastRender)/1000); lastRender=now;
    if(modalOpen) return;                                             // 전체화면 모달로 완전히 가려지면 렌더 스킵(GPU 절감·bannerbreath 정지와 대칭) · 판정 = 플래그(구 `document.querySelector('dialog[open]')`는 매 프레임 실행 = 실측 156µs × 최대 120fps = 19ms/s · 문서 7,056노드·dialog 17개 스캔 · 260807)
    simTime+=dt*P.speed*6.0; render(); }
  function start(){ if(running||lost||!gl||modalOpen) return; running=true; lastRender=0; raf=requestAnimationFrame(loop); }
  function stop(){ running=false; if(raf){ cancelAnimationFrame(raf); raf=0; } }
  // 모달 가림 = **루프 자체 정지**(운영자 260807 발열 · 평의회 8인 6번 조) — 구판은 draw만 건너뛰고 rAF 루프는 계속 돌아
  //   모달로 화면이 100% 가려진 동안에도 프레임 파이프라인이 주사율로 계속 깨어 있었다(실측 = 모달 중 drawArrays 0회인데 rAF 콜백 30초 598회 · 스타일 재계산 432→59회).
  //   판정은 open 속성 변이로만 갱신(attributeFilter = 그 속성이 바뀔 때만 콜백 = 유휴 비용 0) → 매 프레임 DOM 질의 소멸.
  //   재개 = 모달 닫히면 즉시(hidden·reduced-motion이면 각자 경로가 담당) · simTime은 정지 중 안 흐른다(구 동작 동일 = 복귀 시 물결 위상 연속).
  var modalOpen=false;
  function syncModal(){ var o=!!document.querySelector('dialog[open]'); if(o===modalOpen) return; modalOpen=o;
    if(o) stop(); else if(!isReduce() && !document.hidden) start(); }

  if(!WAVE_ON){ canvas.classList.add('off'); return; }                // 렉 스위치 OFF = 그래픽 컨텍스트도 안 만든다(.bgfx 워시만 · rAF·GPU 0)
  if(!initGL()) return;                                               // 폴백 확정(.off)
  new MutationObserver(syncModal).observe(document.documentElement,{subtree:true,attributes:true,attributeFilter:['open']});
  syncModal();                                                        // 초기 상태 반영 = 아래 start()보다 **먼저**(부팅 시 모달이 열려 있으면 start의 modalOpen 가드가 막는다)
  addEventListener('resize',function(){ sizeBuffer(false); });
  if(isReduce()) render(); else start();                             // reduced-motion = 정적 1프레임(rAF 루프 없음)
  document.addEventListener('visibilitychange',function(){ if(document.hidden) stop(); else if(!isReduce()) start(); });   // 백그라운드/화면꺼짐 정지
  reduceMq.addEventListener('change',function(){ if(isReduce()){ stop(); render(); } else start(); });   // 런타임 reduced-motion 토글 반영
  // WebGL 컨텍스트 로스트(모바일 GPU 리셋·백그라운드 복귀 등) → 즉시 .bgfx 워시 폴백, 복원되면 재빌드 후 재개(검은 배경 잔존 차단)
  canvas.addEventListener('webglcontextlost',function(e){ e.preventDefault(); lost=true; stop(); canvas.classList.add('off'); });
  canvas.addEventListener('webglcontextrestored',function(){ lost=false; prog=null; if(initGL()){ if(isReduce()) render(); else start(); } });
})();
