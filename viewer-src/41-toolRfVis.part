paintGenImgRow();
// ── 키워드 알림 — 국내(social·tbs)·해외(reddit·hn·bsky·xtrends) 커뮤니티에 등록 키워드가 뜨면 첫 1회 + 24h 동안 3h마다 토스트(운영자 요구).
//    설정 = 서버 SSOT(NM_SET.kwAlertOn·kwItems · settings/app.json). 발송 dedup = seen 'kw'축(slug#3h버킷 = 크로스기기 정확히 1회 · claimSeen 계승).
//    각 키워드 상태 = kwItems[i] { kw, ts(등록), hit(첫 매칭 epoch·0=미매칭), done(체크=중단) }. 매칭 = livePoll(60s) 훅 checkKwAlerts. 스케줄러 신설(기존 토스트는 1회성만).
const KW_BUCKET_MS = 3 * 3600000, KW_MAX_BUCKET = 8;   // 3시간 간격 · 24h = 8버킷(0=첫 발견 즉시, 1~8 = 3~24h) = "첫 1회 + 24h/3h"
function kwAlertOn() { return NM_SET.kwAlertOn === true; }
function kwGetItems() { return Array.isArray(NM_SET.kwItems) ? NM_SET.kwItems : []; }
function kwNorm(s) { return String(s || '').toLowerCase().replace(/\s+/g, ' ').trim(); }   // 매칭·비교 정규화(대소문자·공백 무시)
function kwSlug(s) { return kwNorm(s).replace(/[^a-z0-9가-힣]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60) || 'kw'; }   // seen id용 발송 dedup 키
// 토큰 분해 = `+` **와 띄어쓰기 둘 다 AND 구분자**(운영자 260729 "띄어쓴 키워드도 자동 커버되게").
//   구판은 공백을 문자 그대로 봐서 '그록 영상'이 "그록으로 영상 만들기"를 못 잡았다(연속 문자열 매칭) → 이제 '그록'·'영상' 각각 포함이면 매칭.
//   `+` 문법은 그대로 살아 있다(구 등록분 무회귀 · 'a+b b c' = a·b·c 4토큰 → 중복 제거).
function kwToks(kw) { return [...new Set(kwNorm(kw).split(/[+\s]+/).map(t => t.trim()).filter(Boolean))]; }
function kwFind(kw, docs) {   // 매칭된 '그 글'을 돌려준다(없으면 null) — 발견 URL을 남기려면 참/거짓이 아니라 문서가 필요
  const ts = kwToks(kw); if (!ts.length) return null;
  const ds = Array.isArray(docs) ? docs : [{ t: kwNorm(docs), u: '' }];
  for (const d of ds) { const tx = (d && typeof d === 'object') ? d.t : String(d || ''); if (ts.every(t => tx.includes(t))) return (d && typeof d === 'object') ? d : { t: tx, u: '' }; }
  return null;
}
function kwMatch(kw, docs) { return !!kwFind(kw, docs); }   // 불리언 래퍼(기존 호출부 호환)   // "A+B C" = *한 글 안에* A·B·C 전부(`+`·띄어쓰기 동급 AND) · 배열 = kwDocs() 글 단위(문자열도 허용 = 단일 문서 취급 · 하위호환)
function kwSaveItems(items) { return saveSettings({ kwItems: _kwClean(items) }); }
function paintKwRow() { const b = $('#kwAlertBtn'); if (!b) return; const on = kwAlertOn(); b.textContent = on ? 'ON' : 'OFF'; b.classList.toggle('on', on); paintKwGear(); }   /* OFF로 끄면 기어도 동반 소등 */
function openKwpop() {   // 대기열 열기 = 설정 팝업(linkpop) 자리에 촤르륵(placeHeadPop 프로필 앵커 · head-pop 미러)
  const kp = $('#kwpop'), prof = $('#profile'); if (!kp) return;
  closeOverlays('kwpop');   // linkpop 등 형제 오버레이 닫기
  kp.hidden = false;
  if (prof) placeHeadPop(kp, prof);
  renderKwList();
  kwAddBox(!kwGetItems().length);   // 비었으면 입력창까지 펼쳐 첫 등록 유도 · 이미 있으면 목록만(+ 로 열기)
}
function closeKwpop() { const kp = $('#kwpop'); if (kp) kp.hidden = true; kwAddBox(false); }   /* 닫으면 입력창도 접어 다음 열림이 항상 '목록만'에서 시작 */
// 키워드 입력창 = 헤더 + 로 여닫는다(운영자 260727 "x옆에 +가 있으면 될듯 — 키워드 입력창 뜨게").
//   show 미지정 = 토글. 열 때 포커스(바로 타이핑) · 접을 때 입력값도 비움(반쯤 쓴 값이 다음에 남지 않게).
function kwAddBox(show) {
  const box = $('#kwpop .kw-add'), inp = $('#kwIn'); if (!box) return;
  const next = (show === undefined) ? box.hidden : !!show;
  box.hidden = !next;
  const b = $('#kwAddOpen'); if (b) b.setAttribute('aria-expanded', next ? 'true' : 'false');
  if (next) { setTimeout(() => { try { inp.focus(); } catch (_) {} }, 40); }
  else if (inp) { inp.value = ''; kwEditCancel(); }   // 접으면 수정 모드도 해제(버튼 라벨 '추가' 복귀)
}
function kwStatusLabel(it) {   // 상태 셀 = 발견 / 미발견 2분류(운영자 260727 "키워드 나오고 우측에 발견 미발견") + 발견이면 그 아래 일시 한 줄(운영자 260801)
  if (!it.hit) return { t: '미발견', c: 'kws-wait', at: '' };
  return { t: '발견', c: it.done ? 'kws-done' : 'kws-hit', at: kwHitAt(it.hit) };   // 확인(done)해도 '발견'은 사실 = 라벨 유지·색만 무채로
}
function kwDate(ts) { const d = ts ? new Date(ts) : null; return d && !isNaN(d) ? (d.getMonth() + 1) + '. ' + d.getDate() + '.' : '-'; }   // 등록 시기 = "10. 28." 날짜 표기(운영자 260727 "7시간 전 > 10. 28. 이런식으로")
function kwHitAt(ts) {   // 발견 일시 = "(8.27. 13:00)"(운영자 260801 표기 지목 그대로) · 기준시 = 형제 kwDate와 동일(브라우저 로컬 = 운영자 기기 KST)
  const d = ts ? new Date(ts) : null; if (!d || isNaN(d)) return '';
  const p2 = n => String(n).padStart(2, '0');
  return '(' + (d.getMonth() + 1) + '.' + d.getDate() + '. ' + p2(d.getHours()) + ':' + p2(d.getMinutes()) + ')';
}
function renderKwList() {
  const list = $('#kwpopList'); if (!list) return;
  kwPurgeDone();   // 그릴 때마다 만료분 정리 → 목록이 스스로 갱신된다
  const items = kwGetItems();
  if (!items.length) { list.innerHTML = '<div class="qempty">등록된 키워드 없음</div>'; paintKwGear(); return; }   /* 안내 소문구 폐지(운영자 260727 "안내문구는 없어도되고" · 입력칸 placeholder도 동반 소등) */
  // 행 = no · 등록 시기 · 키워드 · 체크 · 휴지통(운영자 260727 지목 5열) — 셀 문법은 qRowHtml 정본 100% 미러
  //   (.qt = 시간 고정폭 64 + qAgo 사다리 · .qmain = 본문 · .qst = 고정폭 상태칸[여기선 체크] · .qact = 최우측 액션).
  //   구 상태 라벨(대기/발견/완료)은 운영자 지목 5열에 없어 소등 — '발견'은 기어 보라 점등 + 토스트가 담당(kwStatusLabel = 도먼트).
  list.innerHTML = items.map((it, i) => {
    const st = kwStatusLabel(it);
    // 최우측 액션 = 상태가 정한다(운영자 260727) — 발견·미확인 = 체크(확인) / 미발견·확인완료 = 휴지통(삭제).
    //   확인을 누르면 체크가 휴지통으로 바뀌고 키워드엔 빗금+무채(= 처리 끝난 줄이라는 표시).
    // 좌 칸(헤더 + 와 같은 세로선) = 미발견이면 수정(키워드 고치기) · 발견이면 이동(발견한 글로) — 발견 뒤엔 수정 불가(운영자 260727)
    const left = it.hit
      ? '<button class="pub-ico kw-go" type="button" title="발견한 글로 이동" aria-label="발견한 글로 이동">' + Q_ARR + '</button>'
      : '<button class="pub-ico kw-edit" type="button" title="키워드 수정" aria-label="키워드 수정">' + EDIT_SVG + '</button>';
    // 우 칸(헤더 X 와 같은 세로선) = 발견이면 **체크(껐다 켰다 토글)** · 미발견이면 휴지통(운영자 260727 최종).
    //   체크 ON = 키워드에 빗금 + 알림 중단 · 다시 누르면 빗금 풀리고 알림 재개 · 빗금인 채로 1일 넘기면 자동 삭제(kwPurgeDone).
    const act = it.hit
      ? '<label class="ed-match kw-chk" title="' + (it.done ? '확인 해제 — 알림 재개' : '확인 — 알림 중단(하루 뒤 자동 삭제)') + '"><input type="checkbox"' + (it.done ? ' checked' : '') + '><span class="ed-cbx">' + ACK_MORPH + '</span></label>'
      : '<button class="pub-ico pub-rm kw-del" type="button" title="삭제" aria-label="삭제">' + _TRASHSVG + '</button>';
    return '<div class="qrow kwrow' + (it.done ? ' kw-done' : '') + (it.moved ? ' kw-moved' : '') + '" data-i="' + i + '"' + (it.moved ? ' title="눌러서 발견 재가동 — 이 키워드를 다시 감시한다"' : '') + '>'
      + '<span class="qno">' + (i + 1) + '</span>'
      + '<span class="qt">' + qEsc(kwDate(it.ts)) + '</span>'
      + '<span class="qmain" title="' + qEsc(it.kw) + '">' + qEsc(it.kw) + '</span>'
      + '<span class="qst kwst ' + st.c + '"><span class="kws-t">' + st.t + '</span>' + (st.at ? '<em class="kws-at">' + qEsc(st.at) + '</em>' : '') + '</span>'
      + '<span class="qact kw-a1">' + left + '</span>'
      + '<span class="qact">' + act + '</span></div>';
  }).join('');
  list.querySelectorAll('.kw-chk input').forEach(cb => cb.onchange = (e) => { e.stopPropagation(); const i = +cb.closest('.kwrow').dataset.i; kwSetDone(i, cb.checked); });   /* 체크 = 껐다 켰다 토글(운영자 260727 최종) */
  list.querySelectorAll('.kw-del').forEach(b => b.onclick = (e) => { e.stopPropagation(); const row = b.closest('.qrow'), i = +row.dataset.i; animateRowOut(row, () => kwRemove(i)); });
  list.querySelectorAll('.kw-go').forEach(b => b.onclick = (e) => { e.stopPropagation(); kwOpenSrc(kwGetItems()[+b.closest('.kwrow').dataset.i]); });   /* 이동 = 발견한 글(대기열에서도 이동 가능 · 운영자 260727 "키워드 알림창에서 이동하는 방법이 없더라고") */
  list.querySelectorAll('.kw-edit').forEach(b => b.onclick = (e) => { e.stopPropagation(); kwEdit(+b.closest('.kwrow').dataset.i); });   /* 수정 = 미발견 항목만(발견 뒤엔 이동 버튼이 그 자리) */
  list.querySelectorAll('.kwrow.kw-moved').forEach(row => row.onclick = (e) => { if (e.target.closest('button, label, input')) return; e.stopPropagation(); kwRearm(+row.dataset.i); });   /* 밑줄 줄 클릭 = 발견 재가동(운영자 260801) · 행 안 액션(이동·체크·삭제)은 자기 일 그대로 = 제외 */
  paintKwGear();   // 목록이 그려질 때마다 기어 점등 재평가(체크·삭제 직후 반영)
}
function kwAdd(raw) {
  const kw = String(raw || '').trim().slice(0, 120); if (!kw) return false;
  const items = kwGetItems().slice();
  const inp = $('#kwIn');
  if (_kwEditIdx >= 0 && items[_kwEditIdx]) {   // 수정 모드 = 그 자리 덮어쓰기(등록 시기 유지 · 문구가 바뀌었으니 발견 이력은 초기화)
    const i = _kwEditIdx; kwEditCancel();
    if (items.some((it, j) => j !== i && kwNorm(it.kw) === kwNorm(kw))) { if (inp) inp.value = ''; return false; }   // 다른 행과 중복이면 무시
    items[i] = { ...items[i], kw, hit: 0, done: false, url: '' };
    kwSaveItems(items); renderKwList(); if (inp) inp.value = '';
    kwAddBox(false); checkKwAlerts(); return true;
  }
  if (items.some(it => kwNorm(it.kw) === kwNorm(kw))) { if (inp) inp.value = ''; return false; }   // 중복 무시
  if (items.length >= KW_CAP) return false;
  items.push({ id: crypto.randomUUID(), kw, ts: Date.now(), hit: 0, done: false });
  kwSaveItems(items); renderKwList();
  if (inp) inp.value = '';
  kwAddBox(false);   // 등록 완료 = 입력창 접기(목록이 바로 보이게 · 연속 등록은 + 재클릭)
  checkKwAlerts();   // 등록 즉시 1회 매칭 검사(오늘 이미 떠 있으면 바로 알림)
  return true;
}
// 키워드 수정 = 새 입력 UI를 만들지 않는다 — 헤더 + 로 여는 그 입력창을 그대로 재사용(값 채우고 포커스),
//   저장하면 그 자리(인덱스)에 덮어쓴다. 등록과 수정이 같은 칸을 쓰므로 학습 비용 0(운영자 260727 "수정 버튼(키워드를 수정할 수 있음)").
let _kwEditIdx = -1;
function kwEdit(i) {
  const items = kwGetItems(); if (!items[i]) return;
  _kwEditIdx = i;
  kwAddBox(true);
  const inp = $('#kwIn'); if (inp) { inp.value = items[i].kw; setTimeout(() => { try { inp.focus(); inp.select(); } catch (_) {} }, 50); }
  const b = $('#kwAddBtn'); if (b) b.textContent = '수정';
}
function kwEditCancel() { _kwEditIdx = -1; const b = $('#kwAddBtn'); if (b) b.textContent = '추가'; }
function kwRemove(i) { const items = kwGetItems().slice(); if (i < 0 || i >= items.length) return; items.splice(i, 1); kwSaveItems(items); renderKwList(); paintKwGear(); }
// 이동(↗)을 누른 그 시점 = '이 건은 봤다' 처리(운영자 260801 "이동버튼을 누르면 그 시점부터 그 키워드 라인에 모두 밑줄").
//   밑줄 = 알림 중단(반복 토스트·기기 알림·서버 웹푸시 전부 정지) · 삭제는 안 한다(체크=done의 24h 자동삭제와 다른 축).
//   되돌리기 = 그 줄을 다시 눌러 재가동(kwRearm) — 운영자 지시 5번의 짝.
function kwMarkMoved(it) {
  const items = kwGetItems().slice();
  const i = items.findIndex(x => x && kwNorm(x.kw) === kwNorm(it && it.kw));
  if (i < 0 || items[i].moved) return;
  items[i] = { ...items[i], moved: Date.now() };
  kwSaveItems(items);
  if (!$('#kwpop').hidden) renderKwList();
  paintKwGear();
}
// 밑줄 줄 클릭 = **발견 재가동**(운영자 260801 "밑줄 사용자가 누르면 다시 발견 재가동") — 발견 이력·URL을 비워 '미발견'으로 되돌리고 감시 재개.
//   rearm = 재가동 시각 = **발송 세대 도장**: 뷰어 dedup(claimSeen 'kw' id)과 서버 원장(push/kw_sent.json)이 이 값으로 세대를 갈라
//   같은 키워드가 다시 떠도 알림이 '이미 보냈다'로 삼켜지지 않는다(구판 id = slug#버킷 뿐이라 재가동해도 영구 침묵이었다).
function kwRearm(i) {
  const items = kwGetItems().slice(); if (!items[i] || !items[i].moved) return;
  items[i] = { ...items[i], hit: 0, url: '', moved: 0, done: false, doneAt: 0, rearm: Date.now() };
  kwSaveItems(items); renderKwList(); paintKwGear();
  checkKwAlerts();   // 재가동 즉시 1회 재검사(kwAdd 문법 계승) — 아직 원문에 떠 있으면 바로 다시 '발견'
}
function kwSetDone(i, done) { const items = kwGetItems().slice(); if (!items[i]) return; items[i] = { ...items[i], done: !!done, doneAt: done ? Date.now() : 0 }; kwSaveItems(items); renderKwList(); paintKwGear(); }   /* 대기열 체크 = 기어 소등의 유일 경로 · doneAt = 자동 삭제 기산점(운영자 260727) */
// 빗금(확인) 상태로 하루를 넘긴 항목은 스스로 사라진다(운영자 260727 "빗금 1일 유지된건 자동으로 삭제되고 리스트 갱신").
//   기산 = doneAt(체크한 시각) · 구 데이터(doneAt 없음)는 hit 시각으로 폴백해 영구 잔존을 막는다. 반환 = 실제로 지웠는지(호출부 재렌더 판단).
const KW_DONE_TTL = 24 * 3600000;
function kwPurgeDone() {
  const items = kwGetItems(), now = Date.now();
  const keep = items.filter(it => !(it && it.done && (now - (it.doneAt || it.hit || 0)) > KW_DONE_TTL));
  if (keep.length === items.length) return false;
  kwSaveItems(keep); return true;
}
// 기어 점등 = '미확인 발견'(hit 있고 done 아님)이 하나라도 있으면 ON — 소등 조건 = 대기열 체크(done)뿐(운영자 260727).
//   body 클래스 토글 = has-freshbad/has-sysbad(수집 고장) 관용구 그대로 계승 = 새 표시물 0.
function paintKwGear() {
  try { document.body.classList.toggle('has-kwhit', kwAlertOn() && kwGetItems().some(it => it && it.hit && !it.done && !it.moved)); } catch {}   /* 이동으로 처리한 줄(moved)도 소등 축에 편입(260801) — 봤다는 뜻이라 기어를 계속 켜둘 이유가 없다 */
}
function kwMarkDoneByKw(kw) { const items = kwGetItems().slice(); const i = items.findIndex(it => kwNorm(it.kw) === kwNorm(kw)); if (i < 0) return; items[i] = { ...items[i], done: true }; kwSaveItems(items); if (!$('#kwpop').hidden) renderKwList(); }
// 국내 커뮤니티 전반(tbs_data = 21개 커뮤니티 베스트글 제목 ≈630) — 프론트 미로드라 키워드 매칭용으로만 별도 fetch(4분 캐시)
let KW_TBS = [], _kwTbsAt = 0;
async function loadTbsKw() {
  if (KW_TBS.length && Date.now() - _kwTbsAt < 4 * 60000) return;
  // 소스 순서 = api/trends?f=tbs(GitHub 직독·빌드 우회) → 정적 폴백(loadTrends 문법 동축 · 260803 3차).
  //   ⚠️ 필수인 이유 = Q1331 [CF-Pages-Skip] 코얼레싱이 sns-trends 커밋의 Pages 빌드를 건너뛰므로, 정적 tbs_data.json은 무관한 다른 커밋이
  //   빌드를 물 때까지 갱신되지 않는다 → **키워드 알림 국내 커뮤니티 감시가 조용히 멈춘다**(같은 축의 260720~26 6일 공백 사고 재발 경로).
  for (const u of ['api/trends?f=tbs', 'tbs_data.json?_=' + Date.now()]) {
    try {
      const r = await fetch(u); if (!r.ok) continue;
      const tx = await r.text(); if (/^\s*</.test(tx)) continue;   // SPA 폴백(HTML 200) 가드
      const d = JSON.parse(tx); if (!d || !d.updated || !Array.isArray(d.communities)) continue;   // **형상까지** 검사(260803 평의회 심층방어) — updated만 보면 엉뚱한 파일(sns_trends.json도 updated 보유)이 통과해 빈 코퍼스를 확정하고 정적 폴백까지 건너뛴다(candidates.js `&& d.length` 교훈의 정확한 미러)
      const out = []; (d.communities || []).forEach(c => (c.posts || []).forEach(p => { if (p && p.title) out.push({ t: p.title, u: p.url || '' }); }));
      KW_TBS = out; _kwTbsAt = Date.now(); break;
    } catch { /* 다음 소스 */ }
  }   /* 제목만 → {제목,URL} = 발견 출처 이동용 */
}
// 매칭 대상 = 국내(SOCIAL 집계 제목+소스, tbs 커뮤 글 제목) + 해외(reddit·hackernews·bsky·bsky_trends·xtrends)
// ⚠ 260726 교정 — 구판은 전 소스를 *한 덩어리 문자열*로 합쳐 AND를 검사해서, "A"가 더쿠 글에 "B"가 HN 글에 있으면
//    같은 글이 아닌데도 매칭됐다(오탐 구조). 이제 **글 1건 = 배열 1칸**으로 두고 "한 글이 전 토큰을 다 품을 때"만 매칭.
// 문서 = { t: 정규화 텍스트, u: 원문 URL } — u가 있어야 '발견한 곳으로 이동'(운영자 260727)이 성립한다.
//   URL 필드는 소스마다 이름이 다르다(tbs/social/hn/bsky = url · bsky_trends = link · xtrends = 없음[검색 표면뿐]).
