  paintGenImgTg();
}
const _genImgOnBtn = $('#genImgOnBtn');
_genImgOnBtn && _genImgOnBtn.addEventListener('click', async (e) => {   // 설정 토글 = PIN 1회 인증 후 전역 디폴트 전환(요구3 · lockOnBtn 패턴 계승)
  e.stopPropagation();                          // 링크 메뉴 유지(문서클릭 닫힘 차단 · lockOnBtn 계승)
  if ($('#pindlg').open) return;                // 재진입 가드(더블클릭 좀비 await · lockOnBtn 계승)
  const ok = await lkVerifyOldPin();            // AI 썸네일 on/off = 잠금 PIN 1회 인증(요구3 · #pindlg·5회잠금·마스터 공유 · PIN 미설정 = 통과)
  if (!ok) return;
