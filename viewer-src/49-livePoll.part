function livePoll() {
  if (document.visibilityState !== 'visible') return;   // 안 보이면 폴 안 함(배터리·쿼터)
  if (isComposingModalOpen()) return;   // ⚠️ 작성 모달 열림 = 배경 재렌더 보류(backdrop-filter 깜빡임 방지 · 닫으면 다음 틱 따라잡음 · 260627)
  const y = window.scrollY;
  load().finally(() => { if (!$('#dlg').open && y > 80 && window.scrollY < y - 40) window.scrollTo(0, y); if (!qpop.hidden) renderQueuePage(); });   // 재렌더가 위로 튕기면 보던 위치 복원 + 대기열 열려있으면 새 DATA 반영 재렌더(succ가 피드에 뜨면 주황→초록 라이브 전환·운영자 260622)
  loadCandidates(true); loadPickFails(); loadMessages(); loadPending(); loadHealth(); loadToastSeen(); loadMergesSrv(); loadTrends();   // loadPending = 대기열 배지 · loadHealth = 맞춤법 건강 · loadTrends = 수집 고장 알림(health.subs.stale → 알림메세지·기어색 · 260725 — 내부 5분 TTL 가드라 폴 1분 주기와 무관하게 5분에 1회) · loadToastSeen = 계정 seen(타 기기 처리분 동기 · 운영자 260712) · loadMergesSrv = 계정 병합(260717)
  try { checkKwAlerts(); } catch {}   // 키워드 알림 = 커뮤니티에 등록 키워드 뜨면 첫1회+24h/3h 토스트(내부 가드 = kwAlertOn·미완료 항목 있을 때만 데이터 로드·매칭)
}
setInterval(livePoll, 60000);   // 1분 자동 갱신
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible') { try { if (CURTAB === 'scrap') loadCandidates(false); else if (CURTAB === 'trend') loadSocial(); } catch {} }   // 복귀 = 보이는 탭 1회 강제 재렌더(분신2 C안 260706) · ⚠️ livePoll보다 먼저 — 같은 틱에 livePoll의 quiet 폴(loadCandidates(true))이 SCRAP_LOADING을 동기 선점하면 이 비-quiet 재렌더가 재진입 가드에 드롭돼 통째 무효(QA7 260706)
  livePoll();
});   // 탭 복귀 시 즉시 갱신
window.addEventListener('pageshow', e => { if (e.persisted) { try { if (CURTAB === 'scrap') loadCandidates(false); else if (CURTAB === 'trend') loadSocial(); } catch {} livePoll(); } });   // bfcache 복원(뒤로가기) = visibilitychange 미발화 엣지에도 명시 재요청(분신2 A안·분신10 톱1 260706) · 재렌더 선행 = 위와 동일 사유(QA7)
setViewhead('feed');   // 기본 탭=뉴스요약 헤더 초기화
try { var _qs=new URLSearchParams(location.search); if(_qs.get('qa')==='1'){ try{ document.documentElement.classList.remove('boot-lock'); }catch(e){} var _applyHash=function(){ var h=(location.hash||'').replace(/^#/,'').trim().toLowerCase(); var al={feed:'feed',news:'feed','뉴스':'feed',scrap:'scrap',legacy:'scrap','레거시':'scrap',trend:'trend',sns:'trend',social:'trend','트렌드':'trend',chan:'chan',channel:'chan','채널':'chan'}; var t=al[h]; if(!t) return; var n=0; (function go(){ var b=document.querySelector('.bnav-i[data-tab="'+t+'"]'); if(b){ try{b.click();}catch(e){} return; } if(n++<40) setTimeout(go,100); })(); }; window.addEventListener('hashchange',_applyHash); setTimeout(_applyHash,500); } } catch(e){}   // [QA] ?qa=1 = 부트락 해제 + #feed|scrap|trend|chan 전 섹션 딥링크(운영자 260725 승인 · [E1] 실브라우저 현물 확인용)
try { let _tq = null; try { _tq = (new URLSearchParams(location.search).get('tab') || '').trim().toLowerCase(); } catch {} if (_tq === 'sns' || _tq === 'social') _tq = 'trend'; const _lt0 = localStorage.getItem('nomute_tab'), _lt = _lt0 === 'sns' ? 'trend' : _lt0; const _tgt = ['feed', 'scrap', 'trend', 'chan'].includes(_tq) ? _tq : (['feed', 'scrap', 'trend', 'chan'].includes(_lt) ? _lt : 'scrap'); showTab(_tgt); } catch { try { showTab('scrap'); } catch {} }   /* ?tab= 딥링크가 마지막 탭 복원을 이긴다(운영자 260819 "랜딩이 채널 요약으로 감") — 알림이 가리킨 화면이 보던 탭에 덮이면 딥링크가 있으나 마나다. 구판 #trend 해시는 ?qa=1 안에만 배선돼(18306행) 일반 진입에선 무동작이었고, 그래서 push가 준 목적지가 통째로 무시된 채 nomute_tab(마지막 = 채널 요약)으로 갔다. 쿼리 축 = 이 파일 딥링크 정본 문법(?a=·?brk=·?msg=·?vidl=) 계승 · 서비스워커 navigate도 search가 달라야 실제 재로드가 돈다(sw.js 166행 = pathname+search+hash 일치 시 focus만) */   // 새로고침 = 보던 탭 그대로 복원(feed·scrap·sns·trend 전부) · 저장 없으면 기본 홈=수집함(운영자 260623)
try { if (CURTAB !== 'trend') loadTrends(); } catch {}   // 실검 티커 부팅 킥(운영자 260730 "4개 메뉴 전부") — 티커 소스 = TRENDS인데 loadTrends는 trend 탭 진입(showTab 11167)·livePoll(60s 주기)에서만 돌아 첫 진입이 feed·scrap·chan이면 최대 60초간 빈 띠였다. trend 탭 = showTab이 이미 호출 = 중복 fetch 회피(loadTrends 5분 TTL은 성공 후 스탬프라 동시 2발은 안 막힘) · 비용 = json 1회(livePoll이 어차피 매분 호출하는 같은 파일)

// ── 당겨서 새로고침(커스텀 링) — 네이티브 끄고 현재 탭색 링을 직접 그림. '원'만 메뉴색 = 주소창/상태바 불변(운영자 260623). 새로고침은 hardReload()(SW 셸 캐시 우회 = 최신 셸 즉시 · 운영자 260713) = 탭은 localStorage로 복원(현재 페이지 유지).
(function () {
  if (!('ontouchstart' in window)) return;            // 터치 기기 전용(데스크탑은 네이티브 새로고침/바운스 보존)
  document.documentElement.classList.add('ptr-on');   // CSS 네이티브차단(html.ptr-on)을 JS와 동일 게이트로 묶음 — 비대칭 제거(분신술10)
  const ptr = document.createElement('div'); ptr.id = 'ptr'; ptr.setAttribute('aria-hidden', 'true'); ptr.innerHTML = '<div class="ptr-ring"></div>';
  document.body.appendChild(ptr);
  const ring = ptr.querySelector('.ptr-ring');
  const TRIG = 70, MAXP = 130;                         // 발동 임계 · 최대 당김(px)
  let sy = 0, sx = 0, active = false, engaged = false, dist = 0, armed = false, firing = false;
  const atTop = () => (window.scrollY || document.documentElement.scrollTop || 0) <= 0;
  // 비활성 조건: 발동중 · <dialog> 열림 · 비-dialog 팝업(hidden 토글) 열림(상단 앵커 pmenu·msgpop 위 오발동 차단 — 분신술3·10 + 재검증2)
  // ⚠️ 열림판정 = `el && !el.hidden` (존재 && 안숨김) — 참조 팝업이 후에 폐지돼 el=null이어도 throw 대신 '안 열림'으로 처리(제스처 생존). 옛 `!el.hidden`은 filterpop 폐지(260710) 후 undefined.hidden 예외로 PTR 전멸시킴(운영자 260713 "위 잡아당겨도 새로고침 안 됨" 원인) → 방어형 전환.
  const open = el => !!el && !el.hidden;
  const fmOpen = () => open(document.getElementById('failmenu'));
  const blocked = () => firing || !!document.querySelector('dialog[open]') ||
    open(pmenu) || open(msgpop) || open(bpop) || open(linkpop) || open(qpop) || fmOpen() ||
    // 필터 = 설정>필터 아코디언(#filterSub)으로 이관(260710) → linkpop 안에 종속 = open(linkpop)이 이미 커버(구 filterpop 팝업 폐지 = 참조 삭제)
    open(sovl);   // blocked() ⊇ closeOverlays 관리셋 = 갭 0(재검증·최종검증) · 검색 = 중앙 오버레이 열림으로 판정(260706 5차)
  function reset(soft) {
    active = false; engaged = false; dist = 0; armed = false;
    ptr.style.transition = soft ? 'transform .24s var(--ease), opacity .24s var(--ease)' : 'none';
    ptr.classList.remove('show', 'spin', 'armed');
    ptr.style.transform = 'translate(-50%,-54px) scale(.9)'; ring.style.transform = ''; ptr.style.willChange = 'auto';
  }
  addEventListener('touchstart', e => {
    if (active || blocked() || !atTop() || e.touches.length !== 1) return;
    sy = e.touches[0].clientY; sx = e.touches[0].clientX; active = true; engaged = false; dist = 0; armed = false;
    ptr.style.transition = 'none'; ptr.style.willChange = 'transform, opacity';   // 제스처 중에만 합성 레이어 승격 (링 색 = CSS서 --accent 직결 · 구 탭별 --ptr-c/--ptr-rgb setProperty 폐지 260714)
  }, { passive: true });
  addEventListener('touchmove', e => {
    if (!active) return;
    if (e.touches.length !== 1) { reset(true); return; }                        // 둘째 손가락(핀치) = 양보(이중점화 차단 — 분신술1)
    const dy = e.touches[0].clientY - sy, dx = e.touches[0].clientX - sx;
    if (!engaged) {
      if (dy > 8 && dy > Math.abs(dx) * 1.3 && atTop()) engaged = true;        // 세로 당김 우세 + 최상단일 때만 점화
      else if (Math.abs(dx) > 10 || dy < -6 || !atTop()) { active = false; ptr.style.willChange = 'auto'; return; }   // 가로 스와이프(캐러셀)·위 스크롤 = 양보(레이어 즉시 회수)
      else return;
    }
    if (!atTop()) { reset(true); return; }
    e.preventDefault();                                                         // 우리가 처리(네이티브 제스처 없음)
    dist = Math.min(dy, MAXP);
    const pull = Math.min(dist * 0.62, 80);                                     // 고무줄 저항감
    ptr.classList.add('show');
    ptr.style.transform = `translate(-50%, ${pull}px) scale(${0.9 + Math.min(dist / TRIG, 1) * 0.1})`;
    ring.style.transform = `rotate(${dist * 2.6}deg)`;                          // 당길수록 화살표 회전(피드백)
    armed = dist >= TRIG; ptr.classList.toggle('armed', armed);
  }, { passive: false });
  function end() {
    if (!engaged) { if (active) reset(false); return; }
    if (armed) {
      firing = true; active = false; engaged = false;
      ptr.style.transition = 'transform .2s var(--ease)';
      ptr.style.transform = 'translate(-50%, 42px) scale(1)'; ring.style.transform = '';
      ptr.classList.add('spin');
      setTimeout(hardReload, 360);                                             // 강제 새로고침(SW 셸 캐시 우회 = 최신 셸 즉시 · §파이프라인 5-a) — 탭은 복원 로직이 유지
    } else reset(true);
  }
  addEventListener('touchend', end, { passive: true });
  addEventListener('touchcancel', () => { if (!firing) reset(true); }, { passive: true });
  // bfcache 복귀(뒤로가기 등)면 firing/spin 잔존 상태 해제 — 영구 먹통 방지(분신술1·3·7·10)
  addEventListener('pageshow', e => { if (e.persisted) { firing = false; reset(false); } });
})();

// ── 픽셀 펫(게) — 운영자 260710(업로드 캐릭터 영상 → 아틀라스): 가끔 좌하단에 페이드인 → 60fps 배회 → 페이드아웃. CSS #petcrab 주석 = 설계 정본. ──
(() => {
  const PETCRAB_ON = false;   // 하단 픽셀 펫 = 보관(도먼트) — 운영자 요청 미출현 · 로직·자산·아틀라스 전부 보존 · 되살리기 = true 한 글자
  if (!PETCRAB_ON) return;
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;   // 장식 = 접근성 우선 미출현
  const PET = { tw: 132, th: 120, frames: 111, cols: 10, rows: 12, fps: 30, scale: 0.75 };   // 아틀라스 지오메트리 단일출처(빌드 스크립트 산출값 · 260817 2차에 82→111칸·9→12행으로 자랐다 = 뒤 29칸 퇴장 마무리 동작). ⚠ 이 도먼트는 82칸 시절 순서를 그대로 돌린다 = 되살릴 땐 그 29칸이 배회 루프에 섞인다(부품 nm-pet.js 는 exitFrames 로 분리해 쓴다)
  const W = PET.tw * PET.scale, H = PET.th * PET.scale;
  let el = null, visiting = false;
  const rand = (a, b) => a + Math.random() * (b - a);
  const ensure = () => {
    if (el) return el;
    el = document.createElement('div');
    el.id = 'petcrab'; el.setAttribute('aria-hidden', 'true');
    el.style.width = W + 'px'; el.style.height = H + 'px';
    el.style.backgroundSize = (PET.cols * W) + 'px ' + (PET.rows * H) + 'px';
    document.body.appendChild(el);
    return el;
  };
  function visit() {
    if (visiting || document.hidden) { schedule(); return; }
    visiting = true;
    const p = ensure(), t0 = performance.now(), stay = rand(14000, 26000);
    let x = rand(8, Math.max(40, innerWidth * 0.3)), dir = Math.random() < 0.5 ? -1 : 1,
      speed = rand(16, 30) / 1000, pauseUntil = 0, last = t0;   // px/ms — 종종 멈춰 서성(펫 느낌)
    p.style.opacity = '0'; p.classList.add('on');
    requestAnimationFrame(() => { p.style.opacity = '1'; });   // 페이드인(transition = CSS --ease)
    const step = now => {
      const dt = Math.min(64, now - last); last = now;
      const f = Math.floor((now - t0) / (1000 / PET.fps)) % PET.frames;   // 아트 = 원본 30fps 스텝(픽셀 보간 금지)
      p.style.backgroundPosition = (-(f % PET.cols) * W) + 'px ' + (-Math.floor(f / PET.cols) * H) + 'px';
      if (now >= pauseUntil) {   // 배회 = 60fps rAF 이동 · 좌측 절반대만(우측 = 메뉴4 영역 침범 X)
        x += dir * speed * dt;
        const max = Math.max(60, innerWidth * 0.55 - W);
        if (x < 4) { x = 4; dir = 1; } else if (x > max) { x = max; dir = -1; }
        else if (Math.random() < 0.0025) dir = -dir;
        if (Math.random() < 0.002) pauseUntil = now + rand(900, 2600);
      }
      p.style.transform = 'translateX(' + x + 'px) scaleX(' + dir + ')';
      if (now - t0 < stay && !document.hidden) { requestAnimationFrame(step); return; }
      p.style.opacity = '0';   // 페이드아웃 → 다음 방문 예약
      setTimeout(() => { p.classList.remove('on'); visiting = false; schedule(); }, 750);
    };
    requestAnimationFrame(step);
  }
  const schedule = () => setTimeout(visit, rand(90000, 240000));   // 종종 = 1.5~4분 간격 랜덤
  setTimeout(visit, rand(12000, 35000));   // 첫 등장 = 부팅 12~35초 뒤
})();

