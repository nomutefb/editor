    if (done) {   // 완료분 = 보관함 편입(창을 닫아도 다시 받을 수 있게 · 운영자 260802)
      v.st = 'done'; v.sec = Math.max(1, Math.round((Date.now() - v.t0) / 1000));   // 필요 시간 실측(운영자 260802) — 보관함 기록 + nmEta 학습 원료
      try { if (window.nmEta) nmEta.done(_dgEtaKey(v), v.sec); } catch {}   // 성공 완료 지점에서만 학습(nmEta 계약) · 키 = 모드×플랫폼
