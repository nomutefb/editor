      });
      const parts = g.slice(0, 2).map(x => x.lab + (x.n > 1 ? ' ' + x.n + '장' : ''));   // 상한 2종 = 폰 430 `.dg-imeta`(264px·nowrap) 실측(4종 78px·3종 13px 초과 · 2종 = 0) — 같은 치수는 위에서 이미 묶이므로 캐러셀 정상 케이스는 상한에 안 닿는다
      // 구판은 여기에 한정어 「원본」을 달았다(평의회1 G5) — 서버가 준 값이 **업로더 원본 치수**지 받을 파일이
      //   아니었기 때문이다. 260806 실다운로드가 그 간극을 숫자로 잡았다(스레드 original 1080×1140 → 받은 파일 720×760 ·
      //   X 사진 original_info 1206×1722 → 받은 파일 840×1199). 그래서 **원천을 받을 파일 축으로 옮겼다**
      //   (스레드 = 실물 재생 스트림 실측 · X 사진 = ?name=orig로 원본을 실제로 받게 · X 영상 = 고른 변형 주소의 치수) →
      //   이제 이 값은 액자 ⬇/전체 다운로드가 저장하는 **그 파일의 치수**다 = 한정어가 필요 없다(붙이면 도리어 거짓).
      itemsLine = '<div class="dg-imeta">항목 ' + its.length + ' — ' + esc(parts.join(' · ') + (g.length > 2 ? ' 외 ' + (g.length - 2) + '종' : '')) + '</div>';
    } else {
      const nv = its.filter(it => it.kind === 'video').length, ni = its.filter(it => it.kind === 'img').length, no = its.length - nv - ni;
      itemsLine = '<div class="dg-imeta">항목 ' + its.length + ' — ' + esc([nv ? '영상 ' + nv : '', ni ? '사진 ' + ni : '', no ? '기타 ' + no : ''].filter(Boolean).join(' · ')) + '</div>';
    }
  }
  // 받기 전 **실물 미리보기**(운영자 260805 5차 "ㄱㄱ") — 항목마다 액자 하나.
  //   레퍼런스 = **같은 창의 페이지 스캔 사진 카드**(.dg-grid > .dg-card + .dg-meta 치수 플레이트) 그대로 = 새 부품 0.
  //   영상 = <video controls>(그 자리에서 재생 = 내용 확인) · 사진 = <img> · 주소는 서버가 메타 CDN만 통과시킨 값.
  //   ⚠ 서명 만료가 있는 주소라 저장하지 않고 그 순간만 쓴다(플러그인 「주소 캐싱 금지」와 같은 축).
  let mediaGrid = '';
  if (p && Array.isArray(p.items) && p.items.some(it => it && it.u)) {
    const _shown = p.items.filter(it => it && it.u).slice(0, 12), _n = _shown.length;
    mediaGrid = '<div class="dg-grid dg-g2">' + _shown.map((it, k) => '<div class="dg-card" id="dgpc' + k + '">'
      + (it.kind === 'video'
        ? '<video src="' + escUrl(it.u) + '" playsinline loop preload="metadata" referrerpolicy="no-referrer"></video>'
          + '<button type="button" class="monplay" aria-label="재생 — 탭=재생/일시정지"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>'   // 무컨트롤 + 탭 재생 = vd.html 정본 문법 그대로(네이티브 컨트롤 ⋮ 소멸 · 운영자 260803)
        : '<img src="' + escUrl(_dgImgSrc(it.u)) + '" alt="" loading="lazy" referrerpolicy="no-referrer">')   // 메타 CDN 사진은 프록시 경유(_dgImgSrc) — 직접 로드는 핫링크 차단으로 검은 칸이 된다(운영자 260805 8차 인스타 실측)
      // 종류를 **글자로** 못박는다(운영자 260805 7차 "썸네일로 나오면 사진인지 영상인지 판별이 어려울거야 · 섞여있을 경우") —
      //   부품 = 스캔 카드 치수 플레이트(.dg-meta) 그대로, 정본이 원래 2줄(span{display:block})이라 [종류]/[치수] 한 벌로 들어간다.
      + '<span class="dg-meta dg-idx" aria-hidden="true"><span>' + (k + 1) + '/' + _n + '</span></span>'   // 번호표(운영자 260805 8차 "좌상단에 1/6 이런식으로")
      // 치수는 **화면에 뜬 실물에서 재서** 채운다(아래 배선) — 서버가 못 주는 플랫폼(인스타 임베드 = 폭만)도
      //   같은 문법으로 통일된다(운영자 260805 8차 "사진의 경우 픽셀이 없는 경우가 있네 · 통일해줘").
      + '<span class="dg-meta" aria-hidden="true"><span>' + (it.kind === 'video' ? '영상' : '사진') + ((it.w && it.h) ? ' | ' + it.w.toLocaleString('ko-KR') + '×' + it.h.toLocaleString('ko-KR') : '') + '</span></span>'
      + _dgDlBtnHtml('pkget', k, 'dg-dl')   // 카드 위 개별 ⬇ = **같은 창 스캔 사진 카드와 동일 부품**(.dg-card .dg-dl) · 자리만 우상단(CII 정본) = 새 부품 0(운영자 260805 7차 "각각의 다운로드 버튼")
      + '</div>').join('') + '</div>';
  }
  return '<div class="geni-sechead"><span class="cref-lbl">받을 내용</span></div>'
    + '<div class="dg-item">'
    + ((p && p.thumb) ? '<span class="dg-ithumb"><img src="' + escUrl(p.thumb) + '" alt="" loading="lazy" referrerpolicy="no-referrer"></span>' : '')
    + '<div class="dg-imain"><div class="dg-ittl">' + esc(ttl) + '</div>'
    + '<div class="dg-imeta">' + esc(_dgVidPlatName(plat)) + ((p && p.author) ? ' · ' + esc(p.author) : '') + (noVid ? ' · 사진만' : ' · 영상만 · ' + (plat === 'TH' ? '최고 화질' : (_dgQEff()[0] === 'best' ? '최고 화질' : '최대 ' + esc(_dgQEff()[1])))) + '</div>' + itemsLine + '</div>'   // 기본이 무엇인지 말로 못박는다(운영자 260803 "주로 필요한건 영상임 어짜피") + 화질 리드백 동반(260804) — 「최대」 = 선택값은 상한이지 영상 사양이 아니다(운영자 260805 · 실물 화질은 받기 완료 시 실측으로 표기) · 스레드 = 「최고 화질」(260805 2차 — 상한 축 자체가 비적용)
    // 화질 선택자 = **이 행 다운로드 버튼 바로 왼쪽**(운영자 260805 12차 캡처 지목 — 링크 행은 주소 받는 자리라 무관).
    //   부품·동작·라벨 = 종전 워드칩 그대로 · 표시 조건 = 영상 축이 있을 때만(스레드 고정·사진만 글은 미노출).
    + ((plat === 'TH' || noVid) ? '' : '<button type="button" class="geni-opt" data-act="vidq" title="화질 — 눌러서 고르기(4K=2160p · 2K=1440p · K=1080p · 이 영상에 있는 것만 나와)" aria-label="화질 ' + esc(_dgQEff()[1]) + ' — 눌러서 고르기" aria-haspopup="listbox">' + esc(_dgQEff()[1]) + '</button>')
    // 이 자리 = 구 [영상+자막] 워드칩 → **전체 다운로드**(운영자 260805 7차 "영상+자막 있는 곳에 전체 다운로드 버튼(모두 다운)" ·
    //   "자막은 앞으로 안 받을게"). 부품 = 이미지 스튜디오 전체저장 정본 그대로(.sbtn.cref-dlall.dlbtn 골드레몬 + DLSEQ_IC + '전체')
    //   = 이 창 잡 카드 [전체]와 **같은 함수**(_dgAllBtnHtml) · 새 부품·새 색 0. 미리보기 항목이 없으면 안 그린다(빈 어포던스 0).
    // 받기는 **전부 이 판에서**(운영자 260805 9차) — 항목 묶음이 있으면 [전체], 없으면(유튜브 등) 화질 칩 **바로 옆** ⬇.
    //   부품 = 전 앱 다운로드 표준(.sbtn.dlbtn 픽토온리) · 화질 고르고 그 자리에서 받는다(운영자 "화질 선택과 다운로드가 바로 아래").
    + ((p && Array.isArray(p.items) && p.items.some(it => it && it.u))
        ? _dgAllBtnHtml('pkall', '', '이 게시물 전체 다운로드')
        : _dgDlBtnHtml('pkdl', 0, 'dg-pkdl'))
    + '</div>' + mediaGrid;   // 미리보기 액자 = 행 **바로 아래**(스캔 결과에서도 헤드 → 그리드 순서 = 같은 배치 문법)
}
async function _dgProbeSubs() {   // 자막 유무 사전판별 = api/linkprobe(정본 = 요약창 probeAskLink) · 화면 표시 전용(실제 판정은 러너)
  const u = _dgUrlNorm(), seq = ++_dgProbeSeq;
  _dgSubs = null; _dgPaintPic();
  if (!u || !_dgVidPlat(u)) return;
  try {
    const r = await fetch('api/linkprobe?u=' + encodeURIComponent(u));
    const d = await r.json().catch(() => ({}));
    if (seq !== _dgProbeSeq) return;   // 늦게 온 옛 응답 폐기(타이핑 중 순서 뒤집힘 차단 · probeAskLink 관례)
    _dgSubs = (d && typeof d.subs === 'boolean') ? d.subs : null;
  } catch { if (seq !== _dgProbeSeq) return; _dgSubs = null; }
  _dgPaintPic();
}
function _dgFire() {   // 다운로드 버튼 = 갈래 판단 1곳(영상 게시물 → vidl 잡 추가 · 그 외 → 페이지 스캔)
  if (_dg.busy) return;   // 페이지 스캔만 직렬(결과 판이 하나) — 영상 받기는 큐잉 = 막지 않는다
  const u = _dgUrlNorm();
  if (!u) { _dg.err = '주소를 먼저 붙여넣어 주세요'; _dgRenderBody(); return; }
  // ⚠ **사진만인 게시물은 러너로 보내지 않는다**(운영자 260806 실다운로드 실측) — vidl 러너는 yt-dlp 축이라
  //   영상이 없으면 그 자리에서 죽는다(실측 rc=1 · X 사진 트윗 "No video could be found in this tweet" ·
  //   인스타 사진 글 "There is no video in this post"). 운영자 화면엔 40~60초 뒤 실패 잡만 남았다 = 최악의 헛걸음.
  //   그런데 그 사진들은 **이미 「받을 내용」 액자에 떠 있고** 같은 창의 프록시 저장(api/linkgrab/file)으로 바로 받아진다 →
  //   [보내기]를 그 전체 다운로드에 그대로 잇는다(새 경로 0 · 버튼 추가 0 · 운영자 동작 종전과 동일).
  if (_dgVidPlat(u) && _dgPeekFor === u && _dgNoVid(_dg.peek)) { _dgPeekGetAll($('#dgVidDl')); return; }
  if (_dgVidPlat(u)) _dgVidStart('video'); else _dgGo();   // 기본 = **영상만**(운영자 260803 "주로 필요한건 영상임 어짜피") · 자막까지 = 「받을 내용」 행의 [영상+자막] 워드칩(data-act=vidsubs)
}
function _dgVidStart(mode) {   // 영상 받기 발사 = 주소 → vidl 잡 **추가**(교체 아님 · 큐잉 260802) · 입력칸은 비워 다음 주소를 바로 받는다
  const u = _dgUrlNorm(), plat = _dgVidPlat(u); if (!plat) return;
  if (_dg.jobs.some(v => v.st === 'run' && v.url === u)) { _dg.err = '이미 받는 중인 주소야'; _dgRenderBody(); return; }   // 같은 주소 이중 발사만 막는다(다른 주소는 얼마든지)
  _dg.err = ''; _dg.lastUrl = u; _dg.resOpen = true;
  const v = { url: u, plat, mode: mode || 'both', q: plat === 'TH' ? 'best' : _dgQEff()[0], n: ++_dgJobSeq, st: 'idle' };   // q = **칩에 뜬 그 값**(목록 밖 구 선택은 _dgQEff가 내려앉힌다 · 260805 14차)   // 화질 = 발사 시점 박제(이후 칩을 돌려도 이 잡은 안 바뀐다) · 스레드 = 항상 최고 화질(운영자 260805 2차 "화질을 정하기보다는 가장 좋은 화질" — 스레드는 화질 사다리 자체가 없어 상한 지정이 무의미 · 러너 'best' = 종전 최고화질 경로)
  _dg.jobs.unshift(v);   // 최신이 위 = 이미지 스튜디오 잡 보드(#jobs prepend) 계승
  const inp = $('#dgUrl'); if (inp) { inp.value = ''; inp.dispatchEvent(new Event('input', { bubbles: true })); }   // 발사 = 칸 비움(다음 주소 즉시 입력 · 클립 버튼 상태도 input 이벤트로 동기)
  _dgVidFire(v, v.mode);
}
async function _dgGo() {   // 영상 게시물이 아닌 주소 = 그 페이지 자료 수집(사진·문서·음성·압축 · 구 [가져오기])
  if (_dg.busy) return;
  const u = _dgUrlNorm();
  if (!u) { _dg.err = '주소를 먼저 붙여넣어 주세요'; _dgRenderBody(); return; }
  _dg.busy = true; _dg.err = ''; _dg.lastUrl = u; _dg.meta = {}; _dg.yt = {}; _dg.resOpen = true;
  _dgPaintPic();
  try {
    const r = await fetch('/api/linkgrab?url=' + encodeURIComponent(u));   // 같은 오리진 무헤더(인증 = CF Access 엣지)
    const d = await r.json().catch(() => ({ error: '응답 해석 실패' }));
    if (!r.ok || d.error) throw new Error(d.error || ('HTTP ' + r.status));
    _dg.res = d;
  } catch (e2) { _dg.res = null; _dg.err = '가져오기 실패 — ' + ((e2 && e2.message) || '네트워크 오류'); }
  _dg.busy = false;
  _dgPaintPic();
  _dgRenderBody();
}
const _dgBtnEl = $('#dgBtn'); if (_dgBtnEl) _dgBtnEl.addEventListener('click', e => { e.stopPropagation(); openDlGrab(); });   // 설정 ▸ 다운로드(운영자 260721) — accBtn(계정→snsaccdlg) 선례 미러
// 완료 푸시 딥링크(?vidl=<id>) — 알림 탭 = 다운로드 창 + 그 결과 패널 즉시(운영자 260802 "다운로드를 어떻게 받아").
//   보관함에 있으면 그것으로, 없으면(폰↔PC 다른 기기·캐시 초기화) 서버 result.json을 읽어 복원 = 알림 받은 기기에서 항상 받아진다.
async function _dgDeepLink(id) {
  id = String(id || '').replace(/[^0-9a-f-]/gi, '').slice(0, 32); if (!id) return;
  openDlGrab();
  const hit = _dgDoneLoad().findIndex(x => x.id === id);
  if (hit >= 0) { _dgDoneOpen(hit); return; }
  try {
    // 1순위 = 빌드 우회(api/vidlout) — 완료 푸시는 러너가 커밋한 **직후** 오므로 딥링크야말로 빌드 큐에
    //   가장 먼저 걸린다(폴링과 같은 축 · 260804 봉합). 실패 시에만 종전 정적 경로.
    let d = null;
    try {
      const lr = await fetch('api/vidlout?id=' + encodeURIComponent(id) + '&t=' + Date.now());
      if (lr.ok) { const ld = await lr.json(); if (ld && ld.state === 'done' && ld.res && ld.res.files) d = ld.res; }
    } catch {}
    if (!d) {
      const r = await fetch('vidl_out/' + id + '/result.json?t=' + Date.now());
      if (!r.ok) return;
      const tx = await r.text(); if (/^\s*</.test(tx)) return;   // 404 폴백 HTML = 무시(폴링 가드와 동일 문법)
      d = JSON.parse(tx);
    }
    if (!d || !d.files) return;
    const v = { url: '', plat: d.plat || '', id, mode: d.mode || 'both', t0: Date.now(), n: ++_dgJobSeq, st: 'done', res: d };
    _dg.jobs.unshift(v); _dgDoneSave(v); _dg.resOpen = true; _dgRenderBody();
  } catch {}
}
try { const _vq = new URLSearchParams(location.search).get('vidl'); if (_vq) setTimeout(() => _dgDeepLink(_vq), 0); } catch {}
$('#dgX').addEventListener('click', () => $('#dlgrab').close());   // 닫기 = geniX 미러
$('#dgRf').addEventListener('click', () => openDlGrab());   // 새로고침 = 여는 경로 재호출(구 #toolRf 새로고침 대응 — 그 버튼은 260821 입력 초기화로 전환·이 창은 종전 유지) = **여는 경로 재호출**(입력칸·스캔 결과 초기화 = 리로드와 같은 결과) · 진행 중 받기는 openDlGrab이 localStorage에서 전건 복원 = 유실 0 · 새 로직 0(기존 함수 그대로)
$('#dgMin').addEventListener('click', minimizeDlGrab);
// ── 다운로드 창 최소화/복원 = 작성 모달 일반 최소화(minimizeComposeDlg/restoreComposeDlg) 정본 미러 ──
//   차이 = **재오픈 1줄뿐**: 정본은 openComposeDlg({composeDlg} 히스토리 축)를 부르는데, 이 창은 자체 {dlgrab} 칸
//   문법(§🎨 tooldlg 패턴 — close·popstate 핸들러가 그 키를 본다)이라 복원도 같은 축으로 되돌린다.
//   상태 보존 = _dg 전역이 닫아도 살아있고 리셋은 openDlGrab만 한다 → 최소화는 close 한 번이면 끝(_minimizing 가드 불요).
function minimizeDlGrab() {
  const d = $('#dlgrab'); if (!d || !d.open || MIN_REG.has('dlgrab')) return;
  lastToolRect = d.getBoundingClientRect();                                     // ★ close() 전 캡처(닫으면 display:none → rect 0)
  showRestoreNav();                                                             // ▲ 먼저 띄워 정확한 수렴 좌표 확보
  MIN_REG.set('dlgrab', { label: '다운로드', restore: restoreDlGrab }); minRegRefresh();
  flyGhost('in');
  try { d.close(); } catch (_) {}
}
function restoreDlGrab() {
  const d = $('#dlgrab'); if (!d || d.open || !MIN_REG.has('dlgrab')) return;
  const n = navCenter();                                                        // ▲ 위치 먼저 캡처(숨기기 전)
  MIN_REG.delete('dlgrab');
  if (MIN_REG.size) minRegRefresh(); else hideRestoreNav();                     // 남은 최소화 있으면 ▲ 유지
  closeMinPicker();
  flyGhost('out', () => {
    d.showModal(); try { history.pushState({ dlgrab: true }, ''); } catch {}    // 재오픈 = openDlGrab 마지막 두 줄과 동문(상태 리셋만 뺀 것)
    _dg.jobs.forEach(v => { if (v.st === 'run') _dgVidPoll(v); });              // 폴 재개 — 창 닫힘 = 폴 멈춤 계약이라 복원 때 되살려야 「받는 중」 초가 다시 흐른다
  }, n);
}
// 링크 행 다운로드 픽토 = nm-svg 정본 주입(인라인 SVG 복제 0 · .pin-eye 주입 관례) + 발사 배선
// 링크 행 버튼 = **보내기**(운영자 260805 9차 "픽토그램 다운로드 말고 메세지 전송 느낌 · 다운로드는 저기서(우측 결과) 다 하는 걸로").
//   픽토 = **이 뷰어에 이미 있던 SEND_SVG(종이비행기 · 7906행)** — 운영자가 화살표(→)를 명시 반려(260805 9차-b)했고
//   전송 결 정본이 레포에 이미 존재해 새 아이콘 창작 0으로 계승했다(신설 시도분은 아이콘 SSOT 위반이라 회수).
//   실제 받기는 전부 우측: 유튜브 = 화질 칩 옆 ⬇ · 사진·영상 묶음 = 액자별 ⬇ + [전체].
$('#dgVidDl').innerHTML = SEND_SVG;
$('#dgVidDl').setAttribute('aria-label', '보내기 — 우측 결과에서 받기');
$('#dgVidDl').title = '보내기 — 우측 「받을 내용」에서 받는다';
$('#dgVidDl').addEventListener('click', _dgFire);   // 영상 게시물 = 영상+자막 · 그 외 = 페이지 자료 수집(갈래는 _dgFire가 판단)
$('#dgUrl').addEventListener('input', () => { _dgPaintPic(); if (_dgProbeTm) clearTimeout(_dgProbeTm); _dgProbeTm = setTimeout(() => { _dgProbeSubs(); _dgPeek(); }, 600); });   // 600ms 디바운스 = 타이핑 중 과호출 차단(probeAskLink 동값 계승)
$('#dgUrl').addEventListener('keydown', e => { if (e.key === 'Enter') _dgFire(); });   // Enter = 다운로드 버튼과 동일 갈래
$('#dgBody').addEventListener('click', e => {   // 위임 1핸들러(§🎨 아이콘 위임 관례) — 카드/행/워드칩/기록 전 액션
  const el = e.target.closest('[data-act]'); if (!el) return;
  const act = el.dataset.act, i = +(el.dataset.i || -1);
  const ji = +(el.dataset.j || -1);
  if (act === 'pkdl') { e.stopPropagation(); _dgFire(); }   // 화질 칩 옆 ⬇ = 그 자리에서 받기(유튜브 등 단건 · 운영자 260805 9차)
  else if (act === 'pkget') { e.stopPropagation(); _dgPeekGet(i); }   // 받을 내용 액자 개별 ⬇(운영자 260805 7차)
  else if (act === 'pkall') { e.stopPropagation(); _dgPeekGetAll(el); }   // 같은 행 [전체] = 그 게시물 미디어 전량 순차 저장
  else if (act === 'dl') { e.stopPropagation(); _dgDl(i); }
  else if (act === 'ytreq') { e.stopPropagation(); _dgYtReq(i); }
  else if (act === 'ytget') { e.stopPropagation(); _dgYtGet(i); }
  else if (act === 'vidgo') { e.stopPropagation(); _dgVidFire(_dg.jobs[i], (_dg.jobs[i] || {}).mode || 'both'); }
  else if (act === 'vidsubs') { e.stopPropagation(); _dgVidStart('both'); }
  else if (act === 'vidq') { e.stopPropagation(); _dgQOpen(el); }   // 화질 = 아래로 펼치는 목록(다음 발사부터 적용 · 진행 중 잡은 자기 값을 유지)   // 「받을 내용」 행 [영상+자막] = 그 자리에서 자막까지 포함해 발사(기본 [다운로드]는 영상만)
  else if (act === 'vidget') { e.stopPropagation(); _dgVidGet(ji, i); }
  else if (act === 'vidall') { e.stopPropagation(); _dgVidGetAll(el, ji); }
  else if (act === 'secall') { e.stopPropagation(); _dgDlSec(el, el.dataset.k); }
  else if (act === 'vdfold') { _dg.vdOpen = !_dg.vdOpen; _dgRenderBody(); }
  else if (act === 'vdopen') { e.stopPropagation(); _dgDoneOpen(i); }
  else if (act === 'vddel') { e.stopPropagation(); try { const a = _dgDoneLoad(); a.splice(i, 1); localStorage.setItem(DG_VDONE_KEY, JSON.stringify(a)); } catch {} _dgRenderBody(); }
  else if (act === 'resfold') { _dg.resOpen = !_dg.resOpen; _dgRenderBody(); }   // (구 '기록' 접이 액션 3종 = 축 폐지 · 260802)
});
$('#dgBody').addEventListener('load', e => {   // 썸네일 실측 → 해상도 기입(캡처 단계 — load는 버블 안 함)
  const img = e.target; if (!img || img.tagName !== 'IMG' || !img.dataset.metai) return;
  const i = +img.dataset.metai; const m = _dg.meta[i] = _dg.meta[i] || {};
  m.w = img.naturalWidth; m.h = img.naturalHeight;
  const el = $('#dgres' + i); if (el && m.w) el.textContent = m.w + '×' + m.h;
}, true);
$('#dgBody').addEventListener('error', e => { const img = e.target; if (img && img.tagName === 'IMG') img.hidden = true; }, true);   // 깨진 썸네일 = 조용히 숨김
$('#dlgrab').addEventListener('close', () => { if (_dgPop) { _dgPop = false; } else if (history.state && history.state.dlgrab) { try { history.back(); } catch {} } });   // X·ESC 닫기 = push한 {dlgrab}칸 회수(§🎨 tooldlg 패턴)
window.addEventListener('popstate', () => { if (_composeRecovering) return; const d = $('#dlgrab'); if (d && d.open) { _dgPop = true; d.close(); } });   // 폰 뒤로가기 = 이 창 먼저 닫기(컴포즈 회수 back은 무시 · lbox 가드 계승)
$('#msgDlAll').addEventListener('click', e => { e.stopPropagation(); msgRptDl(e.currentTarget); });   // 헤더 ↓ = 진단 리포트 저장(팝업은 안 닫힘 — 받고 나서 목록을 계속 보게) · 누름 모션 = 위임 핸들러가 aria-label '다운로드' 매칭으로 ic-bounce 자동 부여(새 모션 0)
$('#msgclose').addEventListener('click', e => { e.stopPropagation(); msgpop.hidden = true; if (_msgFromMenu) { linkpop.hidden = false; placeHeadPop(linkpop, $('#profile')); } });   // 세부(메시지함) X 닫힘 → 전단계 설정메뉴(linkpop) 되띄움(메뉴 진입 한정 · 딥링크는 복원 안 함 · 운영자 260710)
$('#msgback').addEventListener('click', e => { e.stopPropagation(); msgShowList(); });   // 상세 → 목록 복귀(운영자 260704)

