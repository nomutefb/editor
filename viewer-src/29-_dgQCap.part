//     → 버튼 1개 · 잠금 없음(주소만 있으면 눌린다) · 못 하는 건 사유를 글로 띄운다.
let _dgProbeSeq = 0, _dgSubs = null, _dgProbeTm = null;   // _dgSubs = true(자막 확인)·false(없음 확인)·null(미확인) — 버튼 툴팁 리드백용
function _dgUrlNorm() { let u = String(($('#dgUrl') || {}).value || '').trim(); if (!u) return ''; return /^https?:\/\//i.test(u) ? u : 'https://' + u; }
function _dgPaintPic() {
  const dl = $('#dgVidDl'); if (!dl) return;
  const u = _dgUrlNorm(), plat = _dgVidPlat(u);
  dl.disabled = !u || _dg.busy;   // 잠금 = '주소 없음'과 '페이지 스캔 중' 둘뿐. ⚠ 구판은 「받는 중」에도 잠갔다 = 운영자 260802
  dl.classList.remove('dlbtn');   // 이 버튼은 더 이상 **다운로드가 아니다**(보내기) → 다운로드 색 정본(.dlbtn 골드) 계승 해제(운영자 260805 9차)
  dl.classList.toggle('dl-on', !dl.disabled);   // 활성 = 강조색1(운영자 260805 6차) · 잠김 = .sbtn 기본 크롬
  //   "이미 한번 링크 입력하면 다음거를 입력을 못해 … 재차, 또는 큐잉 시킬수가 없음"의 **직접 원인**. 이미지 스튜디오는
  //   제작 중에도 다음 발사가 열려 있고 잡이 쌓인다(JOBS 배열) — 같은 모델로 통일했으니 잠글 이유가 사라졌다.
  dl.title = !u ? '주소를 붙여넣으면 받을 수 있어'
