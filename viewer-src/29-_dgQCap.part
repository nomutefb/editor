  if (!u || !_dgVidPlat(u)) { if (_dg.peek) { _dg.peek = null; _dgPeekFor = ''; _dgRenderBody(); } return; }   // 주소 없음·영상 게시물 아님 = 미리보기 없음(페이지 스캔 갈래는 종전대로 [다운로드]가 목록을 만든다)
