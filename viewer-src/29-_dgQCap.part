function _dgQCap(v) { const m = /^(\d+)-/.exec(v || ''); return m ? +m[1] : 0; }
function _dgQEff() {   // 지금 고른 상한이 이 영상에서 실제로 내주는 행(목록에 없는 값이면 그 아래 최고로 내려앉는다)
  const o = _dgQOpts();
  return o.find(x => x[0] === _dg.q) || o.find(x => _dgQCap(x[0]) <= _dgQCap(_dg.q)) || o[o.length - 1] || DG_QUALS[0];
}
function _dgActualLbl(f) {
  if (!f || !f.w || !f.h) return '';
  const s = Math.min(f.w, f.h);
  // ⚠ 티어는 **정확일치**만 통칭으로 부른다(평의회2 260805 실측) — 구판 하한 매칭(`s>=2160`)은
  //   7680×4320(8K)을 「4K」, 1920×1200을 「K」라고 말했다 = 이번 라운드가 없애려던 그 거짓말의 변종.
  //   통칭에 없는 크기는 짧은 변 그대로(1200p·4320p) = 새 어휘 창작 0 · 지어내기 0.
  const tier = _dgTierName(s);
  const fps = Math.round(Number(f.fps) || 0);
  return tier + (fps ? ' ' + fps + 'F' : '');   // 'fps' → 'F' 축약(운영자 260805 11차) — 화질 어휘를 화면 전체에서 한 문법으로
}
const _DG_VAR_RE = /^\d{8}_\d{6}_(?:YT|IG|X|TT|FB|TH)_(?:maxfps|1080p)_/;   // 부가본 표식 = {TS}_{PLAT}_ **바로 뒤**(러너 download() out 템플릿) — 제목·계정에 같은 글자가 섞여도 ①본을 오배제하지 않는다(평의회2 실측) · ⚠ 플랫폼은 **코드 교대로 못박는다**(X는 1글자라 `[A-Z]{2}`가 못 잡아 X만 부가본이 본편으로 계수됐다 = 평의회3 D2 커밋 전 검출)
function _dgResActual(res) {   // 받은 영상들의 실측 라벨 — 완료 잡 카드·이전 받기 공용
  const vids = ((res && res.files) || []).filter(f => f && f.kind === 'video' && f.w && f.h);
  if (!vids.length) return '';   // 영상 0건(사진 게시물·자막만·구 결과) = 화질을 말할 자격 자체가 없다 = 빈 문자
  const main = vids.filter(f => !_DG_VAR_RE.test(String(f.name || '')));
  const pool = main.length ? main : vids;
  // 캐러셀(스레드·IG)은 한 번에 여러 영상을 받는다 → 첫 항목만 재면 「1080이 있는데 720p」라고 단언하게 된다
  //   (평의회2 실측) → 짧은 변 최대치를 대표로 말하고, 나머지가 있다는 사실을 「외 N건」으로 같이 밝힌다.
  const best = pool.reduce((a, b) => (Math.min(b.w, b.h) > Math.min(a.w, a.h) ? b : a));
  return _dgActualLbl(best) + (pool.length > 1 ? ' 외 ' + (pool.length - 1) + '건' : '');
}
// 화질 고르기 = **눌러서 아래로 펼치는 목록**(운영자 260804 4차 "이런식으로 아래에 나오게 할건가?").
//   구 6값 순환은 최고↔최저 이동에 최대 5탭이었다 = 6값이 되는 순간 순환이 부품으로 안 맞는다.
//   부품·동작 = `.min-pick`/`.min-pick-it` **정본 100% 사본**(최소화 복원 picker · 글래스 셸 SSOT·
//   바깥 탭 닫기 가드·좌변 클램프까지 그대로). 새 부품·새 값 0 — 운영자가 든 외부 앱 스샷은 참조하지 않았다.
//   ⚠ 앵커 방향만 다르다: 정본은 ▲(화면 하단) 위로 펴고, 여긴 칩이 화면 위쪽이라 **아래로** 편다(자리 없으면 위로 뒤집음).
function _dgQOpen(btn) {
  _dgQClose();
  const d = $('#dlgrab'); if (!d || !btn) return;
  const pop = document.createElement('div'); pop.className = 'min-pick'; pop.id = 'dgQPick';
  pop.setAttribute('role', 'listbox'); pop.setAttribute('aria-label', '화질 선택');
  // 항목 순서 = 화질 내림차순(4K → 2K → K). 목록 자체는 _dgQOpts가 **그 영상에 실재하는 것만** 추린다(260805 4차).
  _dgQOpts().forEach(([v, lab]) => {
    const it = document.createElement('button'); it.type = 'button'; it.className = 'min-pick-it'; it.textContent = lab;
    it.setAttribute('role', 'option'); it.setAttribute('aria-selected', v === _dg.q ? 'true' : 'false');
    if (v === _dg.q) it.setAttribute('aria-current', 'true');   // 현재값 점등 = :hover 선언 **값 사본**(아래 CSS · 신규 값 0)
    it.addEventListener('click', ev => { ev.stopPropagation(); _dg.q = v; try { localStorage.setItem(DG_Q_KEY, v); } catch {} _dgQClose(); _dgRenderBody(); });
    pop.appendChild(it);
  });
  d.appendChild(pop);   // ⚠ body가 아니라 **다이얼로그 안**(showModal = top layer라 body 자식은 모달 뒤로 깔린다)
  const r = btn.getBoundingClientRect(), pw = pop.offsetWidth, ph = pop.offsetHeight, M = 8;
  let left = r.left + r.width / 2 - pw / 2;                    // 칩 중심에 목록 가운데(정본 산식 그대로)
  left = Math.min(left, window.innerWidth - M - pw);
  left = Math.max(left, M);
  pop.style.left = left + 'px';
  const below = r.bottom + 6;
  pop.style.top = (below + ph > window.innerHeight - M ? Math.max(M, r.top - 6 - ph) : below) + 'px';   // 아래로 · 자리 없으면 위로 뒤집기
  setTimeout(() => document.addEventListener('pointerdown', _dgQOutside, { capture: true }), 0);
}
function _dgQOutside(e) {   // 바깥 탭만 닫기 — 내부·칩 자체는 각자 click이 처리(정본 onMinPickOutside 가드 동문)
  const t = e.target;
  if (t && t.closest && (t.closest('#dgQPick') || t.closest('[data-act="vidq"]'))) return;
  _dgQClose();
}
function _dgQClose() { const p = $('#dgQPick'); if (p) p.remove(); document.removeEventListener('pointerdown', _dgQOutside, { capture: true }); }
function _dgVidPlatName(p) { return ({ YT: '유튜브', IG: '인스타그램', X: 'X(트위터)', TT: '틱톡', FB: '페이스북', TH: '스레드' })[p] || p; }
// 진행 중 작업 계정축 보존(평의회2·8) — run 중 창 닫아도 job id를 기기에 남겨 재열람 시 폴 재개(백그라운드 상주 아님 = 창 열 때만 폴).
const DG_VID_KEY = 'dg_vid_job_v1';
// 받은 영상 보관함(운영자 260802 "다운로드 되면 내가 다운로드를 어떻게 받아") — 종전엔 완료 결과가 _dg.vid에만
//   살아 있어서 창을 닫으면 그대로 증발했다(R2엔 파일이 멀쩡히 있는데 그 URL로 가는 길이 사라짐 = 다시 못 받음).
//   최근 10건·7일을 기기에 남겨 언제든 다시 받게 한다. 저장분 = 파일 이름·URL·용량뿐(영상 실물 아님 = 용량 무해).
const DG_VDONE_KEY = 'dg_vid_done_v1', DG_VDONE_MAX = 10, DG_VDONE_TTL = 7 * 24 * 3600e3;
function _dgDoneLoad() {
  try {
    const a = JSON.parse(localStorage.getItem(DG_VDONE_KEY) || '[]');
    if (!Array.isArray(a)) return [];
    const cut = Date.now() - DG_VDONE_TTL;
    const live = a.filter(x => x && x.t > cut && x.res && x.res.files && x.res.files.length);
    if (live.length !== a.length) localStorage.setItem(DG_VDONE_KEY, JSON.stringify(live));   // 만료분 청소 = 읽을 때(_dgLoadHist 관례)
    return live;
  } catch { return []; }
}
function _dgDoneSave(v) {
  if (!v || !v.res || !(v.res.files || []).length) return;
  try {
    const a = _dgDoneLoad().filter(x => x.id !== v.id);   // 같은 건 재요청 = 최신으로 승격
    a.unshift({ id: v.id, url: v.url, plat: v.plat, mode: v.mode || (v.res && v.res.mode) || 'both', t: Date.now(), sec: v.sec || 0, res: v.res });   // sec = 이번 건이 실제로 걸린 시간(운영자 260802 "받은 리스트는 필요 시간 기록") · 딥링크 복원분은 t0 미상 = 0(=미표시)
    localStorage.setItem(DG_VDONE_KEY, JSON.stringify(a.slice(0, DG_VDONE_MAX)));
  } catch {}   // 용량 초과 = 조용히 포기(보관함은 편의 · 현재 결과 표시는 무영향)
}
function _dgDoneOpen(i) {   // 보관함 항목 → 그때 그 완료 패널 그대로 복원(파일 목록·받기·전부 받기)
  const e = _dgDoneLoad()[i]; if (!e) return;
  const ex = _dg.jobs.findIndex(v => v.id === e.id); if (ex >= 0) _dg.jobs.splice(ex, 1);   // 이미 올라와 있으면 위로 승격(중복 카드 방지)
  _dg.jobs.unshift({ url: e.url, plat: e.plat, id: e.id, mode: e.mode || 'both', t0: e.t, sec: e.sec || 0, n: ++_dgJobSeq, st: 'done', res: e.res });   // 「이전 받기」 항목 열기 = 그때 그 완료 **잡 카드**로 결과 판에 되살림(구: 전용 패널 교체)
  _dg.err = ''; _dg.vdOpen = false; _dg.resOpen = true;
  _dgRenderBody();
}
function _dgAgo(t) {   // 상대시각 = 보관함 행 부제(형제 목록 관례 · 절대시각 병기 없이 1줄)
  const s = Math.max(0, Date.now() - t) / 1000;
  if (s < 3600) return Math.max(1, Math.round(s / 60)) + '분 전';
  if (s < 86400) return Math.round(s / 3600) + '시간 전';
  return Math.round(s / 86400) + '일 전';
}
// 소요·예상 시간 문자열 = nmEta.fmt 정본(「N분 NN초」) — 로더·요약 링크 레일과 같은 시간 문법(자체 포맷 창작 금지) · nmEta 미로드 폴백만 로컬 산식.
function _dgSecTxt(s) { s = Math.max(0, Math.round(Number(s) || 0)); return window.nmEta ? nmEta.fmt(s) : (Math.floor(s / 60) + '분 ' + String(s % 60).padStart(2, '0') + '초'); }
// 예상시간 학습·표시 키 = **모드 × 플랫폼**(운영자 260802-2) — 유튜브 20분짜리와 X 40초 클립을 한 평균에 담으면 둘 다 틀린다.
//   시드는 전 플랫폼 동일(nm-loader.js SEED) = 차이를 지어내지 않고 실측이 갈라놓게 둔다 · 플랫폼 미상(딥링크 복원) = 폴백 'vidl'/'vidl-subs'.
const DG_PLATS = ['YT', 'IG', 'X', 'TT', 'FB', 'TH'];
function _dgEtaKey(v) { const b = (v && v.mode === 'subs') ? 'vidl-subs' : (v && v.mode === 'video') ? 'vidl-video' : 'vidl'; const p = v && v.plat; const q = (v && v.q && v.q !== 'best') ? '-q' + v.q : ''; return ((p && DG_PLATS.indexOf(p) >= 0) ? b + '-' + p : b) + q; }   // 화질도 키 축(720p는 4K보다 압도적으로 빠르다 = 예상시간이 갈려야 한다 · 260804)
// (구 `_dgVidStat` = `.genstat.live` 알약 진행표기 폐지 — 진행은 이제 **제작 잡 카드**(.job > .jst)가 전담 =
//  이미지 스튜디오와 같은 부품(운영자 260802 "이미지 스튜디오를 거의 따라서"). orb·예상·경과 세 축은 _dgJobHtml로 이관.)
// 「이전 받기」 접이 = 이미지 스튜디오 **이전 제작** 접이 100% 모방(.prev 이력색·맨 아래·전 기기 아닌 이 기기 표기만 다름).
//   구 라벨 '받은 영상' → '이전 받기' = 위 「결과」와 축이 한눈에 갈리게(운영자 260802 "이 2개가 뭔 차이인지 모르겠고").
function _dgDoneHtml() {
  const list = _dgDoneLoad();
  let h = '<div class="geni-histwrap"><button class="geni-histfold prev" type="button" data-act="vdfold" aria-expanded="' + (_dg.vdOpen ? 'true' : 'false') + '" aria-controls="dgDoneBody"><span class="geni-histttl"><span class="geni-histbul" aria-hidden="true">•</span>이전 받기 <span class="geni-histcnt">(' + list.length + ')</span></span><span class="dg-histnote">이 기기 · 7일 뒤 자동 삭제</span><span class="geni-histchev" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></button>'
    + '<div class="geni-histbody' + (_dg.vdOpen ? ' open' : '') + '" id="dgDoneBody"' + (_dg.vdOpen ? '' : ' inert') + '><div class="geni-histbody-in">';
  if (!list.length) h += '<div class="geni-histempty">아직 받은 게 없습니다</div>';   // 빈 상태 문구 = 이미지 스튜디오 이전 제작(#histEmpty '아직 제작한 게 없습니다') 미러 · 구 산문 1줄 폐지
  list.forEach((e, i) => {
    const fs = e.res.files || [];
    const vn = fs.filter(f => f.kind === 'video' || f.kind === 'img').length;   // 스레드 사진 게시물(img)도 본편 취급 = '(자막만)' 오표기 방지
    const aq = _dgResActual(e.res);   // 실측 화질(있을 때만 · 운영자 260805) — 구 저장분은 실측 키가 없어 생략 = 지어내지 않음
    h += '<div class="dg-histrow"><div class="dg-hmain" data-act="vdopen" data-i="' + i + '" role="button" tabindex="0"><div class="dg-ittl">' + esc(_dgVidPlatName(e.plat)) + ' · ' + ({ both: '영상+자막', video: '영상', subs: '자막' }[e.mode] || '영상+자막') + ' · 파일 ' + fs.length + '건' + (vn ? '' : ' (자막만)') + (aq ? ' · ' + esc(aq) : '') + '</div><div class="dg-hurl">' + _dgAgo(e.t) + (e.sec ? ' · ' + _dgSecTxt(e.sec) + ' 걸림' : '') + ' · ' + esc(e.url) + '</div></div><button type="button" class="geni-opt" data-act="vddel" data-i="' + i + '">지움</button></div>';   // 필요 시간(운영자 260802) = 상대시각 옆 · 옛 항목(sec 없음)은 생략 = 없는 값 지어내지 않음
  });
  return h + '</div></div></div>';
}
// 진행 중 잡 보존 = **배열**(큐잉 편입 260802) — 구 단일 객체 저장분도 읽어서 1건 배열로 승격(back-compat).
function _dgVidSaveJobs() {   // 현재 run 잡 전량을 한 번에 기록(개별 저장은 경합 · 목록이 정본)
  try {
    const a = _dg.jobs.filter(v => v.st === 'run' && v.id).map(v => ({ url: v.url, plat: v.plat, id: v.id, mode: v.mode, q: v.q, t0: v.t0 }));
    if (a.length) localStorage.setItem(DG_VID_KEY, JSON.stringify(a)); else localStorage.removeItem(DG_VID_KEY);
  } catch {}   // mode 동반 저장 = 창 닫았다 열어도 예상시간·머리 라벨이 그 모드 것으로 복원
}
function _dgVidLoadJob() {
  try {
    const raw = JSON.parse(localStorage.getItem(DG_VID_KEY) || 'null');
    const a = (Array.isArray(raw) ? raw : (raw ? [raw] : [])).filter(e => e && e.id && e.t0 > Date.now() - 40 * 60e3);   // 40분 = 폴 상한과 동일
    if (!a.length) { try { localStorage.removeItem(DG_VID_KEY); } catch {} }
    return a;
  } catch { return []; }
}
// 드라이브 사유 = 사람 말(평의회7·8) — 러너가 이미 사람 말로 주지만 방어적으로 한 번 더 순화.
function _dgDriveWhy(w) {
  w = String(w || '');
  if (/공간|quota|storage/i.test(w)) return '드라이브 공간이 부족해요';
  if (/연결|미설정|GDRIVE|없음/i.test(w)) return '드라이브가 연결 안 돼 있어요';
  if (/HTTP|응답|인증|401|403|5\d\d/i.test(w)) return '드라이브가 잠깐 응답을 안 했어요';
  return w ? w.slice(0, 60) : '원인을 못 찾았어요';
}
// (구 `_dgVidHtml` = 자체 「영상 받기」 패널 폐지 — 진행·실패·완료 세 상태 전부 **제작 잡 카드**(_dgJobHtml)로 통합.
//  운영자 260802 "이미지 스튜디오를 거의 따라서 가져온다고 생각하고" · 개별/전체 다운로드도 그 카드의 정본 자리로 이주.)
async function _dgVidFire(v, mode) {
  if (!v || (v.st !== 'idle' && v.st !== 'fail')) return;   // fail에서도 재시도(평의회8) · 동의 게이트 폐지(운영자 260802)
  v.mode = ['both', 'video', 'subs'].indexOf(mode || v.mode) >= 0 ? (mode || v.mode) : 'both';   // 받을 것 = 다운로드 1버튼 = both(영상+자막) 고정 · video/subs는 서버·러너 화이트리스트에 존치(구 3택 호환)
  v.st = 'run'; v.msg = '요청 중'; v.t0 = Date.now(); v.sec = 0; v.res = null; _dgPaintPic(); _dgRenderBody();
  try {
    const r = await fetch('/api/vidl', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: v.url, mode: v.mode, q: v.q || 'best' }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok || d.error || !d.id) throw new Error(d.error || ('HTTP ' + r.status));
    if (_dg.jobs.indexOf(v) < 0) return;   // 발사 대기 중 취소됐으면 고아 — 폴 시작 안 함(평의회2 · identity 축을 배열 소속으로 승격)
    v.id = d.id; _dgVidSaveJobs();
    _dgRenderBody();
    _dgVidPoll(v);
