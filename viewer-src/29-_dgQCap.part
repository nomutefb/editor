  if (!f || !f.url || !$('#dlgrab').open) return;   // 상태·모달 가드(평의회2)
  const a = document.createElement('a');
  a.href = 'api/dl?u=' + encodeURIComponent(f.url) + '&n=' + encodeURIComponent(f.name); a.rel = 'noopener';   // 같은 오리진 attachment = 로컬 다운로드 폴더 강제 저장(dlSrc 관례)
  document.body.appendChild(a); a.click();
  setTimeout(() => { try { a.remove(); } catch {} }, 1500);
  _dg.got[f.url] = Date.now();
  try { const g = _dgLoadGot(); g[f.url] = Date.now(); localStorage.setItem(DG_GOT_KEY, JSON.stringify(g)); } catch {}
  const row = $('#dgjob' + ji); const db = row && row.querySelectorAll('.jvar-dl')[i]; if (db) db.classList.add('dl-done');   // 받음 mut(.dl-done 전 앱 표준)
}
function _dgVidGetAll(btn, ji) {
