  const p = (_dg.peek && (_dg.peek.title || (Array.isArray(_dg.peek.items) && _dg.peek.items.length))) ? _dg.peek : null;   // 제목 없이 항목 구성만 얻은 글도 미리보기 대상(캡션 없는 스레드 미디어 글)
