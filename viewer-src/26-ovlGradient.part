const TRENDUP_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M2 17.5 8.5 10.5l5 5L22 6.5"/><path d="M16 6.5h6v6"/><path class="gpic-lt" d="M2 17.5 8.5 10.5l5 5L22 6.5" pathLength="100" fill="none" stroke="none"/></svg>';   // 📈 우상향 차트(TOP 10 그룹 픽토그램 · 운영자 260714 "불꽃 어색 → 차트/우상향") — 본선+화살촉 · .gpic-lt = 본선만 라이트 궤도(촉 제외 = 빛이 상승선만 주행) · stroke=none 인라인 = .gpic 밖 재사용 시 본선 이중선 차단(CSS accent-bright가 이김 = .gpic 안 무영향 · AISPARK fill=none 대칭 · 평의회⑤⑨)
const CHEVRON_SVG = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px"><path d="M6 9l6 6 6-6"/></svg>';   // ▾ 더보기(접기=회전 클래스)
// 소스칩 픽토그램(SNS 네이버 계열) — 카페=☕컵(정면·커뮤니티) · 블로그=✒️펜(1인 창작). 지식iN은 픽토 없이 이름만. 크기는 .soc-chip .ico svg가 11px로. 운영자 260704.
const CAFE_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1 11.3a2 2 0 0 1-2 1.7H9a2 2 0 0 1-2-1.7L6 8z"/><path d="M4.5 8h15"/><path d="M9.2 2.8c-.6 1 .6 1.8 0 2.8M14.2 2.8c-.6 1 .6 1.8 0 2.8"/></svg>';   // ☕ 컵 정면 + 김
const BLOG_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>';   // ✒️ 펜
// (ERASE_SVG·UNDO_SVG는 위 4183~4184에 단일 정의 — main #1056 중복분 제거·머지 260627. #askText는 그 상수를 공유)
// 다운로드 시퀀스 버튼(.cref-dlall) 아이콘 = 다운(dn)↔체크(chk) 스왑 한 벌(완료 시 체크 팝 · 정본 패턴 구성도 §9)
const DLSEQ_IC = '<span class="dlseq-ic">' + DOWNLOAD_SVG.replace('<svg ', '<svg class="dn" ') + CHECK_SVG.replace('<svg ', '<svg class="chk" ') + '</span>';
const ACK_MORPH = '<svg class="ackm" viewBox="0 0 24 24" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path class="sc-dash" d="M6 12h12"/><path class="sc-chk" d="M5 13l4 4L19 7"/></svg>';   // 확인 토글 −→✓ 드로우-인(시안1·운영자 260622)
// (EXT_SVG 폐지 — 긴급 토스트 원문 아이콘을 뷰어 원문 바로가기 표준 Q_ARR로 통일 · 운영자 260702)
const SEND_SVG = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>';   // 직접입력 사유 전송(종이비행기 · 강조색 X · 운영자 260626)
async function copyText(text, btn) {
  text = (text || '').replace(/\n+$/, '');
  let ok = false;
  try { await navigator.clipboard.writeText(text); ok = true; } catch {}
  if (!ok) {   // 폴백: 모달(showModal)은 dialog 밖이 inert → textarea를 #dlg 안에 두고 선택영역 명시
    const ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', '');
    ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.opacity = '0';
    $('#dlg').appendChild(ta); ta.focus(); ta.select();
    try { ta.setSelectionRange(0, text.length); } catch {}
    try { ok = document.execCommand('copy'); } catch {}
    ta.remove();
  }
  if (btn) { btn.innerHTML = CHECK_SVG; btn.classList.add('ok');
    setTimeout(() => { btn.innerHTML = COPY_SVG; btn.classList.remove('ok'); }, 1500); }
}
// 제목 탭 = 복사(운영자 260805 "복사 버튼이 나란히 있으니 버그같은데 · 둘다 제목 클릭 > 복사") — 문법 = 키워드 칩 .cardkw 정본 사본:
//   운영자 260622에 「복사버튼 제거 → 탭 복사 + 눌림 플래시」로 같은 판단을 내린 부품이라 안내문구·.copied 플래시·animationend 자기제거(연타에도 매번 재생)까지 그대로 가져왔다.
//   ⚠ role=button은 안 준다 — 요약 제목은 h1(문서 구조 앵커)이라 버튼 롤이 헤딩 의미를 지운다. 키보드 접근은 tabindex+Enter/Space로 보존(구 복사버튼이 갖던 축).
function tapCopy(el, text) {
  el.title = '탭하면 제목 복사'; el.tabIndex = 0;
  let t = 0;
  const run = async ev => { ev.stopPropagation(); await copyText(text); el.classList.add('copied'); clearTimeout(t); t = setTimeout(() => el.classList.remove('copied'), 620); };   // 플래시 = 클래스 유지 620ms(정본 askPhFlash 총 길이) → transition이 --dur로 들고 난다 · 연타 = 타이머 갱신(마지막 탭 기준 · 구 animationend 축은 위 CSS ⚠ 사유로 폐기)
  el.onclick = run;
  el.addEventListener('keydown', ev => { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); run(ev); } });
}
function copyBtn(getText, label) {
  const b = document.createElement('button'); b.className = 'copy'; b.type = 'button';
  b.innerHTML = COPY_SVG; b.setAttribute('aria-label', label || '복사');
  b.onclick = ev => { ev.stopPropagation(); copyText(getText(), b); };
  return b;
}
// 모달 섹션 점프(N=요약·IG / M=카드 프롬프트 / T=카드 이미지). 각 섹션의 윗 구분선이
// 스티키 헤더 바로 아래 오도록 dialog를 정확히 스크롤(A6). 타깃 없으면 안전 return.
// SNS 요약 = 본문(#mdbody)의 IG(인스타) 초안 시작점. 없으면 '콘텐츠 초안' 헤더.
function igHead() {
  const md = $('#mdbody'); if (!md) return null;
  const hs = [...md.querySelectorAll('h1,h2,h3,h4')];
  return hs.find(h => /^\s*\[?\s*IG\b/i.test(h.textContent)) || hs.find(h => /콘텐츠\s*초안/.test(h.textContent)) || null;
}
// '이 기사의 시사점' 헤더 — 요약 영역의 끝 앵커(FAB 점멸 구간 종료점).
function sisaHead() {
  const md = $('#mdbody'); if (!md) return null;
  return [...md.querySelectorAll('h1,h2,h3,h4')].find(h => /시사점/.test(h.textContent)) || null;
}
// rev-fab 시작 앵커 = '콘텐츠 초안' 섹션 헤더. ⚠️ igHead(SNS 점프·스크럽바용)는 하위 '[IG — 약 N자]' 헤더를 잡아 시작점이 요약 하단으로 밀림 → rev-fab이 본문 중간서 안 뜨던 원인(운영자 260705). 콘텐츠 초안 없는 옛 포맷은 igHead로 폴백(igHead 자체는 SNS용이라 불변).
function revStartHead() {
  const md = $('#mdbody'); if (!md) return null;
  return [...md.querySelectorAll('h1,h2,h3,h4')].find(h => /콘텐츠\s*초안/.test(h.textContent)) || igHead() || null;
}
// 요약 수정 FAB 가시 구간 — '콘텐츠 초안'이 화면 중앙 위로 올라온 뒤부터,
// '이 기사의 시사점'이 화면 중앙 위로 넘어가기 전까지. (둘 다 화면 중앙 기준 = 사용자 정의)
function revFabVisible() {
  const dlg = $('#dlg'); if (!dlg || !dlg.open) return false;
  const sum = $('#ph-sum'); if (!sum) return false;
  const centerY = window.innerHeight / 2;
  const start = revStartHead() || sum;                      // 콘텐츠 초안 섹션(igHead SNS용과 분리) — 없으면 요약 섹션 시작
  if (start.getBoundingClientRect().top > centerY) return false;   // 아직 콘텐츠 초안 전(중앙 밑) → 숨김
  const endH = sisaHead();                                  // 이 기사의 시사점
  if (endH) return endH.getBoundingClientRect().top > centerY;     // 시사점이 중앙 위로 넘어가면 숨김
  return sum.getBoundingClientRect().bottom > centerY;      // 시사점 헤더 없는 옛 포맷 → 요약 섹션 끝 기준
}
function updateRevFab() {
  const fab = $('#revFab'); if (!fab) return;
  const dlg = $('#dlg');
  const show = !!(dlg && dlg.open && !revdlg.open && !$('#crevdlg').open && revFabVisible());   // 팝업(요약·카드) 열려 있으면 FAB 숨김(겹침 방지)
  fab.classList.toggle('show', show);
  // #dlg가 positioned <dialog>(UA position:absolute)라 그 박스가 absolute 컨테이닝블록 → 내부 absolute는 콘텐츠와 함께 스크롤됨(backdrop-filter 무관 · 260704 컨테이너 blur 제거돼도 유효).
  // top을 scrollTop만큼 보정해 뷰포트 70%(중하단) 라인에 고정(스크롤해도 화면 같은 자리).
  if (show) fab.style.top = Math.round(dlg.clientHeight * 0.7 - 26) + 'px';
  applyReviseFab();   // FAB 재노출 시 잔류 표기 클래스 정리(표기 자체는 제거됨)
}
// ── 🃏 카드 수정 FAB — 위 요약 수정 FAB의 카드판 미러. 노출=카드 프롬프트 구간(#ph-card~#ph-feed 직전 = 이미지 생성 직전), 색=cards.crev(요약 a.rev과 독립 = 따로 돎). ──
function crevFabVisible() {
  const dlg = $('#dlg'); if (!dlg || !dlg.open) return false;
  const a = CUR ? DATA.find(x => x.file === CUR) : null;
  const st = a && a.cards ? (a.cards.state || '') : '';
  if (st !== 'text_done' && st !== 'done' && st !== 'fired_partial') return false;   // 카드 프롬프트 있을 때만(수정 대상)
  const card = $('#ph-card'); if (!card) return false;
  const centerY = window.innerHeight / 2;
  if (card.getBoundingClientRect().top > centerY) return false;             // 아직 카드 프롬프트 구간 전(중앙 밑) → 숨김
  const feed = $('#ph-feed');
  if (feed && !feed.hidden) return feed.getBoundingClientRect().top > centerY;   // 이미지(피드) 넘어가면 숨김 = '이미지 생성 직전'까지만
  const sec = $('#cardsec');
  return sec ? sec.getBoundingClientRect().bottom > centerY : true;         // 피드 없으면(text_done) 카드섹션 끝 기준
}
function applyCrevFab() {
  const fab = $('#crevFab'); if (!fab) return;
  const pending = !!(CUR && isCardRevising(CUR));
  const a = CUR ? DATA.find(x => x.file === CUR) : null;
  const g = a && a.cards ? (Number(a.cards.crev) || 0) : 0;   // 카드 수정 회차 — 요약 a.rev과 독립(0 초록·1 노랑·2 파랑 순환)
  fab.classList.toggle('revving', pending);
  fab.classList.toggle('locked', pending);
  fab.classList.toggle('revdone', !pending && g > 0);
  if (pending) {
    fab.style.setProperty('--rv-from', 'rgb(' + revColor(g) + ')');
    fab.style.setProperty('--rv-to', 'rgb(' + revColor(g + 1) + ')');
    fab.style.setProperty('--rv-ring', 'rgba(' + revColor(g + 1) + ',.5)');
  } else if (g > 0) {
    fab.style.setProperty('--rv-solid', revColor(g));
  }
}
function updateCrevFab() {
  const fab = $('#crevFab'); if (!fab) return;
  const dlg = $('#dlg');
  const show = !!(dlg && dlg.open && !$('#crevdlg').open && !$('#revdlg').open && crevFabVisible());   // 팝업 열렸으면 숨김(겹침 방지)
  fab.classList.toggle('show', show);
  if (show) fab.style.top = Math.round(dlg.clientHeight * 0.7 - 26) + 'px';   // 요약 FAB과 동일 = 뷰포트 70% 라인 고정(구간 안 겹쳐 동시 노출 없음)
  applyCrevFab();
}
function jumpTo(which) {
  const sec = $('#cardsec');
  let el;
  if (which === 'n')      el = $('#ph-sum');                       // 1/4 요약(시작 = 위 구분선)
  else if (which === 's') el = igHead() || $('#ph-sum');           // 2/4 SNS 요약(인스타 초안 시작점)
  else if (which === 'm') el = $('#ph-card');                      // 3/4 프롬프트 — 카드뉴스 텍스트
  else if (which === 't') { const f = $('#ph-feed'); el = (f && !f.hidden) ? f : (sec.querySelector('.mkbtn') || $('#ph-card')); }  // 4/4 카드 피드
  if (!el) return;
  const d = el.closest('details'); if (d) d.setAttribute('open', '');   // 접혀 있으면 펼침
  const db = $('#dlgbody');
  requestAnimationFrame(() => {
    const top = db.scrollTop + (el.getBoundingClientRect().top - db.getBoundingClientRect().top);
    db.scrollTo({ top: Math.max(0, top), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
}
const esc = s => String(s ?? '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));   // String() = 비문자열(숫자·객체) 입력도 안전(api/candidates 직독 등 빌드 우회 대비) · ' 포함 = 홑따옴표 속성 컨텍스트 잠재 우회 봉합(평의회 260713 ⑥)
const dimTags = s => { const t = String(s ?? ''); const m = t.match(/((?:#[A-Za-z0-9_]+[  ]*)+)$/); return (m && m[1].trim()) ? esc(t.slice(0, m.index)) + '<span class="tag-dim">' + esc(m[1].replace(/[  ]+$/, '')) + '</span>' : esc(t); };   // 끝쪽 순수 영문 해시태그 뭉치 = mut 회색(운영자 260719 "회색으로 흐리게") — 번역 못 하는 영문 태그 잔재를 시선서 낮춤(정보 보존 · 한글 해시태그·본문 온전 = 비라틴 경계서 멈춤) · esc 경유 = XSS 안전(fillH 신뢰 HTML 계약 준수)
// URL 속성 전용 — 위험 스킴(javascript:·data:·vbscript:) 차단 후 esc. 외부 출처(CSE 검색 link/img) href·src 하드닝.
const escUrl = u => { const s = String(u ?? '').trim().replace(/[\u0000-\u001f]/g, ''); return /^(javascript|data|vbscript):/i.test(s) ? '#' : esc(s); };   // 제어문자 스트립 = `java\tscript:` 류 스킴 검사 우회 봉합(평의회 260711 하드닝 — 브라우저는 탭/개행 제거 후 스킴 해석)
const hrefOk = u => { const s = String(u ?? '').trim().replace(/[\u0000-\u001f]/g, ''); return /^(javascript|data|vbscript):/i.test(s) ? '#' : s; };   // DOM .href 프로퍼티 대입용(HTML 이스케이프 X·스킴만 차단 — 앵글9 · 동일 하드닝)
// ── 설치앱(홈 화면 아이콘 = display:standalone) 새 탭 폴백 봉합(운영자 260731 "TOP 10 내역 클릭해도 반응 없음") ──
//   iOS 설치앱은 target="_blank" 링크를 **통째로 무시**한다(새 탭도·현재 창 이동도 없음 = 탭해도 무반응).
//   임베드 불가 항목(구글 검색 URL 등 X-Frame-Options 차단분)은 trEmbed null → 새 탭 폴백이라 이 함정에 그대로 빠졌다
//   (실측 260731 TOP 10 전 행 클릭: 틱톡·유튜브 7행 = 인앱 모달 정상 / 구글 3행 = 모달 0·새 탭 = 설치앱서 무반응).
//   처방 = 위임 1핸들러(레포 관용구): **iOS 설치앱에서만** 가로채 같은 창 이동으로 대체("반응 0" 탈출).
//   판정 = navigator.standalone === true 한정(사파리 전용 비표준 플래그 = 깨지는 그 플랫폼만 정조준):
//     · 안드로이드 크롬 설치앱·데스크톱 설치앱 = display-mode:standalone이지만 새 탭이 정상 작동 → 무접촉(하이재킹 금지)
//     · 브라우저 탭 = 전부 무접촉 = 종전 그대로
//   ⚠ window.open 사용 금지 — 이 앱은 전역에 `async function open(a)`(기사 열기)를 선언해 window.open을
//     **가린다**(실측 260731: window.open(url)이 기사 열기로 새어 들어가 Promise[truthy] 반환 = 폴백 침묵 실패).
const nmStandalone = () => matchMedia('(display-mode: standalone)').matches || !!navigator.standalone;   // 설치앱 판정 정본(구 pushToggle 인라인 중복 흡수 · 안내문·표시용 = 플랫폼 무관 광의)
document.addEventListener('click', e => {
  if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey) return;   // 앱이 이미 처리(인앱 모달·스와이프 억제 등) = 무접촉 · 보조클릭·수식키 = 브라우저 기본 존중
  if (navigator.standalone !== true) return;   // iOS 설치앱 한정(광의 nmStandalone 아님 = 멀쩡한 플랫폼 무접촉)
  const a = e.target.closest && e.target.closest('a[target="_blank"]');
  if (!a) return;
  const u = a.getAttribute('href') || '';
  if (!/^https?:\/\//i.test(u)) return;   // 외부 http(s)만(앱 내부 상대경로·해시 앵커 무접촉)
  e.preventDefault();
  location.href = u;   // 같은 창 이동 = iOS 설치앱 스와이프백으로 복귀
});


// Z: 요약 헤더 아래 기본 개요 — 대분류·매체·기자명·WRITE·IN. 기존 데이터만(기자명=본문 Fact 출처 패턴).
// 해외 매체(국제 발) = '기자' 호칭 스킵(국내 바이라인 관례). 국제부 거친 국내 매체는 매체명이 국내라 국내 취급. (목록 조정 가능 · 운영자 260621)
const FOREIGN_MEDIA = new Set(['BBC', 'BBC뉴스', '가디언', '더가디언', '알자지라', '블룸버그', '로이터', '로이터통신', 'AP', 'AP통신', 'AFP', 'CNN', '뉴욕타임스', 'NYT', '월스트리트저널', 'WSJ', '워싱턴포스트', '니혼게이자이', '요미우리', '아사히', 'NHK', '신화통신', '타스', '폴리티코', '악시오스']);
// 기자명 포맷(운영자 260621): 단독=「000 기자」 · 해외=「000」(기자 생략) · 2명+=「000 기자 외 N명」(해외=「000 외 N명」) · 빈값=생략.
function fmtReporter(rp, media) {
  rp = (rp || '').trim();
  if (!rp || rp === '-') return '';
  const foreign = FOREIGN_MEDIA.has((media || '').trim());
  const sfx = foreign ? '' : ' 기자';                                  // 국내=「기자」 호칭 / 해외=생략(관례)
  const nm = s => { s = s.trim(); const i = s.indexOf(' '); return i < 0 ? '<b class="ov-rp">' + esc(s) + '</b>' : '<b class="ov-rp">' + esc(s.slice(0, i)) + '</b>' + esc(s.slice(i)); };   // 이름(첫 어절)=흰색 · 직함(특파원 등)=기본(운영자 260621)
  const ex = rp.match(/^(.+?)\s*외\s*(\d+)\s*명/);                      // 이미 '외 N명' 형식이면 보존
  if (ex) return nm(ex[1].replace(/\s*기자\s*$/, '').trim()) + sfx + ' 외 ' + ex[2] + '명';
  rp = rp.replace(/\s*기자\s*$/, '').trim();                            // 끝 '기자' 제거(중복 방지)
  const names = rp.split(/\s*[,·、\/]\s*/).map(s => s.trim()).filter(Boolean);
  if (names.length >= 2) return nm(names[0]) + sfx + ' 외 ' + (names.length - 1) + '명';   // 2명+ = 000 기자 외 N명(운영자 260621)
  return nm(names[0] || rp) + sfx;                                    // 단독: 국내=000 기자 / 해외=000
}
function overviewMeta(a) {
  const cat = catBucket(a.category);
  const rp = ((a.body || '').match(/출처[:：]\s*[^()\n]*\(([^)]+)\)/) || [, ''])[1].trim();
  const inn = inDateTime(a);
  const sep = '<span class="ov-sep">·</span>';
  const line1 = [];   // 1줄 = 대분류·매체·기자명
  if (cat) line1.push(`<span class="ov-cat" style="color:${CAT_COLOR[cat]}">${esc(cat)}</span>`);
  if (a.media) line1.push(`<span class="ov-media">${esc(a.media)}</span>`);
  const rpf = fmtReporter(rp, a.media); if (rpf) line1.push('<span class="ov-rp-row">' + rpf + '</span>');   // 래퍼=flex 1아이템(이름 span↔직함/'기자' 띄어쓰기 보존 · flex가 별개 아이템 경계공백 먹던 것 차단 · 운영자 260621)
  const line2 = [];   // 2줄 = WRITE(보도일시)·IN(적재)
  const _wd = repDateTime(a); if (_wd && _wd.trim() && _wd.trim() !== '-') line2.push(`<span class="ov-l">보도</span><span class="ov-d">${esc(_wd)}</span>`);   // 보도일시(옛 WRITE) 확인 어려우면(빈값) 스킵(운영자 260621·260625 용어한글화)
  if (inn.txt) line2.push(`<span class="ov-l">스크랩</span><span class="ov-d">${esc(inn.txt)}</span>`);   // 스크랩(옛 IN=적재)
  return `<div class="ovmeta">${line1.join(sep)}<span class="ov-nl"></span>${line2.join(sep)}</div>`;
}

// ── 알림·메시지 ──
let MSGS = [];
// 맞춤법 검사기 건강 — thumb.html이 실사용 결과를 localStorage('nomute_shc')에 기록 + 여기서 오래되면 능동 프로브.
// 불건강이면 프로필 노란 링 + 메시지(고칠 때까지 유지) · 정상화되면 자동 소멸. (운영자 260623)
let SHC = null;
const SHC_PROBE_TTL = 3 * 3600e3;   // 신호 없음/오래됨(3h) → ?selftest 백스톱 프로브
const shcBad = () => !!(SHC && SHC.healthy === false);
function healthMsg() {
  if (!shcBad()) return null;
  let when = ''; try { when = SHC.ts ? new Date(SHC.ts).toLocaleString('ko-KR', { hour12: false }) : ''; } catch {}
  return { _health: true, text: '맞춤법 검사기 점검 필요 — 자동 교정이 멈췄어. 고치면 사라져.', ts: when };
}
// 새 버전(새 index 셸 배포 감지) = 클라이언트 알림을 메시지함 항목으로(운영자 260724 "UI 바뀔 때마다 알림도 메시지함으로") —
//   튀는 토스트 팝 대신 조용한 채널. _health 계열(클라 전용·id 없음·삭제불가·시스템 구분) + action='shell-apply'(→ '반영하기').
let _shellUpdPending = false, _shellUpdWhen = 0;
function shellUpdMsg() {
  if (!_shellUpdPending) return null;
  return { _health: true, _shellupd: true, action: 'shell-apply', t: _shellUpdWhen || undefined,
           text: '새 버전이 나왔어요 — 반영하면 최신 화면으로 새로고침돼요. (안 눌러도 다음 진입 때 자동 반영)' };
}
// 갱신 실패(라이브 서빙 불가 = 지금 화면이 저장된 옛 사본) = 메시지함 항목(운영자 260725 "그 앱에 갱신된 내용이 있습니다 있어서 그거로 하면 될거같은데, 갱신이 안될때는 항상 그거 뜨게") —
//   문법 = 바로 위 shellUpdMsg() **그대로**(_health 계열·클라 전용·id 없음·삭제불가·시스템 구분 + action → 조치버튼). 다른 건 문구·액션뿐 = 새 부품 0.
//   왜 필요 — 이 상태에선 신규 뉴스가 화면에 안 들어오는 게 *맞는데* 원인이 '수집 고장'이 아니라 '서빙 실패'라, 붉은 경보(checkFreshLane)는 오탐이라 껐다.
//   끄기만 하면 낡은 화면을 조용히 보게 되므로 원인에 맞는 채널로 항상 고지 = 상주(회복되면 자동 소멸 · 삭제·스누즈 없음 = "항상").
let _staleWhen = 0, _staleShown = false;
function staleDataMsg() {
  if (!_staleShown) return null;
  return { _health: true, _stale: true, action: 'data-retry', t: _staleWhen || undefined,
           text: '갱신이 안 되고 있어요 — 지금 화면은 저장된 옛 사본이라 새 뉴스가 안 보여요. 다시 받아오면 최신으로 돌아와요.' };
}
function syncStaleMsg() {   // 상태 변화에서만 배지·목록 갱신(매 폴 재렌더 방지) — flagShellUpdate 본문 문법 계승
  const bad = candStale();   // !CAND_LIVE → candStale(260731): 라이브 소스에서 받았어도 **받아온 지 오래면**(fetch 연속 실패 = 지금 화면이 옛 사본) 여기가 켜져야 한다. 붉은 경보(checkFreshLane)가 같은 축으로 자격미달 판정될 때 그 자리를 이 노란 항목이 메우는 짝 = 게이트가 무알림 침묵으로 안 떨어짐(CLAUDE.md [관측])
  if (bad === _staleShown) return;
  _staleShown = bad; if (bad) _staleWhen = Date.now();
  try { renderMsgBadge(); } catch {}   // 프로필 상태·카운트 갱신
  try { const mp = $('#msgpop'); if (mp && !mp.hidden) renderMsgList(); } catch {}   // 메시지함 열려있으면 즉시 목록 반영
}
// 수집 고장(서버 축) = 알림메세지 항목(운영자 260725 "설정에 알림메세지 만들고 이런 시스템 에러메세지 수집되게 · 체크 표시 누르면 없어지고, 그 전까지는 설정 픽토그램이 극보수 색") —
//   문법 = 바로 위 staleDataMsg() **그대로**(클라 생성·구분 '시스템'). 다른 건 딱 하나 = **id 부여** → ✓(확인)로 치울 수 있고 계정 md축(msgDismiss)으로 전 기기 동기.
//   소스 = sns_trends.json `health.subs.stale`(260713부터 이미 쌓이던 "등록 계정은 있는데 이번 런 0건" 목록 · 새 수집·새 데이터 축 0 = 있는 걸 화면에 꺼낸 것뿐).
//   id에 수집일자를 물려 = 확인하면 그날은 침묵 · 다음 날도 여전히 고장이면 새 id로 다시 고지(영구 묵음 = 사고 은폐라 금지).
//   원인·조치 안내(운영자 260726 "만약에 이게 내가 해야될 내용이면 그거에 대한 설명이 뜨게") — 같은 "0건"이라도 **누가 고쳐야 하는지가 갈린다**:
//     · 폰 축(스레드·인스타) = 메타가 데이터센터 IP를 막아 러너가 못 부른다 → 폰(termux·맥) 크론이 유일 공급원(scraper/sns_trends.py insta_subs·threads_subs docstring) = **운영자 조치**.
//         - 폰이 멈춤(health.phone.ok=false = 파일 나이 >90분) → 크론 살리기.  - 폰은 도는데 0건 → 메타 로그인월 = 부계 세션쿠키(<PLAT>_COOKIE) 주입(260726 실측: 스레드는 쿠키로 살아났고 인스타는 미주입 사각).
//     · 러너 축(X·틱톡·유튜브) = 서버가 30분마다 자동 재시도 → 조치 없음(계속 뜨면 계정 생사만 확인).
//   판정 소스 = 이미 화면이 읽는 TRENDS.health.phone(1738행 하트비트) — 새 데이터·새 수집·새 UI 부품 0. id·✓축·구분은 종전 그대로(문구만 갈래).
const SYS_PLAT_KO = { x: 'X', tiktok: '틱톡', insta: '인스타그램', youtube: '유튜브', threads: '스레드' };
const SYS_PHONE_PLAT = { insta: 'INSTA_COOKIE', threads: 'THREADS_COOKIE' };   // 폰 전용 공급원 = 값은 그 플랫폼 세션쿠키 env 이름(폰 crontab 주입 · 레포 커밋 0)
const _sysDurKo = (m) => { m = Math.max(0, Math.round(Number(m) || 0)); const h = Math.floor(m / 60), mm = m % 60; return h ? (h + '시간' + (mm ? ' ' + mm + '분' : '')) : (mm + '분'); };
function sysErrMsgs() {
  const up = String((TRENDS && TRENDS.updated) || ''), day = up.slice(0, 10) || '';
  const hh = (TRENDS && TRENDS.health) || {};
  const st = (hh.subs || {}).stale || [];
  const ph = hh.phone || null, phDead = !!(ph && ph.ok === false);   // ok=false = 폰 파일이 90분 넘게 안 갱신됨(러너가 폰분 채택을 거른 상태)
  const cov = (hh.subs || {}).cover || {};
  // 전멸 알림 = **막혔을 때만** 띄운다(운영자 260729 "가져올게 없는거라면 그거는 알림 안오게 — 시스템 구조 문제가 아니니까").
  //   stale은 "이번 런 신선 수집 0건"이라 원인을 안 가린다(scraper/sns_trends.py L1942) → 종전엔 원인 불문 "메타 로그인월"로 단정했다.
  //   260729 판례: 스레드 등록 4계정 중 @aicoffeechat·@promppy_com은 302로 막혔지만, @choi.openai·@kopp는 **정상 응답인데
  //   24h 내 새 글이 없어** 0건이었다(수집기 fresh 필터 L1183 · 화면 잔여 9건 = 40~45h 전 승계분) = 사고가 아닌 정상 침묵인데
  //   "부계 쿠키를 갈아라"는 헛 조치를 시켰다.
  //   판정은 cover.got(수집 성공 계정 수) 하나로 갈린다 — got>0 = 최소 한 계정이 페이지를 정상으로 받았다 = 경로는 안 막혔다 = 침묵.
  //   막힌 계정이 섞여 있어도 은폐가 아니다: 그 계정은 **아래 cover 축이 계정별로 이미 보고**한다(중복 1건만 제거).
  //   got=0(전멸) = 진짜 차단이라 종전 문구 그대로 · cover가 아예 없으면(reg=0) 판단 근거가 없으니 종전대로 띄운다(무근거 침묵 금지).
  const out = (Array.isArray(st) ? st : []).filter(k => SYS_PLAT_KO[k]).filter(k => {
    const c = cov[k] || {}, _got = c.got | 0, _reg = c.reg | 0;
    return !(_reg && _got);
  }).map(k => {
    const head = SYS_PLAT_KO[k] + ' 구독이 안 걷히고 있어요 — ';
    let text, _c = 'srv';   // _c = 사유 갈래 태그(id에 물린다 · 260730 적대검증 C-D4) — 종전 id는 날짜만 물어, 아침에 '대기' 알림을 ✓ 처리한 뒤 낮에 폰이 죽어도 같은 id라 "폰 크론 살려라"가 하루 통째로 소실됐다(계정 축은 이미 사유를 id에 문다 = 두 축 규약 정합)
    // 대기 사유 판정(운영자 260730 "ip 제한 걸려있다가 자동으로 들어온다고했는데") — 종전 이 분기는 `why`를
    //   **한 번도 안 읽고** 폰 축이면 무조건 "메타 로그인월 = 쿠키 갈아라"로 단정했다. 실제 원인이 레이트리밋
    //   백오프(폰이 일부러 쉬는 중)여도 이미 넣어둔 쿠키를 또 넣으라는 헛 조치가 나갔다(260730 판례).
    //   원인별 문구는 아래 cover 축이 이미 정확히 가르는데, 그 축은 got=0(전멸)이면 통째로 억제돼(L7588)
    //   전멸일수록 틀린 문구만 남는 이중 사각이었다 → 여기서 같은 사유 코드를 읽어 대기/조치를 가른다.
    //   'cooldown'·'gap' = 폰이 스스로 쉬는 중(scripts/phone_subs.py _skip_stamp) · 429 = 플랫폼 레이트리밋.
    //   ⚠ 분모에서 '미시도'를 뺀다(260730 적대검증 C-D2) — rotate는 회전 구조상 **항상 15/20 = 75%**라
    //     그것만으로 과반이 확정돼, 실제로 시도된 5계정이 무슨 사유든(쿠키 만료 wall 포함) 대기 문구가 이겨
    //     "기다리면 됨"으로 덮였다 = 이 봉합이 고치려던 헛 조치의 정반대 재발. 판정은 **시도된 사유끼리** 한다.
    const _wv = Object.values((cov[k] || {}).why || {}).map(v => String(v));
    const _try = _wv.filter(v => v !== 'rotate' && v !== 'budget');   // 실제로 시도된 계정의 사유만
    const _wait = _try.filter(v => v === 'cooldown' || v === 'gap' || v === '429').length;
