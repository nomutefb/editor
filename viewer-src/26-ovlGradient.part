    //   쿠키를 건드리지 말라는 정반대 안내(실측 = 폰 자체 기록 260905 14:35 인스타 5계정 HTTP 401 · 회전 5계정씩 260904 07:10부터).
    const _sessN = _try.filter(v => v === '401' || v === '403').length, _wallN = _try.filter(v => v === 'wall').length;
