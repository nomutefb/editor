</script>
<!-- 부팅 스플래시 폐지(운영자 260706 "항상 바로 본화면") — 인트로 역할은 잠금화면 워드마크 1초 시퀀스가 승계 · OS(WebAPK) 스플래시는 시스템 소유라 제거 불가(한계 고지) -->

<div class="topclock"><span class="dh-date" id="dhDate"></span><span class="dh-sep"></span><span class="dh-clock" id="dhClock"></span><span class="dh-cnt" id="dhCnt"></span></div>
<div class="topbanner slim"><!-- slim = 워드마크 헤더 모드(운영자 260706) — 배너·펫 시각 원복 = slim 클래스 제거 + 배너 img data-src→src + head 배너 preload 원복. ⚠️ 검색·설정 컨트롤은 타이틀 라인(.vh-acts) 영구 이주·아바타 img 삭제됨 = slim 제거로 안 돌아옴(평의회5 현행화) -->
  <div class="hdr-globe" aria-hidden="true"></div><!-- 헤더 지구본 히어로(운영자 260723 · 첨부2 통일) — 투명 지구본 워드마크 뒤 배경 · CSS .hdr-globe -->
  <h1 class="brandmark">News Curation</h1><!-- h1 승격 = 문서 아웃라인 정합(h1 워드마크 → h2 메뉴 타이틀 · 평의회4 260706) — 셀렉터는 클래스라 무회귀 · 마진은 .brandmark 규칙이 0 고정 -->
  <h2 class="vh-title" id="vhTitle">뉴스 요약</h2><!-- 메뉴 타이틀 = 워드마크 서브(운영자 260706 3차 — 타이틀 라인서 이주·200% 축소·워드마크 폰트 계승·영문 리네임) · 텍스트 = setViewhead(VIEWHEAD)가 탭별 갱신 · 이름 정본 = CLAUDE.md §표기표준 뷰어 메뉴 용어집 -->
  <div class="bannerframe"><div class="bannerclip">
    <img class="banner layer-feed" data-src="assets/brand/main_background.jpg?v=260705t" alt="THE RIGHT TO TELL PEOPLE WHAT THEY DO NOT WANT TO HEAR. — GEORGE ORWELL" fetchpriority="high"><!-- 슬림 헤더(260706): src→data-src 대기 = 숨김 배너 다운로드 0 · _bannerReady는 src 없음=complete 즉시 통과(부팅 무영향·오히려 가속) -->
    <!-- 탭별 배너 레이어 폐지(260705) — 단일 배너 --><!-- 숨은 배너(opacity 0) = data-src 지연 로드(부팅 대역폭 절약) → showTab이 scrap 탭 진입 시 src 세팅(loadBanner) · 운영자 260705 로딩 최적화 -->
    
  </div></div>
  <canvas class="lovemarq" id="marqCanvas" width="1080" height="1080" aria-hidden="true"></canvas><!-- LOVE 마퀴펫 정사각 씬(1080²·풀세트: 펫이 사다리 올라 간판에 LOVE♥ 놓고 점등) — marquee.js 렌더·투명 배경(뒤 브랜드 배너 비침)·NOW SHOWING=페이지 강조색(window.LOVE_ACCENT). 뉴스요약 탭 전용(260704 C안) -->
  <img class="pet" src="pet.webp" alt="" aria-hidden="true" draggable="false" decoding="async" fetchpriority="low"><!-- 전 탭(뉴스요약·레거시·SNS) = 옛 산책 펫(공놀이) — 260704 '100% 롤백'(운영자) -->
  <!-- 검색·새로고침·설정(구 프로필) 컨트롤 = 타이틀 라인(.vh-row)으로 이동(운영자 260706) — 메시지함/잠금/전광판 팝업(fixed·JS 좌표)은 여기 잔류. ⚠️ 이들이 .topbanner 자식인 한 .topbanner엔 transform/filter/backdrop-filter/will-change 금지(생기면 fixed 컨테이닝 블록이 배너로 바뀌어 3팝업이 화면 밖으로 날아감 = §디자인 h 함정 · lockscr는 이 이유로 body 직속 · 평의회3 260707) -->
  <div class="qpop msgpop" id="msgpop" hidden>
    <div class="qh"><b>알림메세지</b><span class="qc" id="msgpopcnt"></span><button class="tool-x dlbtn msg-dlall" id="msgDlAll" type="button" aria-label="문제 다운로드" title="지금 해결할 문제만 모아 HTML로 받기(클로드 전달용)" hidden><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M5 21h14"/></svg></button><span class="qh-xcell"><button class="tool-x" id="msgclose" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div><!-- 헤더 [↓][X] = 키워드함 .qh 「+ 옆 X」(#kwAddOpen) 100% 모방(같은 .tool-x 부품·svg 15/stroke 2/round) · path만 DOWNLOAD_SVG(nm-svg.js 정본) 계승 · 색 = .dlbtn 전 앱 다운로드 표준(재설계 0) · 자리 = .qc(margin-left:auto 스페이서) 뒤 = X 왼쪽 gap 6 · 표시 = 대상 0건이면 hidden(renderMsgList가 토글) -->
    <div class="qlist" id="msglist"></div>
    <div class="msgdetail" id="msgdetail" hidden>
      <button class="msgback" id="msgback" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>목록</button>
      <div class="md-meta"><span class="md-kind" id="mdKind"></span><span class="md-time" id="mdTime"></span></div>
      <div class="md-body" id="mdBody"></div>
      <div class="md-act" id="mdAct" hidden></div><!-- 조치형 알림(m.action) '다시 받아오기' 등 버튼 자리 · openMsgDetail이 렌더(260723) -->
    </div>
  </div>
  <!-- 잠금 설정 팝업 = 메시지함(msgpop) 계승 · 행 = pushrow/pushbtn 계승(운영자 260703) · PIN 변경(구 lkRowPin)은 설정 직하위 독립 항목으로 이관(요구6·7 · 260710) → 자동잠금 시간만 -->
  <div class="msgpop" id="lockpop" hidden>
    <div class="mh"><b>자동 잠금</b><button class="mx" id="lockpopX" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
    <div class="pushrow lk-sub" id="lkRowMin"><span class="pl">자동 잠금(분)</span><span class="lk-stval" id="lockMin" aria-live="polite">2</span></div>
    <div class="lk-sldrow lk-sub" id="lkSldRow"><span class="lk-cap">1</span><div class="lk-track" id="lkTrack" role="slider" aria-label="자동 잠금 분" aria-valuemin="1" aria-valuemax="60" aria-valuenow="2" tabindex="0"><div class="lk-rail"></div><div class="lk-fill" id="lkFill"></div><div class="lk-thumb" id="lkThumb"></div></div><span class="lk-cap">60</span></div>
  </div>
  <!-- 전광판(마퀴펫) 설정 팝업 = 잠금 설정(msgpop) 계승 · 문구·글자색 커스텀 → marquee.js 실시간 반영(260704) -->
  <div class="msgpop" id="marqpop" hidden>
    <div class="mh"><b>전광판</b><button class="mx" id="marqX" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
    <div class="pushrow"><span class="pl">문구 (최대 5자)</span><span class="lk-grp"><input class="lk-in marq-kw" id="marqKwIn" type="text" maxlength="5" placeholder="LOVE♥" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"></span></div>
    <div class="pushrow"><span class="pl">글자색</span><span class="marq-cols" id="marqCols"></span></div>
  </div>
</div>
<!-- 화면 잠금 오버레이(오션 물결 배경 + 옅은 블루-딤 · 물결=#wavebg 승격) — body 직속 = #wavebg/.bgfx 형제(.topbanner 스태킹 컨텍스트 의존 제거 = 조상에 transform/filter 생겨도 잠금 z 안 갇힘 · 평의회3 260705) · PIN 키패드 = 발행본 정본 이식(운영자 260703·260705) -->
<div class="lockscr" id="lockscr" hidden>
  <div class="lk-wm" aria-hidden="true"><b>News Curation</b><small>뉴스 큐레이션</small></div><!-- 인트로 워드마크 타이틀 복원(운영자 260707 "비슷한 화면에 타이틀을 같은 크기로 배치") — OS 스플래시 로고가 강제(못 없앰·아이콘 필수)라, 인트로에서 빼면 스플래시↔인트로 미스매치 → 도로 넣고 스플래시 워드마크와 크기 정합. 크기 = .lk-wm b/small(290~291) 조정 · 페이드인 = lkWmFade(288) -->
  <div class="lk-card">
    <div class="lk-slotwrap"><div class="lk-slots" id="lkSlots" aria-hidden="true"><span class="lk-slot"></span><span class="lk-slot"></span><span class="lk-slot"></span><span class="lk-slot"></span></div><svg class="lk-okring" aria-hidden="true"><rect pathLength="100"/></svg></div><!-- 4자리 전환(운영자 260706) · 눈 버튼 제거 = 4자리라 불요(3차 f) · 래퍼 = 글래스 플레이트 · okring = PIN 성공 시 테두리 스윕(운영자 260706 4차 l "인증돼서 들어가는 느낌") -->
    <div class="lk-err" id="lkErr" role="alert" aria-live="assertive"></div>
    <div class="lk-pad" id="lkPad"></div>
  </div>
</div>

<!-- 검색 중앙 오버레이(운영자 260706 5차 플레이그라운드 확정 · "동작 유지·문구만 삭제" 버튼확답) — 돋보기 탭 = 딤·블러 + 중앙 글래스 필. 바깥 탭/Enter/뒤로가기 = 닫힘(검색어·필터는 유지 = 결과 탐색 · 돋보기 점등이 상태 표시). 빈 상태 산문 0(§디자인 e). body 직계 = transform 조상 없음(fixed 함정 §디자인 h 회피) -->
<div class="sovl" id="sovl" hidden>
  <div class="sov-bg" aria-hidden="true"></div>
  <div class="sov-box">
    <div class="sov-pill" id="sovPill">
      <span class="sov-cap" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></span>
      <input id="q" type="search" placeholder="검색" aria-label="검색" tabindex="-1" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" name="nomute-q" enterkeyhint="search" data-1p-ignore data-lpignore="true" data-form-type="other"><!-- 자동완성·autofill 차단 4종 세트 불변(운영자 260628 · check_refs 게이트) · tabindex -1 = 오버레이 닫힘 상태 유령 포커스 차단(열림 시 JS가 0 복원) -->
      <button class="sov-x" id="sovClr" type="button" aria-label="검색 종료"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button><!-- 우측 픽토그램 = 돋보기(강조색·항상 표시) · 재클릭 = 검색어 비움+오버레이 닫기 = 완전 해제(운영자 260710 재설계) -->
    </div>
    <!-- (구 sov-results 결과목록 폐지 — 결과 = 뒤 리스트 직접 필터 · 재설계 260710) -->
  </div>
</div>

<div class="viewhead" id="viewhead">
  <div class="vh-row"><!-- 타이틀 라인(운영자 260706 3차 재편·260707 필터 스왑): 타이틀 = 워드마크 서브로 이주(.topbanner.slim .vh-title) · 우측 클러스터(.vh-acts) = [검색][필터](새로고침·기어 도먼트 · 마진 한도 = 구 새로고침 슬롯) -->
    <span class="vh-time" id="vhTime"><span id="vhTimeTxt" aria-hidden="true"></span><button class="vh-rf" id="snsFreshBtn" type="button" hidden aria-label="SNS 지금 새로 수집" title="SNS 지금 새로 수집 — 반영까지 3~8분"><svg viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5"/></svg></button><button class="vh-rf" id="chanFreshBtn" type="button" hidden aria-label="채널 요약 지금 새로 수집" title="채널 요약 지금 새로 수집 — 반영까지 3~8분"><svg viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5"/></svg></button></span><!-- 수집 시각 = vh-acts(우상단) 대칭 정반대 좌상단 · 값 = renderSnsTrends(updated)/renderChan(generated_kst)이 #vhTimeTxt 세팅(구 #vhTime 직접 textContent = 260803 픽토 동거로 내부 스팬 이관) · 우측 = SNS 수동 재수집 픽토그램(운영자 260803 "밀릴 때 수동 개선" · trend 탭 전용 · 글리프 = #topRefresh 원형 화살표 그대로 · mut→pend 골드레몬 회전→done 강조 15분) -->
    <div class="vh-acts"><!-- 우상단 클러스터(운영자 260706 3차·260707 스왑): 피드 탭 = [검색][필터] 2개(DOM·시각 순 = 검색 먼저 · 필터 = 최우측 한도 슬롯 = 구 새로고침 자리 · 검색 = 그 왼쪽) · 그 외 탭 = 검색만(한도 슬롯) — 새로고침은 DOM 도먼트(CSS display:none · JS 불변) · 기어(설정)는 활성(260712 원복 · 표시 여부 정본 = .vh-acts .profile 규칙) · 클러스터 우측정렬 한도 = 구 새로고침 슬롯 -->
      <span class="ch-srcsw" id="chanSrcSeg"><button type="button" id="chanSrcTgl" data-cs="ig" class="on" aria-label="채널 소스: 현재 인스타 — 탭하면 페이스북"><span class="cs-rail" aria-hidden="true"><svg class="cs-ic" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5.4"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg><svg class="cs-ic" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></span></button></span><!-- 채널 소스 = IG/FB 아이콘 토글(운영자 260720 — 구 텍스트 IG/FB[Q233·Q265·Q273] 대체 · Lucide 스트로크 픽토그램[인스타 카메라 아웃라인·페북 f] · 브랜드 원색 아닌 강조색 단색=[14] 팔레트 준수) · 항상 점등(활성 소스만) · 탭 = 촤르륵 가로 슬라이드로 IG⇄FB 전환(data-cs가 .cs-rail translateX 구동) · 기본 IG · data-cs/aria/활성 동기 = renderChan · 채널요약 탭 전용 body[data-tab=chan] · .vh-acts 4px gap = 햄버거↔기어 동일 간격 · 픽토 클러스터와 4분할 중앙(align-items:center) -->
      <div class="topsearch" id="topsearch"><!-- #q 입력은 중앙 오버레이(#sovl)로 이주(운영자 260706 5차) — 여기는 토글 픽토그램만 · 피드 탭 = 검색이 필터 왼쪽(운영자 260707 [검색][필터] 스왑) · 그 외 탭 = 검색만(한도 슬롯) -->
        <button class="ts-toggle" id="searchToggle" type="button" aria-label="검색" aria-expanded="false"><svg class="ts-ico" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
        <button class="ts-toggle ts-rf" id="topRefresh" type="button" aria-label="강제 새로고침" title="강제 새로고침"><svg class="ts-ico" viewBox="0 0 24 24" fill="none"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v5h-5"/></svg></button>
      </div>
      <button class="vh-fbtn vh-qbtn" id="queueBtn" type="button" aria-label="분석 대기열" title="분석 대기열" aria-expanded="false" aria-controls="qpop"><svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg><span class="qbadge qbadge-head" id="qbadgeHead" hidden></span></button><!-- 대기열 = 헤더 중간 픽토그램(운영자 260710 2차 "필터 자리로 이동·고정") · 전탭 표시 · 클릭 = 픽토 아래 우변 앵커 촤르륵 · 하단 뉴스요약 제스처와 병존 · 층층 리스트 아이콘 · 필터는 설정 안으로 종속(헤더서 폐지) -->
      <button class="profile" id="profile" aria-label="설정 메뉴" title="설정"><svg class="ts-ico" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg><span class="pbadge" id="pbadge" aria-hidden="true"></span></button><!-- 설정 기어 = 옛 프로필 아바타 대체(운영자 260706 · 24vb·stroke round 규격) — 현 활성(display:grid · 260712 원복 · 표시 여부 정본 = .vh-acts .profile 규칙 = 이 주석 아님) · id·메뉴·배지·상태링 JS 불변 · 설정 진입 = 이 톱니→linkpop(260711 확정) -->
    </div>
    <input type="checkbox" id="cardonly" hidden><!-- 카드만 토글 상태(hidden) — 버튼 #cardonlyBtn·칩 #chips는 설정>필터 아코디언(#filterSub)으로 이관(운영자 260710) · 헤더 filterpop 팝업 폐지 -->
  </div>
  <p class="vh-sub" id="vhSub"></p>
  <div class="pmenu" id="pmenu" hidden><!-- 설정(기어) 메뉴 — 내용·동작 기존 그대로(운영자) · 기어 바로 아래 앵커 -->
    <div class="pmenu-h">
      <button id="refresh" class="pmenu-rf" aria-label="새로고침" title="새로고침"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg></button>
      <button id="pmenuX" class="pmenu-x" aria-label="닫기" title="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button>
    </div><!-- X = 최우측 · 새로고침은 그 좌측 · 노뮤트 로고 삭제(운영자 260705 "프로필 부분 로고 없애줘" — 옛 260629 '로고는 유지' 뒤집음) · Home·SNS 링크 삭제(운영자 260705 "홈페이지랑 SNS 이동하는 것도 없애줘") -->
    <!-- 메시지·발행본·설정 아코디언(알림·잠금) = #linkpop으로 이관(운영자 260707 통합) → pmenu는 도먼트(헤더만 · 진입로 lpSettings 핸들러 제거) · showPmenu/hidePmenu는 openMsgbox 등서 참조 유지(빈 껍데기 토글 안전) · 재분리 시 위 4줄 복원 · 전광판은 marqpop 도먼트 보존 -->
  </div>
</div>

<div class="tkrhost" id="tkrHost" aria-hidden="true"></div><!-- 실검 키워드 티커 호스트(운영자 260730 "4개 메뉴 전부") — 뷰(#trendview) 안 → 뷰 밖 전역 승격: 여기 = #viewhead 직하·전 뷰 위 = 탭 전환과 무관하게 항상 노출(feed·scrap·trend·chan 공통) · 내용 조립 = renderSnsTrends(로드 1회로 전 탭 동시 채움) · 장식(aria-hidden·pointer-events 0) = 열람 경로는 트렌드 탭 실검 레인이 정본 · 되돌림 = 이 줄 + CSS .tkrhost + 조립 블록 -->

<div class="wrap"><div id="list"></div></div>
<section class="scrapview" id="scrapview" hidden>
  <!-- 병합 액션 = 기준 카드 상단선 인라인 칩줄[기준·병합·X](.merge-tags) — JS가 앵커 카드에 주입. 플로팅 바·'기사 선택' 프롬프트 폐지(운영자 260629). -->
  <div id="scrapList"></div>
</section>
<section class="trendview" id="trendview" hidden><!-- 메뉴3 = SNS DIGEST(운영자 260713 쌍 구조 — 구 Trends + 구 메뉴2 합체) -->
  <div id="snsTrends"></div><!-- 트렌드 레인 — sns_trends.json 렌더 · 그룹① 국내 커뮤니티 = 아래 #snsview reparent -->
  <section class="snsview" id="snsview" hidden><div id="snsList"></div></section><!-- 국내 커뮤니티 본체(구 메뉴2 소셜 다이제스트) — renderSnsTrends가 #snsHost로 장착(askHost reparent 관례) · 장착 전 = trendview 말미(전이 무해) -->
</section>
<section class="chanview" id="chanview" hidden><!-- 메뉴4 = 채널 요약(운영자 260713) — 인스타 직결 신호(insta_data.json) · 빈 상태 = 조용한 공백(§디자인 e-가) -->
  <div id="chanBox"></div>
</section>
<div id="pgprog" aria-hidden="true"></div><!-- 페이지 스크롤 진행 게이지(장식·상태표시 = 화면 최상단 얇은 라인 · 260729) — 값 갱신 = fadeTop 합승 pgSync -->
<button class="totop" id="totop" aria-label="맨 위로" title="맨 위로"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V6M6 12l6-6 6 6"/></svg></button>

<dialog id="dlg">
  <div class="dlg-h"><div class="dlg-top"><span class="dlbox" id="dlbox"><button id="pdfBtn" class="dlg-pdf" type="button" data-motion="share" title="공개 링크로 발행" aria-label="공개 링크로 발행"><svg class="dl-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path pathLength="1" d="M15.4 6.5l-6.8 4"/><path pathLength="1" d="M8.6 13.5l6.8 4"/></svg></button></span><a id="src" target="_blank" rel="noopener" title="원문 열기" aria-label="원문 열기"><svg class="src-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="src-base" pathLength="1" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><g class="src-arrow"><path class="src-shaft" pathLength="1" d="M10 14 21 3"/><path class="src-tip" d="M15 3h6v6"/></g></svg></a></div><div class="dlg-prog" id="dlgprog"></div><button class="tool-x dlg-x" onclick="dlg.close()" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <!-- ⚠️ dlgprog(스크럽바 컨테이너) = setupScrub/updateScrub가 querySelector로 채움. cc276cd(PR 1619) 헤더 개편 시 CSS(.dlg-prog·.scrub)·JS는 넣고 이 HTML 요소를 빠뜨려 → 두 함수 early return → 스크럽바 + 요약/카드 수정 FAB 스크롤 갱신 전부 죽어있던 회귀 복구(운영자 260705) -->
  <div class="dlg-body" id="dlgbody">
  <details class="phase" id="ph-sum" open>
    <summary>1. 기사 요약 · 시사점</summary>
    <div class="md" id="mdbody"></div>
  </details>
  <details class="phase" id="ph-card" open>
    <summary id="cardsum">카드뉴스</summary>
    <div class="md" id="cardsec"></div>
  </details>
  <details class="phase" id="ph-feed" open hidden>
    <summary>3. 카드 뉴스</summary>
    <div class="md" id="feedsec"></div>
  </details>
  </div>
  <!-- 요약 수정 FAB — 콘텐츠 초안~시사점 스크롤 구간에만 점등(펜 모양 원·우측 중하단). 클릭 → revdlg 팝업(좌측 펼침).
       #dlg 직속(backdrop-filter 박스 기준 fixed) → 스크롤해도 모달 안에 고정. 옛 'rev-launch' 알약 대체. -->
  <button class="rev-fab" id="revFab" type="button" aria-label="요약 수정" title="요약 수정">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
    <span class="rev-hint">수정 중</span>
  </button>
  <!-- 🃏 카드 수정 FAB — 요약 수정 FAB(#revFab) 미러. 카드 프롬프트 구간(#ph-card~#ph-feed 직전)에만 점등. 색=cards.crev(요약 rev과 독립). 클릭 → crevdlg. 아이콘=카드스택(펜과 구분). -->
  <button class="rev-fab crev-fab" id="crevFab" type="button" aria-label="카드 수정" title="카드 수정">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5 9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>
    <span class="rev-hint">카드 수정 중</span>
  </button>
</dialog>

<!-- 슛(유료 발사) PIN 입력 — confirm/안내 다이얼로그·prompt 대체. 4칸 자동이동·자동인증 -->
<dialog id="pindlg">
  <div class="pin-head"><span class="pin-title" id="pinTitleTxt">PIN</span><span class="pin-busy" id="pinBusy" hidden>변경중…</span><button class="pin-x" type="button" id="pinX" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="pin-sub" id="pinSub">PIN 6자리 입력</div>
  <div class="pin-rise" id="pinRise" aria-hidden="true"></div><!-- '방금 PIN' 떠오름 힌트(요구6 재입력 단계) — lkRiseHint가 채움·height:0으로 아래 슬롯 위 겹침 -->
  <div class="pin-boxwrap"><div class="pin-slots" id="pinboxes" aria-hidden="true"><span class="pin-slot"></span><span class="pin-slot"></span><span class="pin-slot"></span><span class="pin-slot"></span><span class="pin-slot"></span><span class="pin-slot"></span></div>
    <input class="pin-in-h" id="pinInput" type="text" inputmode="none" maxlength="6" readonly autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="PIN 입력"><button class="pin-eye" type="button" aria-label="PIN 표시" title="PIN 표시" aria-pressed="false"></button></div>
  <div class="pin-err" id="pinerr" role="alert" aria-live="assertive"></div>
  <div id="pinSrLive" aria-live="assertive" style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);border:0"></div><!-- SR 전용 라이브 — 재입력 불일치 '무텍스트 흔들림'(요구6)의 접근성 보조(평의회 감사5 · 시각 무·SR만 고지) -->
  <!-- PIN 커스텀 키패드 = 잠금화면(.lk-key) 계승(운영자 260707 "키보드 입력말고 메인 화면 입력 계승") — OS 숫자키보드 폐지(#pinInput inputmode=none+readonly) · 탭 → #pinInput.value 갱신 → input 이벤트(슬롯·자동 resolve 재사용) · 고정 1-9·0 배열(설정 UX) -->
  <div class="pin-pad" id="pinPad" aria-hidden="true">
    <button type="button" class="lk-key pk" data-d="1">1</button><button type="button" class="lk-key pk" data-d="2">2</button><button type="button" class="lk-key pk" data-d="3">3</button>
    <button type="button" class="lk-key pk" data-d="4">4</button><button type="button" class="lk-key pk" data-d="5">5</button><button type="button" class="lk-key pk" data-d="6">6</button>
    <button type="button" class="lk-key pk" data-d="7">7</button><button type="button" class="lk-key pk" data-d="8">8</button><button type="button" class="lk-key pk" data-d="9">9</button>
    <button type="button" class="lk-key empty" tabindex="-1" aria-hidden="true"></button><button type="button" class="lk-key pk" data-d="0">0</button><button type="button" class="lk-key back" data-back="1" aria-label="지우기"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 5H9l-6 7 6 7h11a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1z"/><path d="M16 9l-4 4M12 9l4 4"/></svg></button>
  </div>
</dialog>

<!-- 트렌드(메뉴4) 구독 계정 관리 — 운영자 260711 승인('계정' 버튼 → 관리 모달) · 셸 = .modal-head/.modal-tabs 정본 계승 · 저장 = /api/snsacc 1커밋 · 수집 반영 = sns-trends 런(30분 주기 · SNS_SUBS 카나리아 승격 후 크론 ON = §📰-e) -->
<dialog id="snsaccdlg" aria-label="구독 채널 관리">
  <div class="modal-head"><b>구독 채널</b><span class="pin-busy" id="accBusy" hidden>저장중…</span><button class="tool-x dlg-x" type="button" id="accX" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="modal-tabs" id="accTabs" role="tablist">
    <div class="tooltab on" data-p="x" role="tab">X</div><div class="tooltab" data-p="tiktok" role="tab">틱톡</div><div class="tooltab" data-p="insta" role="tab">인스타</div><div class="tooltab" data-p="youtube" role="tab">유튜브</div><div class="tooltab" data-p="threads" role="tab">스레드</div><!-- insta 탭 라벨 릴스→인스타(운영자 260821 "인스타구독을 넣어야되는데 넣을 곳이 없어" — 피드 레인 정본은 「인스타그램 - 구독」인데 이 탭만 릴스라 인스타 넣는 자리를 못 찾았다 · data-p·저장 키는 insta 그대로 = 데이터 무접촉) -->
  </div>
  <div class="modal-tabs acc-regs" id="accCats" role="group" aria-label="분류" hidden><!-- 2차 = 분류(운영자 260730 "1차 선택지는 플랫폼 · 2차 선택지는 저 나눠진거") — 띠 = #accRegs 문법 100% 계승(새 CSS 0) · 내용 = ACC_CATS 플랫폼별 렌더 · 단일 분류 플랫폼(x·insta·threads·tiktok) = hidden --></div>
  <!-- (구 #accRegs 한국/세계 지역 띠 = 260821 폐지 · 운영자 "한국 세계 구분 없이 넣으면 해당 플랫폼 별 구독 리스트에 쌓이게" — 피드 레인은 이미 260724부터 지역 무관 단일 블록이라 고르게 할 이유가 소멸 · 저장 스키마 kr/gl은 유지[서버·수집기 무접촉 = kr부터 채우고 넘치면 gl] · 되돌림 = git 이력) -->
  <div class="acc-body">
    <!-- 구독 안내문(.acc-note) = 폐지(운영자 260823 "지금 이제 플랫폼 별로 구독채널만 설정값에 남았거든? 그래서 구독이라는 블릿하고 위에 안내문이 의미가없어 없애주라"). 사유 = 260823 2차 분류 폐지로 이 모달의 몸통이 「플랫폼별 구독 계정 목록」 하나로 좁혀졌다 → 그 사실을 설명하던 문장·라벨이 전부 중복 서술이 됐다(구독 말고 고를 것이 없다). CSS 규칙 .acc-note/.acc-glbl 은 잔존 = 도달 불가 분기(isKw·카테고리)가 참조 + 되돌림 원료. 되돌림 = 이 주석을 아래 구판 한 줄로 교체. -->
    <!-- (구) <div class="acc-note">넣은 계정의 최신 글을 그대로 가져옵니다 · 팔로우·알고리즘 무관(인기 랭킹엔 미반영)</div> -->
    <div class="acc-chips" id="accChips"></div>
    <div class="acc-addrow"><input type="text" id="accIn" placeholder="계정명 (예: OpenAI)" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="done" aria-label="계정명"><button class="ed-go acc-add" id="accPlus" type="button">추가</button></div>
    <div class="acc-err" id="accErr" role="alert"></div>
    <div class="acc-foot"><label class="acc-off"><input type="checkbox" id="accOff">구독 끄기(화면 숨김)</label><button class="ed-go" id="accSave" type="button">저장</button></div><!-- 구독 끄기 = 계정 목록은 두고 수집·알림·섹션만 끈다(sns_accounts.json <plat>.off) -->
  </div>
</dialog>

<!-- 트렌드 인앱 임베드 뷰어 — 운영자 260711 "웹앱 내 팝업 모달로 관련 링크" · 카드/행 탭 = 플랫폼 임베드 전용 URL(유튜브 embed·틱톡 embed/v2·릴스 /embed/·X platform embed) iframe · 임베드 불가 소스(실검 뉴스 등) = 종전 새 탭 · '원문' = 새탭 폴백(릴스 로그인벽 등 임베드 변덕 대비) -->
<dialog id="trviewdlg" aria-label="트렌드 보기">
  <div class="modal-head"><b id="tvTitle"></b><a class="tv-open" id="tvOpen" href="#" target="_blank" rel="noopener" title="원문 열기" aria-label="원문 열기"><svg class="src-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="src-base" pathLength="1" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><g class="src-arrow"><path class="src-shaft" pathLength="1" d="M10 14 21 3"/><path class="src-tip" d="M15 3h6v6"/></g></svg></a><button class="tool-x dlg-x" type="button" id="tvX" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="tv-body pt"><iframe id="tvFrame" title="임베드 콘텐츠" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><!-- referrerpolicy = strict-origin-when-cross-origin(브라우저 기본): 유튜브 임베드 플레이어는 부모 origin(referrer)로 도메인 임베드 허가를 검증 → no-referrer면 referrer 통째 제거돼 '오류 153 동영상 플레이어 구성 오류'로 재생 불가(운영자 260712 스샷 실측·수리). strict-origin은 경로는 감추고 origin(https://apps.nomute.kr)만 전송 = 도메인 검증 충족하면서 타 플랫폼(틱톡·릴스·X) 임베드 무영향(원래 referrer 안 봄). --><div class="tv-swz" id="tvSwz" aria-hidden="true"></div><div class="tv-nav" id="tvNavBox" hidden><button class="tv-nv" id="tvPrev" type="button" aria-label="이전 순위"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"/></svg></button><button class="tv-nv" id="tvNext" type="button" aria-label="다음 순위"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></button></div></div>
  <div class="tv-cmts" id="tvCmts" hidden></div><!-- 인기 댓글(운영자 260714 "가장 좋은 건 댓글 반응" → 260720 평의회 F3 발굴: 수집·저장만 되고 미표시던 comments 표시 · 데이터 있을 때만 노출 = 조용한 공백 · 주입 = textContent DOM 조립(XSS 안전) -->
  <div class="tv-foot"><span class="tv-status" id="tvStatus" role="status" aria-live="polite"></span><button class="ed-go" id="tvDl" type="button">다운로드</button><button class="ed-go" id="tvSrc" type="button">편집기</button><button class="ed-go" id="tvAsk" type="button">요약 요청</button></div>
</dialog>

<!-- 채널 심층 모달 2종(운영자 260713 "앱 내에서 볼 경로") — 셸 = base dialog 무채 글래스 상속 + .modal-head 정본 · 데이터 = insta_data.json(daily_series·posts 100) · 진입 = 채널 요약 카드 더보기 필(.tsk-more) -->
<dialog id="chdaydlg" aria-label="일별 상세">
  <div class="modal-head"><b>일별 상세</b><span class="chd-n" id="chdN"></span><button class="tool-x dlg-x" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="chd-body" id="chdBody"></div>
</dialog>
<dialog id="chpostdlg" aria-label="게시물 탐색">
  <div class="modal-head"><b>게시물 탐색</b><span class="chd-n" id="chpN"></span><button class="tool-x dlg-x" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="chp-fl"><span class="ch-rangeseg" id="chpSort"></span></div>
  <div class="chp-fl" id="chpFmt"></div>
  <div class="chp-fl" id="chpCat"></div>
  <div class="chp-list" id="chpList"></div>
</dialog>

<!-- 브리프 스크랩 팝업(운영자 260712 "AI 요약 속 참고 기사 = 지금 창 위 팝업 · 뉴스 요약처럼 이미지+보도자료체") — 셸 = base dialog 무채 글래스 상속 + .modal-head 정본 · 데이터 = sns_brief.json refs(생성 시 동봉 · og:image 후처리) · 열기 = openComposeDlg(pushState 폰 뒤로가기) -->
<dialog id="trefdlg" aria-label="참고자료 스크랩">
  <div class="modal-head"><b id="trefSrc">스크랩</b><a class="tv-open" id="trefOpen" href="#" target="_blank" rel="noopener" title="원문 열기" aria-label="원문 열기"><svg class="src-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="src-base" pathLength="1" d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><g class="src-arrow"><path class="src-shaft" pathLength="1" d="M10 14 21 3"/><path class="src-tip" d="M15 3h6v6"/></g></svg></a><button class="tool-x dlg-x" type="button" id="trefX" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <img class="tref-img" id="trefImg" alt="" referrerpolicy="no-referrer" hidden><!-- eager 고정: lazy+hidden = 교차 없음 → 영원히 미로드 데드락(실측 260712) · 모달 단일 이미지라 eager 비용 0 -->
  <div class="tref-bd"><b class="tref-ttl" id="trefTtl"></b><p class="tref-body" id="trefBody"></p><div class="tref-vid" id="trefVid" hidden></div><!-- 영상 refs(쇼츠·틱톡·릴스·유튜브) = 요약 아래 인라인 임베드(운영자 260713) · iframe은 열 때 생성·닫을 때 제거 = 백그라운드 재생 0 --></div>
</dialog>

<!-- 카드 개별 변경(2차 팝업) — 이미지 보며 텍스트(어절칩 강조)·이미지 희망 입력 → 변경(1b) -->
<dialog id="editdlg">
  <div class="ed-h"><b class="ed-title">카드 변경</b><div class="askhead-act"><button class="ed-x" type="button" aria-label="닫기" onclick="editdlg.close()"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
  <div class="ed-body">
    <div class="ed-imgwrap"><img class="ed-img" alt=""><button class="ed-baf" type="button" hidden aria-label="전/후 비교 (탭하면 전환)" title="전/후 비교">후</button></div>
    <div class="ed-lblrow"><span class="ed-lbl">텍스트</span></div>
    <div class="edcardwrap"><div class="ed-chips" id="edChips" role="group" aria-label="텍스트 어절 — 탭하면 강조, 더블탭 수정"></div></div>
    <div class="ed-lblrow ed-wishrow"><label class="ed-lbl" for="edWish">이미지 수정</label><label class="ed-match"><input type="checkbox" id="edSync"><span class="ed-cbx"><svg class="ackm" viewBox="0 0 24 24" fill="none"><path class="sc-dash" d="M6 12h12"/><path class="sc-chk" d="M5 13l4 4L19 7"/></svg></span><span>텍스트 내용을 그대로 반영</span></label></div>
    <textarea class="ed-wish" id="edWish" placeholder="내용을 입력해주세요"></textarea>
  </div>
  <button class="dlgtop ed-top" id="edtop" type="button" aria-label="맨 위로" title="맨 위로"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V6M6 12l6-6 6 6"/></svg></button>
  <div class="ed-status" id="edStatus" aria-live="polite"></div>
  <div class="ed-foot"><label class="askattach edattach" id="edAttach" title="이미지 첨부 (4:5) — 첨부 후 탭하면 제거" aria-label="이미지 첨부"><svg class="edattach-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.5"></circle><path d="M21 16l-5-5L5 20"></path></svg><img class="edattach-thumb" id="edAttachThumb" alt="" hidden><span class="askattach-badge" id="edAttachBadge" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span><input id="edFile" type="file" accept="image/*" hidden></label><button class="ed-go" id="edGo" type="button"><span class="ed-ic"></span><span class="ed-tx">변경</span><svg class="gck" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7"/></svg></button><div class="ed-confirm"><span class="ed-cmsg">이 카드만 다시 생성할까요?</span><button class="ed-cno" type="button">취소</button><button class="ed-cyes" type="button">확인</button></div></div>
</dialog>


<dialog id="askdlg" class="askdlg">
  <div class="askwrap">
    <div class="askhead"><b>요약 요청</b><div class="askhead-act"><button class="askx askmin" id="askMin" type="button" aria-label="최소화"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 12h12"/></svg></button><button class="askx" id="askX" type="button" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
    <div class="ask-inrow">
      <div class="ask-incol"><!-- 입력칸 + 프리셋 스트립 = 한 세로 칸(첨부 픽토 46px 칸 바깥) → 스트립 좌우폭이 입력칸과 자동 동일(운영자 260726 "옵션바는 텍스트 입력바 좌우 너비까지만") -->
        <div class="asktawrap">
          <textarea id="askText" class="askta" rows="5" placeholder="" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
          <span class="askph" id="askPh">내용을 입력해주세요</span>
          <button class="sbtn askclip ask-cp" id="askCopy" type="button" aria-label="복사"></button>
          <button class="sbtn askclip ask-pp" id="askClip" type="button" aria-label="붙여넣기"></button>
          <button class="sbtn askclip ask-erase" id="askErase" type="button" aria-label="입력 지우기"></button>
        </div>
        <!-- 수집 프리셋 스트립(운영자 260723 · 260726 개정 · 260803 외신⇄국내 단일 토글) — ⚠배치: 입력칸 아래·전송행 위 = 입력칸 좌우폭까지만(첨부 픽토 칸 비침범) · 4토글 = 라벨 자체가 토글 · 기본 점등 = 24시간 내·AI 미제작(선택 = 점등 accent / 미선택 = 소등 mut · ON/OFF 문자 표기 폐지 · 운영자 260726) · 「주요 언론 기반(mj)」 칩 = 「외신 기반(fp)」 토글로 흡수·UI 철거(운영자 260803 "하나로 합쳐서 on off" — 다매체 종합은 상시라 페이로드 mj:1 고정 전송 = 서버·ask.sh·구 대기열 전층 무접촉 · fp = 축 선택만: 켜짐=외신 축 / 꺼짐=국내 축 · 260803 기본 보강 모드 손상 0 설계 = 꺼짐 프롬프트가 종전과 바이트 동일) · 값 = askSend preset → asks/*.json → ask.sh 프롬프트(단 noai = 프롬프트가 아니라 nothumb 축 = thumb_gen skip · 운영자 260727) -->
        <!-- 링크 입력(운영자 260731 "우측 사진 아래에 링크도") — ⚠배치: 우측 첨부 픽토 아래 🔗 픽토 탭 → 이 행이 펼쳐짐(입력칸 좌우폭 = 프리셋 스트립과 동일 칸). 기사 링크 = 원문 활용 · 영상/음성 링크 = Whisper large-v3 전사 후 그 전사문을 원문으로 활용(ask.sh 링크 레일). 입력칸 = .askta 정본 계승(한 줄) · 클립 = attachCopyPaste 정본(상단 걸침) -->
        <div class="asklinkrow" id="askLinkRow" hidden>
          <input type="url" id="askLink" class="askta asklink" placeholder="https://…" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" name="nomute-asklink" enterkeyhint="done" data-1p-ignore data-lpignore="true" data-form-type="other">
          <!-- 경로 리드백(운영자 260731 "자막이 있으면 자막 켜져있다는 거를 동그라미 디밍으로 · 자막 디밍, 전사 디밍 각각") — 미디어 링크일 때만 노출 · 실제로 탈 경로만 점등, 나머지는 디밍 -->
          <div class="alk-st" id="askLinkSt" hidden><span class="alk-i" id="alkSubs"><i class="alk-dot"></i>자막</span><span class="alk-i" id="alkStt"><i class="alk-dot"></i>전사 large-v3</span><span class="gs-v gs-tog alk-force" id="alkForce" role="button" tabindex="0" aria-pressed="false" hidden title="탭=켜기/끄기 — 자막 없는 긴 영상은 기본 30분까지만 전사한다. 켜면 55분까지 강행(그만큼 오래 걸림)">전사 강행</span><span class="alk-eta nm-shim" id="alkEta"></span></div><!-- 예상 시간 = nmEta 정본(「(예상 : N분 NN초)」 · 영상 길이 비례 산출 · 실측 평균 수렴) · 전사 강행 = 프리셋 스트립 토글(.gs-v.gs-tog) 정본 계승(운영자 260731 "강제 활성화 가능") -->
        </div>
      </div>
      <div class="ask-actcol"><!-- 우측 액션 칸(46px) = [이미지 첨부][링크] 세로 스택 · 링크 = 사진 픽토 바로 아래(운영자 260731) -->
      <label class="askattach" id="askAttach" title="이미지 첨부" aria-label="이미지 첨부"><span class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.5"></circle><path d="M21 16l-5-5L5 20"></path></svg></span><span class="askattach-badge" id="askAttachBadge" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg><span id="askAttachCnt"></span></span><input id="askFile" type="file" accept="image/*" multiple hidden></label>
      <button class="askattach asklinktg" id="askLinkTg" type="button" aria-expanded="false" title="링크 넣기 (기사 원문 · 영상/음성 전사)" aria-label="링크 넣기"><span class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span><span class="askattach-badge" id="askLinkBadge" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span></button><!-- 🔗 = ly #srcUrlBtn 픽토 정본 계승 · 배지 = .askattach-badge 계승(링크 들어있으면 ✓) -->
      </div>
    </div>
    <!-- 옵션 라인 = [프리셋 스트립][전송] 한 행(운영자 260802 "전송 버튼을 위 옵션 라인에 수평으로 같이") — 구 .askbot 안 전송을 이 행으로 승격 · 전송 x위치 불변(행 우변 = askwrap 우측 패딩) · 스트립은 남는 폭 전부(첨부 칸 46px 아래까지 확장 = 260726 "입력바 좌우폭까지" 우변 제한 해제 · ⚠배치) -->
    <div class="askoptrow">
        <div class="optstrip" id="askStrip">
          <div class="gospec" id="askSpec"><span class="gs-v on gs-tog" id="apH24" role="button" tabindex="0" aria-pressed="true" title="탭=켜기/끄기 — 켜짐=게시 24시간 내 기사만 수집">24시간 내</span> <span class="gs-sep">|</span> <span class="gs-v gs-tog" id="apFp" role="button" tabindex="0" aria-pressed="false" title="탭=켜기/끄기 — 켜짐=외신 기반(영문 키워드 검색으로 시작 · 외신 주요 매체 2~4곳이 축 · 국내는 교차확인 보조) / 꺼짐=국내 기반(국내 주요 언론 축 — 현행 기본 그대로) · 어느 쪽이든 주요 언론 다수 수집→기승전결 종합자료(≈2천자)는 항상 수행">외신 기반</span> <span class="gs-sep">|</span> <span class="gs-v gs-tog" id="apOg" role="button" tabindex="0" aria-pressed="false" title="탭=켜기/끄기 — 켜짐=내가 준 원본(전문·URL·캡처) 안에서만 작업(다른 기사 추가 검색 없음)">원본 한정</span> <span class="gs-sep">|</span> <span class="gs-v on gs-tog" id="apNoai" role="button" tabindex="0" aria-pressed="true" title="탭=켜기/끄기 — 기본 켜짐 = AI 썸네일을 만들지 않는다(설정 'AI 썸네일' ON이어도 skip) · 끄면 그 건만 평소대로 생성 · 검색 이미지는 어느 쪽이든 그대로 수집">AI 미제작</span></div>
        </div>
      <button class="asksend" id="askSend" type="button"><span>전송</span></button>
    </div>
    <div class="askbot">
      <div class="askimgs" id="askImgs"></div>
    </div>
  </div>
</dialog>

<!-- 요약 수정 팝업 — FAB(우·중하단)에서 좌측으로 펼침. 지시대로 재작성(재요약 X·api/revise). askdlg 클론·.sbtn 클립 계승. 1차 클릭=재확인→2차=전송 -->
<!-- 공개 발행 확인 — 요약창 헤더 '공유' 버튼으로 열림. 공개범위(누구나/비공개 토글)·만료(3일 ~mm/dd)·PIN(cron식 fieldset) → '발행'. 발행 버튼=.asksend 글래스+.revsend 게이지(발행>게이지>체크) 계승·컴팩트 중앙 모달(#pindlg) 계승. -->
<dialog id="pubdlg">
  <div class="dlg-h"><div class="dlg-top"><b class="pub-title">공개 링크로 발행</b></div><button class="tool-x dlg-x" id="pubdlgX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <div class="pub-body">
    <div class="pub-row"><span class="pub-l">공개 범위</span><button type="button" class="pub-vis" id="pubVis" data-scope="public">누구나</button></div>
    <div class="pub-row"><span class="pub-l">만료</span><span class="pub-v" id="pubExp">3일</span></div>
    <fieldset class="pin-fs">
      <legend id="pubPinLeg">잠금 설정 (PIN)</legend>
      <div class="pub-slots" id="pubSlots" aria-hidden="true"><span class="pub-slot"></span><span class="pub-slot"></span><span class="pub-slot"></span><span class="pub-slot"></span><span class="pub-slot"></span><span class="pub-slot"></span></div>
      <input id="pubPin" class="pin-in-h" type="text" inputmode="numeric" maxlength="6" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="PIN 6자리 입력"><button class="pin-eye" type="button" aria-label="PIN 표시" title="PIN 표시" aria-pressed="false"></button>
    </fieldset>
    <button id="pubGo" class="asksend revsend pub-go" type="button"><span>발행</span></button>
    <div class="pub-status" id="pubStatus"></div>
  </div>
</dialog>
<!-- 이미지 생성 팝업 — 검색 카러셀 + 버튼으로 열림. 운영자가 버튼으로 옵션을 고르면 그게 곧 프롬프팅:
     api/genimg → imggen 워크플로{Opus 5·effort max가 기사 요약·시사점+옵션으로 프롬프트 작성 → 제미나이(종량제) 렌더 → R2 → search.json '생성' prepend}.
     칩은 JS(GENI_DICT)가 채움 · 셸=pubdlg 계승 · 운영자 260707 -->
<dialog id="genidlg">
  <div class="dlg-h"><div class="dlg-top"><b class="pub-title">이미지 생성</b></div><button class="tool-x dlg-x" id="geniX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div>
  <!-- ★ 상단 고정 리드(운영자 260713 재배치 "주문을 맨 위 고정 NAV로 · 스크롤 내려도 따라옴"): 내용{주문} + 우측하단 선택요약 + 생성. flex:none = tooldlg flex column 고정 문법 계승(구 geni-foot의 고정을 상단으로 이전) · 구분선(border-bottom --line2)이 아래 스크롤과 분리 -->
  <div class="geni-lead">
    <!-- 미리보기 쉘(운영자 260719 "편집 탭 상단 고정 미리보기를 AI 생성에 그대로 이식 — 사진 입력창은 이 미리보기로 대체") = CII 「합성 미리보기 쉘」 행 통째 계승(thumb .cpprev-box/.cpprev-stage/.cpv-* 정본 미러) — 빈 상태 = 사진 픽토그램 진입점(.cpv-photobtn · #geniRefBtn id 승계 = 클릭 라우팅 불변) · 첨부 = 참고 이미지 + 교체/삭제 툴(.cpv-tool · thumb #cpImgSwap/#cpImgDel 좌표·픽토 동값) · 스테이지 비율 = 선택 비율 동기(geniApply) -->
    <div class="geni-prev" id="geniPrev">
      <div class="cpprev-box" id="geniPrevBox">
        <div class="cpprev-stage" id="geniPrevStage">
          <img class="cpv-style" id="geniStyleEx" alt="" aria-hidden="true" hidden><!-- 화풍 예시(운영자 260719 "화풍 글로만 있으면 덜 직관적 — 화풍별 예시를 미리보기에") = 빈 상태 한정 · 화풍 선택 동기(geniApply) · 자산 = assets/geni-styles/{화풍}.webp · 없으면 조용히 숨김(onerror) -->
          <img class="cpv-ghost" id="geniRefGhost" alt="" aria-hidden="true" hidden><!-- 첨부 고스트(운영자 260719 승인 "그렇게 한번 해줘") = 참고 이미지가 선택 비율 프레임에 앉는 모습 — cover 반투명 언더레이 + 아래 contain 원본 겹침 -->
          <img class="cpv-bg" id="geniRefThumb" alt="" hidden>
          <div class="cpv-empty"><button type="button" class="cpv-photobtn" id="geniRefBtn" aria-label="참고 이미지 첨부 — 탭=파일 선택" title="참고 이미지 첨부 — 탭=파일 선택"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.5"></circle><path d="M21 16l-5-5L5 20"></path></svg></button></div><!-- 빈 상태 반갈(운영자 260721 "좌측은 글 픽토그램, 우측은 사진 픽토그램으로 좌우세로 균형 마진") — 좌 = 글 프롬프팅 진입점(#geniTxtBtn · 픽토 = pastedlg 문서 정본 path · 탭 = 주문칸 #geniWishRow 노출·포커스 = 260719 "미리보기 위 새 입력" 예약 배선) · 우 = 사진(#geniRefBtn id·라우팅 불변) · 버튼 셸 = .cpv-photobtn 정본 공유 -->
        </div>
      </div>
        <!-- ── 코너 옵션 레일(운영자 260802 "우측 네비게이션바로 · 모든 페이지에 똑같이") = 이 문서 `.trail` 정본 재사용 —
             [교체·삭제 픽토 묶음] → 구분선 → [값 칩 = 선택요약 #geniSum] · id·핸들러·geniApply 리드백 전부 불변 ── -->
        <!-- 캡슐① 돋보기 = 미리보기 확대/원상복귀(운영자 260802 2차) — 픽토 = 검색 돋보기 정본(#sovClr) + 안쪽 ±(세로획은 확대 중 소거) -->
        <div class="trailwrap" id="geniRailWrapPv"><!-- 레일 = 미리보기 창 밖 우측 · 캡슐 3분할 [돋보기][옵션][생성](운영자 260802 2차 · thumb 정본 동문) -->
          <nav class="trail" id="geniZoomRail" aria-label="미리보기 확대">
            <button type="button" class="trail-i" id="geniZoom" aria-pressed="false" aria-label="미리보기 확대" title="탭=미리보기 확대 · 다시 탭=원상복귀"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M8 11h6"/><path class="cpz-v" d="M11 8v6"/></svg></button>
          </nav>
          <nav class="trail trail-opts" id="geniRail" aria-label="미리보기 옵션">
          <span class="trail-g"><!-- 글 프롬프팅 = 중앙 반갈에서 레일로 이주(운영자 260802 "중앙에는 사진 업로드 그것만 있고 텍스트 버튼은 우측 네비게이션으로") — id·핸들러(#geniWishRow 노출·포커스) 불변 · 픽토·라벨 그대로 -->
          <button type="button" class="cpv-tool" id="geniRefSwap" hidden aria-label="참고 이미지 교체 — 탭=파일 선택" title="참고 이미지 교체"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9.5" r="1.5"></circle><path d="M21 16l-5-5L5 20"></path></svg></button>
          <button type="button" class="cpv-tool" id="geniRefX" hidden aria-label="참고 이미지 삭제" title="참고 이미지 삭제"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg></button>
          </span>
          <span class="trail-v" id="geniEngRail"></span><!-- 모델 칩 = 픽토 자리 승격(운영자 260803 "네비게이션이 은근히 달라 — 첨부1(편집)이 맞는내용") — 아이콘 렌더 칩이 값 그룹 안에 37px 피치로 섞여 캡슐②의 정본 순서 [픽토 묶음 → 구분선 → 값 칩](CII 92행)이 AI 판만 깨져 있었다 → 구분선 위 픽토 리듬으로 이주(빌더 geniApply가 채움 · gs-tog 배선 = geniSum 동일 위임) -->
          <span class="trail-div"></span>
          <div class="geni-sum trail-v" id="geniSum"></div><!-- 선택요약(극화·웹툰화 / 4:5·FHD·3장·PNG / 무드 자동) = 레일 값 칩으로 이주(운영자 260802) — aria-live 미부여 = 게이지 드래그마다 SR 재낭독 스팸 방지(6인 검증) · 시각 리드백 전용 · 내용 생성(geniApply)·탭 토글(data-tg) 배선 전부 불변 · 모델 칩만 260803 위 #geniEngRail로 승격 -->
        </nav>
        <!-- 발사 = 레일 **캡슐③**(운영자 260807 «돋보기 처럼 구분되게 하나 더 만든다음에 거기로 생성을 옮겨줘») — 구 거처 = 미리보기 창 **안** 하단 오버레이(260806 · 사진을 가렸다) · ⚠배치 = 캡슐 순서 [돋보기][생성][옵션] = 생성 y 고정(옵션 캡슐은 탭마다 길이가 다르고 특수 탭은 통째로 은닉되므로 맨 뒤에 두면 탭마다 생성이 튄다)  (구 주석: 260806 "생성버튼 항상 사진 미리보기 부분 85%에 위치 · 사진 위에 오버레이 중첩") — 구 거처 = 리드(.geni-lead) 안 「생성」 CTA · id·클래스(.asksend .pub-go .geni-go)·핸들러·발사 게이지 전부 원문 그대로 = 카드 제작 정본 사본 · geniMount는 #genidlg 자식을 통째로 옮기므로 이 노드도 함께 이사(거처 불변식 유지) -->
        <button id="geniGo" class="asksend pub-go geni-go trail-fire" type="button"><span>생성</span></button>
        </div>
    </div>
    <!-- (내용·참고이미지 블록 = 스크롤 본문 머리로 이주 · 운영자 260802 9차 "미리보기 창 안에 내용 입력란이 있다던지" — 고정 리드 = [미리보기+레일][생성]만 = 카드 생성·번역 도크와 동일 골격 · id·핸들러·hidden 토글 전부 불변) -->
    <!-- (구 선택요약 스트립 #geniSum = 미리보기 코너 레일로 이주 · 운영자 260802 — DOM·id·핸들러는 레일 안에 존치) --><!-- (구 생성 CTA #geniGo = 미리보기 창 안 85% 오버레이로 이주 · 운영자 260806 — 잔해 0 = 중복 id 좀비 차단 · "생성 버튼까지 그대로 따라오기" 계약은 창 자신이 리드 안이라 그대로 성립) --><button id="geniMore5" class="geni-alt" type="button">실사진 5장 더 찾기</button><!-- geniMore5 = 기사 카러셀 전용(자유 모드 hidden) -->
  </div>
  <div class="geni-body"><!-- 스크롤 영역(운영자 260713 재배치): 카메라·구도 → 개요{해상도·비율·장수·품질} → 표현{화풍·세부·웹툰화·무드} → 문구(맨 아래). 소머리 = .cref-lbl 계승 -->
    <div class="geni-sechead" id="geniWishHead"><span class="cref-lbl">내용</span></div>
    <div class="geni-row geni-wishrow" id="geniWishRow"><textarea id="geniWish" class="nmin" rows="3" maxlength="300" placeholder="선택 · 자유 요청 한 줄" aria-label="주문" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea></div><!-- ⚠배치 활자·박스 = **편집 정본 계승**(운영자 260804 "이미지 스튜디오 - 편집의 폰트 형태를 따라가는게 정석 · 폰트 형태 & 텍스트 박스 형태 둘다") — 구 `.geni-in`은 13px/**700**·pad 6/10·면 rgba(255,255,255,.04)·선 무채 .06이라 형제 칸(13.5px/400·pad 12·면 .55·선 accent .35)과 홀로 갈렸다(실측 260804) → 클래스 교체 1회로 SSOT(nm-input.css `.nmin`) 합류 · 「딱 그부분만」 = 오버레이 칸의 포스트 자간·마진 축은 안 가져온다 · id·핸들러·클립(attachCopyPaste)·hidden 토글 전부 무접촉 · 구 주문 텍스트칸 = 일단 숨김(운영자 260719 "프리뷰 위에 내가 텍스트를 보낼테니까 일단 텍스트 빼봐 · 편집 탭과 완전 동일") — 편집 탭 리드 = [미리보기→요약 스트립→생성]에 텍스트칸 없음 = 동일 구조 수렴 · DOM 유지(값·close 스냅샷·bindImgPaste·focus 참조 무손상 = 크래시 0)·복원 = hidden 2곳 제거 · 발사 정책 무변경(미리보기 위 새 입력 = 다음 지시 배선) -->
    <input id="geniRefFile" type="file" accept="image/*" hidden><!-- 참고 이미지 파일 input = wishrow 밖 형제로 이주(텍스트칸 숨김과 무관하게 첨부 유지 · 프로그램 click 재버블 차단) -->
    <div class="geni-row geni-refmode" id="geniRefModeRow" hidden><span class="pub-l">참고 이미지</span><span class="geni-opts" id="geniRefMode"><button type="button" class="geni-opt" data-v="keep">원본 유지</button><button type="button" class="geni-opt" data-v="ref">참고</button><button type="button" class="geni-opt" data-v="clone">이미지와 동일하게</button></span></div><!-- 첨부 시만 표시(운영자 260713 "이 이미지를 참고할거냐 원본 그대로 유지할거냐") — 원본 유지(keep)=피사체·구도 충실 재현 / 참고(ref·기본)=시각 레퍼런스로 신규 구성 · gen_image가 ref_png 공통 전달, 프롬프트 지시만 분기 · ⚠배치 이미지와 동일하게(clone · 운영자 260726 "이미지와 동일하게 라는 옵션") = 같은 행 세 번째 워드칩(.geni-opt 문법 그대로 계승 · 신규 CSS 0) — 첨부를 AI가 그대로 재탄생: 프롬프트에서 화풍·무드·카메라·문구 지시를 전부 빼고(스타일 낱말 0개) 첨부 원본비로 렌더 -->
    <button class="geni-sechead geni-fold" id="geniCamHead" type="button" aria-expanded="false" aria-controls="geniCamSub"><span class="cref-lbl">카메라 · 구도</span><span class="geni-n" id="geniCamN" hidden aria-hidden="true"></span><span class="geni-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 구분선 아래 첫 항목(운영자 260713) · 접기 = .pmenu-sub/.pm-chev 아코디언 계승 · 배지 = 내부 non-auto 개수(숨은 활성 은폐 방지 · 숫자만 = §디자인 e) -->
    <div class="geni-camsub" id="geniCamSub" inert><div class="geni-camsub-in">
      <div class="geni-row"><span class="pub-l">거리</span><span class="geni-opts" data-k="shot"></span></div>
      <div class="geni-row"><span class="pub-l">표정</span><span class="geni-opts" data-k="expr"></span></div>
      <div class="geni-row"><span class="pub-l">앵글</span><span class="geni-opts" data-k="angle"></span></div>
      <div class="geni-row"><span class="pub-l">포인트</span><span class="geni-opts" data-k="point"></span></div>
      <div class="geni-row"><span class="pub-l">조명</span><span class="geni-opts" data-k="light"></span></div>
      <div class="geni-row"><span class="pub-l">배치</span><span class="geni-opts" data-k="place"></span></div>
    </div></div>
    <button class="geni-sechead geni-fold" id="geniOvHead" type="button" aria-expanded="true" aria-controls="geniOvSub"><span class="cref-lbl">개요</span><span class="geni-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 소머리 접이 = 카메라·구도(#geniCamHead) 폴드 정본 그대로(운영자 260727 "개요엔 화살표가 없음 = 비대칭" 교정) — 셸·체브론·회전·grid-rows 전부 계승 · 신규 CSS·토큰 0 · 기본 펼침(aria-expanded=true·inert 없음) = 종전 가시 상태 불변 -->
    <div class="geni-camsub" id="geniOvSub"><div class="geni-camsub-in"><!-- 접이 래퍼 = .geni-camsub/.geni-camsub-in 정본 exact(grid-rows 0fr↔1fr + overflow 클립) — 안의 .geni-cards 스택은 통째 무접촉 -->
    <div class="geni-cards"><!-- 각 옵션 = 편집 탭 .scard 블록 계승(운영자 260718) — 행/id/핸들러/아코디언 불변, 래퍼만 카드화 -->
    <div class="geni-sum" id="geniEngTip" hidden><span class="gs-lbl">[화풍: 레고]</span><span class="gs-v on">는 <i class="eng-ico" aria-hidden="true"></i>GPT 추천</span></div><!-- ⚠배치 레고+GPT 조합 안내(운영자 260727 "지피티로 이 화풍 선택 후에 토글하면 바로 위에 안내 메세지 짧게") = 모델 행 바로 위 · 부품 = 선택요약 스트립 .geni-sum(#geniSum) 문법 그대로 계승(라벨 mut + 값 accent · 신규 CSS·토큰 0) · 노출 = 화풍 레고 && 엔진 GPT일 때만(geniApply 단일 토글점) -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">모델</span><span class="geni-opts" id="geniEngine"><button type="button" class="geni-opt" data-v="gemini"><i class="eng-ico" aria-hidden="true"></i><span>Gemini 3.1 Flash</span></button><button type="button" class="geni-opt" data-v="gpt"><i class="eng-ico" aria-hidden="true"></i><span>GPT Image 2.0</span></button></span></div></div><!-- ⚠배치 렌더 엔진 = 두 모델 **상시 나열**(운영자 260728 "모델 누르면 바로 바뀌게 · 토글되니까 순간 좀 어색해") — 구 = 칩 하나가 교대로 이름을 바꾸던 방식(누른 뒤에야 뭘 고른 건지 보이고, 다른 모델을 고르려면 값이 뒤바뀌는 걸 봐야 했다). 지금 = 후보 둘이 다 보이고 누른 그 칩이 곧바로 선택 · 셸·문법 = 같은 섹션 '해상도'·'개수'·'무드'(#geniMood) 칩 나열 정본 그대로(신규 CSS·토큰 0) · 브랜드 픽토(G·AI 스파클)는 각 칩이 제 것을 달고 상주 · 값 = genimg.js engine → gen_image 백엔드 분기(GPT 실패 시 Gemini 폴백) -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">해상도</span><span class="geni-opts" data-k="size"></span></div></div>
    <div class="geni-card"><div class="geni-row"><span class="pub-l">비율</span><span class="geni-opts" data-k="aspect"></span><span class="geni-ar" id="geniArWrap" inert><input id="geniArW" class="geni-ar-in" type="text" inputmode="numeric" maxlength="2" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="비율 가로값"><b class="geni-ar-c" aria-hidden="true">:</b><input id="geniArH" class="geni-ar-in" type="text" inputmode="numeric" maxlength="2" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="비율 세로값"><span class="geni-ar-out" id="geniArOut"></span></span></div></div><!-- ⚠배치 비율 직접 = 「직접」 칩 **그 자리**에서 N:N으로 전환(운영자 260727 "직접누르면 비율 n : n 으로 순간 바껴서 넣을수있게하면되고 공간확보하려고그럼") — 구 = 칩 행 아래 아코디언(.geni-arwrap)이 따로 열려 카드가 두 줄로 커졌다(실측 257→298px = 공간확보의 반대). 지금 = 같은 .geni-row 안 .geni-opts 뒤 인라인 슬롯이라 카드 높이 불변 · 열림 판정은 종전 geniAccordion(.open+inert) 그대로 = 배선·상태 신설 0 · 되돌아가기 = 프리셋 칩 탭 -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">개수</span><span class="geni-opts" data-k="count"></span></div></div><!-- 라벨 '개수'(운영자 260713 · 구 '장수') -->
    <!-- (구 '품질' 행 = PNG 단일 칩 = 폐지 · 운영자 260805 "투명일 필요 없는 건 모두 jpg 90") — 산출 포맷이 JPG q90 고정이라 고를 값이 0개 = 행 자체가 잉여(구 260713 'PNG만' 축소의 종점) · 백엔드 fmt 파라미터는 도먼트 보존(genimg.js·gen_image.py — 발사는 상시 jpg) -->
    </div></div></div><!-- .geni-cards → .geni-camsub-in → .geni-camsub(#geniOvSub) 순 폐합 -->
    <button class="geni-sechead geni-fold" id="geniExHead" type="button" aria-expanded="true" aria-controls="geniExSub"><span class="cref-lbl">표현</span><span class="geni-chev" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 개요와 동일 폴드(소머리 3개 = 카메라·구도/개요/표현 대칭 완성 · 운영자 260727) -->
    <div class="geni-camsub" id="geniExSub"><div class="geni-camsub-in">
    <div class="geni-cards"><!-- 표현 옵션 = 편집 탭 .scard 블록 계승(운영자 260718) -->
    <div class="geni-card"><div class="geni-row geni-railrow"><span class="pub-l">화풍</span><div class="geni-railwrap edge"><span class="geni-opts geni-rail" id="geniStyle"></span><div class="geni-navs"><button type="button" class="geni-nav" data-dir="-1" aria-label="이전"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" class="geni-nav" data-dir="1" aria-label="다음"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div></div></div></div><!-- 9화풍 = 한 줄 가로 레일(운영자 260713 "전광판식 좌로 끌기" — 구 2줄 wrap·우측정렬 폐지) · 잡고 끌기(폰)/‹›(PC) · 좌측 순서=제작빈도순 · 기본 극화 -->
    <div class="geni-card"><div class="geni-row geni-railrow"><span class="pub-l">세부 화풍</span><div class="geni-railwrap edge"><span class="geni-opts geni-rail" id="geniSub"></span><div class="geni-navs"><button type="button" class="geni-nav" data-dir="-1" aria-label="이전"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" class="geni-nav" data-dir="1" aria-label="다음"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button></div></div></div></div><!-- 자동 + 현 화풍 세부 = 한 줄 가로 레일(운영자 260713 전광판) · 좌측 순서=자동 고정+제작빈도순 · 화풍 전환 = 아웃 페이드 촤르륵 → 스왑 → 인 촤르륵(geniSubRender) -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">한국웹툰화</span><span class="geni-opts"><button type="button" class="geni-opt" id="geniKweb" aria-pressed="true" title="탭=켜기/끄기">켜짐</button></span></div></div><!-- 켜짐/꺼짐 = **단일 칩 토글 유지**(운영자 260728 "웹툰화는 토글이 on off") — 260728 나열화 회수분: 모델처럼 「후보 중 하나를 고르는」 축이 아니라 **한 기능을 켜고 끄는** 축이라 칩 하나가 상태를 들고 뒤집히는 게 맞다(선택지가 둘 있는 게 아니다) · ⚠배치 반갈(운영자 260727 "좌우로 반 구분된 옵션들처럼 반갈해줘") = 라벨 좌(.pub-l) + 값 우(.geni-opt) — 레퍼런스 = 같은 섹션 '무드'·'색 보정' 카드 정본 그대로(신규 CSS·토큰 0) · 구 = 라벨 없이 칩 하나가 이름 겸 값이라 홀로 좌측에 떠 형제 카드와 어긋나던 것 · 값 낱말 = 상태형(켜짐/꺼짐 · '색 보정: 보정 없음' 상태표기 결 계승) · 토글 핸들러·aria-pressed·요약바 자립칩 전부 불변 · 전 화풍 공통 토글 · 기본 ON(운영자 260710) · 라벨 = 한국웹툰화·값 = ON 점등/OFF 중립(운영자 260713 "웹툰화 > 한국웹툰화 · 한국웹툰식 > ON, 점등 OFF > OFF") — 극화는 NST-B 전문 승격 -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">무드</span><span class="geni-opts" id="geniMood"></span></div><!-- 자동(기본) + 직접 = 아래 게이지 4축 촤르륵(camsub 아코디언·cardIn 스태거 계승) -->
    <div class="geni-moodsub" id="geniMoodSub" inert><div class="geni-moodsub-in" id="geniGauges"></div></div></div>
    <div class="geni-card"><div class="geni-row"><span class="pub-l">색 보정</span><span class="geni-opts"><button type="button" class="geni-opt" id="geniColorReset">기본값</button></span></div>
    <div class="geni-moodsub open" id="geniColorSub"><div class="geni-moodsub-in" id="geniColorGauges"></div></div></div><!-- ⚠배치 색 보정(운영자 260727 "채도는 사용자가 조정하게 · 명도 채도") = 표현 섹션 문구 위 카드 · 게이지 = 무드 게이지(.geni-gg) 문법 그대로 계승(신규 CSS 0) · 상시 펼침(.open) = 값이 기본 0이 아닐 수 있어 숨기면 은폐 · [기본값] = 엔진·모드별 실측 프리셋 복귀 · 값 = 렌더 후 픽셀 교정(프롬프트 무접촉 = 노하우 문서 §L1 함정 회피) -->
    <div class="geni-card"><div class="geni-row"><span class="pub-l">문구</span><span class="geni-opts"><button type="button" class="geni-opt" id="geniTextOn" aria-pressed="false" title="탭=켜기/끄기">꺼짐</button></span></div></div><!-- 켜짐/꺼짐 = 단일 칩 토글 유지(운영자 260728 · 한국웹툰화와 한 쌍 = 같은 ON/OFF 축이라 같이 회수) · ⚠배치 반갈(운영자 260727 · 한국웹툰화 카드와 한 쌍 = 같은 조치) — 라벨 좌 + 상태값 우 · 무드 아래 맨 마지막(운영자 260713 "문구는 여기 맨 아래에 붙게") · 값 = ON/OFF 축약(운영자 260713 "살리기 on > on · 살리기 off > off") · ON = 문구 입력 없음: Opus가 주문(장면 설명)에서 문구를 정해 자연스럽게 살리고, 렌더 불안 시 정확한 한글 리터럴을 프롬프트에 명기(운영자 260710) -->
    </div></div></div><!-- .geni-cards → .geni-camsub-in → .geni-camsub(#geniExSub) 순 폐합 -->
    <!-- AI 생성 결과·이전 제작(운영자 260718 "동일한 형태로 · 0으로" → 260803 실데이터 배선 "다른 곳처럼 배선") = 편집 탭 형태 계승 · 데이터 = 공유 이력 합류(thumb-hist.json+로컬 브리지 · 배선 = geniHist* 블록 — tr.html 문법 이식) · 접이 = 카메라 폴드(.geni-fold) 패턴 계승 -->
    <div class="out" id="geniOut"><!-- 결과+이전 제작 = thumb/tr `.out` 정본 셀렉터 그대로(운영자 260803 6차 "편집처럼 우측에") — 2단(PC ≥900)에선 geniOutPlace가 셸 우칼럼(.genihost 직계)으로 승격 · 1단(폰)·팝업 홈은 여기 본문 말미 그대로 = 회귀 0 -->
    <div class="geni-histwrap">
      <button class="geni-histfold" id="geniResH" type="button" aria-expanded="true" aria-controls="geniResBody"><span class="geni-histttl"><span class="geni-histbul" aria-hidden="true">•</span>결과 <span class="geni-histcnt" id="geniResCnt">(0)</span></span><span class="geni-histchev" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></button>
      <div class="geni-histbody" id="geniResBody"><!-- 결과 = 기본 펼침 · 접이 = hidden+closing 정본 문법(운영자 260803 Q1249 "접이 애니메이션도 적용" — 구 grid-rows 슬라이드·inert · dg 다운로드 창 폴드는 종전 문법 잔존 = 별도 축) --><div class="geni-histbody-in"><div class="geni-histempty" id="geniResEmpty">아직 제작한 게 없습니다</div><div class="jobs" id="geniResJobs"></div><!-- 결과 요약 줄 = thumb 잡 행(.job.done) 마크업 계승(운영자 260806) — 부품·클래스 = nm-job.css 공동 정본 · 자리 = 개별 썸네일 **위**(thumb #jobs → #carGrid 순서 동일) --><div class="hist-grid" id="geniResGrid"></div></div></div>
    </div>
    <div class="geni-histwrap">
      <button class="geni-histfold prev" id="geniPrevH" type="button" aria-expanded="false" aria-controls="geniPrevBody"><span class="geni-histttl"><span class="geni-histbul" aria-hidden="true">•</span>이전 제작 <span class="geni-histcnt" id="geniPrevCnt">(0)</span></span><span class="geni-histnote">전 기기 제작 내역</span><span class="geni-histchev" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></button>
      <div class="geni-histbody" id="geniPrevBody" hidden><div class="geni-histbody-in"><div class="geni-histempty" id="geniPrevEmpty">아직 제작한 게 없습니다</div><div class="hist-grid" id="geniPrevGrid"></div></div></div>
    </div>
    </div><!-- /.out(#geniOut) -->
  </div>
</dialog>
<!-- 설정 ▸ 다운로드(링크 자료수집) — 이식 원본 = muteno/yeulmaru-promo lg-* (운영자 260721 이식 패키지 §3 유닛 A) · 셸·리드·바디·워드칩·접이 = #genidlg(이미지 스튜디오) 문법 계승 · 열기 = 설정 메뉴 '다운로드'(#dgBtn) -->
<dialog id="dlgrab" aria-labelledby="dgTitle">
  <div class="tool-h"><b id="dgTitle">다운로드</b><span class="tool-hbtns"><button class="tool-x" id="dgMin" type="button" aria-label="최소화" title="최소화"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 12h12"/></svg></button><button class="tool-x" id="dgRf" type="button" aria-label="새로고침" title="새로고침"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg></button><button class="tool-x" id="dgX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div><!-- 헤더 = 이미지 스튜디오 셸 헤더(#tooldlg .tool-h) **부품·순서 그대로**(운영자 260803 "이미지 스튜디오의 이 창 화면과 동일해야해") — 구 .dlg-h/.dlg-top/.dlg-x(앱솔루트 X 1개) 폐지 · 3버튼 = [최소화 −][새로고침 ↻][닫기 ×] · 글리프 path·15px·stroke = #toolMin/#toolRf/#toolX 문자 사본(재설계 0) -->
  <div class="dg-wrap"><!-- 헤더 아래 본문 래퍼 = 2단 그리드 컨테이너(thumb `html.inmodal .wrap` 정본 미러 · 아래 @media 900) — 1단에선 종전 flex column(리드 고정 + 바디 스크롤) 그대로 -->
  <div class="geni-lead">
    <div class="geni-sechead"><span class="cref-lbl">링크</span></div><!-- ⚠배치(§3-2) — 이미지 스튜디오 입력부 정본(thumb #rCombo `• 헤더` + 입력칸) 미러: 소머리가 있어야 입력칸 상단 걸침 클립(붙여넣기·지우개)이 헤더에 안 잘린다. 라벨은 이 화면의 대상(링크) 1단어 · 토글류(노뮤트/진짜예요)는 이미지 스튜디오 전용이라 미계승(운영자 260802) -->
    <div class="dg-urlrow">
      <input id="dgUrl" class="geni-in" type="url" aria-label="주소" title="주소" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"><!-- placeholder 예시 제거(운영자 260802 "링크 안에 예시조차 다 없애") · 안내 산문 0 = check_url_placeholder 면제축(placeholder 없음) · 클립(붙여넣기·복사·지우개) = attachCopyPaste 정본이 .iowrap으로 감싸 상단 걸침 부착(이미지 스튜디오 부제·제목 칸과 동일 부품 · 운영자 260802 "여기는 입력하는 곳 스타일") -->
      <button id="dgVidDl" class="sbtn dlbtn" type="button" disabled aria-label="다운로드" title="다운로드"></button><!-- 링크 행 = [주소칸][다운로드] 한 쌍만(운영자 260802 "링크 입력란 옆에 다운로드 버튼만 남기고 … 우측에 다운로드 버튼만 있으면됨") — 구 [받기][자막][가져오기] 3개 폐지 · 부품 = .sbtn 34px 정본 + .dlbtn 전 앱 다운로드 색 정본(뉴스 요약 다운로드 버튼과 동일 계약 · 재설계 0) · 픽토 = nm-svg DOWNLOAD_SVG(JS 주입 = .pin-eye 관례) · 행위 = 영상 게시물이면 영상+자막 받기, 아니면 그 페이지 자료 수집(한 버튼이 갈래를 판단 = 운영자가 고를 게 없음) -->
    </div>
  </div>
  <div class="geni-body" id="dgBody"></div>
  </div>
</dialog>
<dialog id="revdlg" class="askdlg revdlg">
  <div class="askwrap">
    <div class="askhead"><b>뉴스 수정 요청</b><div class="revhead-act"><button class="asksend revsend" id="revSend" type="button"><span>수정</span></button><button class="askx" id="revX" type="button" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
    <div class="asktawrap">
      <textarea id="revText" class="askta" rows="2" placeholder="" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
    </div>
  </div>
</dialog>

<!-- 🃏카드 수정 팝업 — 요약 수정(#revdlg)과 동일 CSS·동작, 범위만 카드 프롬프트 전체 재기획(api/revise-cards). 제미나이 0(이미지 재슛 안 함). 1차 클릭=재확인→2차=전송 -->
<dialog id="crevdlg" class="askdlg revdlg">
  <div class="askwrap">
    <div class="askhead"><b>카드 수정 요청</b><div class="revhead-act"><button class="asksend revsend" id="crevSend" type="button"><span>수정</span></button><button class="askx" id="crevX" type="button" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
    <div class="asktawrap">
      <textarea id="crevText" class="askta" rows="2" placeholder="" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
    </div>
  </div>
</dialog>

<!-- 이미지 수정 요청 팝업 — 요약 수정(#revdlg)과 완전 동일 구성(제목·라벨·부제 없음·placeholder 없음 · 위치만 다름 = 이미지 슬롯 연필). 코멘트를 그 화풍 재생성 프롬프트에 반영(api/thumbredo wish). 비우면 그대로 재추첨. 1차 클릭=재확인→2차=전송(게이지). -->
<dialog id="tredodlg" class="askdlg revdlg tredodlg">
  <div class="askwrap">
    <div class="askhead"><b>이미지 수정 요청</b><div class="revhead-act"><button class="asksend revsend" id="tredoSend" type="button"><span>수정</span></button><button class="askx" id="tredoX" type="button" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
    <div class="asktawrap">
      <textarea id="tredoText" class="askta" rows="2" placeholder="" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
    </div>
  </div>
</dialog>

<!-- 전문 직접 입력 — 막힌 매체(403) Failed 픽에 기사 전문을 붙여넣어 재분석(api/pick body 경로). askdlg UIUX 계승(.sbtn 클립·X·전송). -->
<dialog id="pastedlg" class="askdlg pastedlg">
  <div class="askwrap">
    <div class="askhead"><b><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px;margin-right:5px" aria-hidden="true"><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2z"/></svg>내용 직접 입력</b><div class="askhead-act"><button class="askx askmin" id="pasteMin" type="button" aria-label="최소화"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 12h12"/></svg></button><button class="askx" id="pasteX" type="button" aria-label="닫기"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle"><path d="M6 6 18 18M18 6 6 18"/></svg></button></div></div>
    <div class="pastesub" id="pasteSub"></div>
    <div class="asktawrap">
      <textarea id="pasteText" class="askta pasteta" rows="7" placeholder="막힌 매체라 자동 수집이 안 됐어 — 기사 페이지에서 본문을 전체 선택·복사해 여기 붙여넣고 전송하면 그 내용으로 재분석해(403 우회)." autocapitalize="off" autocorrect="off" spellcheck="false"></textarea>
    </div>
    <div class="askbot">
      <button class="asksend" id="pasteSend" type="button">재분석 보내기</button>
    </div>
  </div>
</dialog>

<!-- 제작 도구 모달(iframe) — + 메뉴 항목(썸네일·릴스·영상) 클릭 시 새 페이지 대신 뷰어 위에 모달로 등장(뉴스 요약 모달과 동일 결). -->
<dialog id="tooldlg" aria-labelledby="toolTitle">
  <div class="tool-h"><b id="toolTitle">제작 도구</b><button class="tool-menu" id="toolMenu" type="button" aria-haspopup="true" aria-expanded="false" title="메뉴 전환"><span id="toolMenuLb"></span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><div class="pmenu tool-menupop" id="toolMenuPop" hidden></div><span class="tool-hbtns"><!-- 헤더 메뉴(운영자 260805 "이미지 스튜디오 우측에 · 토글 = 나머지 4개") — 라벨 = 활성 탭 워드 · 쉐브론 = pm-chev 14×14 정본 사본 · 팝업 = .pmenu 계승(이미지 셸 hdr-tabs 모드만 표시) --><button class="tool-x" id="toolMin" type="button" aria-label="최소화" title="최소화"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 12h12"/></svg></button><button class="tool-x" id="toolRf" type="button" aria-label="입력 초기화" title="입력 초기화 — 이 세부 메뉴의 글자·사진 비우기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v5h-5"/></svg></button><button class="tool-x" id="toolX" type="button" aria-label="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div>
  <div class="tool-tabs" id="toolTabs"></div>
  <iframe id="toolframe" class="toolfr" title="제작 도구" src="about:blank" allow="clipboard-read; clipboard-write; fullscreen"></iframe><!-- fullscreen = 자막 완성영상·프리뷰 전체화면(안드로이드 크롬 Fullscreen API · 260707) -->
  <div id="askHost" class="askhost" hidden></div><!-- 요약 요청 가상 탭 호스트(운영자 260712 — 요약도 이미지·영상과 동일 도구 셸) = #askdlg .askwrap을 통째 이식(reparent · 폼·전송·첨부 로직 무복제 = 드리프트 0) · 닫힘/최소화 시 askdlg로 원복 -->
  <div id="geniHost" class="askhost genihost" hidden></div><!-- 프롬프팅 이식 탭 호스트(운영자 260713 B "B로 간다" — askHost 선례 미러) = #genidlg 자식(헤더·바디·푸터)을 통째 이식(무복제 = 드리프트 0) · 기사 카러셀 + 경로는 팝업 유지(이중 홈 · 닫힘/최소화/발사 시 genidlg로 원복) -->
  <div class="tool-loading" aria-hidden="true"><span class="nm-load" data-orb="loading" data-label="불러오는 중"></span></div><!-- 도구 프레임 로딩 표기(운영자 260724 한 수) = 활성 프레임 미준비(.toolfr.active:not(.ready)) 상태에 로딩 SSOT orb 오버레이(:has 게이트) — 느린 연결서 '멈춤?' 불안 제거 · 로더 = window.nmLoader 자동수화(nm-load[data-orb=loading] · raw 금지 하드락 정합) · 표시/은닉 = 프레임별 .ready 리빌 게이트가 전담(별도 JS 토글 0) -->
</dialog>
<!-- 제작 도구 최소화 복원 ▲ — fixed 고z 버튼(JS reparentNav가 열린 풀스크린 모달[요약리더#dlg·라이트박스] 안으로 옮겨 그 위에도 부유). 평시 탭=펼침 / 길게 눌러 "닫기" 뜨면 한 번 더 탭=완전종료. accent 그린(첨부1 우하단 특수버튼색 계승). -->
<button id="toolRestore" class="tool-restore" type="button" aria-label="제작 도구 펼치기 (길게 누르면 닫기)" title="탭하면 펼치기 · 길게 누르면 닫기"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 8 20 18 4 18Z" fill="currentColor"/></svg></button>

<!-- S 하단 네비(미래 탭 스캐폴드) — 클릭 시 그 위에 작은 팝업 -->
<nav class="bnav" id="bnav">
  <button class="bnav-i" data-tab="scrap" aria-label="LEGACY(레거시)"><span class="nv-en">LEGACY</span></button><!-- 1번 = LEGACY(운영자 260718 "맨 아래 줄 LEGACY만" — 하단 네비 라벨 축약 · 구 'LEGACY MEDIA'(260714) · 헤더 VIEWHEAD는 'LEGACY MEDIA' 유지 = "나머지 동일") -->
  <button class="bnav-i active" data-tab="feed" aria-label="뉴스 요약"><span class="feedtab">뉴스 요약<span class="qbadge" id="qbadge" title="분석 대기열 — 탭하면 열림" hidden></span></span></button><!-- 2번 = 뉴스 요약(운영자 260714 "레거시·뉴스 요약 좌측" — 구 3번서 ＋ 왼쪽으로 · active = 기본 착지 탭 유지 · qbadge 동행) -->
  <button class="bnav-fab" id="toolfab" type="button" aria-label="제작 도구"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></button>
  <button class="bnav-i" id="linkfab" data-tab="trend" aria-label="SNS"><span class="nv-en">SNS</span></button><!-- 3번 = SNS(운영자 260718 "SNS는 SNS만" — 하단 네비 라벨 축약 · 구 'SNS DIGEST'(260714) · id linkfab = 불변(참조 정본·앵커 폴백) · data-tab=trend로 showTab 합류 · 헤더 VIEWHEAD는 'SNS DIGEST' 유지) -->
  <button class="bnav-i" data-tab="chan" aria-label="채널 요약(인스타 분석)"><span>채널 요약</span></button><!-- 4번 = 채널 요약(운영자 260713 쌍 구조 · 인스타 직결 신호 · 260714 우측 유지) -->
</nav>
<!-- 제작 도구 = FAB(+) 위로 3버튼 반원 펼침(라디얼). 좌상 요약 요청(구 라벨 뉴스 요약 — 운영자 260712 개명 = 메뉴3명과 중첩 해소) · 12시 이미지 · 우상 영상. 버튼=.sbtn 투명 글래스 계승. 세부 분기는 도구 안 탭(이미지=오버레이 생성기 탭 / 영상=자막↔영상프롬프트 탭). -->
<div class="radmenu" id="bpop" hidden>
  <button class="raditem" type="button" data-act="ask" data-ang="left" aria-label="요약 요청">
    <span class="sbtn radbtn"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z"/></svg></span>
    <span class="radlab">요약 요청</span>
  </button>
  <button class="raditem" type="button" data-act="thumb" data-ang="up" aria-label="이미지(오버레이 생성기)">
    <span class="sbtn radbtn"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="9" r="1.6"/><path d="M21 16l-5-5L5 21"/></svg></span>
    <span class="radlab">이미지</span>
  </button>
  <button class="raditem" type="button" data-act="cap" data-ang="right" aria-label="영상(편집·생성·프롬프팅·음원·큐영상)">
    <span class="sbtn radbtn"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z"/><path d="m6.2 5.3 3.1 3.9"/><path d="m12.4 3.4 3.1 4"/><path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg></span>
    <span class="radlab">영상</span>
  </button>
</div>
<div class="rad-scrim" aria-hidden="true"></div>   <!-- 라디얼 가림막 = bpop 밖 형제(z 네비 아래 = 피드만 가리고 ＋·네비·라디얼 버튼은 앞) · .radmenu.open ~ 로 연동 -->

<!-- 링크(피드 탐색) = 같은 창 네비게이션(target=_blank 제거 · 운영자 260705 "웹앱 그 창 안에서 열리게") — 설치형 PWA에선 외부 사이트가 앱 창 안(안드로이드 CCT 시트·iOS 인앱 오버레이)에서 열리고 뒤로가기=앱 복귀 · 로그인 = 브라우저 쿠키 공유라 1회 로그인 후 유지. ⚠️ iframe 임베드는 SNS 전부 X-Frame-Options 차단 = 원천 불가(팝업 임베드 요청의 기술 한계 · 이 방식이 가능한 최선). ↗ 새탭 어포던스(::after)는 target 없어 자동 소멸 = 의미 정합(새 탭 아님). -->
<div class="bpop" id="linkpop" hidden>
  <button id="chanToggle" class="lp-btn pmenu-sns lp-yellow" type="button" aria-expanded="false" aria-controls="chanSub">채널<span class="pm-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 채널 아코디언(운영자 260710 신설·노랑) → 레거시피드~인스타 귀속(펼치면 나옴) -->
  <div class="pmenu-sub" id="chanSub" hidden>
    <a href="https://news.naver.com/newspaper/home">레거시 피드</a>
    <a href="https://x.com">X</a>
    <a href="https://threads.com">Thread</a>
    <a href="https://www.instagram.com/">인스타그램</a>
  </div>
  <button id="accBtn" class="lp-btn">구독 채널</button><!-- SNS 구독 채널(계정 명단) 관리(운영자 260713 설정 이관 · 260723 헤더 펜 산개 제거·명칭 '계정'→'구독 채널') → #snsaccdlg 모달 · 정적 바인딩 openSnsAcc -->
  <button id="devBtn" class="lp-btn">구독 기기</button><!-- ⚠배치 = 「구독 채널」 바로 아래(운영자 260819 "설정에 구독 기기 라고 넣어서 누르면 대기열처럼 펼쳐지고") — 이름이 짝을 이루고 둘 다 '명단 관리'라 같은 자리에 뒀다 · 모양 = lp-btn 형제(accBtn) 그대로 · 바인딩 = memoBtn/kwListBtn 패턴 → #devpop -->
  <button id="filterToggle" class="lp-btn pmenu-sns lp-yellow" type="button" aria-expanded="false" aria-controls="filterSub">필터<span class="pm-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 필터 아코디언(운영자 260710 헤더서 설정 안으로 종속·노랑) → 카드만+카테고리 칩(구 filterpop 이관) -->
  <div class="pmenu-sub lp-filtersub" id="filterSub" hidden>
    <!-- 카드만 토글(#cardonlyBtn) 삭제 — 운영자 260713 "설정 메뉴에서 카드 없애" · #cardonly hidden checkbox + render/syncCardBtn null 가드는 잔존(cardonly=false 고정 = 전체 표시·기능 무해 소거) -->
    <div class="chipbar" id="chips"></div><!-- 카테고리 칩(id 유지 = renderChips 그대로) -->
  </div>
  <button id="msgbtn" class="lp-btn">알림메세지 <span id="msgbtncnt"></span></button><!-- 메시지·발행본·설정 아코디언 = pmenu서 이관(운영자 260707) · id 유지 = openMsgbox/openPub/_setToggle 핸들러 그대로 -->
  <button id="pubBtn" class="lp-btn">발행본 <span id="pubBtnCnt"></span></button>
  <button id="memoBtn" class="lp-btn">메모</button><!-- 설정 ▸ 메모 = 작업 기록(운영자 260801 "work to do 기록 · 메모장처럼") → #mmpop 팝업 · 즉발 액션이라 흰색 lp-btn(CII 「설정 메뉴 항목 색 위계」 2분법) · 바인딩 = msgbtn/pubBtn 패턴 -->
  <button id="dgBtn" class="lp-btn">다운로드</button><!-- 설정 ▸ 다운로드 = 링크 자료수집(운영자 260721 "설정 > 다운로드로") → #dlgrab 모달 · 바인딩 = accBtn(계정→snsaccdlg) 선례 미러 -->
  <a id="lucyBtn" class="lp-btn" href="lucy.html">루시봇</a><!-- 설정 ▸ 루시봇 = 스레드 자동운영 관리 화면(운영자 260727 배치 승인 "별도 파일로 두고 설정 안에 파일로 하나") → viewer/lucy.html · 모양 = lp-btn 형제(edBtn) 그대로 · 같은 창 네비 = 채널 a 관례(target 없음 · 260705) · JS 바인딩 불요(순수 네비) -->
  <a id="edBtn" class="lp-btn" href="https://claude.ai/code">에디터</a><!-- 설정 ▸ 에디터 = 클로드 코드 진입(운영자 260721 "설정-에디터 누르면 앱이 확 뜨게") — 모양 = lp-btn 형제(dgBtn) 그대로 · 외부 이동 = 채널 a 관례(같은 창·target 없음 · 260705) = 폰은 클로드 앱(유니버설 링크)·PC는 웹, PWA는 인앱 시트+뒤로가기 복귀 · JS 바인딩 불요(순수 네비) -->

  <button id="setToggle" class="lp-btn pmenu-sns" type="button" aria-expanded="false" aria-controls="setSub">기본값<span class="pm-chev" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></button><!-- 라벨 설정→기본값(운영자 260710 — 바깥 메뉴명이 '설정'이 되며 중복 회피) -->
  <div class="pmenu-sub" id="setSub" hidden>   <!-- 설정 = 2차 아코디언(알림·잠금·PIN 변경·AI썸네일 · 순서 운영자 260710 요구7) 그 자리 펼침 · 촤르륵 = max-height transition .26s(펼침/닫힘 양방) -->
    <div class="pushrow" id="pushrow" hidden><span class="pl">알림</span><button class="pushbtn" id="pushbtn" type="button">OFF</button></div>
    <div class="pushrow" id="lockrow"><button class="lk-open" id="lockBtn" type="button">잠금</button><button class="pushbtn" id="lockOnBtn" type="button">OFF</button></div>
    <div class="pushrow" id="pinchgrow"><span class="pl">PIN</span><button class="pushbtn" id="pinChgBtn" type="button">변경</button></div><!-- PIN 변경 = 설정 직하위 독립 항목(요구6·7) · [라벨][우측버튼] = 알림/AI썸네일 행과 동형(§디자인 k 버튼패밀리 계승 = 어포던스 확보 · 평의회 감사6) · 버튼=lkSettingsRefresh 동적('변경'/'설정') · 현재PIN→새PIN→재입력(떠오르는 모션)·오답 흔들림 · 구 lockpop 내 lkRowPin(진입 불명확) 대체 -->
    <div class="pushrow" id="genimgrow"><span class="pl">AI 썸네일</span><button class="pushbtn" id="genImgOnBtn" type="button">ON</button></div><!-- AI 썸네일 전역 디폴트(서버 NM_SET.genImgOn·PIN 1회 게이트 = 잠금 lkVerifyOldPin 계승 요구3) — 검색 이미지는 무관(항상 수집) · 요약창 '이미지' 토글 = 그 건 한정 오버라이드(운영자 260709) -->
    <div class="pushrow" id="kwAlertRow"><button class="lk-open" id="kwListBtn" type="button">키워드 알림</button><button class="pushbtn" id="kwAlertBtn" type="button">OFF</button></div><!-- 키워드 알림 on/off — 좌 라벨버튼(=대기열 kwpop 진입·lockBtn 계승) + 우 ON/OFF 토글(pushbtn 계승) = 잠금 행(lockrow)과 동형 구성. 국내(social·tbs)·해외(reddit·hn·bsky) 커뮤니티에 키워드 뜨면 첫1회+24h/3h 토스트 · ON = 대기열 자동 오픈(키워드 등록 유도) -->
  </div>
  <button class="lp-ver" id="lpVer" type="button" aria-label="앱 버전 — 탭하면 복사"></button><!-- 배포 버전 도장(운영자 Q44) — stamp-version.yml이 BUILD_STAMP 치환·JS stampVer가 채움 · 설정 열면 스샷에 찍혀 구버전/미해결 판별 -->
</div>
<!-- 대기열 — 뉴스요약 버튼 길게 누르면. 분석 대기/중(pending/) 기사: 들어온시각 · 주요내용 · 전달방식 -->
<div class="bpop qpop" id="qpop" hidden>
  <div class="qh"><b>대기열</b><span class="qh-xcell"><button class="tool-x" id="qpopX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div>
  <div class="qlist" id="qpopList"></div>
  <div class="qpage" id="qpopPage"></div>
</div>

<!-- 키워드 알림 대기열 — 설정 ▸ 키워드 알림(kwListBtn) 또는 ON 전환 시 열림. 대기열(qpop) 껍데기·행 레이아웃 그대로 계승 + 하단 등록 입력행(marqpop lk-in 계승). 행 = [체크(중단)][키워드][상태][삭제]. -->
<div class="bpop qpop kwpop head-pop" id="kwpop" hidden>
  <div class="qh"><b>키워드 알림</b><button class="tool-x kw-addopen" id="kwAddOpen" type="button" aria-label="키워드 추가" title="키워드 추가"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 6v12M6 12h12"/></svg></button><span class="qh-xcell"><button class="tool-x" id="kwpopX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div><!-- 헤더 [+][X] = #tooldlg .tool-h 「최소화 − + 닫기 X」 짝 100% 모방(같은 .tool-x 부품 · svg 15/stroke 2/round 동일) — path만 − `M6 12h12` → + `M12 6v12M6 12h12`(세로선 1획 추가 = 같은 글리프 가족) · 운영자 260727 "x옆에 +가 있으면 될듯 · 최소화 되는 애들 기틀 가져와서 − 대신 +" -->
  <div class="qlist" id="kwpopList"></div>
  <div class="pushrow kw-add" hidden><span class="lk-grp"><input class="lk-in kw-in" id="kwIn" type="text" maxlength="120" placeholder="" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="done"></span><button class="pushbtn kw-addbtn" id="kwAddBtn" type="button" aria-label="키워드 추가">추가</button></div>
</div>

<!-- 설정 ▸ 구독 기기 — 알림을 켠 기기 명단(운영자 260819). 셸·행 = 키워드 알림함(kwpop) 그대로 계승(입력행만 없음).
     행 = [등록일][기기][비활성 체크][휴지통] · 체크 = 그 기기에만 발송 중단(구독은 남는다 · 다시 누르면 재개) · 휴지통 = 명단에서 제거.
     ⚠ 기기 이름은 등록 시점에 서버가 받아 적은 값이라 260819 이전 등록분은 「이름 미상」이다(그 폰에서 알림을 껐다 켜면 그때부터 이름이 붙는다). -->
<div class="bpop qpop devpop head-pop" id="devpop" hidden>
  <div class="qh"><b>구독 기기</b><span class="qh-xcell"><button class="tool-x" id="devpopX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div>
  <div class="qlist" id="devpopList"></div>
</div>

<!-- 설정 ▸ 메모(작업 기록) — 운영자 260801 "설정에 메뉴 하나 · work to do 기록 · 메모장처럼 · 쓰고나면 대기열처럼 남고 · 언제 썼는지·내용은 클릭하면 게시판처럼 나열".
     껍데기·목록↔전문 전환 = 알림메세지함(msgpop) 100% 계승(같은 .qh·.qlist·.qrow msgrow·.msgdetail 부품) · 헤더 [+][X]·하단 입력행 = 키워드함(kwpop) 계승 · 입력칸 = .askta 정본.
     행 = [작성일][내용 한 줄][수정 ✏][삭제 🗑] · 행 클릭(버튼 제외) = 전문 화면. 저장 = 서버 설정(NM_SET.memos) = 기기 바뀌어도 그대로. -->
<div class="qpop msgpop mmpop" id="mmpop" hidden>
  <div class="qh"><b>메모</b><button class="tool-x mm-addopen" id="mmAddOpen" type="button" aria-label="메모 쓰기" title="메모 쓰기" aria-expanded="false"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 6v12M6 12h12"/></svg></button><span class="qh-xcell"><button class="tool-x" id="mmpopX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div><!-- 헤더 [+][X] = 키워드함 .qh 100% 모방(같은 .tool-x 부품·svg 15/stroke 2/round·+ path 동일) -->
  <div class="qlist" id="mmpopList"></div>
  <div class="msgdetail" id="mmdetail" hidden><!-- 전문 화면 = 메시지 상세(#msgdetail) 마크업 그대로 · 알림 구분(.md-kind)·조치 버튼(.md-act)은 메모에 없는 축이라 미사용 -->
    <button class="msgback" id="mmBack" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>목록</button>
    <div class="md-meta"><span class="md-time" id="mmTime"></span></div>
    <div class="md-body" id="mmBody"></div>
  </div>
  <div class="pushrow mm-add" hidden><span class="lk-grp"><textarea class="askta mm-in" id="mmIn" maxlength="4000" placeholder="" autocapitalize="off" autocorrect="off" spellcheck="false"></textarea></span><button class="pushbtn mm-addbtn" id="mmAddBtn" type="button" aria-label="메모 저장">저장</button></div>
</div>

<!-- 발행본 — 프로필 '발행본' 버튼으로 열림. 공개 발행한 요약 목록(만료 D-N·링크복사·삭제). 대기열(qpop) 스타일·행 레이아웃·페이저 그대로 계승. -->
<div class="bpop qpop pubpop" id="pubpop" hidden>
  <div class="qh"><b>발행본</b><span class="qh-xcell"><button class="tool-x" id="pubpopX" type="button" aria-label="닫기" title="닫기"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button></span></div>
  <div class="qlist" id="pubpopList"></div>
  <div class="qpage" id="pubpopPage"></div>
</div>

<!-- Failed 칩 컨텍스트 메뉴 — 길게 누르거나(480ms) 우클릭. 실패 사유(진단 MD 다운로드) · 내용 입력(전문 붙여넣기 재분석). 앵커 팝업 셸 SSOT 프로스트 계승. -->
