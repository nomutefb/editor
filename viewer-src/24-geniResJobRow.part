function geniResJobRow(a) {
  const host = $('#geniResJobs'); if (!host) return;
  host.innerHTML = '';
  GENI_JOBS.forEach(j => host.appendChild(geniJobRow(j)));   // 진행·실패 행 = 완료 요약 줄 **위**(thumb #jobs 최신 우선 순서 동일 · tr resJobRow 동문)
  if (!a.length) return;
  const row = document.createElement('div'); row.className = 'job done';
  const lab = document.createElement('span'); lab.className = 'jlab'; lab.textContent = a[0].cap || '결과';
  const st = document.createElement('span'); st.className = 'jst';
  st.innerHTML = CHECK_SVG + '<span>완료 · ' + a.length + '장 · ' + geniHistTime(a[0].ts) + '</span>';   // 문구 = thumb 복원 잡 행 동문('완료 · N장 · <제작시각>')
  row.append(lab, st);
  const sv = document.createElement('div'); sv.className = 'jsave-row';
  if (!(a[0].src && a[0].src.app)) { const _bs = geniSrvSrcOf(a[0].url); if (_bs) a[0].src = _bs; }   // src 대여(260822 · 기기 간 재개 완료분 = 폼 스냅 미보유 → 서버 이력 동봉본)
  if (a[0].src && a[0].src.app) {   // 수정(연필) = 타일과 같은 게이트·같은 라우터(중복 문법 0)
    const ed = document.createElement('button'); ed.type = 'button'; ed.className = 'imgedit'; ed.title = '이 설정으로 수정'; ed.setAttribute('aria-label', '수정');
    ed.innerHTML = EDIT_SVG;
    ed.addEventListener('click', ev => { ev.preventDefault(); ev.stopPropagation(); studioEditOpen(a[0].src, a[0].url); });
    sv.appendChild(ed);
  }
  const dl = document.createElement('button'); dl.type = 'button'; dl.className = 'sbtn cref-dlall dlbtn'; dl.title = '전체 다운로드'; dl.setAttribute('aria-label', '전체 다운로드');
  dl.innerHTML = (window.DLSEQ_IC || DOWNLOAD_SVG) + '<span class="cref-dllbl">전체</span>';
  dl.addEventListener('click', () => a.forEach((e, i) => setTimeout(() => geniDlBlob(e.url, e.dlname || 'gen.png'), i * 220)));   // 순차 저장 = thumb 전체 다운로드 문법(브라우저 다중저장 차단 회피 간격)
  sv.appendChild(dl);
  row.appendChild(sv);
  host.appendChild(row);
}
/* 결과 = **최신 1묶음**(운영자 260817 «제일 최근거가 첨부1처럼 떠야하고, 누적분은 이전 제작에 쌓이면 되는거임») —
   구판은 세션분을 결과에 전부 쌓아서 방금 만든 것이 지난 것들과 섞였다. 지금 = 맨 위 항목의 묶음(bid)만 결과 · 나머지는 전부 이전 제작.
   ⚠ renderGeniRes·renderGeniPrev **공용 산출**이 실효 조건 = 두 칸이 같은 배열로 갈린다(결과에서 뺀 항목이 이전 제작에도 안 뜨는 유실 0 · thumb renderHist CARSLIDES 제외 동문). */
function geniResList() {
  const sess = geniResSess();
  const sk = new Set(sess.map(e => geniHistKey(e.url)));
  const a0 = sess.concat(GENI_NEWEST.filter(e => !sk.has(geniHistKey(e.url)))).sort((x, y) => (y.ts || 0) - (x.ts || 0));
  if (!a0.length) return [];
  const b0 = geniBidOf(a0[0]);
  return b0 ? a0.filter(e => geniBidOf(e) === b0) : [a0[0]];   // 묶음(bid) 통째 = 1/2·2/2 한 결과(geniFollowNewest 동문) · bid 없는 구 항목 = 그 1장
}
function renderGeniRes() {   // 결과 = 최신 1묶음(운영자 260817) — tr renderTrRes 동문
  const grid = $('#geniResGrid'); if (!grid) return;
  const a = geniResList();
  if (window.nmSeq) nmSeq.tag(a);   // 이미지 스튜디오 공용 순번 도장(운영자 260818 12차 «이미지 스튜디오 안에 있는거는 모두 같은 인덱싱을 공유») — 목록을 통째로 넘기면 표에 없는 산출물만 제작 시각 오름차순으로 발번한다(도입 첫 회 = 과거분 무표기) · 결과 칸도 같은 표
  const cc = $('#geniResCnt'); if (cc) cc.textContent = '(' + a.length + ')';
  const em = $('#geniResEmpty'); if (em) em.hidden = !!a.length || !!GENI_JOBS.length;   // 진행·실패 행이 서 있으면 「아직 없어」 안내는 물러난다(빈 칸과 진행 중은 다른 상태 · tr 동문)
  geniResJobRow(a);   // 요약 줄 = 타일과 같은 배열에서 산출(두 표현이 어긋날 여지 0)
  grid.innerHTML = '';
  a.forEach(e => grid.appendChild(geniHistItem(e, grid, '#geniResCnt')));
}
let _geniHistBooted = false, _geniHistPolling = false, _geniHistSig = '';   // in-flight 가드 + 변경감지 시그니처 = thumb pollServerHist 문법 미러(무변경 재빌드 0)
async function geniHistSync() {   // 서버 인덱스 재fetch = tr loadServerHist 동문(없으면 로컬만 = fail-soft) — 부팅 + 10s 자동 폴 + 복귀 3축 공용 진입점
  if (_geniHistPolling) return;   // in-flight 가드 = visibilitychange+focus+헤더 새로고침 동시 발동 코얼레싱(중복 fetch 0)
  _geniHistPolling = true;
  try {
    let hist = null, clr = GENI_SRV_CLEAR;
    try { const r = await fetch('thumb-hist.json?_=' + Date.now()); if (r.ok) { const d = await r.json(); if (Array.isArray(d)) hist = d; } } catch { /* 없으면 로컬만 */ }
    try { const c = await fetch('thumb-clear.json?_=' + Date.now()); if (c.ok) { const j = await c.json(); if (j && +j.ts) clr = Math.max(clr, +j.ts); } } catch { /* 없으면 0 = 안 지움 */ }
    let live = null;   // 즉시 축(운영자 260804 "다른 메뉴들과 싱크") = free.json@main 라이브 — 항목화 = build-viewer free 병합 문법 exact(같은 제작 = 같은 파일명·캡션 → 정식 교체 시 화면 무변동) · 미가용 = 종전 Pages 축만(조용한 폴백)
    try { const lr = await fetch('api/genihist'); if (lr.ok) { const d = await lr.json(); if (Array.isArray(d)) live = d; } } catch { /* fail-soft */ }
    const liveArr = (live || []).filter(it => it && it.url && !it.fail && /^https?:/.test(it.url)).map(it => {
      const ts = Date.parse(it.ts || ''); if (!Number.isFinite(ts)) return null;
      const fn = String(it.url).split('/').pop().split('?')[0] || 'gen.png';
      return { url: it.url, dlname: '생성_' + fn, cap: it.label || '생성', varStr: it.style ? ' · ' + it.style : '', ts };
    }).filter(Boolean);
    const sig = (hist ? hist.length + ':' + ((hist[0] || {}).url || '') + ':' + ((hist[hist.length - 1] || {}).url || '') : 'x') + '|' + clr
      + '|' + liveArr.length + ':' + ((liveArr[0] || {}).url || '');   // 목록 길이+첫/끝 url+clr+즉시 축 지문 = append/prepend/절단/지우기/즉시 유입 감지(thumb 동문 확장)
    if (sig === _geniHistSig) return;   // 무변경 = 재빌드 skip(10s 폴이 그리드를 매번 갈아엎어 이미지가 재로드되는 것 차단)
    _geniHistSig = sig;
    if (hist) GENI_SRV_HIST = hist;
    GENI_LIVE = liveArr;
    if (clr > GENI_SRV_CLEAR) { GENI_SRV_CLEAR = clr; try { localStorage.setItem('nomute_thumb_srvclr', String(GENI_SRV_CLEAR)); } catch {} }
    renderGeniPrev(); renderGeniRes();
  } finally { _geniHistPolling = false; geniFollowNewest(); }   // 최신 추종 = sig 무변경(early return)이어도 판정(로컬 브리지는 서버 sig 밖 — 형제 탭 histAdd 직후 폴 틱에서도 결과가 붙게 · tr 동문)
}
function geniHistBoot() { if (_geniHistBooted) return; _geniHistBooted = true; geniHistSync(); }   // 지연 개시 = 판 첫 진입(geniPrep 경유) — 메인 부팅마다 인덱스 fetch 안 함(tr 문서-로드 시점 등가)
window.addEventListener('storage', e => { if (e && (e.key === GENI_HKEY || e.key === GENI_HCLEAR_KEY)) { renderGeniPrev(); renderGeniRes(); geniFollowNewest(); } });   // thumb iframe histAdd(완료)·기록 지우기 → 부모 판 즉시 반영(같은 문서 쓰기엔 미발화지만 이 판은 브리지 키를 안 씀 = 수신 전용) + 최신 추종 재판정(형제 탭 제작 = 결과 즉시 합류)
/* ── 이전 제작 동기화 4축 = 형제 탭(thumb:4938~4943 · edit:2808 · tr) 정본 계승(운영자 260804 "번역하고 AI생성만 싱크를 맞춰줘 · 갱신만 같이 되게") ──
   구판 = 판 첫 진입 1회 + 탭 복귀뿐이라, **판을 켜둔 채 다른 기기·형제 탭에서 만든 것이 화면에 안 붙었다**(형제 4탭은 10s마다 수렴하는데 AI 생성만 정지 = 운영자가 본 「싱크 안 맞음」).
   ⚠ 이 판은 iframe이 아니라 부모 문서라 nm-sync.js 상속 밖 = 세 리스너를 여기 직접 단다(형제 탭은 nm-sync.js가 대신 걸어준다).
   `_geniHistBooted` 게이트 유지 = 판을 한 번도 안 연 세션은 0콜(메인 부팅 비용 불변). */
document.addEventListener('visibilitychange', () => { if (!document.hidden && _geniHistBooted) geniHistSync(); });   // 복귀 재동기 = tr 동문(타 기기 제작분 수신 · 미개시 판은 무동작)
window.addEventListener('focus', () => { if (_geniHistBooted) geniHistSync(); });   // 창 포커스 복귀 = thumb:4939 동문(visibilitychange 미발화 경로 · in-flight 가드가 중복 흡수)
window.addEventListener('pageshow', e => { if (e.persisted && _geniHistBooted) geniHistSync(); });   // iOS PWA bfcache 복귀 = visibilitychange 미발화 경로 보강(thumb:4940 동문)
setInterval(() => { if (!document.hidden && _geniHistBooted) geniHistSync(); }, 10000);   // raw-ok: 폴 주기(ms — 지속시간 토큰 아님) · 10s 자동 폴(운영자 260731 "동기화가 십초 단위로") — 형제 4탭과 같은 박자로 수렴 · visible+개시 게이트 + sig 게이트(무변경 재렌더 0) + in-flight 가드 = thumb pollServerHist 문법 미러
// 캐러셀 PC 드래그 — 마우스로 잡아끌어 좌우 슬라이드(터치는 overflow-x 네이티브 스와이프 유지). feedtrack 드래그와 동일 패턴.
function attachCarouselDrag(track) {
  if (!track || track._dragInit) return; track._dragInit = true;
  track.addEventListener('mousedown', e => {
    if (e.button !== 0 || (e.target.closest && e.target.closest('.sbtn,.timg-acts,a,button'))) return;   // 버튼 위에선 드래그 안 함(저장/재생성/검색)
    const sl = track.scrollLeft, x0 = e.clientX; let moved = false;
    track.classList.add('dragging');
    const mv = ev => { track.scrollLeft = sl - (ev.clientX - x0); if (Math.abs(ev.clientX - x0) > 4) moved = true; };
    const up = () => {
      window.removeEventListener('mousemove', mv); window.removeEventListener('mouseup', up);
      track.classList.remove('dragging'); track._dragged = moved;
      const ss = track.querySelectorAll('.cref-slot');   // 놓으면 가장 가까운 슬롯으로 스냅
      if (ss.length > 1) { const stride = ss[1].offsetLeft - ss[0].offsetLeft; if (stride > 0) track.scrollTo({ left: Math.round(track.scrollLeft / stride) * stride, behavior: 'smooth' }); }
    };
    window.addEventListener('mousemove', mv); window.addEventListener('mouseup', up); e.preventDefault();
  });
  track.addEventListener('click', e => { if (track._dragged) { e.stopPropagation(); e.preventDefault(); track._dragged = false; } }, true);   // 드래그 직후 클릭(확대) 억제
}
// 슬롯별 '수정·재생성'(.sbtn 계승) — 연필 아이콘 탭 → 코멘트 팝업(#tredodlg)이 열려 코멘트를 그 화풍 재생성 프롬프트에 반영(api/thumbredo wish).
// 새로고침(↻) 아님 = '수정→재생성'(운영자 260702). 재확인·전송·게이지는 팝업(요약 수정 revdlg 미러)이 담당. 전송 후 슬롯에 진행바 오버레이(markSlotReshooting) · load 폴이 새 이미지(?v=) 오면 섹션 교체.
function thumbRedoSbtn(sid) {
  const b = document.createElement('button');
  b.type = 'button'; b.className = 'sbtn'; b.title = '이 화풍 수정'; b.setAttribute('aria-label', '이 화풍 수정');
  b.innerHTML = EDIT_SVG;   // 연필 = 수정(카드 편집 아이콘과 통일 · 새로고침 아님)
  b.addEventListener('click', e => { e.stopPropagation(); openTredo(sid); });
  return b;
}

// ── 썸네일 이미지: 복사·저장·확대(라이트박스) — §🎨 .sbtn/.tool-x/<dialog>+popstate 계승 ──
// 전체 다운로드 통합 — 순차 저장(진행 i/N 라벨) → 초록 ✓ 완료(첨부2식). 검색이미지·카드피드 두 자리 공용(운영자 260622).
// 다운로드 완료(이미 받음) 표식 — URL 키로 기억해 재렌더에도 'mut(.dl-done)' 유지(전 앱 공통 기틀·운영자 260701·흰색→mut 260706)
const DLED = new Set();
const _dlKey = u => (u || '').split('?')[0].split('#')[0];
const dlSeen = u => !!u && DLED.has(_dlKey(u));
const dlMark = (u, btn) => { if (u) DLED.add(_dlKey(u)); if (btn) btn.classList.add('dl-done'); };
async function dlAllSeq(btn, urls, namer, fire) {
  if (!btn || btn._dlbusy) return;
  urls = (urls || []).filter(Boolean);
  if (!urls.length) return;
  btn._dlbusy = 1; btn.style.pointerEvents = 'none';
  btn.style.minWidth = Math.ceil(btn.getBoundingClientRect().width) + 'px';   // 폭 잠금 — 옛 '저장 중… i/N' 라벨이 버튼 폭을 키워 행이 출렁(thumb 전체버튼 동일 실측 · 운영자 260705). 진행 라벨은 숫자만이라 잠근 폭 안 = 시퀀스 내내 레이아웃 무이동
  const lbl = btn.querySelector('.cref-dllbl');
  const orig = lbl ? lbl.textContent : '';
  btn.classList.remove('dlseq-done', 'dlseq-release'); btn.classList.add('dlseq-busy');   // 좌→우 채움 시작(글래스 §9)
  btn.style.setProperty('--p', '0');
  for (let i = 0; i < urls.length; i++) {
    if (fire) fire(urls[i], i); else downloadImg(urls[i], namer(i));   // fire = 저장 방식이 downloadImg가 아닌 호출처(설정▸다운로드 = api/dl 직행 앵커·linkgrab 프록시)의 주입구 — 진행표기·✓팝·폭잠금 등 시퀀스 계약은 이 정본 한 곳이 그대로 담당(버튼 재설계·로직 복제 0)
    if (lbl) lbl.textContent = `${i + 1}/${urls.length}`;   // 산문 '저장 중…' 제거 = 숫자만(픽토+진행수 어포던스·§디자인 산문 최소화·tabular-nums) — 폭 잠금과 짝(운영자 260705 · thumb dlAllSeq와 1:1 — 구 jSaveSeq 폐기 260705)
    btn.style.setProperty('--p', String((i + 1) / urls.length));   // 진행률만큼 채움(검정 글자 드러남)
    await new Promise(r => setTimeout(r, 280));
  }
  if (lbl) lbl.textContent = '완료';
  btn.classList.remove('dlseq-busy'); btn.classList.add('dlseq-done', 'dl-done');   // 꽉 채움 + ✓ 팝 + 글로우 · dl-done=전체 받음 mut 유지
  if (!fire) urls.forEach(u => DLED.add(_dlKey(u)));   // 개별 URL도 '받음' 기억(개별 버튼도 mut 복원) · fire 경로는 '받음' 표식을 호출처가 자기 키(기기 로컬 got)로 이미 남긴다 = 여기서 중복 기록 안 함
  setTimeout(() => {   // ✓ 잠깐 보여준 뒤 즉시 복귀(드레인 없음 = 글자 안 가려짐·운영자 260622)
    btn.classList.add('dlseq-snap'); btn.classList.remove('dlseq-done');
    if (lbl) lbl.textContent = orig || '전체';
    btn.style.setProperty('--p', '0'); btn.style.minWidth = '';   // 폭 잠금 해제(운영자 260705)
    requestAnimationFrame(() => btn.classList.remove('dlseq-snap'));
    btn._dlbusy = 0; btn.style.pointerEvents = '';
  }, 1050);
}
function _flashBtn(btn, mode) {   // mode: true|'ok'=초록체크 · 'warn'=부분(앰버·URL만/새탭) · 'err'=실패(빨강)
  if (!btn) return;
  if (!btn.dataset.icon) btn.dataset.icon = btn.innerHTML;
  const m = mode === true ? 'ok' : mode;
  if (m === 'ok') { btn.innerHTML = CHECK_SVG; btn.classList.add('ok'); }
  else if (m === 'warn') { btn.innerHTML = CHECK_SVG; btn.classList.add('warnflash'); }
  else { btn.classList.add('errflash'); }
  setTimeout(() => { btn.innerHTML = btn.dataset.icon; btn.classList.remove('ok', 'warnflash', 'errflash'); }, 1500);
}
async function _blobToPng(blob) {   // 클립보드는 png가 가장 호환 — fetch blob(미오염)을 캔버스로 png 변환
  const bmp = await createImageBitmap(blob);
  const cv = document.createElement('canvas'); cv.width = bmp.width; cv.height = bmp.height;
  cv.getContext('2d').drawImage(bmp, 0, 0);
  return await new Promise(res => cv.toBlob(res, 'image/png'));
}
async function copyImg(url, btn) {
  if (!url) return;
  try {
    const r = await fetch(dlSrc(url)); if (!r.ok) throw new Error('proxy ' + r.status);   // R2는 같은-출처 프록시 경유 → 이미지 복사도 CORS 무관 성공
    const blob = await r.blob();
    const png = blob.type === 'image/png' ? blob : await _blobToPng(blob);
    await navigator.clipboard.write([new ClipboardItem({ 'image/png': png })]);
    _flashBtn(btn, 'ok');
  } catch (e) {                                            // 이미지 복사 불가(CORS·권한) → URL 텍스트라도(정직: warn 표시)
    try { await navigator.clipboard.writeText(url); if (btn) btn.title = '이미지 복사 불가(외부) — URL을 복사함'; _flashBtn(btn, 'warn'); }
    catch { _flashBtn(btn, 'err'); }
