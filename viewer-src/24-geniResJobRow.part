    const b = document.createElement('button');
    b.className = st === 'failed' ? 'mkbtn retry' : 'mkbtn';   // 실패 재시도 = 레몬(노랑) 통일(운영자 260701)
    b.textContent = st === 'failed' ? '프롬프트 다시 생성' : '프롬프트 생성';
