<script>
/* 셸 절단 자가치유(260802 웹앱 '상단만 렌더·하단 nav 실종' 사고) — sw.js가 index 셸을 캐시-우선(SWR)으로 서빙하는데
   라이브 응답이 content-length 없는 청크 스트림이라(실측 260802) 전송 중 절단이 '정상 EOF'처럼 보여 잘린 셸이
   nm-shell-v2에 박힐 수 있다 → 그 기기는 매 진입 상단만 렌더(§: 정적 #bnav조차 DOM에 없음 = 인라인 부팅 JS 전멸 =
   갱신 리스너도 없어 자가회복 불능). 이 가드는 head 최상단이라 절단 사본 안에서도 살아남는다:
   DCL 때 문서 끝 센티널 #nm-eod(</body> 직전 · 이 스크립트와 한 쌍 = 삭제·이동 금지)가 없으면 절단 셸로 판정 →
   nm-shell-v2 퍼지 + ?nosw=1(sw.js ⓑ 캐시 전면 우회 탈출구) 1회 재진입 = 순수 네트워크 온전 셸.
   루프 가드 3중: ①sessionStorage 세션당 1회 ②nosw 진입서 또 절단 = 회선 자체 문제 → 재발사 안 함 ③저장 불가(프라이빗) = 치유 포기.
   짝 = sw.js 절단 검문(put 전 </html> 꼬리 확인 = 오염 원천 차단) — 이쪽은 이미 오염된 기기의 탈출로. */
(function () {
  function heal() {
    try {
      if (document.getElementById('nm-eod')) { try { sessionStorage.removeItem('nmShellHeal'); } catch (_) {} return; }   // 온전 셸 = 무동작(+다음 사고 대비 가드 리셋)
      var qs = new URLSearchParams(location.search);
      if (qs.has('nosw')) return;                                                     // 순수 네트워크로도 절단 = 회선 문제 — 재발사 무의미(루프 차단 ②)
      try { if (sessionStorage.getItem('nmShellHeal')) return; sessionStorage.setItem('nmShellHeal', '1'); } catch (_) { return; }   // 루프 차단 ①·③
      var fired = false, go = function () { if (fired) return; fired = true; qs.set('nosw', '1'); location.replace(location.pathname + '?' + qs.toString() + location.hash); };
      var t = setTimeout(go, 1500);                                                   // caches API 무응답 대비 상한
      try { caches.delete('nm-shell-v2').then(function () { clearTimeout(t); go(); }, function () { clearTimeout(t); go(); }); }
      catch (_) { clearTimeout(t); go(); }                                            // caches 미지원(비보안 컨텍스트 등) = 캐시 퍼지 생략하고 재진입만
    } catch (_) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', heal);
  else heal();
})();
/* Access 세션 만료 자가치유(260923 실사고 · 운영자 «화면은 뜨는데 내용이 안 나오고 버튼도 안 된다») — Access 세션이 무효면
   sw.js가 캐시 셸을 서빙해 화면은 뜨지만 외부 스크립트(nm-clip.js 등)·데이터·API가 전부 로그인 페이지로 튕긴다 → 본체 스크립트가
   attachCopyPaste 미정의로 즉사하고, 그 안에 있던 nm-auth-stale 리스너도 같이 죽었다. sw.js 통지는 새 문서가 클라이언트로 잡히기 전에
   발사돼 유실되기도 한다(로컬 재현 실측) = 기기가 빈 화면에 갇힘. 그래서 외부 스크립트보다 앞(head)에서:
   ① SW가 서빙한 진입(controller ∧ nosw 아님)이면 스스로 세션 확인 — nm-sync.js ② 프로브 계승(/nm-sync.js HEAD · redirect:'manual' ·
      ⚠ manifest.json·sw.js·favicon.ico는 Access 우회 경로라 만료여도 200 = 프로브 사문 · 260923 실측)
   ② sw.js nm-auth-stale 통지 수신. 만료 확정 = ?nosw=1 재진입(SW 우회 → 로그인 화면).
   루프 가드 = sessionStorage nmAuthKick 세션 1회(nosw 착지 = 재무장) · 회선 사망(fetch reject) = 재진입 무익 → 무동작. */
(function () {
  var sw = navigator.serviceWorker;
  if (!sw) return;
  var nosw = false;
  try { nosw = new URLSearchParams(location.search).has('nosw'); } catch (_) {}
  if (nosw) { try { sessionStorage.removeItem('nmAuthKick'); } catch (_) {} }   // 재로그인 복귀 착지 = 가드 재무장(같은 탭 재만료 대비)
  function kick() {
    try { if (sessionStorage.getItem('nmAuthKick')) return; sessionStorage.setItem('nmAuthKick', '1'); } catch (_) { return; }   // 세션 1회 · 저장 불가 = 포기
    window._nmAuthKicked = true;   // 새 버전 적용(applyShellUpdate) reload가 이 replace를 밟지 않게 하는 표식
    try { var u = new URL(location.href); u.searchParams.set('nosw', '1'); location.replace(u.href); } catch (_) {}
  }
  try { sw.addEventListener('message', function (e) { if (e.data && e.data.type === 'nm-auth-stale') kick(); }); } catch (_) {}
  if (nosw || !sw.controller) return;   // 네트워크 진입 = 문서가 방금 Access를 통과함
  try { if (sessionStorage.getItem('nmAuthKick')) return; } catch (_) { return; }
  try {
    fetch('/nm-sync.js?_=' + Date.now(), { method: 'HEAD', redirect: 'manual', cache: 'no-store' }).then(function (r) {
      if (r.type === 'opaqueredirect' || r.status === 401 || r.status === 403 || (r.status >= 300 && r.status < 400)) kick();
    }, function () {});
  } catch (_) {}
})();
