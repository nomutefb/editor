const failChipHtml = c => `<button class="sc-fail" type="button" title="탭 = 재시도(다시 분석) · 길게 = 실패 사유·내용 입력 · 제목 = 원문">${failLabel(c)}</button>`;
// '픽 취소(픽 전으로)' = ✓ 체크(구 260701 체크=제자리복귀 → 260711 끄기 → 260722 픽취소): 로컬 픽 해제 + 취소셋(nm_fail_requeue) 등재로
