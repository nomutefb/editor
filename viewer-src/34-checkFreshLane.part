const pickTimedOut = c => { if (!DATA_LOADED) return false; const r = ratingsAll()[candId(c)] || {}; const _ps = pendStatus(c); const _trust = _ps === 'retry' || (_ps === 'processing' && !!r.pickedAt && (Date.now() - r.pickedAt < PICK_HARD_MS)); if (!r.picked || _trust || pickInFeed(c) || pfailHas(c) || pfResolved().has(candId(c)) || pfResubActive(candId(c))) return false; return !r.pickedAt || (Date.now() - r.pickedAt > PICK_TIMEOUT_MS); };   // pickedAt 없는 옛 픽 = 즉시 타임아웃 처리(무한 Picking 차단·260618) · retry(서버 일시 과부하 자동 재시도 중)·processing(서버 진실원본 = pending 잔류·직렬 배치 대기 중, 단 PICK_HARD_MS 내에서만 신뢰)이면 타임아웃 비활성 = 빨강 링/토스트 거짓FAIL 차단(pickState와 짝·운영자 260622 · 직렬 배치 52분 대기가 Failed(3)로 오표시되던 것 차단 260703 — 진짜 실패는 서버 stuck[런 비활성 20분·활성 120분]/picks-failed 가 알림)
const pickFailedShow = c => pfailHas(c) || pickTimedOut(c);   // 화면 '실패' 표시 = 서버 분석실패(picks-failed) OR 클라 무응답 타임아웃
// 실패 재시도 횟수(누적) — Failed(N) 표시 · 재시도(대기열 재투입)할 때마다 +1 (운영자 260701)
const FAILRETRY_KEY = 'nm_fail_retries';
const failRetriesGet = () => { try { return JSON.parse(localStorage.getItem(FAILRETRY_KEY) || '{}'); } catch { return {}; } };
function bumpFailRetry(c) { const m = failRetriesGet(), id = candId(c); m[id] = (m[id] || 0) + 1; try { localStorage.setItem(FAILRETRY_KEY, JSON.stringify(m)); } catch {} }
const failCount = c => 1 + (failRetriesGet()[candId(c)] || 0);   // 최초 실패 1 + 재시도 횟수
