function checkFreshLane() {
  const el = document.getElementById('sysFreshToast');
  const kstH = new Date(Date.now() + 9 * 3600000).getUTCHours();   // 브라우저 로컬 tz 무관 KST 시(naive Date 금지 축과 무관한 산술 시프트)
  const n = CANDS.filter(c => (Date.now() - scTs(c)) < FAST_MAX_H * 3600000).length;   // scTs = 발행(미래 오기록 = first_seen 폴백) — 신규 칼럼 판정과 동축
  const laneBad = candFresh() && CANDS.length > 100 && n < FRESH_ALERT_MIN;   // candFresh = 소스축(CAND_LIVE) × 시간축(CAND_TS) 자격검사(정의·사유 = 9696행 블록). CAND_LIVE만이던 구식은 정적 폴백 스냅샷 오탐만 막고(260725), *fetch가 통째로 실패해 last-good이 몇 시간 묵는* 경로는 못 막아 260731 오탐이 났다 — 둘 다 "낡은 데이터로 수집 고장을 외치는" 같은 뿌리   // 건강 판정 = 야간·탭 게이트와 분리(평의회A "야간 게이트 ≠ 회복" — 융합 시 자정마다 ack 무단 리셋)   // 건강 판정 = 야간·탭 게이트와 분리(평의회A "야간 게이트 ≠ 회복" — 융합 시 자정마다 ack 무단 리셋)
  if (candFresh() && CANDS.length > 100 && n >= FRESH_ALERT_MIN * 2) { try { localStorage.removeItem(FRESH_ACK_KEY); } catch {} _freshMute = false; _freshAckTs = 0; if (srvFreshAckTs()) postSysSeen('rearm'); }   // ⚠ candFresh 동반 필수(260731 실측) — **회복 선언은 고장 판정과 같은 신뢰 등급의 데이터로만**. 게이트를 고장 선언(laneBad)에만 걸고 이 줄을 밖에 두면, 서빙이 죽어 얼어붙은 last-good에 4h내 건이 남아 있는 동안 그 기기가 "고장 판정은 못 하면서 회복 선언만 하는 기기"가 된다 = 계정 ack·로컬 ack·✗뮤트를 무단 해제하고 rearm을 쏴서, ✓를 눌러도 타 기기서 되살아나는 잔소리 루프(최대 4h). 교착 없음 = 계정 ack 12h TTL·_freshMute 세션한정·서빙 복구 첫 성공 폴에서 정상 재무장   // 재무장 = 확실 회복(임계×2 히스테리시스)만 — 경계 진동(4↔6건 = 주간 12.9% 체류 실측)이 ✓·✗를 10~30분마다 지우던 플리커 봉합(평의회B). ✗(접속 숨김)도 확실 회복 후 재고장 = 새 사건이라 재표시(의도). 계정 ack 활성 시 rearm 이벤트 1회 동기(낙관 add로 srvFreshAckTs 즉시 0 = 매 폴 재발송 차단·운영자 260717 계정 종속 일반화).
  document.body.classList.toggle('has-freshbad', (laneBad && kstH >= 8) || candStale());   // ⚠ `|| candStale()` 동반 필수(260731 실측) — 붉은 경보에 자격검사를 걸면서 기어까지 같이 끄면 "진짜 고장 + 서빙 사망"에서 **화면 표시가 0**이 된다. 대체 채널이라던 staleDataMsg는 id도 `_sys`도 없어 renderMsgBadge(7766~7769행)의 unread·warn·sysbad 어디에도 안 잡히기 때문(= 메시지함을 직접 열어야만 보임 · 260725 "항상 뜨게"가 실제로는 무점등이던 구멍의 동반 봉합). 역할 분리 = **기어(상태: 정상 아님) vs 붉은 경보(원인 주장: 수집이 죽었다)** — 원인을 단정 못 할 땐 경보는 침묵하고 기어만 켠다(원인 설명은 메시지 문구 담당)   // 🚨 기어 빨강 점등 = 고장 판정만 따른다(운영자 260725 "해결될 때까지 출력") — ✓·✗ 억제도, 수집함 탭 양보도 무시(그건 *토스트* 잔소리 억제 축) · 야간 오탐 가드(08시)만 공유 · 소등 = 신규 수집 실회복. 선례 = body.has-pickfail 토글 문법 그대로
  if (!laneBad || kstH < 8 || CURTAB === 'scrap') { if (el) el.classList.remove('show'); return; }   // 소등만(ack·mute 무접촉): 회복 완충대(5~9건)·야간(08시 전 = 새벽 발행 저조 오탐 가드)·수집함 탭(빈 신규 칼럼을 직접 보는 중 = 잔소리 0 — 긴급 토스트 CURTAB!=='scrap' 관례 계승 · 평의회B)
  let ack = 0; try { ack = +localStorage.getItem(FRESH_ACK_KEY) || 0; } catch {}
  const _rT = srvSysMax().r;   // 계정 rearm(재무장)을 로컬 축에도 전파(평의회① — ✓ 누른 기기가 회복 시점에 닫혀 있으면 로컬 ✓가 살아남아 12h 내 '새 고장'을 그 기기만 놓치던 구멍): 최신 계정 rearm보다 과거인 로컬 ✓ = 그 사건 종결 = 무효
  if (_rT && ack && ack < _rT) { ack = 0; try { localStorage.removeItem(FRESH_ACK_KEY); } catch {} }
  if (_rT && _freshAckTs && _freshAckTs < _rT) _freshAckTs = 0;
  if (_freshMute || Date.now() - Math.max(ack, _freshAckTs, srvFreshAckTs()) < FRESH_ACK_MS) { if (el) el.classList.remove('show'); return; }   // 억제 = 로컬(기기 즉시) ∪ 계정(타 기기 ✓ — 폰에서 처리하면 PC도 조용 · 운영자 260717)
  if (_toastC || document.querySelector('#nmToast.show, #nmFailToast.show')) { if (el) el.classList.remove('show'); return; }   // 긴급·실패 토스트 우선(상태변수+DOM 실측 이중) — 표시 중이던 경보도 즉시 소등(같은 자리·같은 z 겹침 차폐 차단 · 평의회C — 가족 내려간 다음 폴에 재점등)
  if (el && el.classList.contains('show')) { el.title = '발행 ' + FAST_MAX_H + '시간 내 ' + n + '건 (기준 ' + FRESH_ALERT_MIN + '건 미만) — 수집 파이프라인 점검 필요'; return; }   // 이미 표시 중 = 수치만 갱신 — 60s 폴마다 innerHTML 재구축 시 role=alert 라이브영역이 매분 재낭독(SR 잔소리)·탭 순간 노드 교체 유실 방지
  let t = el;
  if (!t) { t = document.createElement('div'); t.id = 'sysFreshToast'; t.className = 'nm-toast'; t.setAttribute('role', 'alert'); t.setAttribute('aria-live', 'assertive'); document.body.appendChild(t); }
  t.title = '발행 ' + FAST_MAX_H + '시간 내 ' + n + '건 (기준 ' + FRESH_ALERT_MIN + '건 미만) — 수집 파이프라인 점검 필요';
  t.innerHTML = '<span class="tg">' + WARN_SVG + '</span><span class="ft-msg">신규 뉴스가 안 들어오고 있어요.</span>'
    + '<button class="sbtn ft-act" type="button" data-bt="ack" data-motion="check" aria-label="처리 완료" title="처리 완료 — 12시간 조용히(신규가 회복되면 자동 재무장)">' + CHECK_SVG + '</button>'
    + '<button class="sbtn ft-act" type="button" data-bt="x" aria-label="닫기" title="닫기 — 이번 접속 동안만 숨김">' + X_TOAST_SVG + '</button>';
  t.querySelector('[data-bt="ack"]').onclick = ev => { ev.stopPropagation(); _freshAckTs = Date.now(); try { localStorage.setItem(FRESH_ACK_KEY, String(_freshAckTs)); } catch {} postSysSeen('ack'); t.classList.remove('show'); };   // 메모리 미러 선기록 = 저장 실패해도 이 접속에선 ✓ 유효(평의회E) · 계정 ack 동기 = 타 기기도 조용(운영자 260717)
  t.querySelector('[data-bt="x"]').onclick = ev => { ev.stopPropagation(); _freshMute = true; t.classList.remove('show'); };
  requestAnimationFrame(() => t.classList.add('show'));   // 상주형(자동닫힘 없음) = "처리 완료 체크까지 뜸" — 긴급 토스트 8s 자동닫힘과 다른 점(의도)
}
// ── ⚠ 픽 분석 실패 알림 — fetch 막는 매체(chosun 등)로 분석 실패해 'PICKED'로 남고 피드에 안 뜬
//    '내가 픽한' 기사. 속보와 동일 급(프로필 링·토스트)으로 알리고, 수집함서 '다시'(전문 붙여넣기)로 복구.
//    build-viewer 가 pending/failed/ → picks-failed.json 으로 떨궈줌(이미 queue에 든 복구분은 제외). ──
let PFAIL = new Map();   // 정규화url → {reason, ts}
const PF_SKEY = 'nomute_pickfail_seen', PF_RKEY = 'nomute_pickfail_resolved';
const _normU = u => String(u || '').trim().replace(/\/+$/, '');   // build-viewer normUrl 과 동일(끝슬래시만)
// 수집함 카드 '원문 링크' = 클러스터 대표 매체 픽(breaking_pick) 우선. c.url 은 최초보도(흔히 통신사·군소)라
// 다매체 이슈에서 내용 빈약/외딴 매체로 튐(운영자 260622). 제목·매체는 이미 픽 기준(breaking_pick)이라 링크까지
// 일치시킴 = 조선/동아 보수메이저 → 중진보 메이저(scraper PICK_PRIORITY) url 로 이동. 픽 url 비거나 비-http 면
// c.url 폴백. dedup·픽·api 호출은 그대로 c.url(1차 키 불변) — 이 함수는 *읽기(링크 이동)* 전용.
const scLinkUrl = c => {
  const bp = (c && c.breaking_pick && c.breaking_pick.url) || '';
  if (/^https?:\/\//i.test(bp)) return bp;
  return /^https?:\/\//i.test((c && c.url) || '') ? c.url : '';
};
// 외부 원문 새 탭 — *앵커 클릭* 패턴(failOpen과 동일). window.open 안 씀 = ① 전역 open(피드 모달)에 셰도잉
//   안 됨 ② iOS 스탠드얼론 PWA서 location.href면 외부 사이트에 갇힘(뒤로 못 옴) → target=_blank는 사파리로 빠져
//   앱 보존(분신술9·10). hrefOk로 javascript:/data: 차단. 앱을 *안* 떠나므로 BACK 무한루프도 원천 없음(분신술1·4).
function openExt(url) {
  const u = hrefOk(url); if (!u || u === '#') return false;
  try { const a = document.createElement('a'); a.href = u; a.target = '_blank'; a.rel = 'noopener noreferrer'; document.body.appendChild(a); a.click(); a.remove(); }
  catch (_) { try { location.href = u; } catch (__) {} }
  return true;
}
// 긴급(breaking) 건 공용 랜딩 — 백그라운드 푸시 딥링크·포그라운드 토스트가 *같은* 경로 = '해당 건에 정확히' 일관(분신술9·10):
//   누른 시점에 요약 완료면 그 요약창(pickedOpen) / 아니면 스크랩 기사 중 가장 메이저(breaking_pick) 원문 새 탭. bl=서버 폴백 메이저 url.
function goBreaking(c, bl) {
  if (!c) { if (/^https?:\/\//i.test(bl || '')) openExt(bl); else showTab('scrap'); return; }
  if (scFeedArticle(c)) { showTab('feed'); pickedOpen(c); return; }   // ← 요약 완료? YES → 그 요약 페이지
  const link = scLinkUrl(c) || (/^https?:\/\//i.test(bl || '') ? bl : '');   // NO → 가장 메이저 기사(대표 매체 픽) 원문
  if (link) { openExt(link); return; }
  showTab('scrap');
}
// 멤버기반 picked 승계 — rep url이 점프(클러스터 split)해 candId가 바뀌어도, cluster_members 중
// picked 찍힌 옛 url이 있으면 PICKED 유지(+pickCross 증분). 스크래퍼 별칭승계의 뷰어 짝.
function ratingFor(c) {
  const rt = ratingsAll(), own = rt[candId(c)] || {};
  if (own.picked) return own;
  for (const m of (c.cluster_members || [])) {
    const rm = rt[m] || rt[_normU(m)];
    if (rm && rm.picked) return { ...own, picked: true, pickCross: rm.pickCross };   // 멤버로 PICKED 승계
  }
  return own;
}
const pfSeen = () => { try { return new Set(JSON.parse(localStorage.getItem(PF_SKEY) || '[]')); } catch { return new Set(); } };
const pfResolved = () => { try { const s = new Set(JSON.parse(localStorage.getItem(PF_RKEY) || '[]')); TF_SRV.pr.forEach(id => s.add(id)); return s; } catch { return new Set(TF_SRV.pr); } };   // 로컬 ∪ 계정(pr축 — 폰에서 해소한 실패가 PC서도 Picking 탈출 · 운영자 260717 "경계도 ㄱ")
const pfAddResolved = id => { try { const s = pfResolved(); s.add(id); localStorage.setItem(PF_RKEY, JSON.stringify([...s])); } catch {} postSeenIds('pr', [id]); };
// 전문 직접 입력(재제출) 진행창 — Failed 칩 메뉴 '내용 입력'으로 전문을 보낸 직후 candId→타임스탬프 기록.
//   활성 동안(폴 상한과 동일) pfailHas 억제 → Failed가 Picking…으로 전환. 성공하면 pickInFeed로 PICKED(영구),
//   창 지나도 미성공이면 다시 Failed(재실패 인지·또 시도 가능). pfResolved(영구해소·api/submit 경로)와 달리 *임시*.
const PF_USKEY = 'nomute_pickfail_resub';
const pfResub = () => { try { return JSON.parse(localStorage.getItem(PF_USKEY) || '{}'); } catch { return {}; } };
const pfAddResub = id => { try { const m = pfResub(); m[id] = Date.now(); localStorage.setItem(PF_USKEY, JSON.stringify(m)); } catch {} };
const pfRemoveResub = id => { try { const m = pfResub(); delete m[id]; localStorage.setItem(PF_USKEY, JSON.stringify(m)); } catch {} };   // 재시도 발사 롤백 짝(api/pick 거절 시 Picking 낙관 표시 회수 · 평의회 260713 ⑦)
const pfResubActive = id => { const t = pfResub()[id]; return !!t && (Date.now() - t < PICK_TIMEOUT_MS + 60000); };
// 실패 표시 대상 = picks-failed 에 있음 + 복구표시 안 함(api/submit) + 재제출창 아님(전문 직접입력 진행 중) + 피드 미등장(늦은 성공이면 PICKED 우선·stale 실패기록 무시).
// 실패 키 = c.url 또는 클러스터 멤버 url 중 picks-failed에 있는 첫 키(pendStatus·srvTriage와 동일 패턴 — rep-url 점프 시 형제 url로 기록된 실패도 매칭·운영자 260620).
// 픽 alt(대체 fetch 후보) = breaking_pick(본문 풍부한 메이저·PICK_PRIORITY 조선>…) 우선 + cluster_members. rep url 제외·중복제거.
//   analyze 가 alt 를 본문 폴백/모델 제시로 쓰는데, 대표(rep)가 '최초보도=통신사'면 본문이 빈약 → 시스템이 이미 고른
//   메이저 신문을 맨 앞에 둬 더 완전한 본문을 먼저 시도하게 한다(통신사 rep 실패 근본해결 · 운영자 260622). mega 클러스터(cluster_members=[])도 breaking_pick는 살아있어 보강됨.
function pickAlt(c) {
  const rep = _normU(c.url);
  const major = (c && c.breaking_pick && c.breaking_pick.url) ? _normU(c.breaking_pick.url) : '';
  return [...new Set([major, ...((c.cluster_members || []).map(_normU))])].filter(u => u && u !== rep);
}
const pfKeyOf = c => [_normU(c.url), ...((c.cluster_members || []).map(_normU))].find(u => u && PFAIL.has(u)) || '';
const pfailHas = c => !!pfKeyOf(c) && !pfResolved().has(candId(c)) && !pfResubActive(candId(c)) && !pickInFeedStrict(c);   // ⚠️ Strict(url+event_key) — 제목 폴백으로 서버실패를 무관 동일제목 요약에 잘못 은폐하는 것 차단(병렬검증 R1). 드리프트 성공 복구는 build가 큐된 url을 picks-failed서 빼며 자연 해소.
const pfReason = c => (PFAIL.get(pfKeyOf(c)) || {}).reason || '';
let PFAIL_LOADING = false;   // in-flight 가드 = 부팅 eager(9069) + enterScrap(7359) 동시호출 중복 fetch 차단(loadCandidates 패턴 · 운영자 260705 로딩 진단)
async function loadPickFails() {
  if (PFAIL_LOADING) return; PFAIL_LOADING = true;
  try {
    const r = await fetch('picks-failed.json?_=' + Date.now());
    if (r.ok) { const d = await r.json(); if (Array.isArray(d)) PFAIL = new Map(d.map(x => [_normU(x.url), { reason: x.reason || '', ts: x.ts || '' }])); }
  } catch { /* 없으면 무시 */ }
  finally { PFAIL_LOADING = false; }
  detectPickFail();
}
// 알림 대상 = 내가 픽함(로컬 ratings) + 실패목록에 있음(같은 기기서 픽→실패 인지).
const pickFailNow = () => { const RA = ratingsAll(); return CANDS.filter(c => { const r = RA[candId(c)] || {}; return r.picked && pickFailedShow(c) && !failRequeued(c); }); };   // 링/토스트 알림 대상 = 서버실패 OR 무응답 타임아웃(체크로 제자리 복귀한 건 = 확인처리라 알림 제외) · RA 호이스트 = breakingNow와 동일 축(건당 localStorage 통파싱 → 폴당 1회 · 260717)
// ── 픽 후 'Picking…'(분석 중) → 뉴스요약(피드)에 떴으면 PICKED · 실패면 '분석 실패' ──
