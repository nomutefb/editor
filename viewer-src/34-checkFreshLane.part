const failRequeued = c => failRequeuedSet().has(candId(c));
function cancelPickPrepick(c) {   // ✓ 체크 = 픽 취소(픽 하기 전으로): 로컬 픽 해제 → 취소셋 등재 → renderScrap이 [PASS][PICK] 정상카드로 복귀
