//   확인 기록 = 로컬(즉시) ∪ 계정 qf축(api/seen — 폰에서 확인하면 PC도 소등 · CLAUDE.md D3-1 "localStorage 단독 금지").
//   새 실패가 생기면 그 id는 미확인이라 다시 점등(영구 묵음 금지 = 형제 알림 계약 그대로).
let QFAIL_IDS = [];   // 현재 대기열의 실패 항목 id 목록(loadPending·loadQueue 공용 갱신)
const QF_SEEN_KEY = 'nomute_qfail_seen';
function qfSeenSet() { try { const s = new Set(JSON.parse(localStorage.getItem(QF_SEEN_KEY) || '[]')); TF_SRV.qf.forEach(id => s.add(id)); return s; } catch { return new Set(TF_SRV.qf); } }   // 로컬(즉시성 캐시) ∪ 계정(qf축) = msgReadSet 문법 미러
function paintQFailGear() { try { const s = qfSeenSet(); document.body.classList.toggle('has-qfail', QFAIL_IDS.some(id => !s.has(id))); } catch {} }   // 미확인 실패 잔존 = 점등(paintKwGear 문법 계승)
function qfMarkSeen() {   // 대기열 열림 = 지금 보이는 실패분 전부 확인 처리(로컬 즉시 + 계정 동기) → 즉시 소등
  const s = qfSeenSet(), fresh = QFAIL_IDS.filter(id => id && !s.has(id));
  if (fresh.length) {
    fresh.forEach(id => s.add(id));
    try { localStorage.setItem(QF_SEEN_KEY, JSON.stringify([...s].slice(-300))); } catch {}   // 롤링 300 = 서버 CAP(800) 안쪽 · 실패 id 수명(24h 대기열)에 충분
    postSeenIds('qf', fresh);   // 계정 종속(다건 배치 = 커밋 1회 · fail-soft = 로컬이 이 기기 커버)
  }
  paintQFailGear();
}
function setQFail(items) { QFAIL_IDS = (items || []).filter(it => it && it.status === 'fail' && it.id).map(it => String(it.id)); paintQFailGear(); }   // api/pending 응답 → 실패 id 갱신 + 재도색(loadPending·loadQueue 공용 = 어디서 세든 같은 값)
function updateQBadge() {   // 처리중 건수 배지 = 하단 뉴스요약 + 헤더 대기열 픽토그램 공용(0이면 숨김 · 운영자 260710 헤더 추가)
  const txt = PEND_PROC > 99 ? '99+' : String(PEND_PROC), show = PEND_PROC > 0;
  ['qbadge', 'qbadgeHead'].forEach(id => { const b = document.getElementById(id); if (!b) return; if (show) { b.innerHTML = ''; const i = document.createElement('i'); i.textContent = txt; b.appendChild(i); b.hidden = false; } else b.hidden = true; });   // 이너 <i> = 잉크 서브픽셀 보정 앵커(운영자 260717 Q06 · textContent 주입 유지 = XSS 안전 동일)
}
const pendStatus = c => { for (const u of [_normU(c.url), ...((c.cluster_members || []).map(_normU))].filter(Boolean)) { const s = PEND.get(u); if (s) return s; } return null; };   // 이 후보 url(또는 클러스터 멤버)이 pending에 있나 = 전역 픽 진행/실패
function pickState(c) {   // 픽 상태 통합 = 로컬(r.picked) + 전역(api/pending·picks-failed·피드 DATA). null=트리아지 / 'picking' / 'settled' / 'failed'
  const r = ratingsAll()[candId(c)] || {};
  const ps = pendStatus(c);
  if (!r.picked && !ps && !pickInFeed(c)) return null;        // 픽·파이프라인·피드 전부 무관 → 트리아지 버튼
  if (!r.picked && failRequeued(c) && !pickInFeed(c)) return null;   // ✓ 픽 취소 = 픽 하기 전으로 되돌림 — 서버 실패기록(picks-failed)·pending 'fail' 잔존도 무시하고 트리아지([PASS][PICK])로 복귀(운영자 260722). 재픽 시 r.picked=true라 이 가드 자동 우회.
  if (pfResubActive(candId(c)) && !pickInFeed(c)) return 'picking';   // 재시도 발사(대기열 재투입) = 재분석 중 → 서버 fail 잔존(ps='fail')·무응답 타임아웃 무시하고 Picking 유지. pfailHas/pickTimedOut의 pfResubActive 억제를 ps='fail' 경로에도 확장(재탭이 Picking 못 들고 Failed로 덮이던 버그·운영자 260701). 성공=피드 등장은 아래 settled 우선.
  if (ps === 'retry') return 'picking';                        // 일시 과부하 자동 재시도 중 = 분석 진행(클라 10분 타임아웃의 거짓 FAIL 차단 · 서버 진실원본 우선 · 운영자 260622)
  if (pickFailedShow(c) || ps === 'fail') return 'failed';     // 서버 분석실패(picks-failed/pending failed) OR 무응답 타임아웃
  if (pickSettled(c) || ps === 'succ') return 'settled';       // 피드 등장(전역) OR 실패복구 해소 → PICKED
