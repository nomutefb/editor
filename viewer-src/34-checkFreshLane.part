  document.body.classList.toggle('has-pickfail', fresh.length > 0);   // 점등 = 전 탭. 해제 = 수집함 진입(markPickFailSeen).
  if (fresh.length && CURTAB !== 'scrap') {   // 개별 회전 + 표시 전 계정 선점(claimSeen) = 크로스 플랫폼 정확히 1회(운영자 260712)
    const c = fresh[0], showing = document.querySelector('#nmFailToast.show');
    if (showing && _failToastC && candId(_failToastC) === candId(c)) return;
    if (_pfClaiming) return;
    _pfClaiming = true;
    claimSeen('f', c).then(ok => { _pfClaiming = false;
      if (ok) showFailToast(1, c);
      else { try { const s = pfSeen(); s.add(candId(c)); localStorage.setItem(PF_SKEY, JSON.stringify([...s])); } catch {} detectPickFail(); }   // 타 기기 선점 = 로컬 기록·다음 건
    });
  }
}
function markPickFailSeen() {
  const seen = pfSeen();
  const fresh = [];
  pickFailNow().forEach(c => { seen.add(candId(c)); if (!TF_SRV.f.has(candId(c))) { TF_SRV.f.add(candId(c)); fresh.push(candId(c)); } });
  try { localStorage.setItem(PF_SKEY, JSON.stringify([...seen])); } catch {}
  if (fresh.length) fetch('api/seen', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ f: fresh.slice(0, 50) }) }).catch(() => {});   // 일괄 해제도 계정 종속(배치 1커밋 · 운영자 260712)
  document.body.classList.remove('has-pickfail');
}
function markPickFailSeenOne(c) {   // 개별 seen(운영자 260712 "모든 실패 건 개별로") — 그 건만 기록 · 다음 건은 detectPickFail 회전이 표시 · bulk(markPickFailSeen)는 수집함 진입 일괄 해제용으로 유지
  if (!c) return;
  const seen = pfSeen(); seen.add(candId(c));
  try { localStorage.setItem(PF_SKEY, JSON.stringify([...seen])); } catch {}
  postSeen('f', c);   // 계정 종속(운영자 260712) — 타 플랫폼 재알림 차단
}
let _failToastT, _failToastC = null;
function showFailToast(n, sample) {   // 개별 알림(운영자 260712 "모든 실패 건 개별로 — N건 집계 폐지") — 한 번에 한 건·제목만 · 처리(✓↻↗·본체·8s 만료) = *그 건만* seen → detectPickFail 회전이 다음 건 표시(마를 때까지) · n 인자 = 호출처 호환용(미사용)
  const _sf2 = document.getElementById('sysFreshToast'); if (_sf2) _sf2.classList.remove('show');   // 시스템 경보 양보 — 실패 토스트도 같은 자리(.nm-toast fixed·bottom 86) = 겹침 차단(평의회C)
  let t = document.getElementById('nmFailToast');
  if (!t) {
    t = document.createElement('div'); t.id = 'nmFailToast'; t.className = 'nm-toast fail'; t.setAttribute('role', 'status'); t.setAttribute('aria-live', 'polite');   // 픽 실패 알림 = SR announce(분신술10 260704)
    t.onclick = () => { markPickFailSeenOne(_failToastC); t.classList.remove('show'); failSrcOpen(_failToastC); setTimeout(detectPickFail, 250); };   // 본체 탭 = 원문(URL 없으면 유추 관련기사) + 그 건 seen + 다음 건
    document.body.appendChild(t);
  }
  _failToastC = sample || null;
