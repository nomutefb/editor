}
// 실패 기사 열기 = 원문 URL 우선 · 없으면(직접 준 전문 = paste) 유추 관련기사(pickAlt = 같은 사건 타매체) 무조건 링크(운영자 260712 "실패 시 관련 기사 무조건 링크") · 그마저 없으면 수집함으로
function failSrcOpen(c) {
  if (!c) return showTab('scrap');
  if (c.url) return failOpen(c);
  const alt = (pickAlt(c) || [])[0];
  if (alt) return failOpen({ url: alt });
  const q = encodeURIComponent(String(c.title || '').slice(0, 60).trim());   // 최후 폴백 = 제목 구글뉴스 유추 검색(운영자 260712 "무조건 링크" — alt까지 빈 단독 후보 방어)
  if (q) failOpen({ url: 'https://news.google.com/search?q=' + q + '&hl=ko&gl=KR&ceid=KR:ko' }); else showTab('scrap');
}
// Failed 탭 = 묻지 말고 그냥 원문으로 이동(요약요청 모달 안 띄움 · 운영자 요청 260618). 제목 <a>와 동일 동작.
function failOpen(c) {   // ⚠️ window.open이 전역 open(피드 모달)에 가려져 빈 모달이 뜨던 버그 → 앵커 클릭으로 원문 새 탭
  if (!c || !c.url) return;
  const a = document.createElement('a'); a.href = hrefOk(c.url); a.target = '_blank'; a.rel = 'noopener noreferrer';
  document.body.appendChild(a); a.click(); a.remove();
}
function failRetry(c, opts) {   // ↻ 재시도 — ① 재분석 재발사(대기열 재투입 · 전문 없이 fetch 재시도 · alt=cluster_members로 원매체 403 우회) ② (옵션) 가까운 관련기사 새 탭. 칩 재시도=noOpen(대기열만·원문은 제목 탭) / 토스트=새 탭 유지(운영자 260701·260622)
  if (!c) return;
  const alt = pickAlt(c);   // 같은 사건 타매체(메이저 우선·가까운 관련기사)
  if (c.url) {   // ① 재분석 재발사(body 없이 → fetch 재시도 · alt 동반) = 다시 대기열(pending)로 · Failed→Picking(pfResubActive)
    const id = candId(c); saveRating(id, { picked: true, pickedAt: Date.now() }); pfAddResub(id);
    fetch('api/pick', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: c.url, title: c.title || '', alt, event_key: c.event_key || '' }) })
      .then(async r => { if (r.ok) return;   // 서버 거절(GH_TOKEN 회귀·429 등) = 낙관 Picking 회수 + 표면화(무통보 유실 차단 · pickCard 8624 패턴 · 평의회 260713 ⑦)
        const j = await r.json().catch(() => ({}));
        saveRating(id, { picked: false }); pfRemoveResub(id); if (CURTAB === 'scrap' && SCRAP_LOADED) renderScrap();
        alert('재시도 발사 실패 — 다시 시도해줘\n' + (j.error || ('HTTP ' + r.status))); })
      .catch(() => {});   // 네트워크 예외 = 종전대로 조용히(오프라인 순간 등 — 타임아웃 감시가 Failed 복귀 커버)
  }
  if (!(opts && opts.noOpen)) {   // ② 가까운 관련기사 원문 새 탭 — 토스트 재시도만(칩 재시도는 생략 = 대기열만 · 원문은 제목 탭)
    const go = alt[0] || c.url;
    if (go) { const a = document.createElement('a'); a.href = hrefOk(go); a.target = '_blank'; a.rel = 'noopener noreferrer'; document.body.appendChild(a); a.click(); a.remove(); }
  }
  if (!(opts && opts.noRender) && CURTAB === 'scrap') renderScrap();   // noRender = 칩 재시도(발사 게이지 재생 중) — 모션이 끝난 뒤 호출부가 렌더한다(즉시 렌더 = 게이지 파괴). 서버 거절 회수 경로의 renderScrap은 그대로(실패는 즉시 되돌린다)
}
// 실패 카드 두 버튼 배선(운영자 260722 재배선 — 260711 스왑 되돌림: Failed 탭=재시도가 직관 · 체크는 '픽 취소'로 명확. ✓ = 픽 취소(픽 전으로) · Failed 칩 = 탭 재시도·길게 메뉴).
function wireFailChip(fb, c) {   // Failed 칩 = 재시도: 탭 = 다시 대기열 재분석(failRetry→Picking…) · 길게(480ms)/우클릭 = 메뉴(실패 사유·내용 입력) · 제목 <a> = 원문.
  if (!fb) return;
  // 컨텍스트 메뉴 진입점(전수감사 260713) — #failmenu = "길게 누르거나(480ms) 우클릭". 실패 사유(진단 MD)·내용 입력(403 매체 전문 붙여넣기 재분석).
  // ⚠️ 260803 수리 — 구판은 pointerdown 핸들러가 이벤트 인자조차 안 받아 `stopPropagation` 이 0이었다.
  //   그래서 누름이 부모 카드(.sc-item)로 버블 → **480ms 실패메뉴 + 600ms 병합모드 동시 발화**(우클릭도 동일:
  //   구 contextmenu 는 preventDefault 만 있고 전파 차단이 없어 카드 우클릭=enterMerge 로 샜다). openFailMenu 의
  //   closeOverlays 로도 못 막는다 — 480ms 시점엔 MERGE_MODE 가 아직 false 라 닫을 게 없고 병합은 그 뒤에 켜진다.
  //   → 긴급 배지와 **같은 문법**(claimLongPress 4종 방어)으로 재배선. 이동 취소도 movementX 8px →
  //   부모와 같은 clientX 절대거리 10px 로 통일(iOS movementX 0버그 회피 · 스크롤 중 칩만 살아남던 축 제거).
  let _lpFired = false;
  claimLongPress(fb, 480, () => { _lpFired = true; openFailMenu(c, fb); }, () => openFailMenu(c, fb));   // ctxFn = 우클릭은 _lpFired 미설정(click 이 안 오는 경로라 다음 진짜 탭이 삼켜지는 것 차단)
  fb.onclick = e => {
    e.stopPropagation();
    if (_lpFired || Date.now() - _failMenuAt < 350) { _lpFired = false; return; }   // 롱프레스 직후 합성 click = 재시도 오발 차단(_failMenuAt 타임스탬프 가드)
    if (fb.classList.contains('picking') || pfResubActive(candId(c))) return;   // 이미 재분석 중 = 무시(이중발사 차단 — failRetry가 pfResubActive 세팅·렌더가 비활성 Picking… 칩으로 교체)
    bumpFailRetry(c);
    // 재시도 발사 비주얼 = 픽 발사(askReason 'pick') 정본 100% 사본: 초록 게이지 풀필(.sc-got.firing/goFill .72s) → ✓ 체크(okdone/gck) → Picking… 칩.
    // ⚠ 260722 재배선(칩=재시도·✓=픽취소) 때 게이지가 붙어 있던 ✓(.sc-failgo)만 정리되고 칩 쪽엔 이식이 안 돼 재시도가 '즉시 빗금 Picking…'으로 점프했다(운영자 260817 "게이지 차는 모션이 사라졌어").
    //   발사(api/pick)는 정본과 같이 **먼저** 쏘고 모션은 순수 시각 — 그래서 failRetry(noRender)로 재렌더만 미룬다(모션 중 renderScrap = 게이지 파괴).
    const bot = fb.closest('.sc-bot');
    if (!bot) { failRetry(c, { noOpen: true }); return; }   // 하단 슬롯이 없으면 종전대로(모션 없이 재발사)
    const _red = matchMedia('(prefers-reduced-motion:reduce)').matches;
    failRetry(c, { noOpen: true, noRender: true });   // ① 재발사(대기열 재투입) — 렌더는 모션 끝에
    bot.innerHTML = '<div class="sc-got firing" aria-label="재시도 발사"><span>전송</span></div>';   // ② 초록 게이지 풀필(goFill .72s)
    const go = bot.querySelector('.sc-got');
    setTimeout(() => {
      if (!go || !go.isConnected) return;   // 그새 재렌더면 중단(무해 — 그쪽이 이미 Picking… 칩을 그렸다)
      go.classList.remove('firing'); go.classList.add('okdone'); go.innerHTML = '<svg class="gck" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7"/></svg>';   // ✓ 체크(goTick)
      setTimeout(() => { if (CURTAB === 'scrap') renderScrap(); }, _red ? 60 : 440);   // ✓ 잠깐 보인 뒤 Picking…(pfResubActive → .sc-fail.picking 칩)
    }, _red ? 90 : 740);   // goFill .72s 채움 후
  };
}
let _failMenuC = null, _failMenuAt = 0;   // _failMenuAt = 메뉴 오픈 시각 — 직후 합성 click 억제(아래 onclick)
function openFailMenu(c, anchor) {
  const m = $('#failmenu'); if (!m || !anchor) return;
  closeOverlays(); _failMenuC = c;
  m.hidden = false;   // 먼저 표시해야 offset 측정 가능
  const r = anchor.getBoundingClientRect(), mh = m.offsetHeight, mw = m.offsetWidth;
  let top = r.bottom + 6;
  if (top + mh > window.innerHeight - 8) top = r.top - mh - 6;   // 아래 공간 부족 → 칩 위로
  top = Math.max(8, top);
  let left = r.left + r.width / 2 - mw / 2;
  left = Math.max(8, Math.min(left, window.innerWidth - mw - 8));
  m.style.top = top + 'px'; m.style.left = left + 'px';
  _failMenuAt = Date.now();   // focus()가 칩 blur→lp 리셋을 유발해도 직후 click 은 위 onclick 의 타임스탬프 가드로 억제
  const f0 = m.querySelector('.failmenu-it'); if (f0) f0.focus();   // 키보드 접근성 — 첫 항목 포커스(Tab/Enter 도달)
}
function closeFailMenu() { const m = $('#failmenu'); if (m && !m.hidden) m.hidden = true; }
(() => {   // #failmenu 항목·바깥탭·ESC 배선(전수감사 260713) — 진입점 복원과 짝(종전 소비 코드 증발분). diag = 진단 MD 다운로드 · paste = 전문 붙여넣기 재분석.
  const m = $('#failmenu'); if (!m) return;
  m.querySelectorAll('.failmenu-it').forEach(b => b.onclick = e => {
    e.stopPropagation();
    const c = _failMenuC; closeFailMenu();
    if (!c) return;
    if (b.dataset.act === 'diag') failDownload(c); else if (b.dataset.act === 'paste') openPaste(c);
  });
  document.addEventListener('click', e => {
    const mm = $('#failmenu'); if (!mm || mm.hidden) return;
    if (Date.now() - _failMenuAt < 350) return;   // 롱프레스 뗌 직후 합성 click이 메뉴를 즉시 닫던 것 억제(오픈 가드와 동일 창)
    if (!mm.contains(e.target)) closeFailMenu();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFailMenu(); });
})();
// 실패 사유(#failmenu) = 왜 실패했는지 다음에 조치할 수 있게 육하원칙으로 정리한 진단 MD — 클릭 시 바로 다운로드(표시 X).
function failDownload(c) {
  if (!c) return;
  const nowK = new Date().toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' });
  const rt = ratingsAll()[candId(c)] || {};
  const pickedK = rt.pickedAt ? new Date(rt.pickedAt).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul' }) : '?';
  const reason = pfReason(c) || (pickTimedOut(c) ? '무응답(10분+ 미반영) — 서버 실패기록 없음(analyze 미완/지연 추정)' : 'fetch 차단(403 추정)');
  const onServer = PFAIL.has(_normU(c.url));   // 서버 실패목록(picks-failed) 등재 = 분석단계 실패 / 아니면 클라 타임아웃
  const mems = [...new Set((c.cluster_members || []).map(_normU))].filter(u => u && u !== _normU(c.url));
  const L = [];
  L.push('# 픽 분석 실패 진단 — ' + (c.title || '(제목 없음)'));
  L.push('', '> 자동 생성(수집함 Failed 칩). 이 파일을 클로드에게 전달하면 원인 분석·복구에 사용합니다. 또는 같은 메뉴의 「내용 입력」으로 기사 전문을 붙여넣어 재분석할 수 있습니다.', '');
  L.push('## 요약 (5W1H)');
  L.push('- **언제(When)**: 픽 ' + pickedK + ' (KST) · 진단 ' + nowK);
  L.push('- **무엇(What)**: ' + (c.title || '(제목 없음)') + (c.media ? ' · 매체 ' + c.media : ''));
  L.push('- **어디서(Where)**: ' + (onServer ? '`pending/failed/`(분석 단계 실패로 격리) + `picks-failed.json` 등재' : '서버 실패기록 없음 — 클라이언트 무응답 타임아웃(10분 초과)'));
  L.push('- **어떻게(How)**: 수집함 PICK → api/pick → pending → news-analyze. 원매체 fetch 가 데이터센터 IP 403 으로 막히면 본문 확보 실패.');
  L.push('- **누가(Who)**: 운영자 픽');
  L.push('- **왜(Why·추정)**: ' + reason);
  L.push('', '## 입력 (Input)');
  L.push('- 원문 URL: ' + (c.url || '(없음)'));
  L.push('- 식별자(candId): `' + candId(c) + '`');
  L.push('- 교차보도(cross): ' + (c.cross != null ? c.cross : '?') + ' 매체');
  if (mems.length) { L.push('- 같은 사건 다른 매체(cluster_members · 대체 fetch 후보):'); mems.slice(0, 12).forEach(u => L.push('  - ' + u)); }
  L.push('', '## 진단·복구 힌트 (클로드용)');
  L.push('- 데이터센터 IP 403 = 매체 WAF(조선·동아·연합·중앙 등)가 러너 IP 차단. 헤더로 못 뚫음 → **기사 전문 직접 입력**이 정공법.');
  L.push('- 복구 A(웹앱): 이 메뉴의 「내용 입력」 → 기사 본문 붙여넣기 → 전송. body 동봉 pending 으로 재분석(403 무관).');
  L.push('- 복구 B(폰): Termux 공유로 전문 전달(가정용 IP=200).');
  L.push('- 대체: 위 cluster_members 중 접근 가능한 매체를 alt 로 줘 본문 확보.');
  L.push('- 확인: GitHub Actions `news-analyze` 최근 run → `Analyze pending articles` 스텝 로그(`pending/failed/*.log`).');
  try {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([L.join('\n')], { type: 'text/markdown;charset=utf-8' }));
    a.download = '픽실패_' + candId(c).replace(/[^\w.-]+/g, '_').slice(0, 40) + '.md';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => { try { URL.revokeObjectURL(a.href); } catch {} }, 1500);
  } catch (e) { console.warn('진단 MD 다운로드 실패', e); }   // Blob/ObjectURL 극한 실패(모바일 WebView 등) — 미처리 예외 차단(손상 없음·재시도 가능)
}
// 내용 입력 = 기사 전문을 직접 붙여넣어 재분석(막힌 매체 403 우회). askdlg UIUX 계승(.sbtn 클립·X·전송).
let _pasteC = null;
function openPaste(c) {
  if (!c) return;
  if (pastedlg.open) return;   // 전송 중(1.3s)·이미 열림 = 재진입 차단(_pasteC 덮어쓰기·중복 커밋 방지)
  _pasteC = c;
  $('#pasteText').value = '';   // (pasteStatus 잔상 리셋 소멸 — 상태문자열 폐지·qFlash 위임 260720)
  $('#pasteSub').textContent = (c.title || '').slice(0, 80) || (c.url || '');
  updatePasteClip();
  openComposeDlg(pastedlg);   // showModal + 폰 뒤로가기 칸(입력 손실 방지·260627)
  setTimeout(() => $('#pasteText').focus(), 60);
}
// PICKED 클릭 → 피드(메뉴3) 이동 + 해당 기사 팝업. 픽 결과가 피드에 떴으니(pickInFeed) url/클러스터로 매칭해 open(a).
function pickedOpen(c) {   // PICKED → 피드 이동+모달. feedMatch(url→event_key→제목 폴백), 없으면 load() 후 재매칭(feedOpenBy 공용)
  feedOpenBy(() => feedMatch(c, true));   // has_body 필수(needBody) — body 없는 stub 매치 시 빈 모달 대신 feedOpenBy가 '피드 반영 중' 안내(scFeedArticle 게이트와 일관·260630)
}
function scFeedArticle(c) {   // 이 후보가 요약돼 피드(DATA=articles.json)에 떠 있나 → 그 기사 객체(없으면 null).
  // 카드 탭 라우팅에 사용: 있으면 뉴스 요약으로, 없으면 기사 전문으로(요약 안된 빈 요약 목업 차단 · 운영자 260621).
  return feedMatch(c, true);   // ⚠️ has_body 필수(needBody) — 요약 body가 *실제로 있는* 피드 기사만 매치(픽됐으나 분석 미완·실패로 body 없는 stub은 제외 → 클릭이 빈 요약 모달 대신 기사 원문으로 폴백·운영자 260630 재발버그) · url 실패 시 event_key·제목 폴백으로 드리프트 요약 재연결(260714)
}
// 보관한도(데이터)는 크게(10일·수천 건) 두되, 화면은 컬럼당 SC_PAGE장만 그려 가볍게 유지.
// 전량 렌더 + 매 탭마다 재렌더는 수백 장 넘으면 모바일이 버벅임 → 청크 추가 렌더.
const SC_PAGE = 150;
const scShown = { cross: SC_PAGE, new: SC_PAGE };   // 컬럼별 현재 렌더 장수(재렌더에도 유지)
// '더 보기' 버튼 폐지 → 무한 스크롤(운영자 260703 — "hover/클릭 모호 + 누르다 기사 오탭" 교정): 컬럼 바닥의
// 투명 센티널이 화면 600px 앞에 들어오면 SC_PAGE 추가 렌더(도달 전 미리 채워 끊김 없음 · 페이지 스크롤 구조라 root=viewport).
// IO 1개 재사용 — 재렌더마다 disconnect 후 새 센티널만 관찰(콜백은 렌더 1회만 = 양 컬럼 동시 교차해도 이중 렌더 방지).
const _scIO = ('IntersectionObserver' in window) ? new IntersectionObserver(ents => {
  for (const e of ents) {
    if (!e.isIntersecting) continue;
    const key = e.target.dataset.col;
    _scIO.unobserve(e.target);
    if (scShown[key] != null) { scShown[key] += SC_PAGE; renderScrap(); break; }   // 재렌더가 남은 센티널 재생성·재관찰
  }
}, { rootMargin: '600px 0px' }) : null;   // IO 미지원 구형 = 옛 더보기 버튼 폴백(아래 renderScrap)
let scFoldOpen = false, _scFoldN = 0;   // 검증대기 접기(Q-1·260702): 토글 상태(재렌더 유지·새로고침 접힘 기본) · 이번 렌더의 접힌 건수(양수=접힘·음수=펼침)
let ratedKeep = new Set();   // 이번 세션에 별점 매긴 카드 = 다음 갱신(새로고침) 전까진 유지, 갱신 때 리스트서 제외
let _scrapSig = '';   // 직전 렌더 시그니처(동일 구성 재렌더 = 스태거 생략 게이트 · 피드 _feedSig 대응 · 운영자 260621)
// 같은 사건 중복 대표 접기 — 정규화 제목 동일(=같은 헤드라인=같은 기사)이면 우세한 1장만 남김(운영자 260625 · 분신술 10인 보강).
//   원인: 한 사건의 클러스터 대표 2개가 동시에 살아있을 때(to_candidates alias-merge는 *세션간* rep점프만 흡수·co-fresh는 §보수성으로 미병합) 카테고리/매체만 다르게 2장 뜸(실측: 동아 '정치' + 뉴시스 '사회' = 자카드 .79).
//   ⚠️ 멤버겹침(자카드) dedup은 클러스터 노이즈로 *다른* 기사를 오접음(실측: '선관위 압수수색'이 '개표소 올다르크'로 접힘) → **제목 완전일치만** = 보수(특정 헤드라인 충돌 사실상 불가·일반머리표는 JUNK_HEAD가 선제거). 근사 제목(다른 헤드라인 같은 사건)은 안 접음 = 진짜 distinct 보호 우선.
//   ⏱ 시간창(SC_DUP_WINDOW): 같은 제목이라도 scTs가 12h 넘게 벌어지면 = 다른 날 동일 헤드라인(날씨 '낮 최고 32도'·환율 '10.3원 오른…출발' 등 보일러플레이트) = 다른 사건 → 안 접음(분신술1 false-merge 실측 차단).
//   📍 전역(칼럼 분배 *전*) 1회 적용 — 같은 제목 대표가 신규(<4h)/누적(≥4h) 경계로 갈려 둘 다 뜨던 누설 차단(분신술2). 우세도(cross→report_count→최신)로 대표 1개 선택 = 순서 무관 결정적.
//   픽 상태는 makeScItem의 cluster_members 멤버승계(ratingFor)로 접힌 대표가 픽이어도 생존 카드에 PICKED 유지 → 픽 고아 0(분신술3 확인).
const scTitleKey = c => (c.title || '').replace(/\s+/g, '').toLowerCase();
const SC_DUP_WINDOW = 12 * 3600000;   // 12h — 이 안의 동일제목만 같은 기사로 접음(밖 = 다른 날 보일러플레이트로 보존)
const scMoreDom = (a, b) => (a.cross || 0) !== (b.cross || 0) ? (a.cross || 0) > (b.cross || 0)   // 우세 = cross↑ → 연속보도↑ → 최신↑ (접힐 때 더 대표성 큰 쪽 보존)
  : (a.report_count || 0) !== (b.report_count || 0) ? (a.report_count || 0) > (b.report_count || 0) : scTs(a) > scTs(b);
function scDedup(arr) {   // 같은 제목 + 시간근접(<12h) = 같은 기사 → 우세한 1장. 무제목(title 없음)·시간상 먼 동명은 보존.
  const rep = new Map(), out = [];   // titleKey → {c, idx}
  for (const c of arr) {
    const k = scTitleKey(c);
    if (!k) { out.push(c); continue; }   // 무제목 = 안 접음(distinct 보호)
    const prev = rep.get(k);
    if (prev && Math.abs(scTs(c) - scTs(prev.c)) < SC_DUP_WINDOW) {   // 같은 기사 중복 대표
      if (scMoreDom(c, prev.c)) { out[prev.idx] = c; rep.set(k, { c, idx: prev.idx }); }   // 우세한 쪽으로 교체(제자리)
      continue;   // 약한 쪽 접음
    }
    rep.set(k, { c, idx: out.length }); out.push(c);   // 첫 등장 또는 시간상 다른 사건 → 유지
  }
  return out;
}
// ── 수집함 병합(merge·운영자 260625) ── 토큰 클러스터링서 갈라진 같은 사건을 운영자가 수동으로 묶음(롱프레스→체크→병합).
//   저장 = localStorage(이 기기·앵커 candId → 멤버 candId들). fold = applyMerges가 멤버를 접고 앵커에 cluster_members·cross 합산.
//   🔑 우아함 = cluster_members 확장 하나로 pickAlt(→api/pick alt 종합요약)·pickInFeed·cross·픽상태가 전부 기존 메커니즘 재사용(파이프라인·알고리즘 0 변경 = 뷰어 소비만).
const MERGE_KEY = 'nm_merges', MERGE_TS_KEY = 'nm_merges_ts';
const mergesAll = () => { try { return JSON.parse(localStorage.getItem(MERGE_KEY) || '{}'); } catch { return {}; } };
const saveMerges = (m, delta) => {   // bool 반환 = 저장 실패(quota·시크릿) 시 거짓 성공 토스트 차단(분신술7·9) · delta = {set,del} 계정 동기(운영자 260717 "경계도 ㄱ" — 폰 병합 = PC도 접힘 · fail-soft)
  let ok = true; try { localStorage.setItem(MERGE_KEY, JSON.stringify(m)); } catch { ok = false; }
  if (ok && delta && ((delta.set && Object.keys(delta.set).length) || (delta.del && delta.del.length))) {
    try { localStorage.setItem(MERGE_TS_KEY, String(Date.now())); } catch {}
    fetch('api/mapsync', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ file: 'merges', ...delta }) }).catch(() => {});
  }
  return ok;
};
async function loadMergesSrv() {   // 계정 병합 적재(60s 폴 편승) — 로컬 최근 편집(5분 유예 = 배포 지연 1~2분 창에서 서버 구본이 내 편집을 되감는 것 차단) 없을 때만 서버 = 정본 채택
  try {
    if (Date.now() - (+localStorage.getItem(MERGE_TS_KEY) || 0) < 300e3) return;
    const r = await fetch('merges.json?_=' + Date.now()); if (!r.ok) return;
    const d = await r.json(); if (!d || typeof d !== 'object' || Array.isArray(d)) return;
    if (JSON.stringify(d) === JSON.stringify(mergesAll())) return;
    try { localStorage.setItem(MERGE_KEY, JSON.stringify(d)); } catch {}
    if (CURTAB === 'scrap') renderScrap();
  } catch { /* 없으면 로컬만 */ }
}
const kstNow = () => new Date(Date.now() + 9 * 3600e3).toISOString();   // KST 스탬프(§📐 시각 표준)
// 앵커 카드 *복제본*에 멤버 흡수 — cross=union 매체수, cluster_members=[멤버 대표 url 먼저(픽 alt 8캡서 각 사건 보장) + 앵커기존 + 멤버클러스터]. 원본 CANDS 불변(복제라 다음 렌더·타 참조 오염 0).
function mergeDecorate(anchor, memCands) {
  const aRep = _normU(anchor.url);
  // cm = _normU 키로 dedup(종합 alt용·8캡에 각 사건 포함). 멤버 대표 먼저.
  const cm = [], cmSeen = new Set([aRep]);
  for (const u of [...memCands.map(m => m.url), ...(anchor.cluster_members || []), ...memCands.flatMap(m => m.cluster_members || [])]) {
    const k = _normU(u); if (k && !cmSeen.has(k)) { cmSeen.add(k); cm.push(String(u)); }
  }
  // breaking/grade/rc/burst = 멤버 max 승계 = 긴급 멤버가 비-긴급 앵커에 접혀도 🚨 배지 안 사라지게(분신술8 F3). grade null(미채점)은 보존.
  const grades = [anchor.grade, ...memCands.map(m => m.grade)].filter(g => g != null);
  // cross = 매체 수 단순 합산(운영자 260625: 15+7+2=24 · union 아닌 합 = 갈라진 같은 사건이라 매체 거의 안 겹침). 표시·게이트(진입/이슈/점등)·moreN은 이 raw 합산값.
  const _base = anchor.cross || 0, _summed = _base + memCands.reduce((s, m) => s + (m.cross || 0), 0);
  // _rankCross = 랭킹(scScore) 전용 댐핑값 — 합산이 기준의 1.5배(MERGE_DAMP_RATIO) 초과면 *초과분만* 75%(MERGE_DAMP_GAIN) 반영(운영자 260628: 병합으로 매체수 폭증해도 랭킹 과대강조 억제 · 표시/배지/진입은 raw 불변 · 평의회10 만장일치 "랭킹전용·초과분 연속식"). 연속식이라 1.49배↔1.5배 역전 없음·단조.
  const _cap = _base * MERGE_DAMP_RATIO, _rankCross = _summed <= _cap ? _summed : _cap + (_summed - _cap) * MERGE_DAMP_GAIN;
  return { ...anchor,
    cross: _summed, _rankCross, _baseCross: _base,
    breaking: anchor.breaking || memCands.some(m => m.breaking),
    grade: grades.length ? Math.max(...grades) : anchor.grade,
    report_count: Math.max(anchor.report_count || 0, ...memCands.map(m => m.report_count || 0)),
    burst: Math.max(anchor.burst || 0, ...memCands.map(m => m.burst || 0)),
    cluster_members: cm,
    _mergeCount: memCands.length, _mergeMembers: memCands.map(candId) };
}
// AI 확정 사건 묶기(group_judge · 운영자 260702) — 같은 group_id 카드를 자동 병합(수동 병합과 동일 mergeDecorate 파이프 = UI·픽·랭킹댐핑 공짜).
// group_id는 breaking-judge의 group_judge(opus)가 '같은 실제 사건' YES 확정한 그룹에만 박힘 — 렉시컬 단독 병합 금지 선례(260625 안산↔청주) 준수.
// 수동 병합(applyMerges)이 먼저 접은 멤버는 pool에 이미 없음 = 수동 우선 자연 보장. 홀로 남은 group 카드는 그대로(병합 없음).
