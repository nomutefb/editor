const pickingNow = () => DATA_LOADED ? CANDS.filter(c => pickState(c) === 'picking') : [];   // 분석 중(로컬픽 OR 전역 pending). DATA 로드 전엔 [](깜빡 방지)
// ── 트리아지(PASS/👎/확인) cross-device 동기화 (운영자 260620): 로컬 nm_ratings는 기기락이라 PC서 PASS/👎한
//    후보가 폰서 다시 떴다. 전 기기 ledger 축약 = triage-state.json(읽기전용 오버레이·build-viewer 생성)을
//    로컬 *아래* 깔아 병합(로컬=이 기기 최신 의도 우선). 픽은 D(pendStatus)가 따로 담당 = 역할 분리. ──
let SRV_TRI = new Map();   // normUrl → {action?,dismissed?,acked?} (전 기기 ledger 축약 = triage-state.json)
let _triGen = 0;   // 세대 토큰 — 재진입/폴 경합 시 늦게 온 stale 응답이 최신 SRV_TRI를 덮는 것 폐기(loadQueue qGen 형제 패턴 · 평의회 260713 ⑤)
async function loadTriage(render) {
  const g = ++_triGen;
  try {
    const r = await fetch('triage-state.json?_=' + Date.now());
    if (r.ok) { const d = await r.json(); if (g !== _triGen) return; if (Array.isArray(d)) SRV_TRI = new Map(d.map(x => [_normU(x.url), x])); }
  } catch { /* 없으면 로컬만(현행 유지) */ }
  if (g !== _triGen) return;
  if (render && CURTAB === 'scrap' && SCRAP_LOADED) renderScrap();
}
const srvTriage = c => { for (const u of [_normU(c.url), ...((c.cluster_members || []).map(_normU))].filter(Boolean)) { const s = SRV_TRI.get(u); if (s) return s; } return null; };   // 이 후보의 전 기기 트리아지 결정
let _pickPolling = false;
async function pollPicking() {   // 분석 완료까지 폴링 → Picking… 칩만 제자리 교체(전체 재렌더 X = 깜빡임 방지)
  if (_pickPolling || !pickingNow().length) return;
  _pickPolling = true;
  const t0 = Date.now();
  while (Date.now() - t0 < PICK_TIMEOUT_MS + 60000) {   // 상한 = 무응답 타임아웃(PICK_TIMEOUT_MS 10분)+1분 그레이스 = 픽 조건과 일치(15분 헛폴·무한 재시동 차단·260618)
    await new Promise(r => setTimeout(r, 25000));
    if (document.visibilityState !== 'visible') break;   // ⚡버퍼 260701(A2): 백그라운드=폴 중단(옛 continue는 루프를 안 죽여 최대 11분 좀비·remaining 체크 도달 불가로 조기종료 불능이었음). 재가시 시 renderScrap→pollPicking 재시동, 완료분은 재렌더가 PICKED 표시.
    try { await load(); await loadPickFails(); await loadPending(); } catch {}   // 피드(DATA)·실패목록·pending(cross-device 픽) 갱신
    let remaining = 0;
    document.querySelectorAll('.sc-item.picked').forEach(el => {
      if (el.querySelector('.sc-got:not(.picking)')) return;   // 이미 PICKED(완료)면 건너뜀(실패칩은 늦은 성공 자동복구 위해 재평가)
      const c = CANDS.find(x => candId(x) === el.dataset.cid), bot = el.querySelector('.sc-bot');
      if (!c || !bot) return;
