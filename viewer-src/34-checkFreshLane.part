  t.innerHTML = `<span class="tg">${WARN_SVG}</span><span class="ft-msg">${title ? title + '…' : '분석 실패'}</span>`
    + `<button class="sbtn ft-act" type="button" data-fa="ack" data-motion="check" aria-label="확인 — 실패 이해" title="확인 — 실패 알았고 재시도 안 함(없던 일로 · 이 건 알림 끄기)">${CHECK_SVG}</button>`
    + `<button class="sbtn ft-act" type="button" data-fa="retry" aria-label="재시도 — 재분석" title="재시도 — 원인은 됐고 다시 분석(대기열 재투입)">${REFRESH_SVG}</button>`
    + `<button class="sbtn ft-act go-wait" type="button" data-fa="src" data-motion="arrow" aria-label="기사 확인" title="어떤 기사인지 확인(원문 · 없으면 유추 관련기사)">${Q_ARR}</button>`;
  // 버튼 의미(운영자 확정): ✓=실패 이해·무시 / ↻=재시도 / ↗=기사 확인 · 전 처리 = 그 건만 seen + 다음 건 회전(집계 폐지 260712) · stopPropagation 분리.
  const _ack = t.querySelector('[data-fa="ack"]'), _rt = t.querySelector('[data-fa="retry"]'), _sr = t.querySelector('[data-fa="src"]');
  if (_ack) _ack.onclick = e => { e.stopPropagation(); _ack.classList.add('ok'); markPickFailSeenOne(_failToastC); clearTimeout(_failToastT); _failToastT = setTimeout(() => { t.classList.remove('show'); setTimeout(detectPickFail, 250); }, 300); };   // 확인 = 초록 플래시 후 이 건 끄고 다음 건
  if (_rt) _rt.onclick = e => { e.stopPropagation(); markPickFailSeenOne(_failToastC); clearTimeout(_failToastT); t.classList.remove('show'); if (_failToastC) failRetry(_failToastC, { noOpen: true }); setTimeout(detectPickFail, 250); };   // 재시도 = 재분석 + 다음 건
  if (_sr) _sr.onclick = e => { e.stopPropagation(); markPickFailSeenOne(_failToastC); clearTimeout(_failToastT); t.classList.remove('show'); failSrcOpen(_failToastC); setTimeout(detectPickFail, 250); };   // ↗ = 기사 확인 + 다음 건
  requestAnimationFrame(() => t.classList.add('show'));
