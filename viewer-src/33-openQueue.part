    if (Array.isArray(a)) return new Map(a.map(x => (x && typeof x === 'object') ? [String(x.k || ''), { ask: String(x.ask || ''), q: String(x.q || ''), ...(x.snap && x.at ? { snap: x.snap, at: +x.at || 0 } : {}) }] : [String(x || ''), { ask: '', q: '' }]).filter(([k]) => k));
