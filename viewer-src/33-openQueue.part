const CAND_STALE_MS = 20 * 60000;   // 20분 = 폴 20회(60s·15336행) 연속 실패 허용. 하한 근거 = 정상 경로도 데이터가 최대 ~6.5분 묵는다(functions/api/candidates.js: 브라우저 max-age 60s + 엣지 cacheTtl 30s + raw 폴백 ~5분 캐시) · 수집 크론 15분(scrape.yml 외부 cron-job.org)이 실측 20~25분까지 벌어짐(260731 실측: max last_seen 12:07 vs 현재 12:33). 상한은 널널해도 무해 = 이 오탐이 성립하려면 데이터가 최소 4h(FAST_MAX_H) 묵어야 하므로 20분이든 60분이든 차단력 동일 · 반대로 값이 짧을수록 짧은 블립에 진짜 고장을 놓친다(미탐) → 큰 값이 정답. 조정 가능.
const candFresh = () => CAND_LIVE && Date.now() - CAND_TS < CAND_STALE_MS;
const candStale = () => !candFresh() && CANDS.length > 0;   // "지금 화면이 옛 사본" 상태 = 붉은 경보의 자격미달분 + 260725 정적 폴백분. **기어 점등·노란 메시지가 이 한 축을 공유**한다(syncStaleMsg 7515행 = 기어 토글 9843행) — 갈라두면 "기어는 빨간데 메시지함은 비어 있음" 같은 드리프트가 난다. len>0 = 부팅 전패(빈 화면)는 이 축 밖(기존 구멍 · 별건)
let SOCIAL = [], SOCIAL_LOADED = false, SOCIAL_LOADING = false, SOC_LM = 0;   // 소셜 버스트(커뮤니티 공론화) 레인 = SNS 탭(메뉴2). social_candidates.json(scraper/social_burst.py 출력 · 설계 docs/social-burst.md). SOC_LM = 파일 Last-Modified(ms) — age_h 스냅샷 경과 보정 앵커(Q359 ㉠)
// ── 전송한 카드 = 'Pk-ng'(분석 중) 잔류 원장(운영자 260804 "전송 누르고 나면 다시 전송으로 돌아오는데 picking으로") ──
//   왜 저장하나: renderSns는 행 구성이 바뀌면 리스트를 통째 재빌드한다 → 메모리에만 두면 다음 스캔 갱신 때 Pk-ng가 '전송'으로 되돌아가 운영자가 지적한 그 증상이 그대로 재발한다. 새로고침도 동축.
