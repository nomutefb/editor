  const _sf = document.getElementById('sysFreshToast'); if (_sf) _sf.classList.remove('show');   // 시스템 경보 즉시 양보(양방향 · 평의회C·D — 같은 자리·같은 z 차폐로 속보가 가려진 채 8s seen 소모되던 우선순위 역전 차단 · 경보는 조건 지속 시 다음 폴 재점등)
