const TF_AXES = ['t', 'f', 's', 'mr', 'md', 'pr', 'kw', 'qf'];   // 계정 seen 축(서버 seen.js AXES와 동기): t=긴급·f=실패·s=시스템 경보 이벤트·mr=메시지 읽음·md=메시지 치움·pr=픽실패 해소·kw=키워드 알림 발송 dedup(slug#버킷)·qf=요약 막힘 확인(대기열 열면 기록 → 기어 레몬 소등 · 260727)
