function openQueue(anchor) {
  _qAnchor = (anchor && anchor.id === 'queueBtn') ? anchor : null;   // 헤더 픽토그램서 열면 head 모드(픽토 아래) · 그 외(롱프레스·더블탭·우클릭·배지·pageshow)=하단 네비 앵커
  closeOverlays('qpop');
  clearTimeout(_qCloseTimer); qpop.classList.remove('closing');   // 닫힘 애니 중 재오픈 = 취소(다시 촤르륵 열림)
  qpop.hidden = false;   // 폭 측정 위해 먼저 표시
  placeQpop();           // 위치 = 헤더 픽토 아래(head) or PC 버튼 위/모바일 중앙 + 뷰포트 클램프
  { const hb = document.getElementById('queueBtn'); if (hb) { hb.classList.toggle('on', !!_qAnchor); hb.setAttribute('aria-expanded', 'true'); } }   // 헤더서 열면 픽토 활성(accent 강조 · filterBtn.on 패턴)
  try { sessionStorage.setItem('nomute_q_open', '1'); } catch {}   // 열림 기억 → 외부 링크(↗) 갔다 돌아오면(pageshow) 자동 재오픈
  if (!_qPushed) { history.pushState({ qpop: true }, ''); _qPushed = true; }   // 폰 뒤로가기 한 번 = 대기열 먼저 닫기(딴 화면 안 벗어남)
  qfMarkSeen();   // 🍋 확인 즉시 = 기어 레몬 소등(운영자 260727 "대기열 들어가서 확인 · 확인 즉시") — 지금 아는 실패분으로 먼저 끄고, 라이브 응답분은 아래 loadQueue 가 이어서 처리(네트워크 실패해도 소등은 성립)
  loadQueue();
}
function closeQueueUser() {   // 사용자가 직접 닫음(X·바깥탭·다른 오버레이·더블탭) → 재오픈 플래그 해제(↗ 네비게이션 닫힘과 구분 · 운영자 260622)
  if (qpop.hidden) return;
  { const hb = document.getElementById('queueBtn'); if (hb) { hb.classList.remove('on'); hb.setAttribute('aria-expanded', 'false'); } }   // 헤더 대기열 픽토 비활성(운영자 260710)
  if (!qpop.classList.contains('closing')) {   // 시각 닫힘 = popOut(촤르륵 접힘) 후 hidden · 1회만(재진입 중복 차단) · pmenu hidePmenu 패턴
    if (matchMedia('(prefers-reduced-motion:reduce)').matches) { qpop.hidden = true; }
    else { qpop.classList.add('closing'); clearTimeout(_qCloseTimer); _qCloseTimer = setTimeout(() => { qpop.hidden = true; qpop.classList.remove('closing'); }, 190); }   // .18s 애니 + 버퍼
  }
  try { sessionStorage.removeItem('nomute_q_open'); } catch {}
  if (_qPushed) { _qPushed = false; if (_qPop) _qPop = false; else if (_qHistYield) { /* 칸은 위에 뜬 모달이 인계(openTool replaceState) — 여기서 back() 하면 그 모달을 삼킨다 */ } else if (history.state && history.state.qpop) history.back(); }   // 직접 닫기면 푸시한 히스토리 칸 정리(뒤로가기로 닫힌 경우는 이미 pop됨)
}

// ── (폐지 260710 · 운영자 "호버했을 때 메뉴 뜨게 하는 거 없애줘") 하단 네비·프로필 마우스 호버 자동 열기(hoverAuto) 제거 ──
// 열기 트리거 = 탭·클릭·롱프레스·더블탭·우클릭·배지만 유지(마우스 pointerenter 0.5초 예약 열기 폐지 = 스쳐 지나가다 팝업 뜨던 것 제거). 구 hoverAuto/HOVER_OPEN_MS는 git 이력에 보존.

window.addEventListener('popstate', () => {   // 폰 뒤로가기 = 대기열 떠 있으면 그것부터 닫기 · 닫는 중(closing)이면 재진입 안 함(deferred-hide 가드)
  const _wasDlgClosing = _dlgClosing; _dlgClosing = false;   // 리더 X/ESC/백드롭 close가 유발한 {dlg} 회수 back = 소비 — 검색 위 리더 닫을 때 이 back이 검색을 과닫힘시키던 것 차단(평의회3 260710)
  if (_composeRecovering) return;   // 컴포즈 모달 자기칸 회수 back은 무시(마지막 모달 닫을 때 .open=false라 아래 isComposingModalOpen 가드가 풀려도 뒤 대기열 over-close 차단·평의회 V4·260628)
  const _td = $('#tooldlg');
  if ((LBOX && LBOX.open) || isComposingModalOpen() || (_td && _td.open)) return;   // ⚠️ 상위 모달(라이트박스·작성·도구)이 떠 있으면 이 뒤로가기는 그 모달 몫 → 대기열까지 같이 닫히던 over-close 차단(평의회 G4 · 260628)
  if (!sovl.hidden) { if (_wasDlgClosing) return; const _dlg = $('#dlg'); if (!(_dlg && _dlg.open)) { _sovPop = true; closeSearch(); } return; }   // 검색 오버레이 = 자기 몫 소비(260706 5차) — 리더(#dlg)가 오버레이 *위*에 열릴 수 있음: 백버튼 닫기 = _dlg.open 아직 true라 검색 유지 / X·ESC·백드롭 닫기 = _dlgClosing가 그 back을 리더 몫으로 표식(검색 과닫힘·{sov} 누수 차단 · 평의회3 260710) · 다음 back이 검색 닫음
  if (!qpop.hidden && !qpop.classList.contains('closing')) { _qPop = true; closeQueueUser(); }
  if (!pubpop.hidden && !pubpop.classList.contains('closing')) { _pubPop = true; closePubUser(); }
});
const qEsc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
function qAgo(t) {
  if (!t) return '?';
  const m = Math.max(0, Math.round((Date.now() - t) / 60000));
  if (m < 1) return '방금';
  if (m < 60) return m + '분 전';
  return relAge(m / 60);   // 1시간 이상 = 공통 사다리(N시간/N일/N주일/N개월) — 복합표기('5시간 17분') 폐지·열 정렬 일정·기틀(운영자 260621)
}
/* DL_SVG 폐지(픽토 전수감사 260713) — nm-svg.js DOWNLOAD_SVG 인라인 복제(굵기 2.2 드리프트)·사용처 0 = 죽은 상수 */
// 큐 항목 id ↔ 피드(DATA=articles.json) 기사 매칭 — file은 .md 유무 양쪽 허용(제목·준비여부·이동 공용 단일출처)
const qMatch = id => DATA.find(x => x && x.file && (x.file === id || String(x.file).replace(/\.md$/, '') === id));
// SUCC 제목 = 피드(DATA)서 file 매칭 우선(없으면 API title). file은 .md 유무 양쪽 허용.
function qKo(it) {   // 외신 픽 대기열 = 수집함 후보 title_ko 역참조(한국어 표시 · 서버 무변경 — it.key = api/pending normU(url) 매칭키 재사용 · 260703). 제목이 외국어(한글 0)일 때만 조회.
  if (!it || !it.key || !it.title || /[가-힣]/.test(it.title)) return '';
  const c = (CANDS || []).find(x => String(x.url || '').trim().replace(/\/+$/, '') === it.key);
  return c ? scKoTitle(c) : '';
}
function qTitle(it) {
  if (it.status === 'succ') { const a = qMatch(it.id); if (a && a.title) return a.title; return qKo(it) || it.title || '분석 완료'; }
  return qKo(it) || it.title || '(내용 없음)';
}
// 대기열 행 = 시간 | 제목 | 상태(픽토그램) | 바로가기(↗·목적지 색). 전부 좌측정렬·30px·테두리 색맞춤(시안 확정 260622).
const Q_REFR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36M21 4v5h-5"/></svg>';   // ↻ 새로고침
const Q_SPIN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.2-8.55"/></svg>';   // 스피너(열린 호)
const Q_ARR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><g class="qsrc-arrow"><path class="qsrc-shaft" pathLength="1" d="M7 17 17 7"/><path class="qsrc-tip" d="M8.5 7H17v8.5"/></g></svg>';   // ↗ 1시방향 · 3조각(지지대선 shaft + 촉 tip · 받침 없음) = ic-arrow 모션 훅(대기열·토스트 이동버튼 공용)
function qGoBtn(kind, title) {   // kind: green(요약완료) | amber(원문) | gray(갈 곳 없음 — 모습·회색 톤은 비활성 그대로 두되 탭 = 취소 상태머신 진입이라 disabled 속성 제거 · 운영자 260728 "비활성일 때 클릭하면 휴지통")
  const gray = kind === 'gray';
  const t = gray ? title + ' · 탭하면 이 요청 취소' : title;   // 회색 = 사유(왜 못 가나) + 조치(탭=취소) 병기 — 정본 .jcancel 대기상태가 title 로 취소를 알리는 문법 계승(어포던스 없이 눌러야 알던 것 봉합)
  return '<button class="qgo go-' + kind + '" type="button" title="' + t + '"' + (gray ? ' aria-label="이 요청 취소"' : '') + '>' + Q_ARR + '</button>';
}
function qRetryBtn(title) {   // ✨요약요청 실패 재시도 = arm(레몬) ↻ · 클릭 = api/askget 으로 전문 복원 → 요약창 재오픈(askRetry)
  return '<button class="qgo go-arm qretry" type="button" title="' + title + '">' + Q_REFR + '</button>';
}
function qPickRetryBtn(title) {   // URL 픽/분석 실패 재시도 = arm(레몬) ↻ · 클릭 = api/pick 재발사(qPickRetry) — askget 복원(요약요청)과 별개 = pending URL 항목용 · 운영자 260713
  return '<button class="qgo go-arm qpretry" type="button" title="' + title + '">' + Q_REFR + '</button>';
}
// 대기열 실효 상태 = API status + '피드 미반영 succ' 보정 **단일 출처**(qRowHtml·정렬·취소가 같은 함수를 쓴다 — 세 군데 같은 식이 흩어져 있어 한쪽만 고치면 갈렸다).
//  ⓐ 백엔드 succ(분석완료)여도 뷰어 피드(DATA)에 아직 안 떴으면 사실상 미준비 → 조기 '완료/초록 뉴스요약 이동' 금지(운영자 260622).
//  ⓑ 다만 그 미반영이 Q_LAG_MIN 을 넘으면 '배포 랙'이 아니라 **배포 적체 확정** → 스피너를 멈추고 'lag'(대기)로 못박는다.
//     ⚠ 신설 사유 = 260803 실측: Cloudflare Pages 빌드 큐가 ~4시간 밀려(19:01 배포본이 15:03 커밋) 분석 끝난 7건이
//     피드에 없는 채 **영구 회전**. 구판은 상한이 없어 "언제 끝나는지 모르는 스피너"가 무한정 돌았다(운영자 260803 지목).
const Q_LAG_MIN = 20;   // api/pending STUCK_MIN(20) 동값 계승 — "이 이상 안 끝나면 정상 대기가 아니다"의 레포 단일 사다리(신설 값 0)
function qEff(it) {
  if (!it) return '';
  if (it.status !== 'succ' || qMatch(it.id)) return it.status;
  const age = it.t ? (Date.now() - it.t) / 60000 : 0;
  return age >= Q_LAG_MIN ? 'lag' : 'processing';
}
function qGenAgo() {   // 배포본 기준시 → 'HH:MM 배포본' (없으면 '') · 시각 표기는 대기열 공용 로케일(ko-KR 24h)
  if (!FEED_GEN) return '';
  const d = new Date(FEED_GEN); if (isNaN(d)) return '';
  return d.toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', hour12: false }) + ' 배포본';
}
function qRowHtml(it) {
  const url = /^https?:\/\//i.test(String(it.alt1 || it.key || ''));   // 활성 게이트 = 목적지(alt1‖key)와 동일 소스(게이트-목적지 갈림 차단 · 평의회7 V-1)
  const eff = qEff(it);
  let status, action;
  if (eff === 'succ') {
    status = '<span class="qb-done">완료</span>';
    action = qGoBtn('green', '뉴스요약 열기');
  } else if (eff === 'fail') {
    status = '<span class="qb-failt">실패</span>';
    const isAsk = it.via === '요약요청';   // ✨요약요청 실패 = 원문 링크(URL 없음) 대신 '재시도' = 붙여넣은 전문 복원 → 요약창 재오픈(운영자 260704)
    action = isAsk ? qRetryBtn('재시도 — 요청 내용을 복원해 다시 요약')
           : url ? qPickRetryBtn('재시도 — 다시 분석(대기열 재투입)')   // URL 실패 = 재분석 재발사(api/pick) — 요약요청과 대칭 재시도 제공(운영자 260713 · 구 amber 원문 대체 = 재시도 우선 · 수집함 Failed→✓ 재시도와 일관)
           : qGoBtn('gray', '원문 링크 없음');   // 전문(paste) 실패 = key='' (url無)라 재발사 복원 경로 없음 → 재시도 불가(현행 유지). 실패 보고서는 깃에 자동저장.
  } else if (eff === 'lag') {   // 분석은 끝났고 '피드 배포 반영'만 남음 = 회전 정지 + 무채 '대기'(운영자 260803 무한 스피너 종식) — 실패가 아니라서 빨강 금지·아직 못 여니 초록도 금지 = 취소 라벨과 같은 무채 셀
    const _g = qGenAgo();
    status = '<span class="qb-lag" title="분석 완료 · 피드 배포 반영 대기' + (_g ? ' (현재 피드 = ' + _g + ')' : '') + '">대기</span>';
    action = url ? qGoBtn('amber', '원문 새 탭 — 요약은 배포 반영 후 열림')
                 : qGoBtn('gray', '분석 완료 · 피드 배포 반영 대기' + (_g ? ' (현재 피드 = ' + _g + ')' : ''));   // 회색 = 갈 곳 없음 그대로(탭 = 이 요청 추적 취소 · qCancelTap 정본)
  } else if (eff === 'retry') {   // API 일시 과부하 자동 재시도 — ↻ 회전 + 횟수(FAIL 아님)
    status = '<span class="qico s-retry spin" title="API 일시 과부하 — 자동 재시도 중' + (it.tries ? ' (' + it.tries + '회)' : '') + '">' + Q_REFR + '</span>' + (it.tries ? '<span class="qcnt">' + it.tries + '</span>' : '');
    action = url ? qGoBtn('amber', '원문 새 탭') : qGoBtn('gray', '전문 — 원문 링크 없음');
  } else {   // 처리중(또는 succ인데 피드 미반영=빌드 랙) = 스피너 + 주황 원문(재시도와 동색 앰버)
    status = '<span class="qico s-proc spin" title="분석 처리 중">' + Q_SPIN + '</span>';
    action = url ? qGoBtn('amber', '원문 새 탭') : qGoBtn('gray', '전문 분석 중 — 원문 링크 없음');
  }
  const ttl = qTitle(it), cp = [...ttl], ttlS = cp.length > 40 ? cp.slice(0, 40).join('') + '…' : ttl;   // 40자 하드캡 + … (코드포인트 단위)
  const _am = it.t ? (Date.now() - it.t) / 60000 : 1e9;   // 경과(분)
  const tnew = _am <= 60 ? ' qt-new' : _am <= 240 ? ' qt-mid' : '';   // ≤1h 메인 강조 / 1~4h 노랑 / 그외 기본(운영자 260622)
  const pp = qPresetPP(it);   // 수집 프리셋 표기(Q495 시안 확정) — 있으면 제목만 말줄임(qm-flex)·표기 생존
  const mainCell = pp ? '<span class="qmain qm-flex" title="' + qEsc(ttl) + '"><i class="qm-t">' + qEsc(ttlS) + '</i>' + pp + '</span>'
                      : '<span class="qmain" title="' + qEsc(ttl) + '">' + qEsc(ttlS) + '</span>';
  return '<div class="qrow q-' + eff + '"><span class="qt' + tnew + '">' + qEsc(qAgo(it.t)) + '</span>' + mainCell + '<span class="qst">' + status + '</span><span class="qact">' + action + '</span></div>';
}
const PP_LBL = { h24: '24h', fp: '외신', mj: '주요', og: '원본' };   // 수집 프리셋 축약 라벨(Q495 시안 확정 · Q491 스트립 짝 · og = 원본 한정 260727)
function qPresetPP(it) {   // 프리셋 적용된(켜진) 요약요청만 표기 — 켜진 조건 나열 · 스크랩/픽·구 asks(무필드)·전부 꺼짐 = ''(운영자 260724 "역방향 아님 · 보통은 무표기")
  const p = it && it.preset; if (!p) return '';
  const on = ['h24', 'fp', 'mj', 'og'].filter(k => p[k]);
  return on.length ? '<span class="pp">' + on.map(k => PP_LBL[k]).join(' · ') + '</span>' : '';
}
function pagerHtml(pages, cur) {   // 5개/페이지 · 페이지번호 슬라이딩 윈도우(최대 5개)
  if (pages <= 1) return '';
  let h = '<button class="qpg-nav" data-pg="' + Math.max(0, cur - 1) + '"' + (cur === 0 ? ' disabled' : '') + '>' + CHEV_L_SVG + '</button>';
  const W = 5, end = Math.min(pages, Math.max(0, cur - 2) + W), start = Math.max(0, end - W);
  for (let i = start; i < end; i++) h += '<button class="qpg' + (i === cur ? ' on' : '') + '" data-pg="' + i + '">' + (i + 1) + '</button>';
  h += '<button class="qpg-nav" data-pg="' + Math.min(pages - 1, cur + 1) + '"' + (cur === pages - 1 ? ' disabled' : '') + '>' + CHEV_R_SVG + '</button>';
  return h;
}
function renderQueuePage() {
  const box = $('#qpopList'), pg = $('#qpopPage'); if (!box) return;
  if (!QITEMS.length) { box.innerHTML = '<div class="qempty">최근 내역 없음</div>'; if (pg) pg.innerHTML = ''; return; }   // 빈 문구 = '최근 내역 없음'(운영자 260622)
  const pages = Math.ceil(QITEMS.length / QPER);
  QPAGE = Math.min(Math.max(0, QPAGE), pages - 1);
  const slice = QITEMS.slice(QPAGE * QPER, QPAGE * QPER + QPER);
  box.innerHTML = slice.map(qRowHtml).join('');
  slice.forEach((it, i) => {
    const row = box.children[i]; if (!row) return;
    // 프리셋 표기가 제목을 줄이면(말줄임 발동) 표기 제거·제목 전폭 복원(운영자 260724 "제목 줄어들 여지 높으면 그냥 안 표기") —
    //   .pp는 .qmain(flex:1·min-width:0) 안에 갇혀 우측 픽토그램(.qst/.qact flex:none)은 구조상 무침범 · 제목 잠식만 이 가드로 차단.
    const pp = row.querySelector('.pp');
    if (pp) { const qt = row.querySelector('.qm-t');
      if (qt && qt.scrollWidth > qt.clientWidth + 0.5) {   // 표기 있는 채로 제목이 잘림 = 표기가 폭 잠식 → 제거하고 제목 전폭 환원(무표기 행과 동일 구조)
        const main = row.querySelector('.qmain'); pp.remove();
        if (main) { main.classList.remove('qm-flex'); main.textContent = qt.textContent; }
      }
    }
    const go = row.querySelector('.qgo');
    if (go && go.classList.contains('go-gray')) { go.onclick = (e) => { e.stopPropagation(); qCancelTap(it, row, go); }; }   // 비활성(회색 ↗) = 탭하면 취소 상태머신(휴지통 arm → 확정 · 정본 = thumb jobCancelTap · 운영자 260728)
    else if (go && !go.disabled) go.onclick = (e) => { e.stopPropagation(); const s = go.querySelector('svg'); if (s) { const m = (go.classList.contains('qretry') || go.classList.contains('qpretry')) ? 'ic-spin' : 'ic-arrow'; s.classList.remove('ic-arrow', 'ic-spin'); void go.offsetWidth; s.classList.add(m); } if (go.classList.contains('qretry')) askRetry(it); else if (go.classList.contains('qpretry')) qPickRetry(it); else if (go.classList.contains('go-green')) qGo(it.id); else if (it.alt1 || it.key) failOpen({ url: it.alt1 || it.key }); };   // 이동(↗)=ic-arrow(지지대선 슉+촉 플레어+pop·버튼색) / 재시도(↻)=ic-spin 회전 · 리플로우는 버튼 기준(svg.offsetWidth undefined 함정 · 운영자 260705)   // ↗ 목적지 = 버튼 색 기준(초록=뉴스요약 준비됨만 / 주황=기사 원문 새 탭) → succ여도 피드 미반영이면 초록 안 뜨므로 조기 이동·'곧 표시' 토스트 0 · 주황 원문 = alt1(api/pending이 '# alt:' 첫 url = breaking_pick 있으면 메이저·없으면 타 클러스터 멤버) 우선 — 대표 url이 최초보도 속보 스텁(본문 한 줄)로 튀던 것 교정 = 수집함 카드 scLinkUrl(breaking_pick 우선)과 동일 방향 정책(운영자 260703) · failOpen 앵커클릭(window.open 모바일 빈모달 회피·hrefOk 정화) · 원문 없으면 qGoBtn('gray') disabled=완전 비활(운영자 260622)
  });
  if (pg) {
    pg.innerHTML = pagerHtml(pages, QPAGE);
    pg.querySelectorAll('[data-pg]').forEach(b => b.onclick = (e) => { e.stopPropagation(); QPAGE = +b.dataset.pg; setTimeout(() => renderQueuePage(), 0); });   // 재렌더를 클릭 종료 후로 미룸 — 클릭 도중 innerHTML 교체로 누른 버튼이 떨어져 팝업 닫히던 것 차단(가드+stopPropagation과 3중·운영자 260622)
  }
}
// ── 대기열 행 취소(운영자 260728 "비활성 ↗ 클릭=휴지통 → 또 클릭=취소") — 정본 = 이미지 스튜디오 제작 대기열 취소(thumb.html jobCancelTap) 그대로: 1탭 무장(3s 원복 = #histClr 동값) → 2탭 확정 ✓(ok) → 1200ms 잔상 후 행 회수 · 무장 픽토만 X 대신 휴지통(운영자 지목) ──
//   취소 = 이 뷰의 추적만 끊는다(행 숨김·배지 제외·기어 레몬 제외) — 파이프라인 자체를 멈추는 API 없음(thumb jobCancel 동일 한계) · 기록 = localStorage(같은 함 '내역 지우기' nomute_q_cleared 문법 계승 = 기기별)
const QCXL_KEY = 'nomute_q_cancelled';
const qCxlId = it => String((it && (it.id || it.key)) || (it && it.t) || '');
function qCxlSet() { try { return new Set(JSON.parse(localStorage.getItem(QCXL_KEY) || '[]')); } catch { return new Set(); } }
function qCxlFilter(items) {   // api/pending 응답 공용 게이트(loadQueue·loadPending) — 취소분 제외 + 서버서 사라진 id 정리(저장분 무한 증식 방지)
  const s = qCxlSet(); if (!s.size) return items || [];
  const live = new Set((items || []).map(qCxlId));
  const keep = [...s].filter(id => live.has(id));
  if (keep.length !== s.size) { try { localStorage.setItem(QCXL_KEY, JSON.stringify(keep)); } catch {} }
  return (items || []).filter(it => !s.has(qCxlId(it)));
}
function qCancelTap(it, row, btn) {   // 상태머신 = jobCancelTap 100% 계승(3s·1200ms 동값) · 아이콘 축만 ↗(회색)→휴지통(arm 레몬)→✓(ok)
  if (!it._cxArm) {
    it._cxArm = 1; btn._t0 = btn.title;
    btn.classList.remove('go-gray'); btn.classList.add('go-arm'); btn.innerHTML = _TRASHSVG; btn.title = '한 번 더 누르면 이 요청 취소'; btn.setAttribute('aria-label', '취소 확정');
    clearTimeout(it._cxT); it._cxT = setTimeout(() => { it._cxArm = 0; if (!row.isConnected) return; btn.classList.remove('go-arm'); btn.classList.add('go-gray'); btn.innerHTML = Q_ARR; btn.title = btn._t0 || ''; btn.removeAttribute('aria-label'); }, 3000);   // 3s 내 재탭 없으면 원복(#histClr·thumb 동값)
    return;
  }
  clearTimeout(it._cxT); it._cxArm = 0;
  try { const s = qCxlSet(); s.add(qCxlId(it)); localStorage.setItem(QCXL_KEY, JSON.stringify([...s])); } catch {}
  const eff = qEff(it);   // qRowHtml 과 같은 단일 출처(배포 미반영 succ = processing/lag)
  if (eff === 'processing' || eff === 'retry') { PEND_PROC = Math.max(0, PEND_PROC - 1); updateQBadge(); }   // 배지 즉시 동기(이후 폴은 qCxlFilter가 유지)
  btn.classList.remove('go-arm'); btn.classList.add('qcx-ok'); btn.innerHTML = CHECK_SVG; btn.title = '취소됨'; btn.setAttribute('aria-label', '취소됨'); btn.disabled = true;
  const st = row.querySelector('.qst'); if (st) st.innerHTML = '<span class="qb-cxl">취소</span>';   // 상태셀 = 이 함 2자 문법(완료·실패) 계승
  setTimeout(() => { const i = QITEMS.indexOf(it); if (i >= 0) QITEMS.splice(i, 1); renderQueuePage(); }, 1200);   // ✓ 잔상(thumb 1200 동값) 후 행 회수 — 리스트·페이저 재계산 = renderQueuePage 재사용
}
// ── 픽 접수 = 대기열에 즉시 꽂힌다(운영자 260816 "picking 하면 대기열에 바로 꽂혀야되는데 약 1분간의 텀이 있음") ──
//   ⚠ 원인은 폴 주기가 아니라 **파일 착지 지연**이다 — 픽 → /api/pick 은 pick.yml 을 디스패치할 뿐이고,
//   pending/<id>.txt 는 러너가 [체크아웃 → 파이썬 설치 → pick_pending.py → 본문 선-fetch(timeout 60s) → 커밋·푸시]
//   를 다 끝낸 뒤에야 main 에 착지한다. 그 전까지 api/pending(=GitHub contents 조회)은 그 항목을 **물리적으로 모른다**
//   = 뷰어를 아무리 자주 폴해도 빈손이고, 운영자에겐 "픽했는데 대기열에 없음"으로만 보인다(접수 확인 불가).
//   봉합 = api/pick 이 200(디스패치 접수 확정)을 준 순간 같은 규격의 행을 로컬에 심어 목록·배지에 즉시 반영하고,
//   서버 pending 에 같은 url 이 뜨는 순간 로컬분을 회수한다(중복 0 · 파이프라인·서버 무접촉 = 읽기전용 계약 유지).
//   ⚠ 낙관 행은 **대기열 목록·배지에만** 태운다 — PEND(픽 상태 판정축)는 서버 진실만 담는다(loadPending `!it._opt`).
//   기록 = localStorage(qCxl·'내역 지우기' 문법 계승 = 기기별) · TTL 초과분 자동 회수(러너가 죽어도 유령 행이 안 남는다).
const QOPT_KEY = 'nomute_q_optimistic';
const QOPT_TTL = 15 * 60000;   // 15분 — 정상 착지 ~1분 · 선-fetch 60s + 푸시 재시도 백오프(2·4·8s×4)까지 덮는 여유폭(초과 = 러너 사망 = 행 회수)
function qOptAll() { try { const a = JSON.parse(localStorage.getItem(QOPT_KEY) || '[]'); return Array.isArray(a) ? a : []; } catch { return []; } }
function qOptSave(a) { try { localStorage.setItem(QOPT_KEY, JSON.stringify(a.slice(-20))); } catch {} }   // 롤링 20 = 대기열 1페이지(5)·CAP_PEND(25) 안쪽
function qOptAdd(url, title) {   // 픽 접수 확정(api/pick ok) 직후 호출 — 같은 url 재접수는 최신 1건으로 수렴
  const u = _normU(url); if (!/^https?:\/\/\S+$/i.test(u)) return;
  const a = qOptAll().filter(o => o && _normU(o.url) !== u);
  a.push({ id: 'opt-' + u.slice(-80), url: u, title: String(title || ''), t: Date.now() });
  qOptSave(a); PEND_PROC++; updateQBadge();   // 배지도 그 자리에서 +1 = 다음 폴을 안 기다린다(loadQueue·loadPending 재계산이 이어서 정합)
}
function qOptDrop(url) { const u = _normU(url); qOptSave(qOptAll().filter(o => o && _normU(o.url) !== u)); }   // api/pick 거절 롤백 짝(pickCard catch = 낙관 표시 회수 · 평의회 260713 ⑦ 문법)
function qOptLive(items) {   // 서버가 아직 못 보는 접수분만 반환(+ 착지·만료분 회수) — 정리 문법 = qCxlFilter 동축(저장분 무한 증식 차단)
  const now = Date.now();
  const live = new Set((items || []).map(it => (it && it.key) ? _normU(it.key) : '').filter(Boolean));
  const all = qOptAll(), keep = all.filter(o => o && o.url && (now - o.t) < QOPT_TTL && !live.has(_normU(o.url)));
  if (keep.length !== all.length) qOptSave(keep);
  return keep;
}
function qOptMerge(items) {   // api/pending 응답 + 접수분 = 대기열 목록 공용 입구(행 규격 = 서버 pending 항목과 동일 필드)
  return (items || []).concat(qOptLive(items).map(o => ({
    id: o.id, t: o.t, status: 'processing', via: 'URL', src: qOptHost(o.url), key: o.url, title: o.title, _opt: 1,
  })));
}
function qOptHost(u) { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; } }   // api/pending prettyUrl 동값(표시 전용)
let qGen = 0;
async function loadQueue() {
  const g = ++qGen;   // 세대 토큰 — 재오픈/폴 경합 시 늦게 온 stale 응답 폐기(페이지 튕김 방지)
  const box = $('#qpopList'); if (!box) return;
  box.innerHTML = '<div class="qempty">' + (window.nmLoader?nmLoader('loading','Now loading…'):'Now loading…') + '</div>'; const pg = $('#qpopPage'); if (pg) pg.innerHTML = '';
  let items;
  try {
    const r = await fetch('api/pending?_=' + Date.now());
    if (g !== qGen) return;
    if (!r.ok) { box.innerHTML = '<div class="qempty">대기열 조회 실패 (' + r.status + ')</div>'; return; }
    const j = await r.json(); items = qCxlFilter(qOptMerge(j.items || []));   // 접수분(서버 미착지) 병합 → 취소분 제외(qCancelTap 기록 · 운영자 260728) · ⚠ 순서 = 병합이 먼저 — qCxlFilter 의 '서버서 사라진 id 정리'가 낙관 id 를 죽은 것으로 읽어 취소를 되살리는 것 차단
  } catch { if (g === qGen) box.innerHTML = '<div class="qempty">네트워크 오류 — 다시 시도</div>'; return; }
  if (g !== qGen) return;
  let cut = 0; try { cut = +localStorage.getItem('nomute_q_cleared') || 0; } catch {}
  // 발견성 배지(진행중 건수)도 이 응답으로 즉시 동기화 — 리스트 열 때 별도 폴 안 기다리고 배지 최신화(stale 불일치 방지·추가 fetch 0·운영자 260701). status 기준(loadPending과 동일 = 파이프라인 처리중 = 어디서 세든 같은 값).
  PEND_PROC = items.filter(it => it && (it.status === 'processing' || it.status === 'retry')).length; updateQBadge();
  setQFail(items); qfMarkSeen();   // 리스트가 실제로 그려지는 이 응답으로 실패분 최신화 → 그 자리서 확인 처리(열어 놓은 채 새 실패가 들어와도 '보고 있는 중'이므로 소등 유지 · 운영자 260727)
  // 화면상 '진행중'(스피너로 그려지는 것) 최상단 고정 → 리스트 1페이지가 배지·진행상태와 일치.
  //   _qProg를 eff 기준(succ인데 피드 미반영=빌드랙도 qRowHtml서 스피너로 그려짐 → 상단)으로 잡아 '스피너인데 하단' 모순 차단(260701).
  //   시각 파싱 실패로 t=null이어도 진행중이면 status로 상단 → API 최신순 정렬 맨뒤로 밀려 안 뜨던 불일치 방어. 완료(succ/fail)는 API 최신순 유지(JS 안정정렬). '내역 지우기' 컷오프 이후만.
  const _qProg = it => { const e = qEff(it); return (e === 'processing' || e === 'retry') ? 0 : 1; };   // 상단 고정 = '진짜 도는 것'만 — lag(배포 대기 확정)는 완료 계열로 시간순(스피너 아닌 행이 1페이지를 점거하던 것 해소)
  QITEMS = items.filter(it => !it.t || it.t > cut).sort((a, b) => _qProg(a) - _qProg(b) || (b.t || 0) - (a.t || 0));
  QPAGE = 0;
  renderQueuePage();
}
// 피드(메뉴3) 이동 + 해당 기사 모달. 즉시 매칭되면 바로, 없으면(빌드 랙) load() 후 재매칭.
async function feedOpenBy(match, keepQ) {
  if (!keepQ) closeQueueUser();   // 큐 ↗(keepQ)면 대기열 안 닫음 — 요약 모달(top-layer·모바일 풀스크린)이 위를 덮고 닫히면 그대로 다시 보임(close→reopen 깜빡임 제거·운영자 260622). 그 외(PICKED 등)는 정식 닫기.
  showTab('feed');
  let a = match();
  if (a) { open(a); return; }   // 즉시(이미 피드에 있음 = 흔한 경우)
  try { await load(); } catch {}   // 빌드 랙 — 기사 재요청 후 재매칭
  a = match();
  if (a) open(a); else qFlash('피드 반영 중 — 곧 표시돼');
}
function qGo(id) {   // SUCC 링크 — queue 파일명(id) ↔ 피드 기사 매칭(qMatch 공용). 초록 버튼만 호출되므로 항상 매칭됨
  feedOpenBy(() => qMatch(id), true);   // true = 대기열 안 닫음(요약 모달이 위를 덮음)
}
async function askRetry(it) {   // ✨요약요청(ask) 실패 재시도 — api/askget 으로 원문(전문)을 복원해 요약창에 채워 다시 요청(운영자 260704).
  // 원문 링크(URL)를 못 찾은 실패라도 '내가 붙여넣은 내용'을 그대로 되살려 재요청 = 사용자가 다시 검색해 붙일 필요 없음(우선순위 = 재시도).
  let text = '', imgs = 0;
  try {
    const r = await fetch('api/askget?id=' + encodeURIComponent(it.id) + '&_=' + Date.now());
    if (r.ok) { const j = await r.json(); text = String(j.text || ''); imgs = +j.images || 0; }
  } catch {}
  // ⚠️ 대기열을 closeQueueUser 로 닫지 않는다 — 그 history.back() 과 openAsk 의 pushState 가 같은 틱서 경쟁하면
  //   방금 연 요약창이 떠돌이 popstate 로 닫힌다(평의회10 ★). 요약창(showModal·top-layer)이 대기열을 덮으므로 안 닫아도 무방(qGo keepQ 패턴).
  openAsk({ prefill: text, retryOf: it.id });   // retryOf = 옛 실패 id → 재제출 성공 시 submit 이 옛 asks/failed 삭제(옛 실패행 24h 잔존·중복 누적 방지 = 평의회10 Q1·Q3)
  if (!text && imgs) qFlash('텍스트 없이 캡처만 있던 요청 — 캡처 ' + imgs + '장을 다시 첨부해줘');   // 재시도 복원 안내 = qFlash 토스트(팝업 내 상태문자열 폐지 · 운영자 260720 — 모달 위 표시는 qFlash 호스트 이주가 처리)
  else if (!text) qFlash('원문 복원 실패 — 직접 붙여넣어 재시도해줘');
  else if (imgs) qFlash('캡처 ' + imgs + '장은 다시 첨부해줘(텍스트만 복원됨)');
}
async function qPickRetry(it) {   // URL 픽/분석 실패 재시도 — api/pick 로 재분석 재발사(대기열 재투입). askRetry(요약요청·askget 전문복원)와 별개 = pending URL 항목 전용(운영자 260713).
  const u = String(it.key || it.alt1 || '');
  if (!/^https?:\/\//i.test(u)) { qFlash('원문 링크가 없어 다시 분석 못 해 — 전문을 다시 붙여넣어줘'); return; }   // 전문(paste) 실패 = url無(복원 경로 없음)
  try { await fetch('api/pick', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: u, title: it.title || '', alt: (it.alt1 && it.alt1 !== u) ? [it.alt1] : [] }) }); } catch {}   // 수집함 failRetry와 동일 재발사(alt=대체 매체로 원매체 403 우회)
  qFlash('다시 분석 요청했어 — 잠시 뒤 처리중으로 바뀌어');
  setTimeout(loadQueue, 1200); setTimeout(loadQueue, 4000);   // 재발사 후 대기열 갱신(실패행→처리중 · submit 패턴 계승)
}
function qFlash(msg, iconSvg) {   // 짧은 토스트(링크 빌드 랙 안내 + 팝업 상태문구 전량 위임 · 운영자 260720 "문자열 말고 포스트 알림") · iconSvg 주면 픽토그램+esc(메시지) innerHTML(XSS 가드)
  let t = document.getElementById('qFlash');
  if (!t) { t = document.createElement('div'); t.id = 'qFlash'; t.className = 'qflash'; }
  // 열린 모달(showModal·top-layer)은 z로 못 이김(reparentNav 11219 실측 전례) → 최상위 열린 dialog 안으로 이주 = 비inert 자식으로 백드롭 위에 표시 · 없으면 body. fixed라 좌표는 viewport 그대로(컴포즈 모달 transform 잔존은 popIn to{none}이라 무해 · PC 드래그 중 예외 열화만 수용).
  const _dl = document.querySelectorAll('dialog[open]');
  const host = _dl.length ? _dl[_dl.length - 1] : document.body;
  if (t.parentElement !== host) host.appendChild(t);
  t.innerHTML = '<span class="ft-msg">' + esc(msg) + '</span>';   // iconSvg 인자 무시(호출처 호환 유지) — 가족 픽토그램 = 긴급 BELL·실패 WARN 둘만(운영자 260712) · 한 줄 말줄임 = .ft-msg CSS
  t.classList.add('show');
  clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 2500);   // 2600→2500(운영자 260712 회신)
}
document.addEventListener('close', e => {   // 호스트 모달이 토스트 표시 중 닫히면(성공 1.3s 자동닫힘 등) body로 귀환 = 잔여 표시시간 보존(close는 버블 안 함 → 캡처로 수신 · reparentNav 고아 정리와 동일 축)
  const t = document.getElementById('qFlash');
  if (t && e.target instanceof Element && e.target.contains(t)) document.body.appendChild(t);
}, true);
$('#qpopX').addEventListener('click', e => { e.stopPropagation(); closeQueueUser(); });   // 닫기(작은 ✕ → 직접 닫기, 재오픈 플래그 해제)
window.addEventListener('pageshow', () => { try { if (sessionStorage.getItem('nomute_q_open') === '1' && qpop.hidden) openQueue(); } catch {} });   // 외부 링크(↗) 갔다 뒤로가기로 복귀 시 대기열 자동 재오픈 — 열어둔 채 떠났을 때만(직접 닫으면 플래그 해제됨) · 운영자 260622


