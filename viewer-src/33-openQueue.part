const srvSysMax = () => { const lim = Date.now() + 1800e3; let a = 0, r = 0; TF_SRV.s.forEach(v => { const m = /^(ack|rearm):(\d+)$/.exec(v); if (!m) return; const e = +m[2]; if (e > lim) return; if (m[1] === 'ack') { if (e > a) a = e; } else if (e > r) r = e; }); return { a, r }; };   // +30분 초과 미래 epoch = 무효 스킵(평의회③ — 시계 크게 빠른 기기의 ✓ 한 번이 '미래 ack'로 전 기기 영구 침묵 + rearm이 영원히 못 이기는 자가복구 불능 차단 · 선의 스큐 ≤30분 허용 · 서버 클램프와 이중)
const srvFreshAckTs = () => { const { a, r } = srvSysMax(); return a > r ? a : 0; };
