async function claimSeen(kind, c) {   // 표시 전 선점(운영자 260712 "같은 알림 2번 뜨는 건 무조건 막아야") — 서버가 sha 원자 병합으로 '처음 기록' 판정(fresh) → 처음 선점한 기기만 표시 = 크로스 플랫폼 정확히 1회. API 불통 = fail-open(알림 놓침 방지 우선 — 그 순간만 중복 가능성 감수·주석 정직)
