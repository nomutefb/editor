function postSysSeen(kind) { if (kind === 'rearm') { if (Date.now() - _lastRearmPost < 600e3) return; _lastRearmPost = Date.now(); try { localStorage.setItem('nmRearmPost', String(_lastRearmPost)); } catch {} } const v = kind + ':' + Date.now(); if (TF_SRV.s.has(v)) return; TF_SRV.s.add(v); fetch('api/seen', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ s: [v] }) }).catch(() => {}); }   // fire-and-forget·낙관 add(postSeen 문법 계승) — 불통 = 로컬 ack가 이 기기는 커버(fail-soft) · rearm = 정밀 시각(재무장 즉시성) + 10분 rate-limit(커밋 스팸 0 · 다기기 동시 관측 = 기기 수만큼 커밋 = 희귀 허용)
