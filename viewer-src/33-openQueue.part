const SOC_SENT_KEY = 'nm_soc_sent', SOC_PKLABEL = 'Pk-ng', SOC_PKDONE = 'Pk-ed';   // 라벨 = 한 곳(운영자 260804 "칸이 좁으니까 그냥 Pk-ng" · 완료 = "Pk-ed" — 렌더·런타임 전환 공용)
const SOC_SENT_CAP = 200;   // 원장 상한 = 최근 200건(커뮤니티 행은 빠르게 회전 → 무한 누적 방지 · 넘치면 오래된 것부터 탈락)
const SOC_PIN_MS = 24 * 3600e3;   // 전송 카드 잔류 창(운영자 260821 "전송 후에도 그 자리에 남아있게 — 전송하면 사라져서 곤란") — 목록 데이터(social_candidates.json)는 스캔마다 통째 교체라 글이 회전해 빠지면 전송한 카드도 같이 사라졌다(Pk-ng/Pk-ed 추적 고리 단절) → 전송 시점 스냅샷(snap)으로 24시간 잔류. 24h = 이 레포 작업 추적 TTL 정본 동값(nm-jobs 슬롯·pending 계승 · 값 창작 0) · 창을 넘긴 스냅샷은 저장 시 스스로 걷힌다(원장 {ask,q} 본체는 종전대로 상한 200 회전 = 버튼 상태·중복 전송 가드 축 무접촉).
// 원장 = Map(카드키 → {ask, q[, snap, at]}) · ask = asks/<id>.json 베이스(submit 응답) · q = 완료된 queue 파일 id(있으면 Pk-ed = 그 요약으로 이동 가능) · snap/at = 전송 시점 카드 스냅샷·전송 시각(260821 잔류 축 — 구 원장 항목엔 없다 = 그 전송분은 종전대로 회전 소멸 · fail-soft).
//   ⚠ 구판(260804 1차)은 키 배열이었다 → 배열이면 {ask:'',q:''}로 승격해 읽는다(그 회차 전송분은 ask id를 모르니 Pk-ng에 머문다 = 정보 없는 걸 완료로 꾸미지 않는다).
let SOC_SENT = (() => {
