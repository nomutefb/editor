const socAskNorm = s => String(s || '').replace(/-/g, '');   // asks/2026-08-04-0112-xbo3n → 202608040112xbo3n = queue/260804-1012-ask-**202608040112xbo3n**.md 안에 그대로 박히는 형태(ask.sh 명명 규칙)
const RKEY = 'nm_ratings';
const ratingsAll = () => { try { return JSON.parse(localStorage.getItem(RKEY) || '{}'); } catch { return {}; } };
const saveRating = (id, patch) => { const r = ratingsAll(); r[id] = { ...(r[id] || {}), ...patch }; localStorage.setItem(RKEY, JSON.stringify(r)); };
const candId = c => c.id || c.url || c.title;
// ── grade 수기 교정(운영자 260807 "grade가 나오게, 어긋났을 때 고칠 수 있게") — 로컬 즉시 반영(랭킹·표시) + postRate로 원장 적재(scraper/grade_votes.jsonl · 12h 소비 = grade_fix_report) ──
//    ⚠️ 배지·긴급(isBreaking·issGrade)은 raw c.grade 유지 = build-viewer 미러와 규칙 동일 계약 보존(피드↔수집함 배지 드리프트 게이트 축) — 교정은 랭킹(gradeW)·표시 칩만.
const GFIX_KEY = 'nomute_grade_fix';
const gfixAll = () => { try { return JSON.parse(localStorage.getItem(GFIX_KEY) || '{}'); } catch { return {}; } };
const gfixOf = c => { const f = gfixAll()[candId(c)]; return (f && f.g != null) ? f : null; };
const gEff = c => { const f = gfixOf(c); return f ? f.g : c.grade; };   // 실효 등급 = 교정 우선
const scRelTime = iso => {   // published(ISO) → 상대시각(렌더 시점 계산 = 안 틀어짐)
  if (!iso) return '';
  const t = new Date(iso); if (isNaN(t)) return '';
  const s = Math.max(0, (Date.now() - t.getTime()) / 1000);
  if (s < 60) return '방금 전';
  if (s < 3600) return Math.floor(s / 60) + '분 전';
  if (s < 86400) return Math.floor(s / 3600) + '시간 전';
  const d = Math.floor(s / 86400);
  if (d === 1) return '1일 ' + Math.floor((s % 86400) / 3600) + '시간 전';   // 1일대(24~48h)는 시간까지 — '1일 전'끼리 구분(2일+는 그대로)
