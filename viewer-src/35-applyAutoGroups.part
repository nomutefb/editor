  // 픽 분석실패 = 카드(칼럼) 종속서 분리해 상단 전폭 '실패 트레이'에 모음 — cross<8·4h 솎여 칼럼에 미렌더돼도 실패가 안 사라지게(운영자 260620 분신술 표면작업).
  const _mm = mergesAll(), _mergedMembers = new Set(), _liveIds = new Set(CANDS.map(candId));   // 병합 멤버 = 실패트레이서도 제외(앵커에 흡수=이중표면 방지·분신술8 F1) — ⚠️ 단 앵커가 *살아있을 때만*(앵커 탈락[GC·rep점프·별점] 시 흡수처 사라져 멤버 증발 silent-loss 방지·재검4)
  for (const a of Object.keys(_mm)) { if (!_liveIds.has(a)) continue; (Array.isArray(_mm[a] && _mm[a].members) ? _mm[a].members : []).forEach(m => _mergedMembers.add(m)); }
  const failed = base.filter(c => pickState(c) === 'failed' && !JUNK_HEAD.test(c.title || '') && !failRequeued(c) && !_mergedMembers.has(candId(c)));   // 체크(제자리 복귀)한 실패·병합 멤버는 트레이서 제외 → requeue 건은 칼럼 원래 자리로(운영자 260701·260625)
