  const host = $('#scrapList'); if (!host) return;
  const neo = document.createElement('div');   // 오프스크린 빌드 — 시그니처 완전 동일이면 커밋(DOM 교체) 자체를 생략. 종전 no-anim은 스태거만 억제하고 innerHTML 통재빌드는 그대로라, 라이브 재렌더(_firstLoad·loadPending 전이)가 웨이브 안착 직후 화면을 번쩍 갈아엎었음(운영자 260706 2차 "지그재그 안착하면 번쩍 갱신")
  const _sents = [];   // IO 센티널 = 커밋 후에만 observe(커밋 생략 시 기존 센티널 관찰 유지 = 무한스크롤 무중단)
  const q = ($('#q') ? $('#q').value : '').trim().toLowerCase();
  const rt = ratingsAll();
