function applyAutoGroups(pool) {
  const by = new Map();
  for (const c of pool) if (c.group_id) { const a = by.get(c.group_id) || []; a.push(c); by.set(c.group_id, a); }
  if (!by.size) return pool;
  const drop = new Set(), deco = new Map();
  for (const [gid, cards] of by) {
    if (cards.length < 2) continue;
    const anchor = cards.find(c => c.url === gid) || cards.slice().sort((a, b) => (b.cross || 0) - (a.cross || 0))[0];
    const mem = cards.filter(c => c !== anchor);
    deco.set(candId(anchor), mergeDecorate(anchor, mem));
    mem.forEach(c => drop.add(candId(c)));
  }
  if (!deco.size) return pool;
  return pool.map(c => deco.get(candId(c)) || c).filter(c => !drop.has(candId(c)));
}
// 병합 적용 = pool(dedup된 후보)서 멤버 카드 접고 앵커는 mergeDecorate. 멤버가 pool 밖(타 필터로 빠짐)이면 CANDS 폴백으로 찾음.
function applyMerges(pool) {
  const M = mergesAll();
  if (!Object.keys(M).length) return pool;
  const _mems = a => Array.isArray(M[a] && M[a].members) ? M[a].members : [];   // 손상 localStorage(members 비배열) 방어(분신술9)
  // lazy GC: 앵커도 멤버도 전원 CANDS 부재인 죽은 병합 제거(rep-url 점프로 candId 죽음·픽완료·quota 출혈 방지·분신술6·7)
  const liveId = new Set(CANDS.map(candId));
  let pruned = false;
  const _prunedKeys = [];
  for (const a of Object.keys(M)) { if (!liveId.has(a) && !_mems(a).some(m => liveId.has(m))) { delete M[a]; _prunedKeys.push(a); pruned = true; } }
  if (pruned) saveMerges(M, { del: _prunedKeys });   // GC도 계정 동기 — 전 기기 동일 결정(liveId 기반 결정적이라 어느 기기가 먼저 지워도 같은 결과)
  const byId = new Map(pool.map(c => [candId(c), c]));
  const anchorSet = new Set(Object.keys(M).filter(a => byId.has(a)));   // pool에 실존하는 앵커만 = 앵커 부재면 멤버 안 접음(그룹 통째 실종 방지)
  const memberOf = new Map();   // 멤버 candId → 앵커 candId
  for (const a of anchorSet) for (const mid of _mems(a)) { if (mid !== a && !anchorSet.has(mid)) memberOf.set(mid, a); }   // 멤버가 그 자체로 앵커면 접지 않음(A↔B 사이클·중첩 방어·분신술1)
  const out = [];
  for (const c of pool) {
    const id = candId(c);
    if (memberOf.has(id)) continue;   // 멤버 = 접힘(앵커에 흡수)
    if (anchorSet.has(id) && _mems(id).length) {
      const mem = _mems(id).filter(mid => mid !== id).map(mid => byId.get(mid) || CANDS.find(x => candId(x) === mid)).filter(Boolean);
      out.push(mem.length ? mergeDecorate(c, mem) : c);
    } else out.push(c);
  }
  return out;
}
