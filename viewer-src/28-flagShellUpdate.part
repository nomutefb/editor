let _verEtag = '', _verAlerted = '', _verChkLast = 0;
async function checkNewVersion(force) {
  if (typeof BUILD_STAMP === 'undefined' || BUILD_STAMP === 'dev' || _shellUpdApplying) return;   // dev(로컬·미배포) = 대조 축 없음 · 반영 중 = 곧 reload
  if (!force && Date.now() - _verChkLast < 240000) return;   // 4분 스로틀 = visibilitychange 연타 흡수
  _verChkLast = Date.now();
