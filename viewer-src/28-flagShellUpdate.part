    const b = bl[bl.length - 1] || null;   // 목록 마지막 = 실제 브라우저(앞쪽은 Chromium 공용 표식)
    return { plat: h.platform || '', pv: h.platformVersion || '', model: h.model || '', br: b ? (b.brand + ' ' + String(b.version || '').split('.')[0]) : '' };
