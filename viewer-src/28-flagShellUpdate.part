const _pushBtn = $('#pushbtn'); if (_pushBtn) _pushBtn.addEventListener('click', pushToggle);
const _pushRow = $('#pushrow'); if (_pushRow) _pushRow.addEventListener('click', e => { if (e.target.closest('#pushbtn')) return; if (_pushBtn && !_pushBtn.disabled) pushToggle(); });   // 행 전체 탭 = 토글(라벨·여백 눌러도 무반응이던 것 교정 · 버튼 자체 클릭은 기존 리스너 = 중복 발화 차단)
let _healBusy = null, _healCool = 0;   // 단일비행 + 쿨다운(실패 60s·성공 3s) = 팝업 연타·포그라운드 복귀마다 구독 재시도 폭주 방지
function pushHeal() {   // 자가치유(운영자 260707 "ON 해놔도 어느 순간 OFF") — 의도(ON 플래그)와 실제 구독이 어긋나면 조용히 재구독.
