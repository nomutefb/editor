//   X(pbs.twimg.com)는 직접 로드가 정상이라 무접촉 = 종전 그대로.
function _dgImgSrc(u) {
  try { const h = new URL(u).hostname; return /(cdninstagram\.com|fbcdn\.net)$/.test(h) ? 'api/thembed?img=' + encodeURIComponent(u) : u; } catch { return u; }
}
function _dgPeekItems() { return ((_dg.peek && Array.isArray(_dg.peek.items)) ? _dg.peek.items : []).filter(it => it && it.u).slice(0, 12); }
// 치수 통일(운영자 260805 8차 "사진의 경우 픽셀이 없는 경우가 있네 · 통일해줘") — 서버가 못 주는 플랫폼이 있다
//   (인스타 임베드 = srcset 폭만 · X 사진은 원본 w/h 완비 · 스레드는 노드 값). 그래서 **이미 화면에 뜬 실물**을
//   재서(img.naturalWidth · video.videoWidth) 빈 자리만 채운다 — 추가 요청 0 · 전 플랫폼 한 문법 · 지어내기 0.
//   채운 뒤 한 번만 재렌더해 헤더 「항목 N — …」까지 같은 값으로 맞춘다(재귀 = 채울 게 없으면 멈춘다).
function _dgPeekMeasure(root) {
  const its = _dgPeekItems(); if (!its.length) return;
  let pend = 0, filled = false;
  const done = () => { if (--pend <= 0 && filled) _dgRenderBody(); };
  its.forEach((it, k) => {
    // ⚠ 영상은 **값이 있어도 다시 잰다**(운영자 260806) — 서버 값은 주소(efg)에서 유도한 값이라 인코더 반올림만큼 어긋날 수 있고,
    //   여기서 재는 건 지금 재생 중인 **그 스트림 자신** = 액자 ⬇가 저장하는 바로 그 파일이다. 진실이 유도값을 이긴다.
    //   사진은 종전대로 빈 자리만(로드된 실물과 후보 치수가 같으므로 재렌더 낭비 0).
    if (it.w && it.h && it.kind !== 'video') return;
    const c = root.querySelector('#dgpc' + k); if (!c) return;
    const el = c.querySelector('video, img'); if (!el) return;
    const take = () => {
      const w = el.naturalWidth || el.videoWidth || 0, h = el.naturalHeight || el.videoHeight || 0;
      if (w && h && (w !== it.w || h !== it.h)) { it.w = w; it.h = h; filled = true; }   // 값이 **달라졌을 때만** 재렌더 = 무한 재렌더 0
      done();
    };
    pend++;
    if (el.tagName === 'IMG') { if (el.complete) { take(); return; } el.addEventListener('load', take, { once: true }); el.addEventListener('error', done, { once: true }); }
    else { if (el.videoWidth) { take(); return; } el.addEventListener('loadedmetadata', take, { once: true }); el.addEventListener('error', done, { once: true }); }
  });
}
function _dgPeekGet(k) {
  const it = _dgPeekItems()[k]; if (!it) return;
  const base = String((_dg.peek && _dg.peek.title) || '받은자료').replace(/[\\/:*?"<>|\n]+/g, ' ').trim().slice(0, 60) || '받은자료';
  const nm = base + '_' + (k + 1);
  const a = document.createElement('a');
  a.href = '/api/linkgrab/file?url=' + encodeURIComponent(it.u) + '&name=' + encodeURIComponent(nm);
  a.rel = 'noopener';
  document.body.appendChild(a); a.click();
  setTimeout(() => { try { a.remove(); } catch {} }, 1500);
  const b = $('#dgpc' + k); const db = b && b.querySelector('.dg-dl'); if (db) db.classList.add('dl-done');   // 받음 = mut(.dl-done 전 앱 표준)
}
function _dgPeekGetAll(btn) {   // [전체] = 순차 저장 · 진행표기·✓팝은 dlAllSeq 정본이 담당(스캔 [전체]와 같은 함수)
  const n = _dgPeekItems().length; if (!n) return;
  dlAllSeq(btn, Array.from({ length: n }, (_, k) => k), () => '', k => _dgPeekGet(k));
}
function _dgGotMark(i) {   // 받음 마킹 — 기기 로컬 보존(최대 500 롤링) + 배지 즉시 갱신(전체 재렌더 없이)
  const it = ((_dg.res || {}).items || [])[i]; if (!it) return;
  _dg.got[_dgKey(it)] = Date.now();
  try { const g = _dgLoadGot(); g[_dgKey(it)] = Date.now(); const ks = Object.keys(g); if (ks.length > 500) ks.sort((a, b) => g[a] - g[b]).slice(0, ks.length - 500).forEach(k => { delete g[k]; }); localStorage.setItem(DG_GOT_KEY, JSON.stringify(g)); } catch {}
  const b = $('#dgg' + i); if (b) b.hidden = false;
  const d = $('#dgc' + i); const db = d && d.querySelector('.dg-dl'); if (db) db.classList.add('dl-done');   // 개별 버튼 = 받음 mut(.dl-done 전 앱 표준)
}
// 섹션 [전체] = 그 종류의 받을 수 있는 항목 전량 순차 저장 — 진행표기·✓팝은 dlAllSeq 정본이 담당(fire 주입 = 저장 방식만 이 화면 것).
function _dgDlSec(btn, kind) {
  const idx = []; _dgEach((it, i) => { if (it.dl && (it.kind || 'link') === kind) idx.push(i); });
  if (!idx.length) return;
  dlAllSeq(btn, idx, () => '', n => _dgDl(n));
}
function _dgMetaScan() {   // 용량 = head 지연 조회(동시 4 · 캡 80 = 과다 조회 방지 · 원본 계승)
  const r = _dg.res; if (!r) return;
  const q = []; (r.items || []).forEach((it, i) => { const m = _dg.meta[i]; if (it.dl && it.via !== 'direct' && !(m && m.size)) q.push(i); });
  const list = q.slice(0, 80);
  let k = 0;
  const next = () => {
    if (k >= list.length || !$('#dlgrab').open) return;
    const i = list[k++]; const it = r.items[i];
    fetch('/api/linkgrab/head?url=' + encodeURIComponent(it.dl))
      .then(x => x.json()).catch(() => ({}))
      .then(d => {
        if (_dg.res !== r) return;   // 새 스캔으로 교체됐으면 구 응답 폐기
        const m = _dg.meta[i] = _dg.meta[i] || {}; m.size = (d && d.size) || 0; m.type = (d && d.type) || '';
        const el = $('#dgsz' + i); if (el) el.textContent = _dgFmt(m.size) || '용량 미확인';
        next();
      });
  };
  for (let w = 0; w < 4 && w < list.length; w++) next();
}
// --- 스트리밍 영상 저장(yt-dlp 파이프라인) — 요청 → Actions 변환(2~5분) → 서명 URL 직접 수신 (동의 체크 폐지 · 운영자 260802) ---
async function _dgYtReq(i) {
  const it = ((_dg.res || {}).items || [])[i]; if (!it || !it.stream) return;
  const y = _dg.yt[i] = { st: 'req', polls: 0 };
  _dgYtPaint(i, '요청 중', true);
  try {
    const r = await fetch('/api/linkgrab/ytdl', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: it.url, title: it.title }) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok || d.error) throw new Error(d.error || ('HTTP ' + r.status));
    y.id = d.id;
    if (d.ready) { y.st = 'ready'; y.asset = d.asset; y.parts = d.parts; y.size = d.size; _dgYtReady(i); return; }   // 같은 영상 변환분(단일/분할) 재사용
    y.st = 'run'; _dgYtPaint(i, '변환 중 — 보통 2~5분(긴 영상은 더)', true);
    _dgYtPoll(i);
  } catch (e2) { y.st = 'idle'; _dgYtPaint(i, '저장 요청 실패 — ' + ((e2 && e2.message) || '오류'), false); }
}
function _dgYtPoll(i) {
  const y = _dg.yt[i]; if (!y || y.st !== 'run') return;
  if (!$('#dlgrab').open) return;   // 창을 닫으면 폴링도 멈춘다(백그라운드 상주 금지)
  if (++y.polls > 40) { y.st = 'idle'; _dgYtPaint(i, '시간 초과 — 다시 요청해 주세요', false); return; }
  setTimeout(() => {
    fetch('/api/linkgrab/ytstat?id=' + encodeURIComponent(y.id))
      .then(r => r.json()).catch(() => ({}))
      .then(d => {
        if (y.st !== 'run') return;
        if (d && d.ready) { y.st = 'ready'; y.asset = d.asset; y.parts = d.parts; y.size = d.size; _dgYtReady(i); return; }
        if (d && d.failed) { y.st = 'fail'; _dgYtPaint(i, '변환 실패 — 주소·연령 제한·초대형(6GB 초과) 여부를 확인해 주세요', false); return; }
        _dgYtPoll(i);
      });
  }, 15000);
}
function _dgYtPaint(i, msg, busy) {
  const st = $('#dgy' + i); if (st) st.textContent = msg || '';
  const b = $('#dgyb' + i); if (b && b.dataset.act === 'ytreq') b.disabled = !!busy;
}
function _dgYtReady(i) {
  const y = _dg.yt[i]; if (!y) return;
  const n = (y.parts && y.parts.length) || 0;
  const st = $('#dgy' + i); if (st) st.textContent = '변환 완료' + (n ? ' · ' + n + '편 분할' : '') + (y.size ? ' · ' + _dgFmt(y.size) : '');
  const b = $('#dgyb' + i);
  if (b) { b.disabled = false; b.textContent = n ? ('받기 ' + n + '편') : '받기'; b.dataset.act = 'ytget'; }
}
async function _dgYtFetchOne(assetId) {
  const r = await fetch('/api/linkgrab/ytfile?asset=' + encodeURIComponent(assetId));
  const d = await r.json().catch(() => ({}));
  if (!d || !d.url) throw new Error((d && d.error) || '파일 위치 조회 실패');
  const a = document.createElement('a'); a.href = d.url; a.rel = 'noopener'; document.body.appendChild(a); a.click();   // GitHub 서명 URL — 브라우저 직접 수신(대용량 안전)
  setTimeout(() => { try { a.remove(); } catch {} }, 1500);
}
async function _dgYtGet(i) {
  const y = _dg.yt[i]; if (!y) return;
  try {
    if (y.parts && y.parts.length) {   // 1.9GB 초과 자동 분할본 — 각 편이 독립 재생되는 mp4, 합치기 불필요
      _dgYtPaint(i, y.parts.length + '편으로 나눠 받는 중 — 각 편은 그대로 재생돼요', false);
      for (let n = 0; n < y.parts.length; n++) { await _dgYtFetchOne(y.parts[n].asset); await new Promise(rs => setTimeout(rs, 1600)); }
    } else if (y.asset) {
