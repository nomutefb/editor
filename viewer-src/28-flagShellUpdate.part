function flagShellUpdate() {
  try { if (Date.now() - (+sessionStorage.getItem('nmUpdCoolT') || 0) < 90000) return; } catch {}   // 반영 직후 90s 억제(회로차단기 계승 · toast 버전과 동일)
  if (_shellUpdPending) return;   // 이미 대기 = 중복 무해(SWR 재검증 반복 흡수)
  _shellUpdPending = true; _shellUpdWhen = Date.now();
  try { renderMsgBadge(); } catch {}   // 프로필 상태·카운트 갱신
  try { const mp = $('#msgpop'); if (mp && !mp.hidden) renderMsgList(); } catch {}   // 메시지함 열려있으면 즉시 목록 반영
}
// 재점등 260802(운영자 "새버전은 보라색 토스트 하면 됨 키워드 알림 처럼" — 260724 도먼트 해제) — 메시지함 채널(flagShellUpdate)과 병행 · 셸 색 = .nm-toast.upd 보라 오버라이드(키워드 알림 축 합류) · 발화 = SW nm-shell-updated + 아래 checkNewVersion(스탬프 자기확인).
function showUpdateToast() {
  if (_shellUpdShown || _shellUpdApplying) return;   // 표시 중 1회 = 중복 postMessage·재검증 반복 무해화(✗ 누르면 해제 = 다음 배포 재알림) · 적용 중 재알림 = 무시('반영중' 문구를 '탭하면 반영'으로 되감아 죽은 탭처럼 오도하는 창 봉쇄 · 평의회 260717-2)
  try { if (Date.now() - (+sessionStorage.getItem('nmUpdCoolT') || 0) < 90000) return; } catch {}   // 반영 탭 후 90s = 재알림 억제(회로차단기 · 운영자 260717 "탭하면 반영 무한루프") — 잔여 미지 변이가 있어도 루프 절단 · 캐시는 SW put이 계속 수렴
  if (_toastC || document.querySelector('#nmToast.show, #sysFreshToast.show, #nmFailToast.show')) { clearTimeout(_shellUpdT); _shellUpdT = setTimeout(showUpdateToast, 4000); return; }   // 긴급·경보 우선 = 양보 후 재시도(단일 타이머 clear→set = 다중 메시지 재시도 체인 중첩 차단·평의회 260717)
  _shellUpdShown = true;
  let t = document.getElementById('nmUpdateToast');
  if (!t) { t = document.createElement('div'); t.id = 'nmUpdateToast'; t.className = 'nm-toast upd'; t.setAttribute('role', 'status'); t.setAttribute('aria-live', 'polite'); document.body.appendChild(t); }   // role=status·polite = 비긴급(긴급 토스트 role=alert·assertive와 분리)
  t.onclick = () => applyShellUpdate(t);   // 본체 탭 = 최신 셸 재확보 후 새로고침(중첩 N건 일괄 해소)
  t.innerHTML = '<span class="tg">' + Q_REFR + '</span><span class="ft-msg">새 버전이 있어요 · 탭하면 반영</span>'
    + '<button class="sbtn ft-act" type="button" data-bt="x" aria-label="닫기" title="닫기 — 이번 접속 동안만 숨김">' + X_TOAST_SVG + '</button>';
  t.querySelector('[data-bt="x"]').onclick = ev => { ev.stopPropagation(); if (_shellUpdApplying) return; t.classList.remove('show'); _shellUpdShown = false; };   // ✗ = 숨김 + 래치 해제 = 다음 배포(재검증) 감지 시 재알림(주석·의도 정합·평의회 260717) · 적용 중엔 무시 — 숨긴 직후 돌연 리로드되는 title 약속("이번 접속 동안만 숨김") 배신 차단(평의회 260717-8)
  requestAnimationFrame(() => t.classList.add('show'));   // 상주형(자동닫힘 없음) = 사용자가 탭할 때까지 대기(§CII 토스트 행)
}
// ── 배포 스탬프 자기확인(운영자 260802 승인 "아이디어 해주고") — SWR 통지(nm-shell-updated)는 재검증이 도는 '재진입 내비게이션'에서만 오므로,
//    화면을 열어 둔 채로는 배포가 와도 영영 모른다(260802 16:53 유령 신고 "첨부 안 됨"의 근원 = 1분 전 머지 미착화면). 열린 페이지가 스스로
//    서버의 BUILD_STAMP를 대조해 위 보라 토스트를 당긴다. 반영 탭 = applyShellUpdate(기존 정본 그대로 = SW 캐시 갱신 + reload).
