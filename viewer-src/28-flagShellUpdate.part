    + (it.thumb ? '<span class="dg-ithumb"><img src="' + escUrl(it.thumb) + '" alt="" loading="lazy" referrerpolicy="no-referrer"></span>' : '')
    + '<div class="dg-imain"><div class="dg-ittl">' + esc(it.title || '자료') + '<span class="dg-got" id="dgg' + i + '"' + (got ? '' : ' hidden') + '>받음</span></div>'
    + '<div class="dg-imeta"><span id="dgsz' + i + '">' + (_dgFmt(m.size) || (it.dl ? '용량 확인 중' : '')) + '</span>' + (it.note ? ' · ' + esc(it.note) : '') + ' <span class="dg-ytst" id="dgy' + i + '"></span></div></div>'
    + (it.stream && !it.dl ? '<button type="button" class="geni-opt" id="dgyb' + i + '" data-act="ytreq" data-i="' + i + '">저장 요청</button>' : '')
    + (it.dl ? _dgDlBtnHtml('dl', i, 'dg-dl' + (got ? ' dl-done' : '')) : '')
    + '</div>';
}
function _dgEach(fn) { (((_dg.res || {}).items) || []).forEach(fn); }
function _dgDlUrl(it) {
  if (it.via === 'direct') return it.dl;
  const nm = String(it.title || '').replace(/[\\/:*?"<>|]+/g, ' ').trim().slice(0, 120);
  return '/api/linkgrab/file?url=' + encodeURIComponent(it.dl) + (nm ? '&name=' + encodeURIComponent(nm) : '');
}
function _dgDl(i) {
  const it = ((_dg.res || {}).items || [])[i]; if (!it || !it.dl) return;
  const a = document.createElement('a');
  a.href = _dgDlUrl(it); a.rel = 'noopener';
