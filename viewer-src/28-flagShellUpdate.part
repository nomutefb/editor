  } catch (e2) { _dgYtPaint(i, '받기 실패 — ' + ((e2 && e2.message) || '오류'), false); }
}
// --- 영상 플랫폼 경로(운영자 260728 "배치파일 조건대로") — 조건 정본 = apps/vidl/vidl_run.py(로컬 Downloader.bat v7.0 이식):
//     최고화질+자막(en,ko srt·txt) / 프레임별(maxfps_) / FHD별(1080p_) · 재생목록 방지 · 파일명 TS_플랫폼_계정_제목.
//     받기 = api/dl 프록시(같은 오리진 attachment) = 항상 로컬 다운로드 폴더 · 드라이브 연결(GDRIVE_SA_JSON) 시 러너가 내 드라이브/Shared에도 업로드(= bat robocopy 축).
//     UI = 기존 #dlgrab 문법 그대로(geni-sechead/dg-item/geni-opt — 신규 클래스·색 0) · 발사 = 링크 행 픽토([받기]/[자막])(구 동의 게이트 dgConsent 폐지 = 운영자 260802).
// 영상 게시물 URL만 vidl 경로로(호스트 + 경로 이중 화이트리스트 · 평의회1·3) — 프로필·채널·탐색 페이지는 '' 반환 = 기존 스캔 폴백(사진 수집 보존).
//   서버(functions/api/vidl.js·apps/vidl/vidl_run.py)도 동일 목록으로 이중 차단 = 이 감지는 UX용, 최종 게이트는 서버.
function _dgVidPlat(u) {
  let h, path;
  try { const x = new URL(u); h = x.hostname.toLowerCase().replace(/^www\./, ''); path = x.pathname.toLowerCase(); } catch { return ''; }
  const host = (d) => h === d || h.endsWith('.' + d);
  if (host('youtu.be')) return path.length > 1 ? 'YT' : '';   // youtu.be/<id>
  if (host('youtube.com')) return (/^\/(watch|shorts\/|live\/|embed\/)/.test(path) || (path === '/watch')) ? 'YT' : '';
  if (host('instagram.com')) return /^\/(p|reel|reels|tv)\//.test(path) ? 'IG' : '';
  if (host('x.com') || host('twitter.com')) return /\/status\/\d/.test(path) ? 'X' : '';
  if (host('tiktok.com')) return (/\/(video|photo)\/\d/.test(path) || /^\/(t|v)\//.test(path) || h.startsWith('vm.') || h.startsWith('vt.')) ? 'TT' : '';
  if (host('fb.watch')) return path.length > 1 ? 'FB' : '';
  if (host('facebook.com')) return (/\/(videos|reel|watch)\//.test(path) || path === '/watch' || /\/videos\/\d/.test(path)) ? 'FB' : '';
  if (host('threads.net') || host('threads.com')) return /\/(post|t|share)\//.test(path) ? 'TH' : '';   // 공유 시트가 주는 두 형식(/share/<코드>/ · /t/<코드>)도 수용(운영자 260802 "스레드 다운로드가 안되네") — 구 정규식은 `/post/`만 맞아 공유 링크는 잠긴 채 무반응이었다(레포 큐에도 https://www.threads.com/share/… 형식이 실제로 들어와 있다) · 러너 플러그인이 share→post 정규 주소를 페이지에서 되찾는다
  return '';
}
// 화질 = **해상도×프레임 한 축 6값**(운영자 260804 3차 "묶어서 6개 선택자중 하나로 하는게 맞다고 봄 —
//   왜냐면 소스 안에 다양한 영상이 있는경우가 별로 없음"). 2칸으로 쪼개면 같은 조합에 조작이 두 번이다.
//   값 = api/vidl.js·vidl-make.yml·vidl_run.QUAL_OK 3면 동일 문자 · 'best'(하위호환)는 여기 없다 = UI 비노출.
//   라벨 = 짧은 통칭(운영자 260805 "2160p > 4K 1440p > 2K 1080p > K 이런식으로 줄여줄래?") — 칩·목록 폭이 줄어
//   제목 자리를 덜 먹는다. ⚠ **값(2160-60…)은 그대로** = 4면 배선의 전선 문자라 표시만 갈아끼운다.
const DG_QUALS = [['2160-60', '4K 60F'], ['2160-30', '4K 30F'], ['1440-60', '2K 60F'],
                  ['1440-30', '2K 30F'], ['1080-60', 'K 60F'], ['1080-30', 'K 30F']];   // 라벨 = 최단 통칭(운영자 260805 11차 "말을 더 줄임 4K 30F 이런식으로") · 값(2160-60…)은 4면 배선 문자라 불변
const DG_Q_KEY = 'dg_q_v1';
function _dgQLoad() { try { const v = localStorage.getItem(DG_Q_KEY); return (v === 'best' || DG_QUALS.some(x => x[0] === v)) ? v : DG_QUALS[0][0]; } catch { return DG_QUALS[0][0]; } }   // 'best' = 사다리 미상 2택에서 고른 값(운영자 260805 14차) — 화이트리스트 밖 값은 종전대로 최고 티어로 폴백   // 기본 = 최고 티어(2160p 60fps)
function _dgQName(q) { const h = DG_QUALS.find(x => x[0] === q); return h ? h[1] : DG_QUALS[0][1]; }
// 실측 화질 라벨(운영자 260805 "가능하지도 않은데 4k 60fps가 나오거든? 30프레임이 한계로 알고있는데") —
//   선택값(_dg.q)은 **상한**이라 영상이 그보다 낮으면 그대로 뿌리는 표기가 거짓이 된다(4K 60fps 요청 · 실물 30fps).
//   러너(vidl_run ffprobe_dims)가 받은 파일을 실측해 files[]에 실어주는 {w,h,fps}만 여기서 말로 바꾼다 —
//   실측 없음(구 결과·자막만) = '' = 지어내지 않고 「최대 …」 요청 표기로 남긴다.
//   말 = DG_QUALS 통칭 그대로(짧은 변 2160=4K · 1440=2K · 1080=K · 그 외 Np — 세로 영상은 짧은 변이 곧 통칭 축) · 새 어휘 창작 0.
function _dgTierName(s) { return s === 2160 ? '4K' : s === 1440 ? '2K' : s === 1080 ? 'K' : s + 'p'; }   // 통칭 = DG_QUALS 값 사본 · 그 외는 짧은 변 그대로(새 어휘 0)
// 화질 목록 = **그 영상에 실제로 있는 것만**(운영자 260805 4차 "그 가능한 포맷만 리스트업에 띄워달라는거임").
//   재료 = 서버 vidpeek이 실은 `fmts`([[height,fps],…] · 유튜브 innertube 실측). 없으면 종전 정적 6값 그대로(fail-soft).
//   규칙 = ⓐ 그 높이가 **실재하는 티어만** 행을 만든다(720p뿐인 영상에 4K 행을 만들지 않는다)
//         ⓑ 60fps가 있는 티어만 30/60 두 줄로 가른다 — 24fps 영상은 상한을 어느 쪽으로 걸어도 같은 파일이라
//            두 줄이 곧 거짓 어포던스다(운영자 1차 지적의 후반부 = 「영상에 맞게끔 지정 가능하게」)
//         ⓒ 라벨의 fps = **그 티어의 실제 최대 fps**(4K 24fps처럼 진짜 값) · 값(2160-60…)은 4면 배선 문자라 불변.
function _dgQOpts() {
  const fm = (_dg.peek && Array.isArray(_dg.peek.fmts)) ? _dg.peek.fmts : null;
  // 사다리를 못 얻었으면(유튜브 봇검문 등) **정적 6값을 띄우지 않는다** — 그 영상에 없는 화질이 섞인다.
  //   대신 어느 영상에서나 참인 2택만 낸다(운영자 260805 14차 "조회가 안될때는 그냥 '최고 화질'로 고정 · 저화질 하나 넣어주고").
  //   best = 러너가 그 영상의 최대를 집는다 · 1080-30 = 짧은 변 ≤1080·30fps 상한 = 우리가 표현 가능한 가장 낮은 단(값은 4면 배선 문자 그대로).
  if (!fm || !fm.length) return [['best', '최고 화질'], ['1080-30', '저화질']];
  const out = [];
  [2160, 1440, 1080].forEach(T => {
    const at = fm.filter(x => +x[0] === T);
    if (!at.length) return;
    const mx = Math.max(...at.map(x => +x[1] || 0));
    if (mx > 30) {
      out.push([T + '-60', _dgTierName(T) + ' ' + mx + 'F']);
      if (at.some(x => (+x[1] || 0) <= 30)) out.push([T + '-30', _dgTierName(T) + ' 30F']);
    } else out.push([T + '-60', _dgTierName(T) + (mx ? ' ' + mx + 'F' : '')]);
  });
  if (out.length) return out;
  const top = fm.reduce((a, b) => (+b[0] > +a[0] ? b : a));   // 티어 미만(720p 등)뿐 = 최고 1줄만(상한 K = 그 아래를 그대로 집는다)
  return [['1080-60', _dgTierName(+top[0]) + ((+top[1]) ? ' ' + Math.round(+top[1]) + 'F' : '')]];
}
