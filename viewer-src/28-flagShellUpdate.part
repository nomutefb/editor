    const res = await fetch(location.pathname, { cache: 'no-store', headers: _verEtag ? { 'If-None-Match': _verEtag } : {}, signal: (typeof AbortSignal !== 'undefined' && AbortSignal.timeout) ? AbortSignal.timeout(8000) : undefined });   // 비내비게이션 fetch = SW 불간섭 순수 네트워크(applyShellUpdate 동문법)
    if (res.status === 304) return;   // 기준 도장과 동일 = 무변화(본문 0)
    if (!(res.ok && !res.redirected && res.type === 'basic')) return;   // 가드 = sw.js ⓐ·applyShellUpdate 동일(Access 리다이렉트 오염 차단)
    _verEtag = res.headers.get('etag') || '';
    const m = new RegExp("BUILD_" + "STAMP = '([^']+)'").exec(await res.text());   // 패턴 분절 = 이 파일 자신을 읽으므로, 검사 코드 자신의 문자열이 스탬프보다 먼저 매칭되는 자기참조 오탐 차단
    const sv = m && m[1];
    if (!sv || sv === 'dev' || sv === BUILD_STAMP || sv === _verAlerted) return;   // 스탬프 = 진실 판정(ETag 변이·압축 변주는 여기서 걸러짐 = sw.js scrub와 같은 취지)
    _verAlerted = sv;
    if (autoApplyUpdate(sv)) return;        // 한가하면 그 자리 자동 반영(SW 통지 유실·SW 미등록 경로의 짝 — 한쪽만 배선하면 나머지가 조용히 종전 동작으로 남는다) · 도장(sv) 전달 = 배포별 1회 회로차단의 키
    flagShellUpdate(); showUpdateToast();   // 메시지함(조용) + 보라 토스트(운영자 260802) 동시 — 억제 로직은 각자 보유
  } catch {}   // 오프라인·타임아웃 = 다음 주기 재시도(fail-soft)
}
setTimeout(() => { checkNewVersion(true); }, 45000);   // 부팅 45s 후 1회(초기 로드·데이터 fetch 경쟁 회피)
setInterval(checkNewVersion, 600000);                  // 10분 주기 = 열어 둔 화면도 배포를 안다
document.addEventListener('visibilitychange', () => { if (!document.hidden) checkNewVersion(); });   // 폰·탭 복귀 순간 = 즉검(4분 스로틀 안에서)
// '탭하면 반영' reload 후 스크롤 복원(운영자 260717 — 시각 튜닝 시 맨위 튕김 방지) · 세션 1회성 · 콘텐츠 async 렌더라 충분히 길어질 때(또는 2.5s)까지 rAF 대기 후 복원 · 앱 재렌더 scrollY 보존 관례(12347 등) 계승
(function restoreUpdScroll() {
  let y; try { y = sessionStorage.getItem('nmUpdScrollY'); if (y != null) sessionStorage.removeItem('nmUpdScrollY'); } catch { return; }
  if (y == null) return; y = +y; if (!(y > 0)) return;
  try { if ('scrollRestoration' in history) history.scrollRestoration = 'manual'; } catch {}   // 브라우저 자동복원과 충돌 차단(내가 콘텐츠 준비 후 복원)
  const t0 = Date.now();
  const step = () => {
    const se = document.scrollingElement || document.documentElement;
    if ((se && se.scrollHeight >= y + window.innerHeight) || Date.now() - t0 > 2500) { window.scrollTo(0, y); return; }   // 콘텐츠 충분히 김 or 2.5s 타임아웃 = 복원
    requestAnimationFrame(step);
  };
