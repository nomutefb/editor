    const s = r && await r.pushManager.getSubscription(); return s ? 'on' : 'off';
  } catch { return 'off'; }
}
async function pushRefresh() {
  const row = $('#pushrow'), btn = $('#pushbtn'); if (!row || !btn) return;
  const st = await pushState();
  if (st === 'unsupported') { row.hidden = true; return; }   // iOS 미설치 등 = 숨김
  row.hidden = false;
  // ON/OFF 2-state 통일(운영자 260703): denied(차단)도 'OFF'로 표기 — 클릭 시 pushToggle이 해제 안내(차단은 거의 안 생김·항상 허용해둠). '차단됨'/앰버 폐지.
  btn.disabled = false; btn.classList.remove('denied'); btn.textContent = st === 'on' ? 'ON' : 'OFF'; btn.classList.toggle('on', st === 'on');
  if (st === 'on') { try { localStorage.setItem('nm_push_want', '1'); } catch (e) {} }   // 백필 — want 플래그 도입(260707) 전에 켠 구독은 플래그가 없어 pushHeal이 침묵 → ON으로 읽히는 순간 편입
  else if (st === 'off') pushHeal();   // OFF가 '보이는 순간' = 치유 시점(부팅 1회만으론 팝업 열 때 어긋남) — want·권한 미충족이면 pushHeal이 스스로 무시·성공 시 ON 재렌더
}
// 기기 정보 = 등록 요청이 같이 들고 가는 값(운영자 260819 "안드로이드 오에스 버전이나 브라우저라도 나온다던지").
//   서버는 요청 헤더의 브라우저 신분 문자열을 스스로 읽는다 — 여기서 보태는 건 **크롬 계열만 주는 더 정확한 값**(플랫폼 판·기기 모델)이다.
//   없는 브라우저(사파리·파이어폭스)면 null = 서버가 읽은 문자열만 남는다(그래도 안드로이드 판·브라우저는 거기 다 들어 있다).
async function nmDevHint() {
  try {
