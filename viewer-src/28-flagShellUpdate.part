  // 권한 granted면 무프롬프트로 복구되고, 권한이 회수됐으면 조용히 실패(프롬프트 남발 금지) = OFF 표시가 정직.
  if (_healBusy || Date.now() < _healCool) return _healBusy;
  _healBusy = (async () => {
    try {
      if (!pushOK()) return;
      if ((localStorage.getItem('nm_push_want') || '') !== '1') return;
      if (Notification.permission !== 'granted') return;
      const reg = await navigator.serviceWorker.register('sw.js'); await navigator.serviceWorker.ready;
      if (await reg.pushManager.getSubscription()) { _healCool = Date.now() + 3e3; await pushRefresh(); return; }   // 살아있음 = 표시만 동기화(pushState 일시 null로 OFF 그려진 경우 교정)
      const sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64ToU8(VAPID_PUB) });
      const r = await fetch('api/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'subscribe', subscription: sub.toJSON(), hint: await nmDevHint() }) });
      if (!r.ok) { await sub.unsubscribe().catch(() => {}); _healCool = Date.now() + 60e3; return; }
      _healCool = Date.now() + 3e3;
      await pushRefresh();   // ON 표시 복구
    } catch (e) { _healCool = Date.now() + 60e3; /* 조용 — 쿨다운 후 재시도 */ }
  })().finally(() => { _healBusy = null; });
  return _healBusy;
}
pushHeal();
document.addEventListener('visibilitychange', () => { if (!document.hidden) pushHeal(); });   // 앱 전환 복귀 = 백그라운드 새 SW 활성·구독 로테이션 직후일 수 있음 → 재점검

// 프로필 메뉴
const pmenu = $('#pmenu');
const msgpop = $('#msgpop');
// 프로필 메뉴 = 다른 부분 활성화 시 popOut(촤르륵)으로 닫힘 — hidden 즉시 대신 애니 후 hidden(reduced-motion이면 즉시).
let pmTimer = null;
function showPmenu(){ clearTimeout(pmTimer); pmenu.classList.remove('closing'); ['position','left','right','top','bottom','maxHeight','overflowY','transformOrigin'].forEach(p => { pmenu.style[p] = ''; }); pmenu.hidden = false; loadPubBadge(); $('#profile').classList.add('on'); }   // 메뉴 열림 = 기어 강조색 on-state(vh-fbtn.on 패턴 계승 · 260706) · 인라인 위치 리셋 = 링크 메뉴 경유(fixed 하단 앵커) 잔상이 헤더 앵커 오픈에 안 새게(운영자 260706 튀어나감 버그 수리 짝가드)
function hidePmenu(){
  $('#profile').classList.remove('on');   // 기어 on-state 해제(어느 닫힘 경로든)
  if (pmenu.hidden || pmenu.classList.contains('closing')) return;
  if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) { pmenu.hidden = true; return; }
  pmenu.classList.add('closing'); clearTimeout(pmTimer);
  pmTimer = setTimeout(() => { pmenu.hidden = true; pmenu.classList.remove('closing'); }, 190);   // .18s 애니 + 버퍼
}
// 오버레이 상호배타 — 하나 열 때 나머지(프로필·메시지·제작도구·링크·검색) 닫기(겹침 방지)
function closeOverlays(keep) {
  if (keep !== 'pmenu') hidePmenu();
  if (keep !== 'msg') msgpop.hidden = true;
  if (keep !== 'lockpop') { const _lp = $('#lockpop'); if (_lp) _lp.hidden = true; }
  if (keep !== 'marqpop') { const _mp = $('#marqpop'); if (_mp) _mp.hidden = true; }
  if (keep !== 'bpop') { bpop.hidden = true; bpop.classList.remove('open'); const _tf = $('#toolfab'); if (_tf) _tf.classList.remove('open'); }   // 라디얼 닫힘 = .open 제거(다음 열림 애니 복원) + FAB ×→+ 복귀
  if (keep !== 'linkpop') linkpop.hidden = true;
  if (keep !== 'kwpop') { const _kp = $('#kwpop'); if (_kp) _kp.hidden = true; }   // 키워드 알림 대기열도 화면전환 시 정리(linkpop 형제)
  if (keep !== 'mmpop') { const _mm = $('#mmpop'); if (_mm) _mm.hidden = true; }   // 메모함도 동일(kwpop 형제)
  if (keep !== 'devpop') { const _dv = $('#devpop'); if (_dv) _dv.hidden = true; }   // 구독 기기함도 동일(kwpop 형제)
  if (keep !== 'qpop') closeQueueUser();
  if (keep !== 'pubpop') closePubUser();
  if (keep !== 'search') closeSearch();
  if (keep !== 'filterpop') closeFilterPop(true);   // 필터 오버레이 = 프로필 팝업 등과 상호배타(전환=즉시 닫힘·촤르륵 생략 · 운영자 260627·260629)
  if (keep !== 'merge' && MERGE_MODE) exitMerge();   // 병합모드도 정리(다른 화면전환 시 잔존·z누수 차단·분신술4) — exitMerge가 pushState 칸도 회수
  closeFailMenu();   // Failed 칩 컨텍스트 메뉴도 같이 닫음(겹침 방지 — 자기 자신은 직후 다시 표시)
}
let _menuToMsg = null;
let _msgFromMenu = false;   // 메시지함이 설정메뉴(linkpop) 안 버튼으로 열렸는지 — X로 닫을 때 상위 linkpop 복원 여부(딥링크 진입은 false = 복원 안 함 · 운영자 260710 "세부 닫히면 전단계 메뉴 떠야")
$('#profile').addEventListener('click', e => {
  e.stopPropagation();
  // 설정 톱니바퀴(운영자 260710 재활성) = 설정 메뉴(linkpop) 헤더 아래 우측 촤르륵 · pmenu(도먼트)→linkpop 전환 · 채널·필터·메시지·발행본·기본값 한 메뉴
  const willOpen = linkpop.hidden;
  closeOverlays('linkpop'); clearTimeout(_menuToMsg);
  if (willOpen) { linkpop.hidden = false; placeHeadPop(linkpop, $('#profile')); pushRefresh(); }
  else linkpop.hidden = true;
});
document.addEventListener('click', e => {
  if (!msgpop.hidden && !msgpop.contains(e.target) && !$('#profile').contains(e.target)) msgpop.hidden = true;
});
// 프로필 메뉴는 캡처단계로 닫음 — 다른 부분이 stopPropagation 해도 촤르륵 닫힘 보장(바깥 어디든 탭하면).
document.addEventListener('click', e => {
  if (pmenu.hidden || pmenu.classList.contains('closing')) return;
  if (pmenu.contains(e.target) || $('#profile').contains(e.target)) return;
  if ($('#pindlg') && $('#pindlg').open) return;   // PIN 모달(#pindlg) 입력 중이면 메뉴 유지 — 입력칸 탭(모달 안=pmenu 밖)에 메뉴가 닫혀 설정 완료 후 토글 갱신이 안 보이던 것 차단(lockpop/pubpop 동일 관용구 · 평의회5 260705)
  hidePmenu();
}, true);
// 스크롤·휠 등 다른 액션 활성화 = 프로필(·메시지) 메뉴 자동 닫힘(운영자 260621: 켜진 채 스크롤하면 거슬림). 메뉴 항목 탭은 페이지 스크롤 아님 → 안 닫힘.
// ⚠ 창 **자기 안쪽** 스크롤은 '다른 액션'이 아니다 — 알림 상세 전문(.msgdetail = max-height 5*51 스크롤 영역)·목록(.qlist 5행 캡)을 굴리면 wheel이 버블링으로 window까지 올라와 그 자리에서 창이 닫혔다(운영자 260814 "메세지 세부 스크롤이 안돌아 · 스크롤 하는 순간 창이 꺼져버림" · 실측 260814 = 전문 1788px/창 255px인데 휠 1틱에 hidden=true·scrollTop 0 = 내용을 한 줄도 못 읽는다 · 목록도 동일 · 터치는 element scroll이 window로 안 올라가 종전에도 정상이었다 = **PC 휠 전용 사각**).
//   판정 = 발원 요소가 그 팝업 안이면 그 팝업만 유지(다른 팝업은 종전대로 닫힘) · 페이지 스크롤은 e.target이 document(nodeType 9) → 후보 제외 = 260621 계약 100% 보존.
['scroll', 'wheel'].forEach(ev => window.addEventListener(ev, e => {
  const t = (e && e.target && e.target.nodeType === 1) ? e.target : null;   // 요소 발원만 후보 — document·window 발원 = 페이지 스크롤 = 종전대로 닫는다
  const inPop = el => !!(t && el && el.contains(t));
  if (!pmenu.hidden && !pmenu.classList.contains('closing') && !inPop(pmenu)) hidePmenu();
  if (!msgpop.hidden && !inPop(msgpop)) msgpop.hidden = true;
  closeFilterPop();   // 스크롤하면 필터 오버레이도 닫힘(pmenu·msgpop과 동일 · 운영자 260627)
}, { passive: true }));
$('#refresh').addEventListener('click', () => { hidePmenu(); load(); loadMessages(); loadCandidates(); loadPickFails(); loadHealth(true); });
$('#topRefresh').addEventListener('click', () => { setTimeout(hardReload, 420); });   // 강제 하드 새로고침(코드+데이터 · SW 셸 캐시 우회 = 진짜 최신 셸 · 탭은 localStorage 복원). 위임 ic-spin(누름 회전)이 한 바퀴 보이고 리로드 — 즉시 reload면 스핀이 안 보임(운영자 260629·260619 · 260713 hardReload=nosw 우회로 강제화).
// (🚨 긴급 확인 버튼 핸들러 폐지 — 운영자 260620: 프로필 긴급 점등·확인 루틴 제거. 토스트 재알림 de-dup은 수집함 진입(showTab scrap)으로 이전.)
// 메시지·발행본·잠금 팝업 위치 = 링크 메뉴(#linkfab) 위 앵커(운영자 260707 "열린 메뉴 가까이" — 진입로가 linkpop으로 이관됐는데 앵커만 구 프로필에 남아 딴 데서 뜨던 것 교정)
function vhAnchor() { const p = $('#profile'); return (p && p.getClientRects().length) ? p : $('#searchToggle'); }   // 구 프로필 앵커 = linkfab 부재 시 최후 폴백으로만 잔존(기어 도먼트 260706 3차)
function placePopNearMenu(pop) {   // 설정 안 팝업(메시지·발행본·잠금·전광판) = 설정 톱니(#profile) 아래 우변 촤르륵(운영자 260710 요구5 "검색 외 모든 창 우측 상단 모서리가 픽토에 고정" · 구 linkfab 하단 앵커 폐지) · ⚠️ 호출 전 pop.hidden 해제 필수(폭 측정)
  pop.classList.remove('anch-b');   // 구 bottom 앵커(msgUnfoldUp) 해제 → head-pop = top 앵커(msgUnfold 우상단 원점)
  placeHeadPop(pop, $('#profile') || $('#queueBtn') || $('#searchToggle'));
}
function placeMsgpop() { placePopNearMenu(msgpop); }
['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, () => { if (!msgpop.hidden) placeMsgpop(); }, { passive: true }));
['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, () => { if (!qpop.hidden && !qpop.classList.contains('closing')) placeQpop(); }, { passive: true }));   // 대기열도 창 크기 바뀌면 재배치(PC 버튼 위 앵커·좌우 클램프 유지 = 창 좁혀도 안 짤림 · 운영자 260705)
$('#msgbtn').addEventListener('click', e => { e.stopPropagation(); _msgFromMenu = true; openMsgbox(); });   // 설정메뉴 안 버튼 진입 = X 닫힘 시 linkpop 복원 대상
const _accBtnEl = $('#accBtn'); if (_accBtnEl) _accBtnEl.addEventListener('click', e => { e.stopPropagation(); openSnsAcc(); });   // SNS 구독 계정(운영자 260713 헤더→설정 이관) · linkpop 안 버튼 = msgbtn/pubBtn 패턴(stopPropagation) · 모달(snsaccdlg) top-layer로 위에

// ── 설정 ▸ 다운로드(#dlgrab · 링크 자료수집) — 이식 원본 = muteno/yeulmaru-promo lg-* 블록(운영자 260721 이식 패키지 §3 유닛 A) ──
//  URL 붙여넣기 → /api/linkgrab 전수 스캔 → 종류별 섹션(사진 1:1 그리드 · 영상 · 문서 · 음성 · 압축 · 기타) → 골라서 [선택 받기].
//  노뮤트 커스터마이징(§5·§6): esc()/escUrl 계승 · 같은 오리진 무헤더 fetch(인증 = CF Access 엣지 · X-App-Password 폐지) · UI = #genidlg 문법
//  (geni-lead/geni-body/geni-sechead/geni-opt/geni-sum/geni-hist* · 이모지 섹션머리 → 소머리) · 체크 픽토 = nm-svg CHECK 경로(문자 ✓ 금지)
//  · 받음 표시·입력 기록 = 기기 로컬(원본 설계 유지 = 서버/깃 무저장 · 기록 = 최근 1건 12시간 휘발) · 프록시 저장 = 같은 오리진 attachment(블롭 불요).
//  ⚠ 동의 체크(dgConsent) 폐지 = 운영자 260802 명시 지시("나머지 부가적 설명 및 동의 … 다 없애주셈") — 구 260721 "동의 체크 제거 금지"를 오늘 지시가 개정한다.
//   진입 = 링크 행 픽토 2개([받기]=영상+자막 · [자막]=자막만) 즉시 발사 · 부가 산문·예시 placeholder·동의 줄 전부 제거(리드백은 점등/디밍 한 축).
const DG_GOT_KEY = 'dg_got_v1';   // 받음(URL 키 · 최대 500)
//  ⚠ 구 '기록' 접이(DG_HIST_KEY = 최근 입력 주소 1건) 폐지 = 운영자 260802 "기록, 받은영상 이 2개가 뭔 차이인지 모르겠고"
//    + "이미지 스튜디오에 있는 제작 중인거랑 이전 제작물을 그대로 따라하게" — 이미지 스튜디오에 없는 축이라 접이 2개 중 하나가 통째로 잉여였다.
//    주소 되찾기는 「이전 받기」 행이 이미 URL을 들고 있으므로 기능 손실 0. 남은 키는 창 열 때 1회 청소.
const DG_SECTIONS = [['img', '사진'], ['video', '영상'], ['doc', '문서'], ['audio', '음성'], ['zip', '압축'], ['link', '기타 링크']];
let _dg = { busy: false, res: null, err: '', lastUrl: '', sel: {}, meta: {}, got: {}, jobs: [], resOpen: true, vdOpen: false, yt: {}, peek: null };
//  jobs = 받기 잡 **배열**(최신이 앞) = 이미지 스튜디오 JOBS 모델 계승(운영자 260802 "한번 링크 입력하면 다음거를 입력을 못해 …
//    큐잉 시킬수가 없음"). 구 설계는 슬롯 1개(_dg.vid)라 ⓐ 받는 중엔 다운로드 버튼이 하드 잠기고 ⓑ 새 주소를 넣으면
//    앞 건이 통째로 교체될 판이라, 두 번째 주소를 넣을 길이 아예 없었다. 이제 잡마다 독립 폴 = 동시 N건.
let _dgJobSeq = 0;   // 잡 표시 번호(#1, #2…) = thumb job.n 계승 · 창 세션 안에서만 증가
let _dgPop = false;   // 폰 뒤로가기로 닫혔는지(§🎨 pushState/popstate · tooldlg toolPopHandled 패턴 계승)
function _dgLoadGot() { try { return JSON.parse(localStorage.getItem(DG_GOT_KEY) || '{}') || {}; } catch { return {}; } }
function openDlGrab() {
  _dg = { busy: false, res: null, err: '', lastUrl: '', sel: {}, meta: {}, got: _dgLoadGot(), jobs: [], resOpen: true, vdOpen: false, yt: {}, peek: null, q: _dgQLoad() };   // q = 화질 상한(운영자 260804) — 기기 보존(매번 다시 고르지 않게 · got·보관함과 같은 축)   // 스캔 결과는 매번 새로(공용 PC 원칙) · 받음/보관함만 기기 보존
  try { localStorage.removeItem('dg_hist_v1'); } catch {}   // 폐지된 '기록' 축 잔여 청소(1회성)
  const d = $('#dlgrab'); const inp = $('#dgUrl'); if (inp) inp.value = '';
  _dgSubs = null; _dgProbeSeq++;   // 창을 새로 열면 자막 리드백도 초기화(옛 프로브 응답 폐기)
  _dgVidLoadJob().forEach(j => { _dg.jobs.push({ url: j.url, plat: j.plat, id: j.id, mode: j.mode, q: j.q, t0: j.t0, n: ++_dgJobSeq, st: 'run', msg: '받는 중' }); });   // 진행 중 받기 = 창 닫았다 다시 열어도 전건 복원(평의회2·8 · 이제 복수)
  _dgPaintPic();
  _dgRenderBody();
  if (!d.open) { d.showModal(); try { history.pushState({ dlgrab: true }, ''); } catch {} }
  _dg.jobs.forEach(v => { if (v.st === 'run') _dgVidPoll(v); });   // 복원 폴 재개(모달 open 후)
}
function _dgKey(it) { return String(it.dl || it.url || ''); }
// 「받기 폴이 살아 있어야 하는 상태」 = 창이 열려 있거나 **최소화돼 ▲에 걸려 있을 때**(운영자 260803 아이디어 승인 "그거는 진행 ㄱ").
//   왜: 최소화는 '접어둔 채 기다린다'는 뜻인데 구 가드(`.open`)는 접는 순간 폴을 끊어, ▲에 진행을 띄워도 숫자가 얼어붙는다.
//   백그라운드 상주는 여전히 아니다 — 창을 **완전히 닫으면**(X·ESC) MIN_REG에도 없으니 종전대로 멈춘다(재열람 시 localStorage 복원).
function _dgAlive() { const d = $('#dlgrab'); return !!(d && d.open) || MIN_REG.has('dlgrab'); }
function _dgRunN() { return (_dg.jobs || []).filter(v => v.st === 'run').length; }   // 진행 중 받기 건수(▲ 배지·picker 라벨 공용)
function _dgFmt(b) { b = Number(b) || 0; if (!b) return ''; if (b < 1024) return b + 'B'; if (b < 1048576) return (b / 1024).toFixed(b < 10240 ? 1 : 0) + 'KB'; if (b < 1073741824) return (b / 1048576).toFixed(1) + 'MB'; return (b / 1073741824).toFixed(2) + 'GB'; }
// ── 본문 = 이미지 스튜디오 결과 판 **그대로**(운영자 260802 "이미지 스튜디오를 거의 따라서 가져온다고 생각하고") ──
//   위 = 「• 결과 (N)」 접이(강조색·기본 펼침) 안에 **제작 중 잡 카드**(.jobs > .job) → 완료 카드 → 페이지 스캔 결과
//   아래 = 「• 이전 받기 (N)」 접이(.prev 이력색·기본 접힘)
//   ⚠ 순서 = 운영자 260802 "영상 받는중 이게 받은 기록보다는 위에 가있어야함(제작중 뜨는거)" — 구 배치는
//     [기록][받은 영상][받는 중] 이라 **진행 중이 맨 밑**이었다(정확히 반대). 이미지 스튜디오는 결과·진행이 위, 이전 제작이 아래.
function _dgRenderBody() {
  try { _dgQClose(); } catch (_) {}   // 재렌더 = 화질 목록의 앵커(칩)가 교체되므로 먼저 걷는다(고아 팝업 차단)
  try { if (MIN_REG.has('dlgrab')) minRegRefresh(); } catch (_) {}   // 접어둔 상태에서 받기가 늘거나 끝나면 ▲ 배지도 같이 움직인다(발사·완료·실패가 전부 이 렌더를 지난다 = 갱신 지점 단일)
  const body = $('#dgBody'); if (!body) return;
  const jobs = _dg.jobs, r = _dg.res;
  const n = jobs.length + (r ? 1 : 0);
  let inner = '';   // 상단 안내 산문 폐지(운영자 260802) — 리드백은 링크 행 버튼 점등/디밍 한 축이 전담
  if (_dg.err) inner += '<div class="dg-err">' + esc(_dg.err) + '</div>';
  inner += _dgPeekHtml();   // 「받을 내용」 = 판 맨 위(= 지금 손에 든 주소가 무엇인지) · 그 아래가 받는 중·받은 것
  if (jobs.length) inner += '<div class="jobs">' + jobs.map((v, i) => _dgJobHtml(v, i)).join('') + '</div>';   // 제작 중·완료 잡 카드 = nm-job.css 공동 정본(이미지 스튜디오와 같은 부품)
  if (r) {
    const items = r.items || [];
    inner += '<div class="geni-sechead"><span class="cref-lbl">' + esc(r.title || '결과') + ' <span class="dg-cnt">— 자료 ' + items.length + '건</span></span></div>';
    if (!items.length) inner += '<div class="geni-histempty">이 페이지에서 내려받을 자료를 찾지 못했어요</div>';
    DG_SECTIONS.forEach(sec => {
      const kind = sec[0], label = sec[1];
      const idxs = []; items.forEach((it, i) => { if ((it.kind || 'link') === kind) idxs.push(i); });
      if (!idxs.length) return;
      const dlable = idxs.filter(i => items[i].dl);
      inner += '<div class="geni-sechead"><span class="cref-lbl">' + label + ' <span class="dg-cnt">' + idxs.length + '</span></span>' + (dlable.length > 1 ? _dgAllBtnHtml('secall', ' data-k="' + kind + '"', label + ' 전체 다운로드') : '') + '</div>';   // 구 권리 동의 줄(dgConsent) 폐지 = 운영자 260802 · 구 '모두 선택' 워드칩 → [전체] 다운로드(카드피드 정본) = 운영자 260802 "거기 보면 전체 다운 있는데 그 다운 버튼 활용하고"
      if (kind === 'img') {
        inner += '<div class="dg-grid">';
        idxs.forEach(i => { inner += _dgCardHtml(items[i], i); });
        inner += '</div>';
      } else {
        idxs.forEach(i => { inner += _dgRowHtml(items[i], i); });
      }
    });
  }
  if (!n && !_dg.err && !_dg.peek) inner += '<div class="geni-histempty">아직 받은 게 없습니다</div>';   // 미리보기가 떠 있으면 생략 — 받을 게 눈앞에 있는데 「없습니다」는 서로 어긋난다(빈 상태 = 정말 빈 판일 때만)   // 빈 상태 문구 = 이미지 스튜디오 결과 빈 상태(#carEmpty '아직 제작한 게 없습니다') 미러
  let h = '<div class="geni-histwrap"><button class="geni-histfold" type="button" data-act="resfold" aria-expanded="' + (_dg.resOpen ? 'true' : 'false') + '" aria-controls="dgResBody"><span class="geni-histttl"><span class="geni-histbul" aria-hidden="true">•</span>결과 <span class="geni-histcnt">(' + n + ')</span></span><span class="geni-histchev" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></button>'
    + '<div class="geni-histbody' + (_dg.resOpen ? ' open' : '') + '" id="dgResBody"' + (_dg.resOpen ? '' : ' inert') + '><div class="geni-histbody-in">' + inner + '</div></div></div>';
  h += _dgDoneHtml();   // 「이전 받기」 = 맨 아래(이미지 스튜디오 '이전 제작'과 같은 자리 · 운영자 260802)
  body.innerHTML = h;
  // 미리보기 액자 영상 = 탭 재생/일시정지(vd.html 정본 배선 그대로 · 무컨트롤이라 이 한 줄이 유일한 재생 수단)
  body.querySelectorAll('.dg-card > video').forEach(v => {
    const pb = v.parentNode.querySelector('.monplay');
    v.onclick = () => { if (v.paused) v.play(); else v.pause(); };
    if (pb) { v.onplay = () => { pb.hidden = true; }; v.onpause = () => { pb.hidden = false; }; }
  });
  _dgPeekMeasure(body);   // 치수 미상 항목 = **화면에 뜬 실물에서 재서** 채운다(전 플랫폼 통일 · 운영자 260805 8차)
  if (r) _dgMetaScan();
}
// 받기 잡 카드 = 이미지 스튜디오 제작 잡 행(thumb renderJob) 마크업 100% 미러 — 부품·클래스·자리 전부 nm-job.css 공동 정본.
//   [jlab 「플랫폼 · 받을 것 #N」] [jst 우측 상태(orb/✓/⚠ + 경과·소요)] / [jgrid: jvars 파일 [i] 이름 ⬇ | jsave-row ⬇전체] / 진행 중 = .jdel 취소 X
// 받은 파일 라벨 = 이미지 스튜디오 변형 라벨(「흰칸」·「기본」)과 같은 **짧은 말**(운영자 260804 "양식을 첨부2처럼").
//   왜 파일명을 안 쓰나: X 게시물은 {영상.mp4 · 자막.srt · 자막.txt}가 접두 100자를 공유하고 **확장자만** 다르다
//   → 행에 파일명을 깔면 [1][2][3]이 눈으로 구분이 안 된다(260804 실측 스샷 = 세 줄이 같은 글자로 보임).
//   구분이 필요한 축은 「이게 무엇인가」지 「파일명이 무엇인가」가 아니다 — 파일명·크기는 title로 간다.
function _dgFileLabel(f, imgN) {
  const n = String((f && f.name) || ''), low = n.toLowerCase();
  const ext = (low.match(/\.([a-z0-9]+)$/) || ['', ''])[1];
  const stt = low.indexOf('.stt.') >= 0;   // 받아쓰기 폴백 산출(vidl_run stt_fallback) = 플랫폼 자막과 구분해 말한다
  if (f && f.kind === 'img') return '사진' + (imgN > 0 ? ' ' + imgN : '');
  if (/_본문[_.]/.test(n)) return '본문';
  if (ext === 'srt' || ext === 'vtt') return stt ? '받아쓰기 자막' : '자막';
  if (ext === 'txt') return (stt ? '받아쓰기 자막' : '자막') + ' (txt)';
  if (f && f.kind === 'video') {
    if (n.indexOf('_maxfps_') >= 0) return '영상 · 프레임별';   // ②판 표식(vidl_run name_tag) — 어느 판인지가 이 화면의 구분점
    if (n.indexOf('_1080p_') >= 0) return '영상 · FHD판';      // ③판 표식
    return '영상';
  }
  return ext ? ext.toUpperCase() : '파일';
}
function _dgJobHtml(v, i) {
  const fs = (v.res && v.res.files) || [];
  const sec = Math.max(0, Math.round((Date.now() - (v.t0 || Date.now())) / 1000));
  const modeLbl = ({ subs: '자막', video: '영상', both: '영상+자막' })[v.mode] || '영상+자막';
  // 화질 자리 = 완료면 **실측**(러너 ffprobe · 예 「4K 24fps」) · 아니면 「최대 <선택값>」 — 선택값은 상한이라
  //   그대로 말하면 거짓이 된다(운영자 260805 "가능하지도 않은데 4k 60fps가 나오거든"). 실측 없는 구 완료분은 요청 표기 유지.
  //   ⚠ 완료면 **실측만**(없으면 빈칸) — 구판은 실측이 없을 때 요청 표기로 되돌아갔고, 그 경로엔 구 결과뿐 아니라
  //     **영상 0건 완료**(인스타·X·틱톡 사진 게시물 = 러너가 img를 성공으로 인정)가 들어와 「최대 4K 60fps」라고 말했다(평의회2 실측).
  const qLbl = v.st === 'done' ? _dgResActual(v.res) : (v.q === 'best' ? '최고 화질' : v.q ? '최대 ' + _dgQName(v.q) : '');   // best(스레드) = 「최고 화질」 — _dgQName의 4K 60fps 폴백을 타면 그게 또 거짓 표기가 된다
  let ic, tx, shim = '';   // shim = 받는 중만 글자 위 빛 스윕(`.nm-shim` 도료 SSOT = nm-loader.js) — 이미지 스튜디오 잡 행(thumb renderJob)과 **한 벌**로 간다(같은 nm-job.css 부품인데 한쪽만 빛나면 조용히 갈린다 · 운영자 260809)
  if (v.st === 'fail') { ic = WARN_SVG; tx = '실패' + (v.msg ? ' · ' + esc(String(v.msg).slice(0, 60)) : ''); }
  else if (v.st === 'done') { ic = CHECK_SVG; tx = '완료 · ' + fs.length + '건' + (v.sec ? ' (' + _dgSecTxt(v.sec) + ')' : ''); }   // 「✓ 완료 · N장 (32s)」 정본 문법 · 단위만 이 화면 것(장→건)
  else { ic = window.nmOrbHTML ? nmOrbHTML('solving', 14) : ''; tx = '받는 중 <b class="jsec">' + _dgSecTxt(sec) + '</b>' + (window.nmEta ? ' · ' + nmEta.label(_dgEtaKey(v)).trim() : ''); shim = ' class="nm-shim"'; }   // 경과 = 흰색 .jsec(운영자 260728 정본) · 예상 = nmEta → 진행 중이므로 빛 스윕(도료가 색을 대체 = thumb 잡 행과 한 벌)
  let h = '<div class="job' + (v.st === 'done' ? ' done' : '') + (v.st === 'fail' ? ' err' : '') + '" id="dgjob' + i + '">'
    + '<span class="jlab">' + esc(_dgVidPlatName(v.plat) || '링크') + ' · ' + modeLbl + (qLbl ? ' · ' + esc(qLbl) : '') + ' #' + (v.n || (i + 1)) + '</span>'
    + '<span class="jst">' + ic + '<span' + shim + '>' + tx + '</span></span>';   // shim = 받는 중만 빛 스윕(상수 문자열 = 주입 여지 0)
  // (받는 중 취소 X = 운영자 260802 미채택 — 러너를 실제로 멈추는 API가 없어 「이 화면의 추적만 끊는」 반쪽 취소였다.
  //  버튼이 없어도 40분 폴 상한이 스스로 실패로 닫고, 창을 닫으면 폴은 멈춘 채 잡만 보존된다 = 갇히는 상태 없음.)
  if (v.st === 'fail') h += '<button type="button" class="geni-opt" data-act="vidgo" data-i="' + i + '">다시 시도</button>';
  if (v.st === 'done' && fs.length) {
    let _imgN = 0;
    h += '<div class="jgrid"><div class="jvars">'
      + fs.map((f, k) => {
        const got = !!_dg.got[f.url];
        if (f.kind === 'img') _imgN++;
        const lab = _dgFileLabel(f, _imgN);
        const tip = f.name + (f.size ? ' · ' + _dgFmt(f.size) : '');   // 풀 파일명·크기 = 툴팁으로 보존(행에서 뺀 정보를 버리지 않는다)
        // 변형 행 = 이미지 스튜디오 정본 100% 사본: `.jvar.on` + 점선 밑줄 라벨(클릭) + 픽토온리 ⬇.
        // ⚠ `.on`은 **어포던스**다(cursor:pointer + 점선 = "눌리는 자리") → 라벨에도 같은 다운로드를 물린다
        //   = 거짓 어포던스 0(정본은 라벨 클릭 = 그 변형으로 점프 · 여기선 그 파일 받기 = 이 화면의 유일한 동작).
        return '<span class="jvar on"><span class="jvar-tx" data-act="vidget" data-j="' + i + '" data-i="' + k + '" title="' + esc(tip) + '">[' + (k + 1) + '] ' + esc(lab) + '</span>'
          + '<button type="button" class="jvar-dl dlbtn' + (got ? ' dl-done' : '') + '" data-act="vidget" data-j="' + i + '" data-i="' + k + '" title="' + esc(tip) + '" aria-label="' + esc(lab) + ' 다운로드">' + DOWNLOAD_SVG + '</button></span>';   // 개별 다운로드 = 이미지 스튜디오 변형 행 ⬇(.jvar-dl.dlbtn 픽토온리·골드레몬) 그대로
      }).join('')
      + '</div>' + (fs.length > 1 ? '<div class="jsave-row">' + _dgAllBtnHtml('vidall', ' data-j="' + i + '"', '받은 파일 ' + fs.length + '건 전체 다운로드') + '</div>' : '') + '</div>';   // 전체 다운로드 = 같은 카드 우측 .jsave-row(정본 자리)
    const dr0 = (v.res && v.res.drive) || {};
    if (!(dr0.on && dr0.n) || (v.res && v.res.up_err)) h += '<div class="dg-err" style="flex-basis:100%">' + esc(_dgDriveWhy(dr0.why)) + ((v.res && v.res.up_err) ? ' · 업로드 실패 ' + v.res.up_err + '건' : '') + '</div>';   // 실패만 말한다(정상 = 무언 · 산문 안내 폐지 260802)
    const st0 = (v.res && v.res.stt) || {};
    if (st0.why && !st0.on) h += '<div class="dg-err" style="flex-basis:100%">' + esc('받아쓰기: ' + st0.why) + '</div>';   /* ⚠ (260816) 받아쓰기 폴백 실패 사유 표기 — 러너 `apps/vidl/vidl_run.py` 가 사유 **8종**(348·352·354·364·370·376·384·386행 = 「영상 없음」·「길이 판독 실패」·「영상 N분 — 받아쓰기는 10분 이하만」{상한 = `STT_MAX_DUR` 600초}·「시간 예산 부족」·「오디오 추출 실패」·「받아쓰기 실패(음성 인식 불가)」·「받아쓰기 시간 초과」·일반 예외)를 `result.json` 의 `stt` 로 쓰고 그 파일 헤더(17행)가 **「사유는 result.json "stt"로 정직 표기」라고 선언까지 하는데**, 화면은 그 키를 한 곳에서도 안 읽고 있었다(실측 = viewer 전수 grep 0건). 그래서 자막·영상+자막으로 받았는데 플랫폼 자막이 없고 받아쓰기까지 죽으면 화면은 「완료 · N건」만 말했다 = **자막이 왜 없는지가 어디에도 안 뜬다**(같은 축 = 영상 편집 `xtr_note` 260816 봉합). 부품 창작 0 = 바로 윗줄 드라이브 실패 문법·`.dg-err` 그대로. ⚠ 술어 `!st0.on` 이 실효 조건 = 성공분도 `why` 를 채운다(382행 「자막 0개 → Whisper large-v3 받아쓰기 N조각」) → 그것까지 띄우면 정상 회차마다 붉은 줄이 떠서 윗줄의 「실패만 말한다(정상 = 무언)」 계약을 깬다. ⚠⚠ **지금 이 줄이 실제로 뜨는 경우는 드물다(260816 적대검증 실측 · 정직 기록)** — 현 화면의 유일한 발사 경로가 「영상만」 고정이고(10111행) 「영상+자막」 워드칩은 260805에 마크업에서 빠졌다(`data-act="vidsubs"` 실측 0건 · 10214행 핸들러는 죽은 잔재) → 러너가 자막 모드가 아니면 사유를 아예 안 채운다. 그래서 이 표기가 살아 있는 창구는 ⓐ 옛 「영상+자막」 결과를 「이전 받기」·알림 딥링크로 다시 열 때 ⓑ 저장소에서 손으로 발사할 때(기본값이 자막 동반) ⓒ 자막 모드가 되살아날 때 셋뿐이다. **그래도 지운다면 그 셋에서 다시 무증상이 되므로 남긴다** — 이 줄의 값은 「지금 자주 뜨는가」가 아니라 「사유가 있는데 화면이 안 읽는 상태로 되돌아가지 않는가」다. */
  }
  return h + '</div>';
}
// [전체] 다운로드 버튼 = 카드피드 전체저장(.sbtn.cref-dlall.dlbtn + DLSEQ_IC + '전체') 정본 사본 — 마크업·색·모션 재설계 0.
function _dgAllBtnHtml(act, extra, label) {
  return '<button type="button" class="sbtn cref-dlall dlbtn dg-dlall" data-act="' + act + '"' + (extra || '') + ' title="' + esc(label || '전체 다운로드') + '" aria-label="' + esc(label || '전체 다운로드') + '">' + DLSEQ_IC + '<span class="cref-dllbl">전체</span></button>';
}
// 개별 다운로드 버튼 = 전 앱 다운로드 표준(.sbtn.dlbtn + DOWNLOAD_SVG) — 뉴스 요약 카드피드 개별 저장과 동일 부품.
function _dgDlBtnHtml(act, i, cls) {
  return '<button type="button" class="sbtn dlbtn ' + (cls || '') + '" data-act="' + act + '" data-i="' + i + '" title="다운로드" aria-label="다운로드">' + DOWNLOAD_SVG + '</button>';
}
// 사진 카드 — 1:1 박스 · 우상단 2줄(해상도/용량 · var(--bg) 플레이트) · 좌하단 받음 배지 · 우하단 ⬇ 다운로드.
