  // 260727 실측(같은 원본·복제 모드): GPT Image = 채도 +29% 과포화(되돌림 ×0.775 = -22%) · 명도 -3%(노이즈 수준 = 0)
  //                                   Gemini    = 채도 -1% · 명도 +2% (둘 다 노이즈 수준 = 0)
  return (_geniSel.engine === 'gpt' && _geniSel.refMode === 'clone') ? { sat: -20, bri: 0 } : { sat: 0, bri: 0 };
