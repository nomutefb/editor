    ] : [   // 나열 순서 = 본문 행 상대 순서 유지(개요{비율} → 표현{화풍·세부·한국웹툰화·문구}) — 모델 = 위 #geniEngRail(픽토 자리) · 카메라·해상도·개수·품질·무드 = 요약 비표기(운영자 260721 · 본문 행·발사 파라미터·카메라 배지 #geniCamN은 불변)
      gsPair('비율', geniAspect() || 'N:N?', true, 'aspect', '탭=다음 비율'),
      gsPair('화풍', geniStyleKo(_geniSel.style), true, 'style', '탭=다음 화풍'),
      gsPair('세부 화풍', geniSubKo(_geniSel.sub), true, 'sub', '탭=다음 세부 화풍'),
      gsSelf('한국웹툰화', !!_geniSel.kweb, 'kweb'),
      gsSelf('문구', !!_geniSel.textOn, 'textOn')
    ]).join('<span class="gs-sep" aria-hidden="true">/</span>');   // 구분자 = 편집 스트립 .gs-sep 정본(운영자 260719 스트립 통일 — 간격은 클래스 margin이 전담)
    // 점등 규칙(운영자 260728 "선택된 옵션은 모두 강조색") = **값을 고르는 항목은 항상 점등**(모델·비율·화풍·세부 화풍 — 무엇을 골랐든 그건 선택된 값이다) + **켜고 끄는 항목은 ON일 때만**(한국웹툰화·문구 — 꺼짐 = 미선택이라 중립 유지 = #askStrip 소등 문법 동일).
    //   구 = '기본값 이탈만 점등'(4:5·극화·자동·Gemini면 소등) — 기본값을 고른 것도 선택인데 안 고른 것처럼 읽혀 오독(운영자 실측 "지피티 이미지만 들어옴" = Gemini 기본이라 소등이던 자리).
  }
  geniGate();
}
