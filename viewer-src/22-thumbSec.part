const GENI_REFMODES = ['keep', 'ref', 'clone'];   // 참고 이미지 모드 = 원본 유지 / 참고(기본) / 이미지와 동일하게(운영자 260726) — 값 집합 SSOT(genimg.js·gen_image.py 화이트리스트와 3층 동일 계약)
