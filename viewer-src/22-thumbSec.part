function geniRailSetup(sel) {
  const rail = $(sel); if (!rail || rail._railSet) return; rail._railSet = true;
  let down = false, moved = false, sx = 0, sl = 0;
  rail.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = rail.scrollLeft; rail.classList.add('grabbing'); });
  rail.addEventListener('pointermove', e => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 4) moved = true; rail.scrollLeft = sl - dx; });
  const end = () => { down = false; rail.classList.remove('grabbing'); };
  rail.addEventListener('pointerup', end); rail.addEventListener('pointerleave', end);
  rail.addEventListener('click', e => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);   // 드래그 후 오클릭 차단(캡처)
  rail.addEventListener('scroll', () => geniRailUpd(rail), { passive: true });
  const wrap = rail.closest('.geni-railwrap');
  if (wrap) wrap.querySelectorAll('.geni-nav').forEach(btn => btn.addEventListener('click', () => rail.scrollBy({ left: (+btn.dataset.dir) * Math.max(110, rail.clientWidth * 0.7), behavior: 'smooth' })));
  geniRailUpd(rail);
}
function geniSubList() { return geniFreqSort('sub', [['auto', '자동'], ...(GENI_SUB[_geniSel.style] || []).filter(([v]) => v !== 'auto')]); }   // 현 화풍의 세부 목록 단일 계산점 — 레일 HTML(geniSubHTML)과 요약바 순환(GENI_SUM_TG.sub)이 같은 순서를 쓴다(표시 순서 = 넘어가는 순서)
function geniSubHTML() {   // 자동(선두 고정) + 현 화풍 세부 = 제작빈도순 — 항목 사이 | 구분자(운영자 260713) · --i = 촤르륵 스태거 순번
