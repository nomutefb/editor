    else { const w = parseInt(_geniSel.arW, 10), h = parseInt(_geniSel.arH, 10); const g = (function gcd(a, b) { return b ? gcd(b, a % b) : a; })(w, h); arout.textContent = '= ' + (w / g) + ':' + (h / g) + ' (' + (w / h).toFixed(2) + ')'; }   // 환산(운영자 260710 "입력하면 비율이 계산되어 나와야")
  }
  const camN = GENI_CAM_KEYS.filter(k => _geniSel[k] && _geniSel[k] !== 'auto').length;   // 접힘 그룹 활성 배지(복원값 포함 — 모르고 발사 방지)
  const nb = $('#geniCamN'); if (nb) { nb.textContent = camN; nb.hidden = !camN; }
