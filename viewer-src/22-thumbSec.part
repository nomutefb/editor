}
function geniSubOn() { $('#geniSub').querySelectorAll('.geni-opt').forEach(b => b.classList.toggle('on', b.dataset.v === _geniSel.sub)); }
function geniSubRender() {   // 세부 화풍 인라인 나열 단일 렌더점 — 화풍이 바뀌었을 때만 아웃 촤르륵(.out) → 300ms 스왑 → 신노드 인 촤르륵(동일 화풍 재호출 = on 토글만)
  const sb = $('#geniSub'); if (!sb) return;
  const cur = sb.dataset.style || '';
  if (cur === _geniSel.style) { if (sb.classList.contains('out')) { clearTimeout(_geniSubT); sb.classList.remove('out'); } geniSubOn(); return; }   // 아웃 진행 중 원래 화풍 복귀 연타 = 스왑 취소 + 재등장(out 해제 = animation-name 복귀라 인 촤르륵 재생)
  clearTimeout(_geniSubT);
  const swap = () => { sb.dataset.style = _geniSel.style; sb.innerHTML = geniSubHTML(); sb.classList.remove('out'); geniSubOn(); sb.scrollLeft = 0; geniRailUpd(sb); };   // 세부 목록 교체 = 좌측 리셋 + 페이드/화살표 갱신
  if (cur) { sb.classList.add('out'); _geniSubT = setTimeout(swap, 300); } else swap();   // 최초(빈 목록) = 즉시 · 이후 = 페이드아웃 완주 뒤 교체
