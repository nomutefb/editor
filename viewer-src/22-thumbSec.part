function thumbSec(a) {
  const c = a.cards || {};
  if (!a.has_body && !a.body && !c.state) return null;   // 픽(분석)된 기사에만 (has_body=경량 인덱스 플래그·body는 detail lazy → 게이트는 플래그 우선)
  // 실제 이미지(검색 og:image / AI 생성)가 하나라도 있을 때만 표시 — 빈 안내·레거시 폴백(구글검색 링크·위키미디어·'곧 반영' placeholder)은 띄우지 않음(요약 위 잡음 제거 · 운영자 260620)
  const search = Array.isArray(c.thumb_search) ? c.thumb_search : [];
  const gen = Array.isArray(c.thumb_gen) ? c.thumb_gen : [];
  if (!search.length && !gen.length) {
    // 픽됐는데 썸네일 아직 = thumb_gen은 분석과 별도 잡(픽 후 ~십몇 분) — 신규(30분 내)면 '생성 중' 자리표시(폴링이 준비 시 실제 썸네일로 자동 교체). 오래된 기사(생성 안 옴)는 종전대로 미표시(잡음 0·운영자 260621).
    if ((a.has_body || a.body) && feedAgeH(a) < 0.5) {
      const ph = document.createElement('div'); ph.className = 'thumbsec'; ph.dataset.sig = thumbSecSig(a);
      ph.innerHTML = '<div class="thumbsec-h">썸네일 후보 — 검색 · AI 생성</div>'
        + '<div class="thumb-pending">썸네일 생성 중… <small>준비되면 자동 표시</small></div>';
      return ph;
    }
    return null;
  }
  const wrap = document.createElement('div'); wrap.className = 'thumbsec'; wrap.dataset.sig = thumbSecSig(a);
  const dlAllH = (search.length + gen.length) ? '<button type="button" class="sbtn cref-dlall dlbtn thsec-dlall" title="썸네일 후보 전체 저장" aria-label="썸네일 후보 전체 저장">' + DLSEQ_IC + '<span class="cref-dllbl">전체</span></button>' : '';   // 전체저장 = 제목 라인 우측(검색+AI생성 통합 · .dlbtn 표준 · 운영자 260622)
  const secLbl = (search.length ? ['검색'] : []).concat(gen.length ? ['AI 생성'] : []).join(' · ');   // 헤더 = 실존 캐러셀만 표기 — AI 생성 스킵(no_thumb) 기사에 'AI 생성' 영구 오버-프로미스 방지(평의회 260711)
  // 발사 버튼 폴백 = 검색 카러셀이 없는 기사(og:image 0장 = fetch 차단 매체 등)에만 섹션 헤더로 이주 — 정상 기사는 종전대로 검색 소머리 우측 그대로(운영자 260801 "거기 버튼 위치 좋고").
  // 없으면 그 기사만 영영 진입로 0(누를 + 자체가 안 그려짐) = 사후 AI 생성 불가 구멍이었다.
  const secGenH = (!search.length && _thumbFile(a)) ? '<button type="button" class="sbtn cref-more cref-gen thsec-gen" title="AI 이미지 생성" aria-label="AI 이미지 생성"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span class="cref-dllbl">AI</span></button>' : '';
  wrap.innerHTML = '<div class="thumbsec-h"><span class="thsec-t">썸네일 후보 — ' + secLbl + '</span>' + secGenH + dlAllH + '</div>';
  // 1) 검색 이미지(4:5 캐러셀) — 실제 추출분이 있을 때만. 라벨 옆 토큰=검색·비전 비용(현재 0)
  if (search.length) {
    // 좌측(회색 돋보기) = 기사 제목 검색(불변) · 키워드(한/영 + 토글)는 thumbStatic이 kwData로 처리(운영자 260622)
    const _titleHref = 'https://www.google.com/search?tbm=isch&tbs=qdr:d&q=' + encodeURIComponent((a.title || '뉴스').slice(0, 100));
    wrap.appendChild(thumbStatic('검색 이미지', search, 'search', _titleHref, c.thumb_usage,
      { ko: (a.image_query || '').trim(), en: (a.image_query_en || '').trim() }));
  }
  // 2) AI 생성(4:5 × 4화풍 · 260908 복귀) — 생성분이 있을 때만. 라벨 옆 토큰=생성 비용(전 화풍+재생성 누적)
  if (gen.length) wrap.appendChild(thumbStatic('AI 생성', gen, 'gen', null, c.thumb_usage));
  const genH = wrap.querySelector('.thsec-gen');   // 폴백 발사(검색 카러셀 부재 기사) = 검색 소머리 + 와 동일 경로(openGenIdlg) · wrap = 섹션(=imgFetchGo가 AI 트랙을 찾거나 만든다)
  if (genH) genH.addEventListener('click', e => { e.stopPropagation(); openGenIdlg(_thumbFile(a), wrap, genH); });
  const dlH = wrap.querySelector('.thsec-dlall');   // 제목 라인 전체저장 = 검색+AI생성 전 이미지 통합 순차 다운로드(.dlbtn 표준 dlAllSeq)
  if (dlH) {
    const meta = search.map((it, i) => ['검색 이미지', it, i]).concat(gen.map((it, i) => ['AI 생성', it, i]));
    dlH.addEventListener('click', e => { e.stopPropagation(); dlAllSeq(dlH, meta.map(m => m[1].img), k => thumbDlName(meta[k][0], meta[k][1], meta[k][2])); });
  }
  return wrap;
}
// ── AI 썸네일 화풍 선호 투표(운영자 260805 "좋으면 thumb up · 별로면 thumb down · 그게 남게끔 해서 나중에 한번 보자") ──
// 왜 = 지금 시스템엔 **운영자가 어느 썸네일을 좋다고 봤나**가 어디에도 안 남는다. 그래서 260805 프롬프트
//   개선을 실제 발사분 236건 손 재판독으로 역추정해야 했다(정답지 부재). 이 원장이 그 정답지가 된다 —
//   화풍(photo/webtoon)·연출코드(thumb_dispatch)·SUBJECT 유무별 선호를 나중에 숫자로 볼 수 있다.
// 부품 = 카드뉴스 투표 정본 100% 계승(.fbup/.fbdown · .voted · 2탭 취소 armCancelThumb 문법) — 새 창작 0.
// 레일 = 기존 postRate(api/rate) 재사용 = **워크플로·inputs 신설 0**(rate.yml inputs는 이미 10/10 = GitHub 상한이라
//   11번째를 늘리면 디스패치 400 = 평점 레일 전체 사망 · brkno 예약키 선례와 같은 축). action='thumb' +
//   reason='<up|down>:<sid>' 로 실어 러너(rate_record.py)가 **별도 원장** scraper/thumb_votes.jsonl 로 분기한다
//   (기사 취향 원장 ratings.jsonl 오염 0 = 자동픽 학습 무영향).
const THV_KEY = 'nm_thvote';   // ⚠️ 카드 투표(nomute_fb)와 **다른 키** — 같은 키를 쓰면 카드 n번과 화풍 sid가 충돌한다
function thVoteGet(file, sid) { try { return (JSON.parse(localStorage.getItem(THV_KEY) || '{}'))[file + '#' + sid] || null; } catch { return null; } }
function thVoteSet(file, sid, v) {
  let m = {}; try { m = JSON.parse(localStorage.getItem(THV_KEY) || '{}'); } catch { /* noop */ }
  if (v) m[file + '#' + sid] = v; else delete m[file + '#' + sid];
  try { localStorage.setItem(THV_KEY, JSON.stringify(m)); } catch { /* noop */ }
}
function thVoteApply(slot, file, sid) {
  const v = thVoteGet(file, sid), up = slot.querySelector('.fbup'), dn = slot.querySelector('.fbdown');
  if (!up || !dn) return;
  up.classList.toggle('voted', v === 'up'); dn.classList.toggle('voted', v === 'down');
  up.disabled = v === 'down'; dn.disabled = v === 'up';   // 한쪽 기록되면 반대쪽 잠금(카드 정본 applyVoteState 동일)
}
function thVoteWire(slot, a, sid) {
  const file = a.file || '';
  thVoteApply(slot, file, sid);
  slot.querySelectorAll('.fbup, .fbdown').forEach(btn => {
    const vote = btn.classList.contains('fbup') ? 'up' : 'down';
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const cur = thVoteGet(file, sid);
      if (cur === vote) {                                   // 같은 쪽 재탭 = 인라인 arm → 한 번 더 탭하면 취소(카드 정본 문법·팝업 0)
        if (btn.classList.contains('thumb-arm')) { disarmThumb(btn); thVoteSend(a, sid, ''); thVoteSet(file, sid, null); thVoteApply(slot, file, sid); return; }
        slot.querySelectorAll('.sbtn.thumb-arm').forEach(disarmThumb);
        btn._iconHTML = btn.innerHTML; btn.classList.add('thumb-arm'); btn.textContent = '취소';   // 픽토→텍스트 단독 교체(§📐 공존금지)
        clearTimeout(btn._armT); btn._armT = setTimeout(() => disarmThumb(btn), 2600);
        return;
      }
      if (cur) return;                                      // 반대쪽 이미 투표 = 잠김(disabled와 이중)
      thVoteSet(file, sid, vote); thVoteApply(slot, file, sid);   // 로컬 먼저 = 즉시 반응(전송은 fire-and-forget · 실패해도 화면 안 죽는다)
      thVoteSend(a, sid, vote);
    });
  });
}
function thVoteSend(a, sid, vote) {
  postRate({ id: a.file || '', url: a.url || '', title: (a.title || '').slice(0, 300),
             action: 'thumb', reason: (vote ? vote : 'clear') + ':' + sid });
}
// 제미나이 추정$ 표기(plain 텍스트 · 버튼 아님) — 라벨(AI 생성·검색 이미지) 우측. 형식 "$ 0.0"(토큰 T는 hover 툴팁 title에만 · 운영자 260630, 카드 3498과 통일).
// bucket={calls,total,cumulative}. 토큰=정확(API) · $=추정(이미지 토큰 단가). 운영자 260620: 돈아이콘·볼드·pill 제거.
const GEM_RATE = 0.00003;   // 이미지 토큰 추정단가(≈$30/1M·$0.039/장 기준). $=추정·T=정확. ⚠️ 실측 usage.json 들어오면 1콜 totalTokenCount로 재캘리브레이션(이미지 과금은 장당 고정이라 토큰선형은 근사)
function usageText(bucket, kind) {
  if (!bucket) return '';
  const tok = bucket.cumulative || 0;
  const usd = (tok * GEM_RATE).toFixed(1);
  const title = kind === 'search'
    ? (tok ? '검색·비전 Gemini 누적 ' + tok.toLocaleString() + '토큰 · 추정 $' + usd
           : '검색 = og:image 스크래핑(AI 비전 미사용) · Gemini 0')
    : 'Gemini — AI 생성 전 화풍+재생성 누적 ' + tok.toLocaleString() + '토큰 · 추정 $' + usd
      + (bucket.calls ? ' (최근 ' + bucket.calls + '콜)' : '');
  return '<span class="cref-usage" title="' + esc(title) + '">$ ' + usd + '</span>';   // 달러만 표시(토큰 T는 hover 툴팁 title에만 · 카드 비용표시(3498)와 동일 통일 · 운영자 260630)
}
const REFRESH_SVG = '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 4v5h-5"/></svg>';
const SEARCH_SVG = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>';
// 정적 캐러셀(thumb_search/thumb_gen) — items=[{img,label?,sid?}]. 탭=확대 · 우상단 액션행 .sbtn(저장 · 생성슬롯=재생성+저장 · §🎨 .slide-acts 계승). usage={gen,search}.
function thumbStatic(label, items, kind, href, usage, kwData) {
  const list = items.slice(0, kind === 'search' ? 60 : 40);   // 검색이미지 = '+5장 더'로 누적되니 cap 해제(7→60, 12장↑ 표시) · 운영자 260622   // AI 생성 cap 7→40(운영자 260807): 수정본이 덮어쓰기가 아니라 +1장으로 쌓이므로(1/2→1/3→1/4…) 구 7은 수정 5회면 도달해 그 뒤 수정본이 **조용히 잘린다**
  const wrap = document.createElement('div'); wrap.className = 'cref';
  // 수정 대기 슬롯 = 아직 도착 안 한 수정본의 자리(운영자 260807 "1/3 2/3 3/3(새로 만들어지고 있는 중인 거)").
  // 원본 위에 진행바를 덮던 구판(markSlotReshooting)과 달리 **원본은 그대로 보이고** 트랙 끝에 제작중 슬롯이 붙는다.
  const _pend = (kind === 'gen' && CUR_A) ? thumbRedoPendList(CUR_A.file).length : 0;
  const _total = list.length + _pend;   // 순번 분모 = 실존분 + 대기분(= 발사 즉시 1/3 2/3 3/3으로 늘어난다)
  const kd = kwData || {};
  const _moreFile = (kind === 'search' && CUR_A) ? CUR_A.file : '';   // '+5장 더' = 현재 모달 기사(CUR_A)에 관련 뉴스이미지 더 검색(api/moreimg · 운영자 260622)
  const hasKw = kind === 'search' && (kd.ko || kd.en);
  let _lang = kd.en ? 'en' : 'ko';   // 🌍해외(en 有)=영문 우선 기본 / 국내=한
  const _gis = (q, en) => 'https://www.google.com/search?tbm=isch&' + (en ? 'hl=en&gl=us&' : '') + 'tbs=qdr:d&q=' + encodeURIComponent((q || '').slice(0, 100));
  const _chip = q => String(q || '').trim().split(/\s+/).filter(Boolean).join(', ');   // 공백→쉼표+간격(#736)
  // 검색 헤더 우측 = [제목 돋보기(회색)] · [키워드 분절박스: K돋보기(검색) | 한/영(토글)·박스색 전환] · [전체저장(아이콘+전체)]
  const hbtn = href ? '<a class="sbtn cref-srch" href="' + escUrl(href) + '" target="_blank" rel="noopener" title="기사 제목으로 이미지 검색" aria-label="제목 이미지 검색">' + SEARCH_SVG + '</a>' : '';
  const kwbox = hasKw
    ? '<span class="cref-kwbox iq">'
      + '<a class="cref-kwsrch" target="_blank" rel="noopener" aria-label="키워드로 이미지 검색"><span class="cref-klbl">K</span>' + SEARCH_SVG + '</a>'
      + ((kd.ko && kd.en)
          ? '<button type="button" class="cref-kwtog" title="키워드 언어 전환(한/영)" aria-label="키워드 언어 전환(한/영)"></button>'
          : '<span class="cref-kwtog cref-kwtog-static"></span>')
      + '</span>'
    : '';
  const dlAll = '';   // 전체저장 = 섹션 제목 라인(.thumbsec-h)으로 이관 = 검색+AI생성 통합 1버튼(운영자 260622)
  const moreBtn = _moreFile ? '<button type="button" class="sbtn cref-more cref-gen" title="AI 이미지 생성·더 가져오기 — 버튼 옵션 프롬프팅(Opus 5 작성·Gemini 렌더) 또는 관련 실사진 재검색(1~2분)" aria-label="AI 이미지 생성·더 가져오기"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg><span class="cref-dllbl">AI</span></button>' : '';   // + AI = 이미지 생성 팝업(#genidlg · 기존 실사진 재검색 = 팝업 보조 버튼으로 보존 · 운영자 260707) · 'AI' 라벨 = 운영자 260801(픽토만으론 발사 버튼 식별 불가 — .cref-dlall 문법 계승)
  const acts = (hbtn || kwbox || moreBtn) ? '<span class="cref-acts">' + moreBtn + hbtn + kwbox + '</span>' : '';   // 전체(dlAll)는 키워드와 함께 cref-kwrow 한 줄(우측정렬·세로중앙 · 운영자 260622)
  const bucket = usage ? (kind === 'gen' ? usage.gen : kind === 'search' ? usage.search : null) : null;
  const kwHtml = hasKw ? '<span class="cref-kw"></span>' : '';   // 키워드 칩(검정 글래스) — 텍스트·색은 언어따라 JS가 채움
  // 키워드(좌) + 전체저장(우)을 한 줄에 세로중앙 — 키워드를 '전체' 버튼과 같은 중앙선에(운영자 260622: 더는 별도 줄로 안 내려감)
  const kwRow = (kwHtml || dlAll) ? '<div class="cref-kwrow">' + kwHtml + dlAll + '</div>' : '';
  // 대기 슬롯 = imgFetchGo 로딩 슬라이드(.cref-slot.cref-loading + .cref-ld + nmLoader) **100% 계승**(새 부품 창작 0).
  // 다른 점 두 가지뿐 = ⓐ 자리가 맨 좌측이 아니라 **트랙 끝**(수정본은 마지막 N/N으로 붙는다) ⓑ .tredo-ld 마커 —
  // imgFetchGo 의 중복발사 가드(`track.querySelector('.cref-loading')`)가 이 슬롯을 '진행 중'으로 오인해
  // AI 생성 버튼을 조용히 잠그는 것을 막는다(수정 대기 ≠ 생성 진행). 로더 종류 solving = 구 markSlotReshooting 동값.
  const _pendH = Array.from({ length: _pend }, (_, k) =>
    '<div class="cref-slot cref-loading tredo-ld chin" style="animation-delay:0ms,0s">'
    + '<span class="cref-no"><b>' + (list.length + k + 1) + '</b>/' + _total + '</span>'
    + '<div class="cref-ld">' + (window.nmLoader ? nmLoader('solving', '제작중…') : '<span class="cref-ld-tx">제작중…</span>') + '</div></div>').join('');
  wrap.innerHTML = '<div class="cref-h"><span class="cref-lblrow"><span class="cref-lbl">' + esc(label) + '</span>' + usageText(bucket, kind) + '</span>' + acts + '</div>'
    + kwRow   // 키워드(좌)+전체(우) 한 줄·세로중앙(운영자 260622)
    + '<div class="cref-track">' + (list.map((it, i) => {
        const cap = ((kind === 'gen' || it.label === '생성') && it.label) ? '<span class="tgen-cap">' + esc(it.label) + '</span>' : '';   // gen=화풍명 유지 · search '유사' 라벨 제거(의미없음·운영자 260622) · '생성'(genimg 제미나이 생성물)은 검색 카러셀 안에서 구분 표기(운영자 260707)
        const no = '<span class="cref-no"><b>' + (i + 1) + '</b>/' + _total + '</span>';   // 좌상단 순번 = 카드 캐러셀 '1/N'(현재 초록·총개수) 동일
        const dname = thumbDlName(label, it, i);
        const sidAttr = (kind === 'gen' && it.sid) ? ' data-sid="' + esc(it.sid) + '"' : '';   // 생성 슬롯 = 화풍 sid(재생성 진행바 타깃·복원용)
        // 저장 = 진짜 <a download href=api/dl 프록시>(같은-출처 attachment) = 모바일/인앱 브라우저 네이티브 다운로드(합성 a.click()보다 안정 · 운영자 260622).
        // AI 생성 슬롯만 = 화풍 선호 투표(운영자 260805 "좋으면 thumb up · 별로면 thumb down · 남게끔") —
        // 부품은 카드뉴스 투표 정본 100% 계승(.fbup/.fbdown · THUMBUP/THUMBDOWN_SVG · .voted · 2탭 취소).
        // 검색 이미지는 우리가 만든 게 아니라 프롬프트 개선의 정답지가 못 된다 → gen 한정.
        const voteH = (kind === 'gen' && it.sid)
          ? '<button type="button" class="sbtn fbup" aria-label="좋은 썸네일" title="좋음">' + THUMBUP_SVG + '</button>'
            + '<button type="button" class="sbtn fbdown" aria-label="아쉬운 썸네일" title="아쉬움">' + THUMBDOWN_SVG + '</button>'
          : '';
        return '<div class="cref-slot ' + kind + '" data-i="' + i + '"' + sidAttr + ' role="button" tabindex="0" aria-label="확대">'
          + '<img loading="lazy" referrerpolicy="no-referrer" src="' + escUrl(it.img) + '" alt=""'
          + ' onerror="this.closest(\'.cref-slot\').style.display=\'none\'">' + no + cap
          + '<div class="timg-acts">' + voteH
          +   '<a class="sbtn timg-dl dlbtn" href="' + escUrl(dlSrc(it.img, dname)) + '" download="' + esc(dname) + '" aria-label="이미지 저장" title="이미지 저장">' + DOWNLOAD_SVG + '</a>'
          + '</div></div>';
      }).join('') + _pendH || '<div class="cref-empty">이미지 없음</div>') + '</div>';
  wrap.querySelectorAll('.cref-slot').forEach(slot => {
    const i = +slot.dataset.i, it = list[i]; if (!it) return;
    const acts = slot.querySelector('.timg-acts');
    if (kind === 'gen') { slot.classList.add('chin'); slot.style.animationDelay = Math.min(i, 14) * 32 + 'ms'; }   // 생성물 등장 촤르륵 = cardIn + i×32ms 스태거(4223 산식 그대로 · 운영자 260801 "추가되는 거 촤르륵으로") — 검색 슬롯은 무접촉(재검색 5장 누적이라 매번 전체 재생 = 과함)
    if (kind === 'gen' && it.sid) acts.insertBefore(thumbRedoSbtn(it.sid), acts.firstChild);   // 생성 슬롯마다 수정 .sbtn(저장 앞)
    // (구) 재생성 대기 화풍 = 원본 슬롯에 진행바 오버레이 → 폐지(운영자 260807) : 수정은 원본을 덮지 않으므로 원본은 끝까지 깨끗하게 보인다.   // 대기 표시는 트랙 끝 .tredo-ld 슬롯(_pendH)이 담당 — markSlotReshooting은 dormant 보존.
    if (kind === 'gen' && it.sid && CUR_A) thVoteWire(slot, CUR_A, it.sid);   // 화풍 선호 투표(👍/👎) — 상태 복원 + 1탭 기록 + 2탭 취소
    const _tdl = slot.querySelector('.timg-dl'); if (dlSeen(it.img)) _tdl.classList.add('dl-done');   // 재렌더 시 '받음' mut 복원
    _tdl.addEventListener('click', e => { e.stopPropagation(); dlMark(it.img, _tdl); });   // 저장 앵커 탭 = 네이티브 다운로드(확대 라이트박스로 안 번지게만) + '받음' mut
    slot.addEventListener('click', e => { if (!e.target.closest('.timg-acts')) openLightbox(list, i, label); });   // 탭=확대(복사는 확대뷰에서)
    slot.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(list, i, label); } });
  });
  // 키워드 분절박스 — 칩 텍스트/색 · 박스 색 · 검색 쿼리 · 토글 라벨(한/영)을 _lang 따라 즉시 갱신(운영자 260622)
  if (hasKw) {
    const kwEl = wrap.querySelector('.cref-kw');
    const box = wrap.querySelector('.cref-kwbox'), srch = box && box.querySelector('.cref-kwsrch'), tog = box && box.querySelector('.cref-kwtog');
    let _curChip = '';
    const apply = () => {
      const en = _lang === 'en', q = en ? kd.en : kd.ko, chip = _chip(q);
      _curChip = chip;
      if (kwEl) { kwEl.textContent = chip; kwEl.title = '탭하면 키워드 복사'; kwEl.classList.toggle('en', en); }
      if (box) box.classList.toggle('en', en);   // 박스 전체 색 한(초록)↔영(파랑)
      if (srch) { srch.href = _gis(q, en); srch.title = (en ? '영문' : '한글') + ' 키워드로 이미지 검색'; }
      if (tog) tog.textContent = en ? '영' : '한';
    };
    apply();
    if (tog && !tog.classList.contains('cref-kwtog-static'))
      tog.addEventListener('click', e => { e.stopPropagation(); e.preventDefault(); _lang = _lang === 'en' ? 'ko' : 'en'; apply(); });
    if (kwEl) {   // 키워드 칩 탭 = 복사 + 눌림 플래시(글자 스왑 없음 · 안 B · 운영자 260622)
      kwEl.addEventListener('animationend', () => kwEl.classList.remove('copied'));   // 끝나면 클래스 제거 = 반복 탭 재생
      kwEl.addEventListener('click', async e => {
        e.stopPropagation();
        await copyText(_curChip);
        kwEl.classList.remove('copied'); void kwEl.offsetWidth; kwEl.classList.add('copied');   // reflow로 애니 재시작
      });
    }
  }
  const dlAllBtn = wrap.querySelector('.cref-dlall');   // 우상단 전체 저장 — 이 카러셀 이미지 전부 순차 다운로드
  if (dlAllBtn) dlAllBtn.addEventListener('click', e => { e.stopPropagation(); dlAllSeq(dlAllBtn, list.map(it => it.img), i => thumbDlName(label, list[i], i)); });   // 통합: 진행 i/N → 초록 ✓
  const moreEl = wrap.querySelector('.cref-more');   // + = 이미지 생성 팝업 열기(버튼 프롬프팅 · 기존 재검색은 팝업 안 보조 버튼 · 운영자 260707)
  if (moreEl && _moreFile) moreEl.addEventListener('click', e => { e.stopPropagation(); openGenIdlg(_moreFile, wrap, moreEl); });
  attachCarouselDrag(wrap.querySelector('.cref-track'));   // PC 마우스 드래그 좌우 슬라이드(feedtrack 패턴 계승·운영자 260622)
  return wrap;
}
// 이미지 받아오기 공통기 — api 발사(moreimg 재검색·genimg 제미나이 생성 공용 · 운영자 260707) ·
// 맨 좌측 반투명 로딩 슬라이드 · articles.json 폴링(~25s×ticks)으로 thumb_search 늘면 thumbsec 재렌더(새 이미지 좌측·번호 갱신).
// 생성(thumb_gen) 로딩 슬롯이 들어갈 트랙 = **AI 생성 카러셀**. 발사 버튼은 검색 소머리(또는 섹션 헤더)에 있어 wrap이 검색 카러셀/섹션이라
// 종전엔 생성 로딩이 검색 카러셀에 떴고(산출은 AI 카러셀 = 자리 불일치), AI 카러셀이 없던 기사는 도착 순간 섹션째 튀어나왔다(운영자 260801 "딱딱 안끊기게").
// → 있으면 그 트랙을 쓰고, 없으면 정본 문법(.cref/.cref-h/.cref-lbl/.cref-track) 그대로 카러셀을 만들어 붙인다(틀도 cardIn 촤르륵으로 등장).
function genTrackOf(wrap) {
  const sec = wrap.closest('.thumbsec') || wrap;
  const cur = sec.querySelector('.cref-slot.gen, .cref-slot.cref-loading');
  if (cur) return cur.closest('.cref').querySelector('.cref-track');
  const cf = document.createElement('div'); cf.className = 'cref chin';
  cf.innerHTML = '<div class="cref-h"><span class="cref-lblrow"><span class="cref-lbl">AI 생성</span></span></div><div class="cref-track"></div>';
  sec.appendChild(cf);
  const t = sec.querySelector('.thsec-t'); if (t && !/AI 생성/.test(t.textContent)) t.textContent += ' · AI 생성';   // 헤더 라벨 = 실존 카러셀만 표기(secLbl 계약) — 이제 실존하므로 추가
  return cf.querySelector('.cref-track');
}
async function imgFetchGo(file, wrap, btn, o) {   // o = { url, body, ld(로딩 문구), ticks, field(완료 폴링 대상) }
  const track = (o.field === 'thumb_gen') ? genTrackOf(wrap) : wrap.querySelector('.cref-track'); if (!track) return false;
  const field = o.field || 'thumb_search';   // 완료 감지 대상 = moreimg(재검색)=thumb_search / genimg(생성)=thumb_gen (운영자 260713 정합 봉합 — genimg가 thumb_search 폴링해 완료 영영 미감지=로딩 잔류·화면 이상 버그)
  if (track.querySelector('.cref-loading:not(.tredo-ld)')) return 'busy';   // 이미 진행 중(중복 발사 가드) — 발사측이 조용히 처리   // :not(.tredo-ld) = 수정 대기 슬롯은 '생성 진행 중'이 아니다(운영자 260807) — 안 빼면 수정 대기 동안 AI 생성 버튼이 조용히 잠긴다
  const a0 = DATA.find(x => x && x.file === file);
  const before = ((a0 && a0.cards && a0.cards[field]) || []).length;   // 기준 = 현재 해당 카러셀(검색/생성) 이미지 수
  // 로딩 슬라이드를 await 전에 먼저(동기) 꽂는다 = .cref-loading 가드 즉시 작동 → 연타 레이스 차단(평의회 검증·260622)
  const ph = document.createElement('div'); ph.className = 'cref-slot cref-loading chin';   // 맨 좌측 반투명 로딩(N장 추가 예정 의미) · chin = 등장 촤르륵(cardIn — 구 즉시 삽입 = 툭 튐 · 운영자 260801)
  ph.style.animationDelay = '0ms, 0s';   // cardIn(등장) 지연 0 · crefDim(브리딩)은 즉시 = 2값 = 두 애니 각각(단일 값이면 브리딩까지 밀림)
  ph.innerHTML = '<div class="cref-ld">' + (window.nmLoader?nmLoader('thinking', o.ld):'<span class="cref-ld-tx">'+esc(o.ld)+'</span>') + '</div>';   // 로딩 스피너 → 도트 픽토그램(nm-loader.js · 강조색 --accent)
  track.insertBefore(ph, track.firstChild);
  track.scrollTo({ left: 0, behavior: 'smooth' });
  if (btn) { btn.classList.add('busy'); btn.disabled = true; }
  let ok = false;
  try { const r = await fetch(o.url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(o.body) }); ok = !!((await r.json().catch(() => ({})) || {}).ok); } catch {}
  if (btn) setTimeout(() => { btn.classList.remove('busy'); btn.disabled = false; }, 2500);   // 버튼은 곧 풀어줌(중복은 .cref-loading 가드)
  if (!ok) { ph.remove(); if (btn && typeof _flashBtn === 'function') _flashBtn(btn, 'err'); return false; }   // 실패 = 로딩 제거(가드 해제)
  let n = 0;
  const ticks = (o.ticks || 10) * 3;   // ×3 = 폴 주기를 25s→8s로 줄인 짝(아래) — 총 대기창은 그대로 유지(14틱×25s=350s ≒ 42틱×8s=336s) · 호출부 ticks 값 무접촉 = 형제 발사 경로 회귀 0
  const tick = async () => {
    if (isComposingModalOpen()) { setTimeout(tick, 25000); return; }   // ⚠️ 작성 모달 중엔 thumbsec 교체(아래 replaceWith = 배경 재렌더) 보류 — §깜빡임 게이트(분신술7) · n 미소모 · 모달 닫으면 다음 틱 재개
    n++;
    try {
      const rr = await fetch('articles.json?_=' + Date.now()); const j = await rr.json();
      const a = (j.articles || []).find(x => x && x.file === file);
      const now = ((a && a.cards && a.cards[field]) || []).length;
      if (a && now > before) {   // 새 이미지 도착 → DATA 갱신 + 열린 모달이면 thumbsec 통째 재렌더(로딩 슬라이드 자동 소거·새 이미지 좌측·번호 갱신)
        await ensureDetail(a);   // 경량 인덱스라 body/md 빈 채 → CUR_A/DATA 교체 전 detail 복원(다운로드 카드·출처 유실 방지 · 평의회 260624)
        const idx = DATA.findIndex(x => x && x.file === file); if (idx >= 0) { DATA[idx] = a; _feedIdxRef = null; }   // 같은 배열참조·요소 교체 = feedMatch 색인 강제 재구축(다음 조회 시 346회·~0ms) — 인덱스 필드 in-place 변경 대비 구조적 보험(병렬검증 성능 한 수)
        // 교체 = 로딩 슬롯을 그 자리서 .18s 페이드아웃(crefSwapOut)한 뒤 섹션 스왑 → 새 슬롯이 촤르륵(chin)으로 들어온다.
        // 구 동작 = 즉시 replaceWith = 로딩→이미지가 한 프레임에 번쩍(운영자 260801 "딱딱 안끊기게"). 도착 슬롯 스태거는 thumbStatic이 i×32ms로 부여.
        if (CUR_A && CUR_A.file === file) {
          CUR_A = a;
          const swap = () => { const old = $('#mdbody .thumbsec'), fresh = thumbSec(a); if (old && fresh) old.replaceWith(fresh); };
          const lds = [...document.querySelectorAll('#mdbody .thumbsec .cref-loading')];
          if (lds.length && !matchMedia('(prefers-reduced-motion:reduce)').matches) { lds.forEach(el => el.classList.add('swapout')); setTimeout(swap, 180); } else swap();   // 관용구 = 6978행 동일(전정계 배려 = 즉시 교체)
        }
        return;   // 완료
      }
    } catch {}
    if (n < ticks) setTimeout(tick, 8000);   // raw-ok: 폴 주기(ms — 지속시간 토큰 아님) · 구 25s(260810 개정) = 제작이 끝나도 최대 25초를 더 기다렸다 — 제작 자체가 실측 35s 안팎인 판에서 대기의 상당분이 이 주기였다(6308행 이력 폴 10s와 같은 결)
    else { const tx = ph.querySelector('.cref-ld-tx'); if (tx) tx.textContent = '곧 반영 — 새로고침'; }   // 타임아웃(빌드 지연/0장) = 소프트 안내
  };
  setTimeout(tick, 25000);
  return true;   // 접수 성공 = 발사측(#geniGo) 게이지 완료(gaugeDone)·✓ 판정 신호(thumbRedo 미러)
}
function moreImgGo(file, wrap, btn) { return imgFetchGo(file, wrap, btn, { url: 'api/moreimg', body: { file }, ld: '5장 받아오는 중…', ticks: 10 }); }   // 실사진 재검색(기존 경로 그대로 · field 생략 = thumb_search 기본)
function genImgGo(file, wrap, btn, opts) { geniFreqBump('style', _geniSel.style); geniFreqBump('sub', _geniSel.sub); return imgFetchGo(file, wrap, btn, { url: 'api/genimg', body: { file, opts }, ld: '생성 중…', ticks: 14, field: 'thumb_gen' }); }   // 제미나이 생성(Opus 프롬프트 1~2분 + 렌더 → 여유 폴) · field:thumb_gen = 생성물 카러셀 폴링(완료 감지 정합·운영자 260713) · 발사 = 화풍·세부 제작빈도 +1(다음 열림 좌측 정렬)

// ── 이미지 생성 팝업(#genidlg) — 버튼이 곧 프롬프팅 · 3부 재편(운영자 260710: 개요{해상도·비율·장수·품질} → 표현{화풍·세부·웹툰화·무드} → 내용{주문·문구}) ──
// 라벨 = 평문 한국어 · 값 = 백엔드 화이트리스트 키(genimg.js·gen_image.py와 동일 집합).
const GENI_FMT = 'jpg';   // 산출 포맷 = JPG q90 고정(운영자 260805 "오버레이용 png(투명) 말고는 모두 jpg 90") — 화면 선택지 0개라 사전이 아니라 상수 1곳이 소유(발사 opts.fmt 단일 원천) · 투명이 필요한 산출(오버레이 exportOverlay·누끼 cutout)만 PNG 잔류 = 별개 경로
const GENI_DICT = {
  size: [['720p', '720p'], ['FHD', 'FHD'], ['2K', '2K'], ['4K', '4K']],   // 픽셀 라벨(기본 FHD · 운영자 260710) — 서버가 렌더 크기·짧은변 px 환산(gen_image SIZE_RENDER/SIZE_SHORT · FHD = 1K 렌더 보간 = 과금 현행 동일)
  aspect: [['4:5', '4:5'], ['9:16', '9:16'], ['16:9', '16:9'], ['custom', '직접']],   // ⚠배치 1:1 프리셋 제거(운영자 260727 "1:1 말고 직접 · 공간확보") — 정사각은 '직접' N:N에 1:1 입력 = 기능 손실 0 · 두 탭(번역·AI 생성) 동시 적용 = 비율 목록 대칭 유지 · 옛 스냅샷 1:1 = GENI_DICT 미포함이라 기본값 강하(21:9·fmt jpg→png 선례 그대로)   // 순서·집합 = 4:5·9:16·16:9·1:1·직접(운영자 260718 "21:9 대신 직접" — 21:9 프리셋 제거, 커스텀 N:N이 초광폭 겸함 · 한 줄 밀집 정리 · 구 260713 21:9 포함) · 1:1 = gen_image NATIVE_ASPECTS·genimg.js N:N(0.25~4) 계약 내 · 직접 = N:N 입력(각 1~99 · 아래 아코디언 행 · 환산 표시) · 구 21:9 스냅샷 = GENI_DICT 미포함이라 복원 시 기본값 강하(fmt jpg→png 선례)
  count: [['1', '1개'], ['2', '2개'], ['3', '3개'], ['4', '4개']],   // 라벨 '개수'·표기 'N개'(운영자 260713 "장수 → 텍스트 개수로 변경") — 값(1~4)·서버 계약 불변
  // (구 fmt 축 = 폐지 · 운영자 260805 "투명일 필요 없는 건 모두 jpg 90") — 산출은 JPG q90 고정이라 고를 값이 0개 = 사전 항목·'품질' 행 동시 제거 · 발사 파라미터는 GENI_FMT 상수 1곳(아래) · 옛 스냅샷의 fmt 키 = 사전 미포함이라 복원 대상에서 자연 탈락(구 21:9·1:1 선례 동문)
  place: [['auto', '자동'], ['top23', '썸네일'], ['center', '중앙'], ['full', '전신']],   // 썸네일(구 라벨 상단⅔) = 카드뉴스·썸네일 정본(주요 피사체 상단 2/3 앵커·하단 캡션존 비움 — 운영자 260707 "조건에 썸네일" 명칭 확정 · 값 top23 불변)
  shot: [['auto', '자동'], ['S10', '표정 클로즈'], ['S08', '클로즈업'], ['S06', '상반신'], ['S04', '전신'], ['S03', '와이드']],   // 카메라 거리 = 01b 샷 크기 실코드(운영자 260707 "얼마나 가까이")
  expr: [['auto', '자동'], ['EM-03', '슬픔'], ['EM-05', '분노'], ['EM-16', '눈물'], ['EM-17', '결연'], ['EM-09', '억눌림'], ['EM-12', '직시']],   // 표정 = 22 FACS 실코드(운영자 260707 "표정 묘사")
  angle: [['auto', '자동'], ['AG-01', '눈높이'], ['AG-02', '로우 위압'], ['AG-03', '하이 왜소'], ['AG-04', '부감'], ['AG-06', '더치'], ['AG-09', '측면']],   // /k 라이브러리 39(앵글·높이) 실코드
  point: [['auto', '자동'], ['DF-01', '눈물 클로즈'], ['DF-02', '주먹'], ['DF-04', '서류·물건'], ['DF-05', '대치 투샷'], ['DF-07', '군중 속 1인']],   // 38(거리·크롭 = 표현 포인트)
  light: [['auto', '자동'], ['LGT05', '촛불'], ['LGT06', '골든아워'], ['LGT08', '흐린 확산'], ['LGT09', '하드 측광'], ['LGT10', '역광 실루엣'], ['LGT12', '형광 임상']],   // 12(감정 조명)
};
const GENI_MOOD_AX = [['ct', '긴장도', '차분', '긴장'], ['sh', '정서', '침통', '희망'], ['ew', '온도', '스산', '온기'], ['rr', '격앙', '냉정', '격앙']];   // 무드 게이지 4축(각 -2..+2 · 0=중립) — 서버 gen_image MOOD_AX 동일 키 · 양끝 = 축별 기준 라벨(운영자 260710 "종류별 분리·기준 달기")
const GENI_CAM_KEYS = ['shot', 'expr', 'angle', 'point', 'light', 'place'];   // 접힘 카메라·구도군 — 배지 = non-auto 개수(숨은 활성 은폐 방지)
let _geniCtx = null;   // {file, wrap, btn, free}
let _geniSel = { style: 'webtoon', sub: 'auto', size: 'FHD', aspect: '4:5', arW: '1', arH: '1' /* 직접 기본 = 1:1(운영자 260727 "누르면 1:1이였다가 자릿수가 비는 느낌") — 빈 칸이 아니라 값이 앉아 있고 탭하면 그 자리가 비며 바로 타이핑 · ⚠ 한 줄 객체 리터럴이라 // 주석 금지(뒤 필드가 통째로 먹힌다 = 260727 부팅 크래시 실측) */, count: '1', mood: 'auto', moodAx: { ct: 0, sh: 0, ew: 0, rr: 0 }, kweb: true, textOn: false, engine: 'gemini', engineTouched: false, colorAx: { sat: 0, bri: 0 }, colorTouched: false, place: 'auto', shot: 'auto', expr: 'auto', angle: 'auto', point: 'auto', light: 'auto', refMode: 'ref' };   // 기본 = 극화·4:5·FHD·PNG·웹툰화 ON·무드 자동(운영자 260710) · 참고 이미지 기본 참고(refMode 첨부 시만 의미)
let _geniInited = false;
let _geniDD = null;   // 열려 있는 선택박스(도먼트 — 260713 화풍 전량 나열로 열기 호출처 0 · 항상 null·닫기 경로만 잔존)
function geniEngIco() { const [ko, ico] = GENI_ENG_ICO[_geniSel.engine] || GENI_ENG_ICO.gemini; return '<i class="eng-ico" title="' + ko + '" aria-label="' + ko + '">' + ico() + '</i>'; }   // 아이콘만 남는 자리 = title·aria-label로 모델명 보존(스크린리더·호버)
function geniStyleKo(v) { const hit = GENI_ALL_STYLES.find(x => x[0] === v); return hit ? hit[1] : v; }
function geniSubKo(v) { if (v === 'auto') return '자동'; const hit = (GENI_SUB[_geniSel.style] || []).find(x => x[0] === v); return hit ? hit[1] : v; }
function geniArVal() { const w = parseInt(_geniSel.arW, 10), h = parseInt(_geniSel.arH, 10); return (w >= 1 && w <= 99 && h >= 1 && h <= 99 && w / h >= 0.25 && w / h <= 4) ? w + ':' + h : null; }   // 직접 비율 유효값 — 각 1~99 + 비율 1:4~4:1(극단값 후처리 병리 차단 · 평의회3) = 서버·python 3층 동일 계약
function geniArFit(el) { if (el) el.style.width = Math.max(1, (el.value || '').length) + 'ch'; }   // 숫자칩 폭 = 값 길이 동기(1~2ch · tabular-nums라 자릿수당 폭 일정) — 고정폭이면 「1 : 1」이 빈 상자처럼 벌어진다(구 26px 고정 = 박스 입력칸 잔재)
function geniAspect() { return _geniSel.aspect === 'custom' ? geniArVal() : _geniSel.aspect; }   // 발사 비율 — 직접 미완성 = null(게이트가 막음)
// 옵션바 모델 표기 = 축약(운영자 260727 "gemini는 gem, gpt는 gpt로 · 모델명 풀로 안나오게") — 풀네임(Gemini 3.1 Flash·GPT Image 2.0)이 요약 스트립을 2줄로 랩시키던 것 회수(구 5항 축소와 동축) · 스코프 = 옵션바 리드백 한정 = 본문 개요 '모델' 행(#geniEngine)은 값을 고르는 자리라 풀네임 유지(운영자 260727 "모델 영어로 각각 쓰고 토글" 정본 불변)
const GENI_ENG_ICO = { gemini: ['Gemini 3.1 Flash', () => GEMINI_SVG], gpt: ['GPT Image 2.0', () => AI_SVG] };   // 요약 스트립 모델 값 = 브랜드 픽토(운영자 260727 "줄임말 gem/gpt … 아니, 픽토그램으로 대체") — Gemini = 구글 G 레터마크 · OpenAI = AI 스파클 = **레터마크 ↔ 별로 판별**(정본 = nm-svg.js · 260803 별 계열 2안 회수 = 별끼리는 어느 조합이든 겹쳐 읽힌다) · 지연 참조(() =>) = 스크립트 로드 순서 무관
function geniRoot() { const h = $('#geniHost'); return (h && !h.hidden) ? h : $('#genidlg'); }   // 폼 뿌리 단일점(이중 홈 · 운영자 260713 B) — 이식 탭 표시 중 = geniHost · 그 외(팝업·보관) = genidlg. 스코프 질의·선택박스 앵커 전부 이걸 경유
// ── 선택박스(드롭다운) — 무채 크롬 목록(§디자인 i) · 도먼트(260713 화풍·세부 화풍 전량 인라인 파이프 나열 전환으로 열기 호출처 0 — 함수·CSS 보존 = 재도입 비용 0 · 닫기(geniDDClose)는 close/ESC 경로에 잔존·무해) ──
function geniDDClose() { if (_geniDD) { try { _geniDD._anchor.setAttribute('aria-expanded', 'false'); } catch {} _geniDD.remove(); _geniDD = null; document.removeEventListener('pointerdown', geniDDDoc, true); } }
function geniDDDoc(e) { if (_geniDD && !_geniDD.contains(e.target) && !(_geniDD._anchor && _geniDD._anchor.contains(e.target))) geniDDClose(); }   // 바깥 탭 = 닫기(앵커 자체는 클릭 토글에 맡김)
function geniDDOpen(anchor, list, cur, pick) {
  if (_geniDD) { const same = _geniDD._anchor === anchor; geniDDClose(); if (same) return; }   // 같은 버튼 재탭 = 토글 닫기 · 다른 버튼 = 갈아끼움
  const host = geniRoot();   // 폼 뿌리 직속 앵커(6인 검증 P2 · 이식 탭 = geniHost relative 기준 · 260713 B) — 구 .geni-body 자식 = 스크롤 박스에 클리핑 + scroll=닫힘이라 잘린 항목 도달 불가 → 뿌리(:modal/relative = positioned) 기준이면 바디 스크롤 무관·클립 여유 최대
  const dd = document.createElement('div'); dd.className = 'geni-dd'; dd.setAttribute('role', 'listbox');
  dd.innerHTML = list.map(([v, ko]) => '<button type="button" class="geni-dd-it' + (v === cur ? ' on' : '') + '" role="option" aria-selected="' + (v === cur) + '" data-v="' + v + '">' + ko + '</button>').join('');
  dd.addEventListener('click', e => { const b = e.target.closest('.geni-dd-it'); if (!b) return; e.stopPropagation(); geniDDClose(); pick(b.dataset.v); });
  dd._anchor = anchor;
  host.appendChild(dd);
  geniDDPlace(dd, anchor, host);
  anchor.setAttribute('aria-expanded', 'true');
  _geniDD = dd;
  setTimeout(() => { document.addEventListener('pointerdown', geniDDDoc, true); try { (dd.querySelector('.on') || dd.firstElementChild).focus({ preventScroll: true }); } catch {} }, 0);   // 첫 포커스 = 현 선택(키보드/SR 도달) · preventScroll = 포커스 스크롤 격발 방지
}
function geniDDPlace(dd, anchor, host) {   // 배치 단일점(열기+스크롤 추적 공용) — 아래 협소 = 위로 flip · 가용공간 클램프(6인 검증 P2)
  const ar = anchor.getBoundingClientRect(), hr = host.getBoundingClientRect();
  const below = hr.bottom - ar.bottom - 12, above = ar.top - hr.top - 12;   // 앵커 아래/위 가용(다이얼로그 박스 기준)
  const up = below < 150 && above > below;
  dd.style.maxHeight = Math.max(96, Math.min(230, Math.round(up ? above : below))) + 'px';
  if (up) { dd.style.top = ''; dd.style.bottom = Math.round(hr.bottom - ar.top + 4) + 'px'; dd.style.transformOrigin = 'bottom right'; }
  else { dd.style.bottom = ''; dd.style.top = Math.round(ar.bottom - hr.top + 4) + 'px'; dd.style.transformOrigin = ''; }
  dd.style.right = Math.max(4, Math.round(hr.right - ar.right)) + 'px';   // 칩 우변 정렬(transform-origin과 짝)
}
function geniDDSync() {   // 바디 스크롤 = 닫기 아닌 앵커 추적 재배치 — 클릭 직전 스크롤 이벤트가 다음 프레임에 늦게 와 방금 연 목록을 닫던 레이스 수리(실측 260710) · 앵커가 가시영역 밖으로 나가면 그때 닫기
  if (!_geniDD) return;
  const host = geniRoot(), body = host.querySelector('.geni-body');
  const ar = _geniDD._anchor.getBoundingClientRect(), br = body.getBoundingClientRect();
  if (ar.bottom < br.top + 6 || ar.top > br.bottom - 6) { geniDDClose(); return; }
  geniDDPlace(_geniDD, _geniDD._anchor, host);
}
function geniAccordion(el, open) { if (!el) return; el.classList.toggle('open', !!open); if (open) el.removeAttribute('inert'); else el.setAttribute('inert', ''); }   // 아코디언 = class+inert 한 쌍(camsub 계승 — 접힘 시 tab-order·SR 제거)
let _geniMoodScrollY = null, _geniMoodT = 0;   // 무드 게이지 열기 직전 바디 스크롤 위치(닫을 때 복원) + 재발행 타이머(운영자 260713)
function geniMoodScroll(open) {   // 무드 직접 = 게이지 아코디언(.geni-moodsub .26s ease) 열림에 맞춰 개수 행을 바디 최상단으로 이징 스크롤(표현 구간+게이지 가시) · 자동 닫힘 = 열기 전 위치로 복귀 · 개수 행은 게이지보다 위라 offsetTop 불변
  const body = geniRoot().querySelector('.geni-body'); if (!body) return;
  clearTimeout(_geniMoodT);   // 연타(직접↔자동) 재발행 타이머 정리
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;   // 이징 감쇠(하우스 규율 · 평의회5)
  if (open) {
    const cnt = geniRoot().querySelector('.geni-opts[data-k="count"]');
    const row = cnt && cnt.closest('.geni-row'); if (!row) return;
    if (_geniMoodScrollY === null) _geniMoodScrollY = body.scrollTop;   // 복원 기준 1회만 저장(게이지 드래그 중 재저장 방지)
    const go = () => body.scrollTo({ top: Math.max(0, row.offsetTop - 12), behavior: rm ? 'auto' : 'smooth' });   // 개수 행 상단(위 12px 여백)
    go();                                        // 즉시 = 아코디언 확장과 동시 이징
    if (!rm) _geniMoodT = setTimeout(go, 300);   // 확장 완료(.26s) 후 재발행 = 접힘 시점 maxScroll 클램프로 개수 행이 top에 못 붙던 언더슛 보정(평의회1) · reduced-motion은 아코디언도 즉시 확장(2710행 transition:none)이라 불요
  } else if (_geniMoodScrollY !== null) {
    body.scrollTo({ top: _geniMoodScrollY, behavior: rm ? 'auto' : 'smooth' }); _geniMoodScrollY = null;
  }
}
let _geniSubT = 0;   // 세부 화풍 촤르륵 스왑 타이머(연타 레이스 가드)
// ── 제작 빈도(로컬·기기별 · 서버동기화 0 · 운영자 260713 "선택 아닌 제작 누적") ──
function geniFreq() { try { return JSON.parse(localStorage.getItem('geni_freq') || '{}') || {}; } catch { return {}; } }
function geniFreqBump(kind, v) { if (!v || v === 'auto') return; try { const f = geniFreq(); f[kind] = f[kind] || {}; f[kind][v] = (f[kind][v] || 0) + 1; localStorage.setItem('geni_freq', JSON.stringify(f)); } catch {} }   // 제작 발사 시 +1
function geniFreqSort(kind, items) {   // auto/기본 선두 고정 + 나머지 제작빈도 내림차순(동률=원순서·JS stable) — 자주 쓰는 게 좌측(초기 노출) · 재정렬 = 다음 로드/열림
  const f = geniFreq()[kind] || {};
  const head = items.filter(([v]) => v === 'auto'), rest = items.filter(([v]) => v !== 'auto');
  rest.sort((a, b) => (f[b[0]] || 0) - (f[a[0]] || 0));
  return [...head, ...rest];
}
// ── 가로 레일 = 드래그(마우스)·화살표(PC)·끝선 페이드(운영자 260713 전광판) · 폰 = 네이티브 터치 ──
function geniRailUpd(rail) {   // 끝선 페이드 클래스 + 화살표 disabled(렌더/스크롤 후 갱신)
  if (!rail) return;
  const max = rail.scrollWidth - rail.clientWidth, sl = rail.scrollLeft;   // 재는 것을 **먼저 한 번에**(260811 평의회1 실측 봉합) — 구판은 `읽기 → 클래스 토글 → 또 읽기` 를 세 번 번갈아서 한 번 부를 때마다 배치 계산이 3회 돌았다(실측 3회 → 1회). 값은 그대로다(클래스 문자열·화살표 꺼짐 상태 양쪽 동일 실측)
  const atS = sl <= 1, atE = max <= 1 || sl >= max - 1;
  rail.classList.toggle('atStart', atS);
  rail.classList.toggle('atEnd', atE);
  const wrap = rail.closest('.geni-railwrap'); if (wrap) { const nv = wrap.querySelectorAll('.geni-nav'); if (nv[0]) nv[0].disabled = atS; if (nv[1]) nv[1].disabled = atE; }
}
function geniRailHome() { ['#geniStyle', '#geniSub'].forEach(s =>{ const r = $(s); if (r) { r.scrollLeft = 0; requestAnimationFrame(() => geniRailUpd(r)); } }); }   // 폼 개막 = 두 레일 좌측 정렬선에서 시작(끌어둔 스크롤 잔존 = 열림 순간 첫 키워드가 선 밖 · 평의회⑦ 260714) + 페이드·화살표 실측 재계산(표시 후 호출 정본 — 숨김 중 계산 = scrollWidth 0 오판) · 호출 = 팝업 openGenIdlg·이식 geniMount 두 홈
// ⚠ 재계산은 **다음 프레임**으로(260811 평의회3 실측 봉합) — AI 생성 탭은 이 직전에 노드 388개를 통째로 옮기고 호스트를 방금 켠 참이라 문서가 전부 더러운 상태다.
