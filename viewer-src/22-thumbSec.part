function geniRefDownscale(file) {   // ≤512px 최장변 JPEG · base64 ≤48000자(dispatch input 상한 65535 안전여유) — 참고용 512px면 충분 · 초과 = 품질 낮춰 재시도, 그래도 크면 null
  return new Promise(res => {
    const url = URL.createObjectURL(file), img = new Image();
