  else { _geniSel.aspect = 'custom'; _geniSel.arW = String(bw); _geniSel.arH = String(bh); }   // 그 외 = 직접 N:N 칸에 실측비 주입(환산 표시가 리드백)
}
function _imgFromClipboard(e) {   // paste 이벤트 → 첫 이미지 File(없으면 null) — askText 선례(#askText paste) 공통화
