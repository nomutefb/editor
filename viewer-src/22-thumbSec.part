    const gsSelf = (nm, on, tg) => gsV(nm, on, tg, '탭=켜기/끄기', true);   // 자립 토글 항목 = 옵션 이름 자체가 값(운영자 260727 "ON/OFF 없애고 글자만 · 글자 토글로 대체" · 레퍼런스 = #askStrip 정본) · aria-pressed = ON/OFF 축이라 부여
    const gsPair = (lbl, val, on, tg, tip) => '<span class="gs-lbl">' + lbl + '</span> ' + gsV(val, on, tg, tip);   // 쌍 골격 = 편집 탭 editSpec 정본(콜론 없음 · 라벨 mut + 값 상태색) · 값만 탭 대상(라벨은 글자 그대로)
    const engRail = $('#geniEngRail');   // 모델 칩 = 픽토 자리(구분선 위 · 운영자 260803 "첨부1(편집)이 맞는내용") — 아이콘 칩이 값 그룹 피치(37)에 섞이던 것을 편집 탭 [픽토 묶음→구분선→값] 정본 리듬으로 분리 · 문법·핸들러(gs-tog engine) 불변
    if (engRail) engRail.innerHTML = gsPair('모델', geniEngIco(), true, 'engine', '탭=모델 바꾸기');
    sum.innerHTML = (cloneOn ? [   // 복제 모드 = 화풍·세부·웹툰화·문구가 서버에서 통째로 무시된다 → 요약도 2항으로(켜둔 화풍을 그대로 나열하면 '반영되는 척' = 은폐)
      gsPair('비율', geniAspect() || 'N:N?', true, 'aspect', '탭=다음 비율'),
      gsPair('참고 이미지', '이미지와 동일하게', true),
