      try { c.getContext('2d').drawImage(img, 0, 0, w, h); } catch { URL.revokeObjectURL(url); res(null); return; }
      URL.revokeObjectURL(url);
      let q = 0.72, out = c.toDataURL('image/jpeg', q);   // q-ok: 산출물 아님 = 모델 첨부용 적응형 압축(48KB 상한에 맞춰 q를 낮춰가는 루프라 q90 고정이 불가 · 화면·다운로드에 안 나간다)
      while (out.length - 23 > 48000 && q > 0.3) { q = Math.round((q - 0.1) * 100) / 100; out = c.toDataURL('image/jpeg', q); }   // q-ok: 위 루프의 재인코딩 — 같은 축
      res(out.length - 23 <= 48000 ? out : null);
    };
    img.onerror = () => { URL.revokeObjectURL(url); res(null); };
    img.src = url;
  });
}
async function geniRefPick(file) {   // 파일 선택 → 다운스케일 → 미리보기·배지·토글행 표시 · geniGo가 opts.refB64/refMode로 동봉
  if (!file || !/^image\//.test(file.type || '')) return;
  const dataUrl = await geniRefDownscale(file);
  const btn = $('#geniRefBtn');
  if (!dataUrl) { if (typeof _flashBtn === 'function' && btn) _flashBtn(btn, 'err'); return; }   // 너무 큰/깨진 이미지 = 실패 플래시(현행 헬퍼 계승)
  geniRefClear();
  _geniRef = { b64: dataUrl.split(',')[1], url: dataUrl };
  if (!GENI_REFMODES.includes(_geniSel.refMode)) _geniSel.refMode = 'ref';
  _geniRefNat = { w: 0, h: 0 };   // 첨부 원본 픽셀비 = 복제 모드 비율 스냅 재료(아래 onload에서 실측 · 실패 = 0 유지 = 스냅 없음)
  try { const _pi = new Image(); _pi.onload = () => { _geniRefNat = { w: _pi.naturalWidth, h: _pi.naturalHeight }; if (_geniSel.refMode === 'clone') { geniCloneAspect(); geniApply(); } }; _pi.src = dataUrl; } catch {}
  const pv = $('#geniPrev'), th = $('#geniRefThumb'), gh = $('#geniRefGhost'), xb = $('#geniRefX'), sw = $('#geniRefSwap'), rm = $('#geniRefModeRow');
  if (th) { th.src = dataUrl; th.hidden = false; }
  if (gh) { gh.src = dataUrl; gh.hidden = false; }   // 고스트 = 같은 이미지 cover 반투명 언더레이(운영자 260719 승인 — 비율 프레임에 앉는 모습)
  if (pv) pv.classList.add('has');
  if (xb) xb.hidden = false;   // 첨부됨 = 삭제(휴지통)·교체 툴 노출(thumb 편집 미리보기 이주분 동일 문법 — 260719 쉘 이주)
  if (sw) sw.hidden = false;
  if (rm) rm.hidden = false;
  geniApply();
}
function geniApply() {   // 선택 상태 → 화면 단일 반영점(칩 .on · 선택박스 라벨 · 아코디언 · 게이지 · 요약 리드백 · 게이트)
  geniRoot().querySelectorAll('.geni-opts[data-k]').forEach(box => {
    const k = box.dataset.k;
    box.querySelectorAll('.geni-opt').forEach(b => b.classList.toggle('on', b.dataset.v === _geniSel[k]));
  });
  $('#geniStyle').querySelectorAll('.geni-opt').forEach(b => b.classList.toggle('on', b.dataset.v === _geniSel.style));   // 화풍: 9종 전량 인라인 나열(운영자 260713 — 구 상용3+기타 라벨 승격 로직 폐지)
  geniRailUpd($('#geniStyle')); geniRailUpd($('#geniSub'));   // 레일 페이드·화살표 상태 갱신(열림·선택 반영 후)
  const subOn = _geniSel.sub !== 'auto';   // 세부 화풍: 인라인 파이프 나열(운영자 260713 — 구 자동+직접 선택박스 폐지) · 목록 재구성·on 토글 = geniSubRender 단일점
