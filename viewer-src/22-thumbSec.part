  const eng = $('#geniEngine'); if (eng) eng.querySelectorAll('.geni-opt').forEach(b => { const ico = b.querySelector('.eng-ico'); if (ico && !ico.firstChild) ico.innerHTML = b.dataset.v === 'gpt' ? AI_SVG : GEMINI_SVG;   /* Gemini = 구글 G 레터마크(운영자 260727 "구글을 나타내는 G 그거 써서 표시" → 260803 재확인 「G라고 뉴스 요약한 부분에 보면 있음」 · nm-svg.js GEMINI_SVG = G_SVG 별칭) — 별 계열 2안(260802 쌍성 ⑤ · 260803 4점 별 ②)은 GPT 스파클 결과 겹쳐 전건 회수 · 구글 이미지 검색 버튼과 한 픽토 공용 = 260727 정본 복귀 */ b.classList.toggle('on', b.dataset.v === _geniSel.engine); });   // 모델 = 두 칩 상시 나열(운영자 260728) · 브랜드 자리 = 픽토그램(운영자 260727 "구글 나타내는 G로 제미나이 표시 · 오픈에이아이는 인공지능 픽토그램") — 구글 = G_SVG 레터마크 · OpenAI = AI_SVG 스파클(둘 다 nm-svg.js 정본) · 픽토+텍스트 조합 문법 = #toolTitle 정본 · 픽토 주입 = 최초 1회(빈 자리일 때만 = #geniEngTip .eng-ico 문법 계승 · 매 apply innerHTML 재작성 안 함)
  const engTip = $('#geniEngTip'); if (engTip) engTip.hidden = !(_geniSel.style === 'lego' && _geniSel.engine === 'gemini');   // 레고 + 제미나이일 때만 안내 노출(운영자 260727 반전 재지시) — GPT로 되돌리거나 화풍을 바꾸면 조용히 사라진다
  const engTipIco = $('#geniEngTip .eng-ico'); if (engTipIco && !engTipIco.firstChild) engTipIco.innerHTML = AI_SVG;   // 안내 안 GPT 브랜드 자리 = 모델 칩과 같은 AI 스파클(같은 대상을 가리킨다는 신호)   // 렌더 엔진 = 두 모델 교대 토글(기본 Gemini = 중립 · GPT = 점등 = 기본값 이탈 표기 관례 계승 · 운영자 260727)
  const ton = $('#geniTextOn'); if (ton) { ton.classList.toggle('on', !!_geniSel.textOn); ton.setAttribute('aria-pressed', _geniSel.textOn ? 'true' : 'false'); ton.textContent = _geniSel.textOn ? '켜짐' : '꺼짐'; }   // 문구 = 단일 칩 ON/OFF 토글(운영자 260728 · 한국웹툰화와 한 쌍 회수) · 반갈 뒤 칩 = 상태값 전담(운영자 260727)
  const rmMode = GENI_REFMODES.includes(_geniSel.refMode) ? _geniSel.refMode : 'ref';   // 참고 이미지 모드 = 원본 유지/참고/이미지와 동일하게(운영자 260726)
  const rmb = $('#geniRefMode'); if (rmb) rmb.querySelectorAll('.geni-opt').forEach(b => b.classList.toggle('on', b.dataset.v === rmMode));   // 참고 이미지 모드 토글 on-state
  const cloneOn = !!(_geniRef && rmMode === 'clone');   // 복제 모드 = 화풍·세부·웹툰화·문구가 프롬프트에서 통째로 빠지는 모드(스타일 낱말 0개가 이 모드의 전부 — 서버가 무시하므로 요약도 그렇게 읽혀야 은폐가 아니다)
