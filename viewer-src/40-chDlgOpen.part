// 처방(2단): ① 1회 자동 재로드(전형적 일시 스톨은 여기서 해소) ② 그래도 무응답이면 fail-safe 리빌(.ready 부여)
//   = 구 260724 이전 동작으로 복귀 = 빈 화면일지언정 '멈춘 로딩'에 갇히지 않음(정직 · orb는 즉시 사라짐).
// ── 조기 리빌 = '틀 먼저'(운영자 260725 "일단 틀 띄워놓고 로딩에 제반되는 내용을 그 다음에 준비하게 하지") ──
// 왜: iframe load는 폰트·이미지·CDN 등 *마지막 하위 리소스 1개*까지 기다린다 → 뼈대는 진작 다 그려졌는데
//   느린 리소스 하나 때문에 프레임 전체가 opacity 0로 잠겨 "왜 이렇게 늦게 떠?"가 된다(무한로딩의 완만한 형제).
// 처방: same-origin 문서의 readyState가 'loading'을 벗어나는 순간(=DOMContentLoaded = 인라인 스크립트까지
//   실행 완료 = 틀 완성) 즉시 리빌. 남은 리소스는 보이는 화면 뒤에서 계속 채워진다(체감 = 즉시 표시).
//   cross-origin(폴링 불가) = 종전대로 load/워치독에 위임.
// ── 노출 직전 부모 주입(운영자 260805 「첨부1 화면이 나왔다가 지연된 다음 정상 출력」) ───────────────
// 왜: thumbTabBridge(내부 #tabs 숨김 + .panel −18)는 **iframe load**에만 걸려 있었는데, 리빌(.ready)은
//   frEarly·워치독이 그보다 **먼저** 붙인다 → 그 사이 구간엔 thumb 내부 탭바가 부모 탭바 밑에 겹쳐 그려진다
//   (실측 260805 폰 4G·CPU4x: 리빌 515ms → 주입 3,779ms = **3,264ms 동안 탭바 2줄 + 첫 소머리 −18 미적용**).
//   운영자 첨부1이 정확히 이 구간의 사진이다(둘째 줄 탭 4개 = 번역이 빠진 thumb **자체** 탭바 = 부모 승격 전 원본).
// 처방: 리빌을 붙이는 **모든** 경로(frEarly·워치독 fail-safe)가 이 함수를 먼저 통과 = 주입이 페인트보다 항상 앞선다.
//   idempotent(_thumbTabHide id 가드·tabsEl._parentSynced 가드)라 load 때 재호출돼도 무해 = 기존 load 경로는 무접촉 존치(폴백).
function frPreReveal(fr, d) {
  try { if (d && fr === toolFrames.thumb) thumbTabBridge(d); } catch (_) {}
}
const FR_DCL_TICKS = 30;   // raw-ok: 폴링 틱 수(개수 — 지속시간 토큰 아님) · 100ms×30 = 3s 유예(아래 사유) · 워치독 11s보다 짧아 폴백 순서 보존
function frEarly(fr) {
  if (!fr) return;
  clearInterval(fr._er);
  let n = 0;
  fr._er = setInterval(() => {
    if (fr.classList.contains('ready') || ++n > 180) { clearInterval(fr._er); return; }   // 이미 노출·상한(≈18s) = 워치독이 뒤를 받음
    let d = null;
    try { d = fr.contentDocument; if (!d || d.location.href === 'about:blank') return; } catch (_) { clearInterval(fr._er); return; }   // cross-origin = 위임
    if (!d.body || !d.body.firstElementChild) return;   // 뼈대 0 = 빈/흰 프레임 노출 차단
    // 「파싱 중이어도 그려진 게 있으면 통과」는 **3s 유예 뒤**로 미룬다(운영자 260805) — 위 260725 주석이 선언한 정본은
    //   「readyState가 'loading'을 벗어나는 순간(= DOMContentLoaded = 인라인 스크립트까지 실행 완료 = **틀 완성**)」인데
    //   실제 조건은 그보다 앞선 '뭐라도 그려졌으면 통과'라, thumb처럼 **틀을 인라인 스크립트가 만드는** 문서에선 반쪽 화면이 나갔다
    //   (thumb.html 실측 260805 = 마크업 27.8~35.1% · 나머지 65%가 인라인 <script> 430KB → 마크업만 파싱된 순간 리빌 =
    //    도크·폼 없이 내부 탭바 + 결과/이전제작 뼈대만 뜬 화면 = 운영자 첨부1의 나머지 절반).
    //   유예 안에 DCL이 오면 완성 틀이 나가고, 안 오면 구 동작 그대로 통과 = 「파서를 막는 스크립트 뒤에서 무한정 기다리지 않는다」는
    //   260725 취지 보존(최종 폴백 = 워치독 FR_WD_MS).
    if (d.readyState === 'loading' && (n <= FR_DCL_TICKS || !d.body.getBoundingClientRect().height)) return;
