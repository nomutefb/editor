function chDlgOpen(dg) { if (!dg.open) { dg.showModal(); try { history.pushState({ chdlg: true }, ''); } catch {} } }
window.addEventListener('popstate', () => {
  if (_chClosing) { _chClosing = false; return; }
  ['#chdaydlg', '#chpostdlg'].forEach(sl => { const dg = $(sl); if (dg && dg.open) { _chPop = true; dg.close(); } });
});
['#chdaydlg', '#chpostdlg'].forEach(sl => { const dg = $(sl); if (!dg) return;
  dg.addEventListener('close', () => { if (_chPop) { _chPop = false; } else if (history.state && history.state.chdlg) { _chClosing = true; try { history.back(); } catch {} } });
  dg.querySelector('.dlg-x').addEventListener('click', () => dg.close());
});
function openChDay() {   // 일별 상세 = 전 기간 표(최신 위 · 게시>0 = 강조)
  const rows = ((chActive() || {}).daily_series || []).slice().reverse();   // 활성 소스(1-1/1-2) 상세 — 전역 CHAN 하드코딩 정정(Q155 후속 · 페이블 검증단)
  if (!rows.length) return;
  let h = '<table class="chd-t"><thead><tr><th>날짜</th><th>게시</th><th>조회</th><th>도달</th><th>방문</th><th>팔로우</th></tr></thead><tbody>';
  rows.forEach(r => {
    h += `<tr><td>${esc(String(r.date).slice(2))}</td><td class="${r.posts ? 'pp' : 'pz'}">${r.posts != null ? r.posts : '—'}</td>` +
      ['views', 'reach', 'profile_views', 'follows'].map(k => `<td>${r[k] != null ? chFmtK(r[k]) : '—'}</td>`).join('') + '</tr>';
  });
  $('#chdBody').innerHTML = h + '</tbody></table>';
  $('#chdN').textContent = rows.length + '일';
  chDlgOpen($('#chdaydlg'));
}
let CHP = { sort: 'views', fmt: '전체', cat: '전체' };   // 게시물 탐색 상태(정렬·포맷·주제)
function renderChPost() {
  const all = (chActive() || {}).posts || [];   // 활성 소스 게시물(1-1/1-2)
  const cats = ['전체', ...new Set(all.map(x => x.cat).filter(Boolean))];
  $('#chpFmt').innerHTML = ['전체', '릴스', '피드'].map(f => `<button class="ch-mchip${CHP.fmt === f ? ' on' : ''}" type="button" data-f="${f}">${f}</button>`).join('');
  $('#chpCat').innerHTML = cats.map(c => `<button class="ch-mchip${CHP.cat === c ? ' on' : ''}" type="button" data-c="${c}">${c}</button>`).join('');
  const hasV = k => k === 'new' || all.some(x => x[k] != null);   // 정렬축 데이터 존부(활성 소스 게시물 기준 · 최신 = iso 상존)
  if (!hasV(CHP.sort)) CHP.sort = hasV('views') ? 'views' : hasV('eng') ? 'eng' : 'new';   // 활성 소스에 값 없는 축 선택 잔존 시 폴백(조회수→반응→최신)
  $('#chpSort').innerHTML = [['views', '조회수'], ['eng', '반응'], ['share_pm', '공유율'], ['save_pm', '저장률'], ['new', '최신']].filter(s0 => s0[0] !== 'eng' || hasV('eng')).map(s0 => `<button type="button" data-s="${s0[0]}"${CHP.sort === s0[0] ? ' class="on"' : ''}${hasV(s0[0]) ? '' : ' disabled'}>${s0[1]}</button>`).join('');   // 값 전무 축 = disabled 흐림(운영자 260723 "ㄱ 아니면 다른 값이 있으면 대체" — fb views·share_pm 미수집 축 눌러도 무변화 혼란 차단) · '반응'(eng = 반응+댓글+공유 합 · fb_fetch 산출) = 값 있을 때만 노출되는 대체 축(disabled 버튼 = 클릭 이벤트 자체 미발화라 기존 위임 배선 무접촉)
  let list = all.filter(x => (CHP.fmt === '전체' || x.format === CHP.fmt) && (CHP.cat === '전체' || x.cat === CHP.cat));
  list = list.slice().sort((a, b) => CHP.sort === 'new' ? String(b.iso || '').localeCompare(String(a.iso || '')) : (b[CHP.sort] || 0) - (a[CHP.sort] || 0));
  const tmed = (chActive() || {}).topics || {};   // 활성 소스 주제 중앙값(fb = topics 방출 시 eng 중앙값 · 미방출이면 배지 자동 미표시)
  $('#chpList').innerHTML = list.map((x, i) => {
    const _mv = x.views != null ? x.views : x.eng, tm = tmed[x.cat], ratio = tm && tm.views_med && _mv != null ? _mv / tm.views_med : null;   // 주제 중앙값 대비 배율(운영자 260713 한 수 ㄱㄱ) — 같은 주제 안 특출도 · FB 소스분기(평의회 260724 must-fix): views 부재 시 eng로 비교(topics.views_med = fb는 eng 중앙값) + null 방어(구: null/med = ×0.0 유령 배지 전 행 부착 회귀 차단 · IG는 x.views 그대로 = 무회귀)
    const rt = ratio != null ? ` <i class="${ratio >= 10 ? 'hot' : ''}">×${ratio.toFixed(1)}</i>` : '';   // hot = ×10+(TOP100 분포 실측 p90 17.4·중앙 2.3 — 상위 20%만 점등)
    return `<a class="chp-row" href="${escUrl(x.permalink || '#')}" target="_blank" rel="noopener"><span class="trend-rank">${i + 1}</span><span class="chp-tt" data-nm></span><span class="chp-ct">${esc(x.cat || '—')}${rt}</span><span class="chp-mt">${x.views == null && x.eng != null ? '반응 ' + chVf(x.eng) : chVf(x.views) + ' · 공유 ' + (x.share_pm != null ? (+x.share_pm).toFixed(1) : '—')}</span></a>`;
  }).join('');
  const nms = $('#chpList').querySelectorAll('[data-nm]'); list.forEach((x, i) => { if (nms[i]) nms[i].textContent = x.name || '(무캡션)'; });   // 캡션 = textContent 주입(XSS 안전 관용구)
  $('#chpN').textContent = list.length + '/' + all.length;
}
function openChPost() { if (!((chActive() || {}).posts || []).length) return; renderChPost(); chDlgOpen($('#chpostdlg')); }   // 활성 소스 게이트(fb 게시물 없으면 조용 무동작 유지)
// 채널 소스 세그(헤더 정적 · Q157) 전역 1회 배선 — 전환 = 재렌더·스크롤 보존 · fb 미적재 = 캐시 무효화 재적재(페이블 검증단 LOW 유지)
{ const _cst = document.getElementById('chanSrcTgl'); if (_cst) _cst.addEventListener('click', () => {
  CHAN_SRC = CHAN_SRC === 'fb' ? 'ig' : 'fb'; const y = window.scrollY; renderChan(); window.scrollTo(0, y);   // 단일 IG⇄FB 토글 = 소스 순환(운영자 260720 — 구 2버튼 명시 선택[Q233] 대체 · 항상 점등 · 활성/라벨은 renderChan 갱신)
  if (CHAN_SRC === 'fb' && !CHAN_FB && !CHAN_LOADING) { CHAN_AT = 0; loadChan(); }   // fb 최초 탭 lazy 로드 유지
}); }
// 채널 요약 인스타 링크 = 인앱 팝업(운영자 260809 "링크가 창 위에 팝업되게 · sns 요약에서 새창으로 안 넘어가는 것처럼 · 다른 앱이나 웹 창으로 전환 안 되게").
// 대상 2종 = ⓐ 브리프 본문의 골드 참조(a.tbrief-ref) ⓑ 최근 게시물 타일 12칸(a.ch-th — 운영자 "혹시 인스타 아래 12개도 그렇게 가능한지" = 같은 팝업 재사용이라 가능).
// ⚠ 마크업은 <a href> 그대로 둔다(창작 0 · 접근성·공유·새 탭 폴백 보존) — 여기서 기본 동작만 가로챈다.
// ⚠ 새 탭 의도(중·보조 클릭·Ctrl/Cmd/Shift·롱프레스 컨텍스트)는 통과시킨다 = trefdlg의 "롱프레스/새탭 = href 보존 폴백" 관례 계승.
// ⚠ document 위임 1회 = renderChan이 innerHTML을 통째로 갈아끼워도 배선이 안 끊긴다(재렌더 무관 = 아래 #chpostdlg 관례 동축).
document.addEventListener('click', e => {
  if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
  const box = e.target.closest('#chanBox'); if (!box) return;   // 스코프 = 채널 요약 판(메뉴3 스크랩 참조는 openTref가 계속 담당)
  const a = e.target.closest('a.tbrief-ref, a.ch-th'); if (!a) return;
  const u = a.getAttribute('href') || '';
  if (!/^https?:\/\/(?:www\.)?instagram\.com\/(?:p|reel|reels|tv)\//.test(u)) return;   // 인스타 게시물만(그 외 링크는 종전 동작)
  e.preventDefault();
  openIgPost(u, a.classList.contains('ch-th') ? (a.dataset.cap || '') : a.textContent);   // 타일 = data-cap(캡션) · 브리프 참조 = 링크 글자 자신
});
(() => { const w = $('#chpostdlg'); if (!w) return;   // 칩·세그 = 위임 1회 배선(재렌더 무관)
  w.addEventListener('click', e => {
    const f = e.target.closest('[data-f]'), c = e.target.closest('[data-c]'), s0 = e.target.closest('[data-s]');
    if (f) CHP.fmt = f.dataset.f; else if (c) CHP.cat = c.dataset.c; else if (s0) CHP.sort = s0.dataset.s; else return;
    renderChPost();
  });
})();

// ── ✨ 요약 요청(멀티모달 입력) — 자연어+캡처 → 큐레이션 요청 ──
const askdlg = $('#askdlg');
let askImages = [];   // 압축 이미지 {dataUrl, kb}
const ASK_MAX = 3;   // 첨부 최대 3장(운영자 260629 · 한 줄 유지)
let _askResolveId = null;   // 실패 픽 복구로 열렸으면 그 candId — 전송 성공 시 복구표시
let _askRetryOf = null;     // ✨요약요청 실패 재시도로 열렸으면 옛 실패 base id — 전송 성공 시 submit 이 옛 asks/failed 삭제(중복 잔존 방지 · 평의회10 Q1·Q3)
// ── 수집 프리셋(운영자 260723 "항상 기본 프리셋" · 260803 외신⇄국내 단일 토글) — 24시간 내 h24 · 외신 기반 fp · 원본 한정 og · AI 미제작 noai · 창 열 때마다 기본 점등 재계승(_genImgOvr 건별 리셋 문법) · 값 = api/submit preset → asks/*.json → ask.sh 프롬프트 배선 ──
let askPreset = { h24: 1, fp: 0, mj: 1, og: 0, noai: 1 };   // fp = 외신 기반 = 기본 소등(소등 = 국내 기반 · 운영자 260803 "하나로 합쳐서 on off" — 구 「외신 기사 위주」에서 라벨 개정) · mj = 다매체 종합(주요 언론 2~4곳·≈2천자) = **상시 1 고정**(운영자 260803 — 구 「주요 언론 기반」 칩 철거·외신 기반 토글로 흡수: 종합은 어느 축이든 항상 · 값을 계속 전송해 서버 submit·ask.sh 파서·구 대기열 표기 전층 무접촉 = 260803 기본 보강 모드 손상 0) · og = 원본 한정(운영자 260727) · noai = AI 미제작(운영자 260727 "미제작이 기본값") = **기본 점등**[= 평소엔 AI 썸네일을 안 만들고, 만들 건에서만 끈다] · fp·og 는 소등 출발(평소 동작이 아니라 명시적으로 켜는 제한). noai 만 성격이 다르다 = 수집 조건(ask.sh 프롬프트)이 아니라 산출 조건 = 전송 nothumb 축(제미나이 썸네일 생성 skip · 검색 og:image 는 무관·항상 수집)
const ASK_PRESET_IDS = { h24: 'apH24', fp: 'apFp', mj: 'apMj', og: 'apOg', noai: 'apNoai' };   // apMj = 260803 UI 철거(요소 부재 → 아래 paint·바인딩의 if(el) 가드가 자동 스킵 = mj 상시 1 유지 · 키 잔존 = 코드 경로 무변경)
function paintAskPreset() { for (const k in ASK_PRESET_IDS) { const el = $('#' + ASK_PRESET_IDS[k]); if (el) { el.classList.toggle('on', !!askPreset[k]); el.setAttribute('aria-pressed', askPreset[k] ? 'true' : 'false'); } } }   // 표기 = 라벨 상시 노출 + 점등(.on = accent)/소등(mut)만 — ON/OFF 문자 교체 폐지(운영자 260726 "on, off로 구분하지 않음") · 상태 전달은 aria-pressed 가 담당(role=button 짝)
for (const k in ASK_PRESET_IDS) { const el = $('#' + ASK_PRESET_IDS[k]); if (el) { const tg = () => { askPreset[k] = askPreset[k] ? 0 : 1; paintAskPreset(); }; el.addEventListener('click', tg); el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); tg(); } }); } }   // 토글 바인딩 = thumb 스트립 bind 정본 문법(클릭 + Enter/Space)
function openAsk(opts) {
  opts = opts || {};
  bpop.hidden = true; linkpop.hidden = true;   // (상태문자열 잔상 리셋 소멸 — askStatus 폐지·qFlash 위임 260720)
  _askResolveId = opts.resolveId || null;
  _askRetryOf = opts.retryOf || null;   // 재시도 재제출이면 옛 실패 id(전송 성공 시 submit 이 옛 asks/failed 삭제) · 일반 열기면 null
  _genImgOvr = null; paintGenImgTg();   // AI 썸네일 = 창 열 때마다 설정 디폴트 계승(건별 오버라이드 리셋 · 운영자 260709) — 호출 시점엔 선언 완료(이벤트 경유)라 TDZ 무해
  askPreset = { h24: 1, fp: 0, mj: 1, og: 0, noai: 1 }; paintAskPreset();   // 수집 프리셋 = 창 열 때마다 기본 상태 재계승(fp·og = 소등, noai = 점등으로 복귀 · 건별로 끈 걸 다음 요청까지 끌고 가지 않는다) · 화면 기본 점등 = h24·noai 2종 + mj = 비표시 상시 1(260803 외신 기반 토글로 흡수 · 건별 오버라이드 리셋 · 운영자 260723 "항상 기본 프리셋 · 불 들어와 있고 끄면 꺼지게")
  if (opts.prefill != null) $('#askText').value = opts.prefill;   // 프리필 = askRetry 가 복원한 전문 전체(실패 재시도) 또는 제목·URL
  updateAskClip(); updateAskPh();
  openTool(null, '요약 요청', ASK_TABS, 'ask');   // 도구 셸(운영자 260712 — 이미지·영상과 동일 UIUX) = 탭 {요약 요청(기본)·미디어 요약} · 히스토리 칸 = 도구 모달이 관리(옛 openComposeDlg(askdlg) 대체 · 전 진입로[라디얼·실패 재시도·프리필] 공통)
  setTimeout(() => { const ta = $('#askText'); ta.focus(); if (opts.prefill != null) { const i = ta.value.length; try { ta.setSelectionRange(i, i); } catch {} } }, 60);
}
// ── 요약 요청 가상 탭(#ask) — askdlg 폼을 도구 셸에 이식(운영자 260712 "이미지 부분하고 동일하게 · 요약 요청/미디어 요약 2구분") ──
// 폼·전송·첨부·AI썸네일 토글·재시도 로직 = #askdlg 원본 그대로(reparent = 복제 0·드리프트 0). askdlg <dialog>는 보관함으로 잔존.
const _askWrap = document.querySelector('#askdlg .askwrap');
function askMount() {   // 가상 탭 활성 = askwrap을 도구 셸 안으로 + iframe 전부 숨김(보존)
  const h = $('#askHost'); if (!h || !_askWrap) return;
  if (_askWrap.parentElement !== h) h.appendChild(_askWrap);   // DOM 이동 = 입력값·리스너 보존
  h.hidden = false;
  for (const k in toolFrames) toolFrames[k].classList.remove('active');   // iframe 숨김(폼 보존 · 미디어 요약 탭 복귀 시 재활성)
  tooldlg.classList.add('frame-ready');   // 가상 탭 = load 이벤트 없음 → 즉시 표시
}
function askUnmount() {   // 닫기·최소화 시 원위치(askdlg 보관함) — DOM 이동이라 입력값 그대로 보존
  const h = $('#askHost'); if (h) h.hidden = true;
  if (_askWrap && _askWrap.parentElement !== askdlg) askdlg.appendChild(_askWrap);
}
function closeAskSurface() {   // 전송 성공 후 닫기 — 도구 셸에 떠 있으면 셸을, 아니면(레거시 경로) askdlg를
  if (tooldlg.open && curToolKey === 'ask') { try { tooldlg.close(); } catch (_) {} }
  else { try { askdlg.close(); } catch (_) {} }
}
// 제작 도구(썸네일·자막) = 라디얼 항목 클릭 → 새 페이지 대신 뷰어 위 모달(iframe)로 등장.
const tooldlg = $('#tooldlg');
// 폰/브라우저 뒤로가기 = 도구 닫고 메인으로(앱 이탈 차단). 열 때 히스토리 1칸 푸시 → 백버튼이 그 칸을 pop.
let toolPopHandled = false;   // popstate(백버튼)로 닫혔는지 — close 핸들러의 히스토리 정리 분기
let toolMinimizing = false;   // close 핸들러 1-shot 가드 — 최소화(폼 보존 닫기) vs 정규 닫기 구분
let toolMin = false;          // 최소화 상태(▲ 복원 버튼 떠있음)
let lastToolRect = null;      // 최소화 직전 모달 rect — 고스트 FLIP·펼침 타깃 재사용
// ── 다중 도구 창(이미지·영상) 독립 최소화 (운영자 260628 버그픽스) ───────────────
// 옛: #tooldlg 단일 iframe 공유 + MIN_REG 고정키 'tooldlg' → 둘째 도구 최소화가 첫째 엔트리를 덮어 1개만 떴다.
// 픽스: 도구별 iframe 보존 + 도구키별 MIN_REG. 활성 프레임만 .active(표시)·나머지는 display:none로 살려둠(폼 보존). 활성 프레임 참조 = activeToolFrame().
const toolFrames = {};        // toolKey → iframe
const toolMeta = {};          // toolKey → { title, tabs, src } (복원용)
let curToolKey = null;
function activeToolFrame() { return (curToolKey && toolFrames[curToolKey]) || document.querySelector('#tooldlg .toolfr.active') || document.getElementById('toolframe'); }
function thumbTabBridge(d) {   // 이미지(thumb) 탭 부모 승격(260704) = 내부 #tabs 숨김 + 내부 탭변화(b4 FAB·selApp) 역동기 → 부모 .tooltab 하이라이트. thumb.html 무접촉(부모가 style 주입+observer·same-origin).
  try {
    if (!d.getElementById('_thumbTabHide')) { const s = d.createElement('style'); s.id = '_thumbTabHide'; s.textContent = '#tabs{display:none!important} .panel{margin-top:-18px}'; (d.head || d.documentElement).appendChild(s); }   // 내부 탭바 숨김(부모 .tool-tabs로 승격) + 첫 소머리 −18px = 영상(ly/k) 첫 블릿 화면선 정합(thumb 첫 .csec margin-top 16 vs 영상 label 0 델타 · thumb.html 무접촉 · 운영자 260704 · 구 −16 → −18 = 260803 덜컹 소멸 개정 — wrap 상단패딩(18) 전액 상쇄 = 도크 정지 y0 → sticky top:0 동일점, 7표면 도크 -18 동시 개정과 한 축) · ⚠️ thumb.html:36 .tabs margin-bottom 26(옛 187px 첫블릿 정렬 보정)은 이 display:none으로 dead화 — 첫 소머리 화면선 잔차(~2~5px thumb-low 추정)는 라이브 실측 후 필요시 이 주입 스타일에 스코프 보정(예 .wrap padding-top·첫 .csec margin-top 델타 = thumb.html 무접촉 유지)
    const tabsEl = d.getElementById('tabs'); if (!tabsEl) return;
    const sync = () => { if (curToolKey !== 'thumb') return; if (((toolMeta.thumb || {}).app) === 'tr') return; /* 번역 탭 활성 중 = 숨은 thumb 내부 상태 역동기 차단(하이라이트 강탈·geni 자동이식 방지 · 260721) */ const on = d.querySelector('.tab.on'); const app = on && on.getAttribute('data-app'); if (!app) return; if (toolMeta.thumb) toolMeta.thumb.app = app; $('#toolTabs').querySelectorAll('.tooltab').forEach(x => x.classList.toggle('on', x.getAttribute('data-app') === app)); if (app === '6' && tooldlg.open && !(toolMeta.thumb && toolMeta.thumb.geniFired)) geniMount(); };   // curToolKey 가드 = cap(영상) 활성 중 비활성 thumb 탭변화가 공유 #toolTabs(=cap 탭바) 오염하는 것 차단(재검증 2명 수렴·미래 방어·260704) · app 6 역동기 = 폼 자동 이식(운영자 260714 Q02 "처음 켜도 버튼 없이 폼 바로" — 부팅이 app 6으로 복원돼 하이라이트만 옮고 폼은 버튼 관문 뒤에 갇히던 덫 봉합 · geniFired 발사 직후 = 잡 그리드 유지 · geniMount 내부 가드{팝업 열림·이미 이식}가 이중 방어 · tooldlg.open = 최소화 중 백그라운드 격발 차단)
    if (!tabsEl._parentSynced) { tabsEl._parentSynced = true; new MutationObserver(sync).observe(tabsEl, { subtree: true, attributes: true, attributeFilter: ['class'] }); }
    sync();   // 초기 동기(thumb 로드 시 selApp('2')=썸네일 → 부모 하이라이트 정합)
  } catch (_) {}
}
// ── 프레임 로드 워치독(운영자 260725 "번역 무한로딩") — load 이벤트가 *영영 안 오는* 경우의 탈출구 ──
// 왜: 리빌 게이트(.ready)는 오직 iframe load에만 걸려서, load가 안 오면 .tool-loading orb가 무한 회전(멈춤 오인).
