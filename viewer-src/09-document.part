</script>
<noscript><style>html{scrollbar-width:thin;scrollbar-gutter:stable}html::-webkit-scrollbar,body::-webkit-scrollbar{width:10px;height:10px;display:block}</style></noscript><!-- no-JS 폴백 = 네이티브 스크롤바 복귀(구 html 규칙 원값) — JS가 있으면 cscroll.js 오버레이가 담당하므로 폭 0이 정답이고, JS가 죽은 창에서만 네이티브 바+거터 예약이 되살아난다(운영자 260726 픽토 점프 수정과 짝 · 폴백 유지 계약 = 14167행 주석) -->
