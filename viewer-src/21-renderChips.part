function renderChips() {
  const c = $('#chips'); if (!c) return;
  const none = !FILTERS.cats.size && !FILTERS.issue;
  let h = `<button class="chip chip-all${none ? ' on' : ''}" data-f="all">전체</button>`;
  h += `<button class="chip chip-iss${FILTERS.issue ? ' on' : ''}" data-f="issue">이슈</button>`;   // 이슈 = 긴급+이슈 통합 토글(켜면 breaking·issue 둘 다 표시·운영자 260621)
  h += CHIP_CATS.map(cat => { const on = FILTERS.cats.has(cat); return `<button class="chip${on ? ' on' : ''}" data-cat="${cat}">${cat}</button>`; }).join('');   // 무채색 통일 — 활성 칩 = 중립 흰색(.chip.on)·카테고리 고유색 inline 제거(운영자 260629 · 카드 카테고리색 CAT_COLOR는 불변)
  c.innerHTML = h;
}

let LOAD_SEQ = 0;   // load() 세대 토큰 — 복귀 핸들러·60s 폴·탭전환이 겹칠 때 늦게 도착한 옛 응답이 새 DATA를 덮는 out-of-order 차단(QA7 선존 지적 260706)
async function load() {
  const _g = ++LOAD_SEQ;
  try {
    const r = await fetch('articles.json?_=' + Date.now());
    const j = await r.json();
    if (_g !== LOAD_SEQ) return;   // stale 응답 폐기 — 더 새 load가 떠 있음(그쪽이 렌더)
    DATA = j.articles || [];
    FEED_GEN = j.generated || '';   // 이 피드가 만들어진 배포본 시각 — 대기열 lag 행이 '어디까지 반영됐나'를 그 자리서 말한다(배포 적체 진단 · 260803)
    dateHead(j.count || DATA.length);
  } catch(e) { if (_g !== LOAD_SEQ) return; if (!DATA_LOADED) DATA = []; const d = $('#dhCnt'); if (d) d.textContent = 'articles.json 없음'; }   // last-good 유지(분신8 260706): 60s 폴 중 네트워크 blip 1회에 피드 전체가 '결과 없음'으로 비워지던 것 차단 — 첫 로드 실패만 빈 상태
  const _firstLoad = !DATA_LOADED; DATA_LOADED = true;   // 첫 로드 완료 표시
  render();
  if (_firstLoad && CURTAB === 'scrap' && SCRAP_LOADED) renderScrap();   // 첫 DATA 도착 = 수집함 1회 재렌더(pickInFeed 정확·Picking 깜빡 보정)
  if ($('#dlg').open && CUR) {
    const a = DATA.find(x => x.file === CUR);
    if (a) await ensureDetail(a);   // 폴링이 DATA를 통째 교체 → 열린 기사의 lazy body/md 재로드(없으면 재렌더가 빈 카드로 깨짐)
    // 상태 안 바뀌면 재렌더 생략 — 60초 폴링이 펼쳐둔 프롬프트를 도로 접는 것 방지
    if (a && ((a.cards && a.cards.state) || '') !== CUR_STATE) { cardSec(a); feedSec(a); }
    // 썸네일 섹션 라이브 동기화 — 픽 직후 '생성 중' 자리표시를 thumb_gen 도착 시 실제 썸네일로 자동 교체(폴링). 수동 '다시 만들기'(THUMB_REDO)는 아래 전용 경로가 처리하므로 제외.
    if (a && !THUMB_REDO.has(CUR)) {
      const cur = $('#mdbody .thumbsec'), sig = thumbSecSig(a);
      if ((cur ? cur.dataset.sig : '') !== sig) {
        const fresh = thumbSec(a);
        if (cur && fresh) cur.replaceWith(fresh);
        else if (cur) cur.remove();
        else if (fresh) { const h1 = $('#mdbody h1'); (h1 ? h1.insertAdjacentElement('afterend', fresh) : $('#mdbody').insertAdjacentElement('afterbegin', fresh)); }
      }
    }
  }
  // 변경 발사 후 자동 제자리 교체 — Map에서 새 이미지(?v 갱신) 온 카드만 빼고 1회 재구성(스크롤 보존).
  if (REPENDING.size && $('#dlg').open && CUR) {
    const a = DATA.find(x => x.file === CUR), c = a && a.cards;
    if (c && c.images && c.images.length) {
      const model = buildFeedModel(a); let swapped = false;
      for (const [k, v] of [...REPENDING]) {
        if (v.file !== CUR) continue;
        // 완료판정 = oldImg(발사 시점 card.versions[cur].image)와 *같은 소스*인 model.versions[cur].image로 비교.
        // ⚠️ c.images[slot](R2/name 경로)은 versions 경로(oldImg)와 URL 체계가 달라, 2판+(이미 한 번 수정) 카드선
        //    내용 무관 항상 !== → 첫 폴(빌드 전)에 조기 '완료' 오판 → 옛 이미지로 되돌리고 폴 중단 = 미반영(운영자 260630).
        const mm = model.find(m => m.n === v.card);
        const newImg = mm ? ((mm.versions[mm.cur] || {}).image || null) : null;
        if (newImg && newImg !== v.oldImg) { REPENDING.delete(k); swapped = true; }
      }
      if (swapped) {   // 새 이미지(+버전) 반영 — 캐러셀 위치 보존하며 피드 재구성(고정 UI가 현재 사진에 재바인딩)
        const tr = $('#feedsec .feedtrack');
        const keepIdx = tr ? Math.round(tr.scrollLeft / (tr.clientWidth || 1)) : 0;
        feedSec(a, keepIdx);
      }
    }
  }
  // 썸네일 '수정·재생성' 완료 감지 — per-sid: 그 화풍 img(?v=)가 바뀌면 그 sid만 해제. 어느 하나 완료 시 섹션 재렌더(완료분=새 이미지 · 잔여분=진행바 유지=thumbStatic 복원)·6분 타임아웃.
  if (THUMB_REDO.size && $('#dlg').open && CUR && THUMB_REDO.has(CUR)) {
    const a = DATA.find(x => x.file === CUR);
    if (a) {
      const rec = THUMB_REDO.get(CUR); let dirty = false;
      for (const base of Object.keys(rec.snap || {})) {
        if (genGenCount(a, base) > rec.snap[base]) { delete rec.snap[base]; dirty = true; }   // 그 화풍 계열이 +1장 = 수정본 도착(운영자 260807) — 구판은 원본 img ?v= 변화를 봤는데 이제 원본은 안 바뀐다
      }
      if (Date.now() - rec.t0 > 600000) {   // 10분 타임아웃(러너 큐+Pages 배포로 6분 초과 가능·평의회 async)
        THUMB_REDO.delete(CUR); dirty = true;
        if (typeof qFlash === 'function') qFlash('이미지 수정이 지연되거나 실패했을 수 있어 — 안 바뀌면 다시 시도해', WARN_SVG);   // 무피드백 침묵 타임아웃 해소(revise 20분 폴백 패턴 계승)
      } else if (!Object.keys(rec.snap || {}).length) THUMB_REDO.delete(CUR);   // 전부 완료(방어적 ||{} — 평의회 통합)
      if (dirty) {
        const old = $('#mdbody .thumbsec'), fresh = thumbSec(a);
        if (old && fresh) old.replaceWith(fresh); else if (old) old.remove();
      }
    }
  }
  reapplyReshooting();   // 재렌더(상태변화·교체)로 사라진 대기 카드 잠금 배지 재적용
}

let _feedSig = '';   // 피드 렌더 시그니처(행·상태·필터) — 직전과 동일하면 재애니 생략(미세 깜빡임 방지)
function render() {
  const q = $('#q').value.trim().toLowerCase();
  const cardonly = $('#cardonly').checked;
  const rows = DATA.filter(a =>
    (!cardonly || hasCardImage(a)) &&
    (!q || ((a.title||'')+' '+(a.title_orig||'')+' '+(a.media||'')).toLowerCase().includes(q)) &&   // 외신 = 번역 제목(a.title)·원문(title_orig) 둘 다 검색 매칭(260703) · ||'' 가드+공백구분자(평의회4: null/undefined 리터럴 오매칭·필드경계 오매칭 차단 = scrap/sns 필터와 통일)
    (!FILTERS.cats.size || FILTERS.cats.has(articleCat(a))) &&
    (!FILTERS.issue || feedBrk(a) || a.issue));   // 이슈 필터 = 긴급(breaking·속보 — feedBrk = grade 게이트 내장 = 배지와 동일 술어)+이슈(a.issue = 빌드타임 issEligible: cross≥10·grade게이트·정형컷 260702) 통합. ⚠️ 구판 raw a.breaking||/속보/ 는 grade 무게이트라 g1 경미가 이슈 필터에 섞였다(운영자 260810 · 배지와 같은 축으로 통일)(a.issue = 빌드타임 issEligible: cross≥10·grade게이트·정형컷 260702) 통합
  const list = $('#list');
  if (!rows.length) { list.innerHTML = (q || cardonly || FILTERS.cats.size || FILTERS.issue) ? '<div class="empty">결과 없음</div>' : '<div class="ghost-card" aria-hidden="true"></div><div class="ghost-card" aria-hidden="true"></div>'; _feedSig = ''; return; }   // 빈 기본 탭 = 고스트 카드 실루엣 2장(운영자 260712 Q2-ⓐ 승인 — 평의회⑩ 1순위 '기본 착지 백지' · 산문 0 = §디자인 e 정신 유지 · 검색·필터 걸렸을 때만 '결과 없음' 피드백)
  // 깜빡임 방지: 행 구성·상태·필터가 직전 렌더와 동일하면 스태거(cardIn) 애니 생략 — 탭 전환·60초 폴의 *동일 데이터* 재렌더가 카드 페이드를 매번 재생해 미세 깜빡임. DOM은 항상 재구성(데이터 최신 보장), 애니만 게이트.
  const sig = rows.map(a => a.file + ':' + (Number(a.rev) || 0) + ':' + ((a.cards && a.cards.state) || '') + ':' + (brkIssueKind(a) || '') + ':' + (isRevising(a.file) ? 'r' : '') + (isCardRetrying(a) ? 'k' : '') + (cardFirePending(a.file) ? 'f' : '')).join(',') + '|' + q + '|' + cardonly + '|' + [...FILTERS.cats].sort().join('+') + '|' + (FILTERS.issue ? 'i' : '');
  if (sig === _feedSig && list.childElementCount) return;   // 구성·상태·필터 완전 동일 = DOM 무접촉 스킵(renderScrap 커밋 스킵 미러 · 평의회6 260707 — 탭 전환 즉시렌더 직후 fetch 재렌더가 통재빌드로 스태거를 절단·이중 비용 내던 것 차단 · sig에 rev/cards.state/긴급/수정중 전부 탑승이라 실변경은 항상 통과). ⚠️ 정직: dlReport/dlScrap의 relAge 상대시간 라벨·progGauge stuck 판정은 sig 밖 = 유휴 동일탭 폴에선 동결·다음 실변경/탭 전환 때 갱신(자가치유) — scrap 7309 커밋 스킵과 동일한 의도적 트레이드오프(신선도 한정·데이터 무영향). sig 밖 동적 요소 추가 시 여기 재검토.
  const _anim = sig !== _feedSig && !_searchRender;   // 내용·필터 바뀐 렌더만 촤르륵, 동일 재렌더·검색 타이핑은 즉시(깜빡임 0) — sig 커밋은 루프 성공 후(아래)
  list.innerHTML = '';
  let _cardFail = false;   // 카드 1장 예외 = 그 장만 스킵 + sig 미커밋(부분 렌더가 3429 스킵으로 영구 동결되던 것 차단 · 평의회 260713 ⑤)
  rows.forEach((a, i) => {
    try {
    const c = document.createElement('div'); c.className='card';
    const kind = brkIssueKind(a); if (kind) c.classList.add(kind);   // 긴급/이슈 → 카드 테두리 점등(.card.brk/.iss) + 우상단 배지
    const g = Number(a.rev) || 0;                    // 서버 회차(완료색·정본) — 1=노랑·2=파랑·0=초록기본
    if (g % 3) c.dataset.gen = (((g % 3) + 3) % 3);
    if (isRevising(a.file)) {                         // 진행 중(클라 임시) = 진행바 물결(현재→다음 색)
      c.classList.add('revving');
      c.style.setProperty('--rv-from', 'rgb(' + revColor(g) + ')');
      c.style.setProperty('--rv-to', 'rgb(' + revColor(g + 1) + ')');
    }
    if (_anim) c.style.animationDelay = Math.min(i, 14) * 32 + 'ms';   // 촤르륵 스태거(내용·필터 바뀐 렌더만)
    else c.style.animation = 'none';   // 동일 재렌더(탭전환·폴) = 즉시 표시 = 깜빡임 0
    c.innerHTML = `
      <div class="cardmain">
        <div class="cardtop"><span class="catslot"><b style="color:${CAT_COLOR[articleCat(a)] || 'var(--fg)'}">${esc(articleCat(a))}</b></span>${dlReport(a)}${kind ? `<span class="urg ${kind}">${kind === 'brk' ? '긴급' : '이슈'}</span>` : ''}<span class="ctop-r">${dlScrap(a)}</span></div>
        <div class="row1"><span class="t"></span></div>
        <div class="s"></div>
        <div class="kv">
          <div class="outcol"><span>매체</span>${a.media ? (/^https?:\/\//i.test(a.url || '') ? `<a class="mlink" href="${esc(a.url)}" target="_blank" rel="noopener"><b>${esc(outletShort(primaryMedia(a.media)))}</b></a>` : `<b>${esc(outletShort(primaryMedia(a.media)))}</b>`) : '<b class="senshyphen">—</b>'}</div>
          <div><span>편향</span>${a.bias ? biasLabel(a) : '<b class="senshyphen">—</b>'}</div>
          ${(_sc => _sc ? `<div class="typecol"><span>민감</span><div class="typewrap">${_sc}</div></div>` : '')(sensChips(a.tags))}
        </div>
        <div class="botrow">
          ${progGauge(a)}
        </div>
      </div>`;
    c.querySelector('.t').textContent = a.title;
    c.querySelector('.s').textContent = a.summary || '';
    c.onclick = () => open(a);
    const _fb = c.querySelector('.urg.brk');   // 피드 긴급 배지 = 수집함 .sc-badge.brk 와 **같은 신고 배선**(한쪽만 달면 다른 화면에선 무반응)
    if (_fb) brkClaimBadge(_fb, a);
    c.querySelector('.mlink')?.addEventListener('click', e => e.stopPropagation());   // 대표 매체 = 원문 링크(새 탭) — 카드 열기(open)와 충돌 방지
    // 진행바 세그먼트 = N/M/T 모달 점프(nav 통합·A5). 본문 클릭(open)과 충돌 방지 stopPropagation.
    c.querySelectorAll('.prog .seg[data-j]').forEach(seg => {
      const go = async e => {
        e.stopPropagation();
        if (seg.dataset.retry) return retryPromptSeg(a, seg);   // 실패한 프롬프트 세그 = 점프 대신 그 자리 재시도(운영자 260727)
        await open(a); requestAnimationFrame(() => jumpTo(seg.dataset.j));
      };
      seg.onclick = go;
      seg.onkeydown = e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(e); } };
    });
    list.appendChild(c);
    } catch (err) { _cardFail = true; }   // malformed 1건이 루프 전체(피드 blank)를 못 죽이게
  });
  if (!_cardFail) _feedSig = sig;   // 전 카드 성공 시에만 커밋 — 실패 렌더는 다음 폴에 전체 재시도(자가치유)
}

// 편향 게이지 바 — N/10 → 옐로→그린 채움, 좌우 무관(N/A) → 빗금
function gauge(b) {
  const m = /(\d+)\s*\/\s*10/.exec(b || '');
  if (m) return `<div class="gauge"><i style="width:${Math.min(100, +m[1]*10)}%"></i></div>`;
  return `<div class="gauge na"></div>`;
}

// ── 카드 셀 하단 헬퍼들(#4~#7) ──
// (NMT 레일 제거 — 진행바 세그먼트가 N/M/T 점프 겸함. A5)
// 민감 태그 → 개별 칩. "#성범죄 #자살자해" 공백 split. "해당 없음"/빈값이면 '' (민감 칸 자체를 안 그림 — 옛 '—' 대시는 베이스라인서 떠 보여 폐지·운영자 260625).
// 본체 7개(SENS_PROTECT)=앰버 경고 틴트(.warn). 목록 외(옛 큐 잔여 태그)=기본 흰 칩(.tagchip).
function sensChips(tags) {
  if (!tags || tags === '해당 없음') return '';
  const arr = tags.split(/\s+/).filter(Boolean).slice(0, 2);   // 민감 = 최대 2개(카드 게이지바 우측선 안 · 초과분은 typewrap …클립·운영자 260702)
  if (!arr.length) return '';
  return arr.map(t => {
    const warn = SENS_PROTECT.includes(t) ? ' warn' : '';
    return `<span class="tagchip${warn}">${esc(t)}</span>`;
  }).join('');
}
// ── 프롬프트 단계 실패 = 게이지 라벨 탭으로 그 자리 재시도(운영자 260727) ──
// 경로 = #cardsec '프롬프트 다시 생성' 버튼과 완전 동일(makeCards 'text' = 2단계만 · 이미지 0). 유료 3단계는 이 축 아님.
// 발사 후 서버 state(generating) 반영까지 60초 폴 공백이 있어, 그 사이만 클라 임시상태로 진행 중 표시(빗금 → 펄스).
const CARD_RETRY = new Map();      // file → 발사 ts
const RETRY_HOLD_MS = 3 * 60000;   // 폴백 해제 — 서버 미반영·응답 유실이어도 이 시간 뒤 진짜 상태로 복귀(영구 가짜 진행 차단)
function isCardRetrying(a) {
  const ts = a && CARD_RETRY.get(a.file); if (!ts) return false;
  if (Date.now() - ts > RETRY_HOLD_MS) { CARD_RETRY.delete(a.file); return false; }
  const up = a.cards && a.cards.updated ? Date.parse(a.cards.updated) : 0;
  if (up && up > ts) { CARD_RETRY.delete(a.file); return false; }   // 서버가 새로 갱신 = 임시상태 종료(진짜 상태가 이김)
  return true;
}
async function retryPromptSeg(a, seg) {
  if (CARD_RETRY.has(a.file)) return;                       // 연타 = 중복 발사 차단
  CARD_RETRY.set(a.file, Date.now());
  seg.classList.remove('fail'); seg.classList.add('cur'); delete seg.dataset.retry;   // 탭 즉시 피드백(재렌더 전에도 빗금 → 진행 펄스)
  const ok = await makeCards(a.file, null, 'text');         // btn 없음 = 게이지 버튼 상태머신 미사용(이 표면엔 버튼이 없다)
  if (!ok) CARD_RETRY.delete(a.file);                       // 실패(alert는 makeCards가) = 임시상태 즉시 해제 → 다시 빗금
  render();
  setTimeout(load, 4000);                                   // 서버 state 조기 반영(60초 폴 대기 단축)
}
// 진행 스텝퍼 B안 — 요약·프롬프트·카드 3세그먼트. 클릭 = N/M/T 모달 점프(nav 통합·A5). 기존 cards.state만.
function progGauge(a) {
  const st = (a.cards && a.cards.state) || '';
  const segs = [['요약','n'], ['프롬프트','m'], ['카드','t']];
  // 시간 초과 미완 = 멈춤 → 펄스 정지(무한 회전 방지·시간 기반 실패 로직). 임계 = 백엔드 상한 정합(cardSec stuck/genStuck과 동일 기준):
  //   렌더(fired_partial) = 10분(운영자 260704) · 프롬프팅(generating) = 26분(CARD_TIMEOUT 25분+1 · 260711 동행 — 성공할 11~25분 카드 오표시 방지).
  const up = a.cards && a.cards.updated;
  const upMin = up ? (Date.now() - Date.parse(up)) / 60000 : 0;
  const stuck = up && upMin > 10;
  const genStuckG = up && upMin > 26;
  const hasMd = !!(a.cards && (a.cards.md || a.cards.has_md));   // 프롬프트(텍스트)까지 갔는지 → 실패 표식 위치 판정 (has_md = 경량 인덱스 플래그·md는 detail lazy)
  let done = 1, busy = false, fail = false;   // done=완료 세그먼트 수(요약은 큐 전건 완료)
  if (st === 'done') done = 3;
  // 멈춤(stuck)이면 '진행되다 깨짐' → 펄스 대신 그 세그먼트에 실패 표식(노랑 빗금·빨강 라벨), 재시도는 cardSec 버튼.
  else if (st === 'fired_partial') { done = 2; if (stuck) fail = true; else busy = true; }   // 카드 발사·이미지 대기
  else if (st === 'text_done') done = 2;                        // 프롬프트까지·카드 대기
  else if (st === 'generating') { if (genStuckG) fail = true; else busy = true; }   // 카드 프롬프팅 중(26분 = CARD_TIMEOUT 정합)
  else if (st === 'failed') { fail = true; if (hasMd) done = 2; }   // 텍스트 있으면 카드 단계 실패(seg 카드)
  if (isCardRetrying(a)) { done = 1; busy = true; fail = false; }   // 라벨 탭 재시도 발사 직후(클라 임시) = 서버 state 반영 전까지 프롬프트 세그를 진행 중으로(빗금 → 펄스 · 운영자 260727)
  // 모달 버튼 발사(CARD_FIRE) = 같은 공백 구간을 이 게이지에도 반영(운영자 260805 "프롬프트 제작중 들어갔는데 진행중인게 안뜬다").
  //   구조 = #cardsec 은 cardFirePending 으로 '제작중…' 로더를 띄우는데(6189·6200) 이 게이지는 서버 st 만 봐서 요약 1칸에 멈춰 있었다
  //   — **같은 발사인데 두 화면이 서로 다른 말**을 했고, 그 공백이 러너 큐·Pages 배포까지라 수 분(실측 260805: dispatch 후 3분 23초 만에 pending 취소 = 끝내 안 옴).
  //   범위 = cardSec 가드와 동일하게 ''·failed 뿐 — 완성분(done/text_done/fired_partial)의 stale 재생성은 3칸 완료를 1칸으로 후퇴시키지 않는다.
  if ((!st || st === 'failed') && cardFirePending(a.file)) { done = 1; busy = true; fail = false; }
  // 실패 이력(error.log 잔존) = 한 번이라도 깨진 흔적 → 해당 단계에 영속 흉터(scar). 재시도·성공해도 유지.
  const scarSeg = (a.cards && a.cards.failedOnce) ? (hasMd ? 2 : 1) : -1;
  const aria = { n:'인스타 요약으로 이동', m:'카드 프롬프트로 이동', t:'카드 이미지로 이동' };
  const retry = (st === 'generating' && busy) ? (Number(a.cards && a.cards.retry) || 0) : 0;   // 자동 재시도 회차(프롬프팅 중일 때만) — 진행 세그먼트 라벨 우측에 MUT '(N회)'
  const html = segs.map(([lb, j], i) => {
    let cls = '';
    if (i < done) cls = ' done';
    else if (i === done && busy) cls = retry > 0 ? ' cur retry' : ' cur';   // 재시도(트라이 N) = cur에 .retry → 글자만 네온레몬(게이지바·펄스는 메인색 유지·운영자 260705)
    else if (i === done && fail) cls = ' fail';
    if (i === scarSeg) cls += ' scar';
    const rn = (i === done && busy && retry > 0) ? `<span class="rn">(${retry})</span>` : '';   // '프롬프트'는 가운데 고정(rn=absolute라 라벨 안 밀림), 그 우측에 MUT '(N)'(숫자만·크기·정렬 라벨과 동일 · 운영자 260701)
    // 프롬프트 세그(i=1)가 실패면 그 라벨 자체가 재시도 버튼 = 모달 안 들어가고 그 자리에서 다시 생성(운영자 260727).
    // 카드(i=2) 실패는 대상 아님 — 유료(제미나이 렌더)라 재확인 2탭 '카드 이미지 생성' 버튼 경로 유지.
    const rt = (i === 1 && i === done && fail) ? ' data-retry="text"' : '';   // ⚠ i===done 필수 — fail은 카드 전체 플래그라, 카드(3단계) 실패 기사(done=2)에서 완료된 프롬프트 세그까지 재시도로 오표시되던 것 차단(260727 QA 실측)
    return `<div class="seg${cls}" data-j="${j}"${rt} role="button" tabindex="0" aria-label="${rt ? '프롬프트 다시 생성' : aria[j]}"${rt ? ' title="눌러서 프롬프트 다시 생성"' : ''}><span class="sl">${lb}${rn}</span><span class="bar"></span></div>`;
  }).join('');
  return `<div class="prog">${html}</div>`;
}
// #1 보도일 — "M/D (요일)" + 시각(time:HH:MM이면 뒤에 붙임). 박스 없이 텍스트, 카드 맨 위.
function repDate(date) {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date || '');
  if (!m) return esc(date || '');
  const W = ['일','월','화','수','목','금','토'];
  const d = new Date(+m[1], +m[2] - 1, +m[3]);
  return `${+m[2]}/${+m[3]} (${W[d.getDay()]})`;
}
// #1 보도일 + 시각 — a.time이 HH:MM 형식일 때만 ' HH:MM' 붙임(아니면 날짜만). 6/14 (일) 11:00 꼴.
function repDateTime(a) {
  const base = repDate(a.date);
  const t = (a.time || '').trim();
  if (!/^\d{1,2}:\d{2}$/.test(t)) return base;
  const est = a.time_est && String(a.time_est).trim() && String(a.time_est).trim() !== 'false';   // 추정 시각이면 "(추정)" 꼬리표(운영자 260621)
  return `${base} ${esc(t)}${est ? ' (추정)' : ''}`;
}
// IN(적재) 날짜 — 파일명 YYMMDD-HHMM 파싱. WRITE는 repDateTime(a). (B)
function inDateTime(a) {
  const m = /^(\d{2})(\d{2})(\d{2})-(\d{2})(\d{2})/.exec(a.file || '');
  if (!m) return { txt: '', today: false };
  const W = ['일','월','화','수','목','금','토'];
  const d = new Date(2000 + +m[1], +m[2] - 1, +m[3]);
  return { txt: `${+m[2]}/${+m[3]} (${W[d.getDay()]}) ${m[4]}:${m[5]}`, today: `${m[1]}${m[2]}${m[3]}` === todayYMD6() };
}
// 공통 상대시간 사다리(기틀 · 피드+대기열 공용 · 운영자 260621): <30분=방금 / 30분 전 / N시간 전(1h부터 분 생략·복합표기 없음) / N일(1~6) / N주일(1~4) / N개월. 무효(파싱실패=1e7 sentinel·9000 가드 밖)는 ''→발행일 폴백.
function relAge(h) {
  if (!isFinite(h) || h < 0 || h >= 9000) return '';
  const min = h * 60;
  if (min < 30) return '방금';
  if (min < 60) return '30분 전';
  if (h < 24) return Math.floor(h) + '시간 전';
  const d = Math.floor(h / 24);
  if (d < 7) return d + '일 전';
  if (d < 30) return Math.floor(d / 7) + '주일 전';
  return Math.floor(d / 30) + '개월 전';
}
// ── 표기 전용 발행 나이(260805) — time 실측값이 있으면 정본 그대로, **빈칸이면 자정 대신 수집시각(파일명)** ──
// ⚠ 스코프 = 표기(dlReport) 한정. 배지·매칭 축(brkIssueKind·feedMatch·feedAgeH)은 articleAgeH를 그대로 쓴다 —
//   자정 폴백은 참나이의 *상한*(과대계상 = 오컷 방향)이고 수집시각은 *하한*(과소 = 긴급 오발 방향)이라 요구가 반대다.
//   실측(평의회 260805): 폴백을 배지 축까지 바꾸면 4730 Math.max(inAge,pubAge)가 pubAge≡inAge로 항등식이 되어
//   syndication 지연 가드(260623)가 34.8%에서 소멸 → 속보∧time="" 12건이 실나이 18.6·22.6·33.5h인데 수집 순간 🚨긴급으로 뒤집힌다.
//   반대로 표기 축은 정확도가 요구라 상한 폴백이 오답이다(실측 과대계상 중앙값 +16.9h · 67%가 +12h↑ = "3시간 전 기사가 1일 전").
// ⚠ feedAgeH 호출 금지 = 상호재귀(feedAgeH가 time 무효 시 articleAgeH를 되부른다) → 파일명 정규식을 직접 파싱한다.
function articleAgeDispH(a) {
  a = a || {};
  if (/^\d{1,2}:\d{2}/.test(String(a.time || '').trim())) return articleAgeH(a);   // 실측 발행시각 보유 = 정본 경로 그대로(무변경)
  const fm = /^(\d{2})(\d{2})(\d{2})-(\d{2})(\d{2})/.exec(String(a.file || ''));   // 수집(IN) 시각 = 파일명 YYMMDD-HHMM(KST wall-clock)
  if (!fm) return articleAgeH(a);                                                  // 파일명도 무효 = 폴백의 폴백 = 종전 동작(발행일 표기로 강등)
  const t = Date.UTC(2000 + +fm[1], +fm[2] - 1, +fm[3], +fm[4] - 9, +fm[5]);       // KST → UTC instant(−9h · feedAgeH와 동일 기준)
  if (isNaN(t)) return articleAgeH(a);
  const dm = /^(\d{4})[.\-](\d{1,2})[.\-](\d{1,2})/.exec(String(a.date || ''));    // 발행일(자정)과 수집이 이틀 넘게 벌어지면 = 옛 글 직접공유(폰공유·붙여넣기)
  if (dm && t - Date.UTC(+dm[1], +dm[2] - 1, +dm[3], -9, 0) > 48 * 3600000) return articleAgeH(a);   // 그 건은 수집시각 대체가 오히려 왜곡(3개월 전 글이 "방금") → 구 폴백 유지(실측 8건)
  return Math.max(0, (Date.now() - t) / 3600000);
}
// 피드 메타라인 = [카테고리] 보도시간(좌·페이드) ··· 스크랩(우·NEW<30분/흰/회). "보도/스크랩" 라벨 없이 시간만(디자인안04).
function dlReport(a) {   // 보도(좌): ≤6h 라임 / 7~11h 흰 / 12h↑ 회 · 무효=발행일 폴백
  const h = articleAgeDispH(a), s = relAge(h);
  if (!s) return a && a.date ? `<b class="wr" style="color:var(--mut)">${repDate(a.date)}</b>` : '';
  return `<b class="wr" style="color:${h < 7 ? 'var(--accent)' : h < 12 ? 'var(--fg)' : 'var(--mut)'}">${s}</b>`;
}
function dlScrap(a) {    // 스크랩(우): <30분 NEW(라임 강조) / 30분~6h 흰 / 7h↑ 회
  const h = feedAgeH(a);
  if (!isFinite(h) || h < 0 || h >= 9000) return '';
  if (h * 60 < 30) return '<b class="scrap nw">NEW</b>';
  return `<b class="scrap" style="color:${h < 7 ? 'var(--fg)' : 'var(--mut)'}">${relAge(h)}</b>`;
}
// (옛 biasText/BIAS_COLOR 제거 260624 — 카드가 biasLabel 텍스트 라벨로 바뀌어 유일 호출부 사라진 죽은코드 + 옛 색맵은 좌우 반전[약우=파랑]이라 미래 재호출 시 위험. 평의회 검증5·6·10 권고.) · 게이지바 CSS(.bgauge·.biasrow)는 카드 게이지 롤백 도먼트였다가 평의회 Q165에서 정리 완료 — --bias-*-rgb 토큰은 soc-gauge가 사용 중이라 존치.
// ── 편향 텍스트 라벨(카드 kv 줄) — 게이지바(#922) 롤백, 텍스트 라벨로 복귀(운영자 260624). 본문 자유요약은 게이지흐름 유지(decorate M).
//    형식: 원문→요약 보정 있으면 '좌 보정(4+1)'(원문방향+N±델타), 보정0이면 '좌 4', 원문값 부재면 '중립 5'(요약값만). 좌우무관(N/A)→'무관'.
//    라벨은 숫자에서 도출(1~2강좌·3~4좌·5~6중립·7~8우·9~10강우) = 같은 숫자에 다른 라벨 뜨던 드리프트 차단. 색은 원문방향(보정 전) 기준. (260629 #1203 '좌 4 +1(우 보정)' 흰색안 → 운영자 요청으로 카드 라벨만 이전 방향색 형식으로 복원·본문 decorate 줄은 불변)
const biasNum = s => { const m = /(\d+)\s*[\/／]\s*10/.exec(s || ''); return m ? +m[1] : null; };
const biasZone = v => { v = Math.min(10, Math.max(1, v)); return v <= 2 ? '강좌' : v <= 4 ? '좌' : v <= 6 ? '중립' : v <= 8 ? '우' : '강우'; };
const biasZoneCol = v => { v = Math.min(10, Math.max(1, v)); return v <= 2 ? 'var(--bias-l2)' : v <= 4 ? 'var(--bias-l1)' : v <= 6 ? 'var(--bias-mid)' : v <= 8 ? 'var(--bias-r1)' : 'var(--bias-r2)'; };
// 편향 줄 새 포맷(운영자 260629) — '중립 5 (+1 / 우 보정) → 중립 6'. 보정을 원문 옆 괄호로(가운데) · 강조색=숫자/델타/방향, 흰색=존라벨/괄호/슬래시.
const biasZoneHtml = v => `<span class="biasv">${biasZone(v)} </span><span class="biasnum">${v}</span>`;   // 존 라벨(흰)+숫자(강조)
const biasFlowHtml = (N, M) => {   // 원문 N → 요약 M (보정 표기 포함). 보정0이면 단일값.
  const d = M - N;
  if (!d) return biasZoneHtml(N);
  const corr = ` <span class="biaspar">(</span><span class="biascorr">${d > 0 ? '+' : '−'}${Math.abs(d)}</span><span class="biaspar"> / </span><span class="biasdir">${d > 0 ? '우' : '좌'} 보정</span><span class="biaspar">)</span>`;
  return `${biasZoneHtml(N)}${corr} <span class="biasar">${ARROW_R_SVG}</span> ${biasZoneHtml(M)}`;
};
const outletShort = m => { m = m || ''; return m.length > 7 ? m.slice(0, 6) + '…' : m; };   // 매체명 7자 초과 → 6자+… (고정폭 매체 칸 안·운영자 260630). 예: 한국조선대한일보 → 한국조선대한…
const primaryMedia = m => (m || '').split('·')[0].trim().replace(/\s*등\s*$/, '').trim();   // 다매체("뉴스1·아시아경제·연합뉴스 등") → 대표(소스) 매체 1개 — 원문(a.url)의 소스 매체(analyze가 앞에 둠). 카드엔 대표 1개만·원문 링크(운영자 260701).
function biasLabel(a) {
  const M = biasNum(a.bias);
  if (M == null || /무관|N\s*\/?\s*A/i.test(a.bias || ''))
    return `<b class="bias" style="color:var(--mut)">무관</b>`;
  const N = biasNum(a.bias_src);
  if (N == null)   // 원문 없음(옛 기사·IG·Thread·폴백) = 요약값만 표시(보정 표기 생략)
    return `<b class="bias" style="color:${biasZoneCol(M)}">${biasZone(M)} ${M}</b>`;
  const d = M - N;
  if (!d)   // 보정 0 = 단일값
    return `<b class="bias" style="color:${biasZoneCol(N)}">${biasZone(N)} ${N}</b>`;
  // 카드 라벨 = 콤팩트 방향색 '좌 보정(4+1)'(운영자 #1215 복원 재적용 — #1218 풀플로우 '중립 5 (+1/우 보정)→중립 6'는 본문 decorate에만, 카드 제외). 본문 편향줄(biasFlowHtml)은 불변.
  const zc = biasZoneCol(N);   // 원문방향 '좌'=방향색 · N=방향색 · '보정'·델타 부호=흰(--fg) · 괄호=mut
  return `<b class="bias"><span style="color:${zc}">${biasZone(N)}</span> <span style="color:var(--fg)">보정</span><span style="color:var(--mut)">(</span><span style="color:${zc}">${N}</span><span style="color:var(--fg)">${d > 0 ? '+' : '−'}${Math.abs(d)}</span><span style="color:var(--mut)">)</span></b>`;   // 예: 좌 보정(4+1)
}
// 대분류(C) — 옛 큐 category 값 → 5버킷 UI 매핑(지침엔 없음·표면화만). 박스 없는 색글자.
const CAT_MAP = { '사회':'사회','정치':'정치','시사':'사회','경제':'경제','문화':'문화','국제':'국제','외교':'국제','테크':'테크','과학':'테크','IT':'테크','AI':'테크','스포츠':'문화','연예':'문화' };   // 정치 → 독립 버킷(사회서 분리·운영자 260621) · 스포츠·연예 = 문화(260625)
const CAT_COLOR = { '정치':'var(--cat-pol)','사회':'var(--cat-soc)','경제':'var(--cat-eco)','국제':'var(--cat-intl)','문화':'var(--cat-cul)','테크':'var(--cat-tech)' };   // 카테고리 색 = 전용 구분자 토큰 --cat-*(:root 팔레트 등재 · 260623 6색 복원 — 강조색 매핑(동일 260704 오전분)은 운영자 불승인 롤백 · 운영자 260704 "24시간 전 색으로 복원 + 팔레트에 별도로")
function catBucket(cat) { const c = (cat || '').trim(); return CAT_MAP[c] || (['정치','사회','경제','문화','국제','테크'].includes(c) ? c : ''); }
function catChip(cat) {
  const b = catBucket(cat); if (!b) return '';
  return `<span class="cat" style="color:${CAT_COLOR[b]}">${esc(b)}</span>`;
}
