// ── 설정 ▸ 메모(work to do 기록 · 운영자 260801 "기사 하다가 메모해둘때가 은근히 있는데") ─────────────────────────────
//    저장 = 서버 설정 SSOT(NM_SET.memos · settings/app.json — kwItems 선례) = 폰서 적고 PC서 본다. 로컬 캐시는 오프라인 폴백(saveSettings 낙관 반영).
//    화면 = 알림메세지함 그대로 — 목록(.msgrow: 작성일 · 내용 한 줄 · 수정 · 삭제) ↔ 행 클릭 = 전문(.msgdetail) · 새 컴포넌트 0.
function mmGet() { return Array.isArray(NM_SET.memos) ? NM_SET.memos : []; }
function mmSave(items) { return saveSettings({ memos: _mmClean(items) }); }
function mmWhen(ts) {   // 전문 머리 = "8. 1. 20:14" — 날짜는 목록과 같은 정본(kwDate) 재사용 + 시:분(kwHitAt 문법 계승 · 기준시 = 브라우저 로컬)
  const d = ts ? new Date(ts) : null; if (!d || isNaN(d)) return '';
  const p2 = n => String(n).padStart(2, '0');
  return kwDate(ts) + ' ' + p2(d.getHours()) + ':' + p2(d.getMinutes());
}
function mmShowList() { const d = $('#mmdetail'), l = $('#mmpopList'); if (d) d.hidden = true; if (l) l.hidden = false; }   /* 목록 복귀(msgShowList 미러) */
function openMemo() {   // 열기 = 설정 톱니 아래 우변 촤르륵(메시지함 공용 placePopNearMenu)
  const mp = $('#mmpop'); if (!mp) return;
  hidePmenu(); closeOverlays('mmpop');
  mmShowList();
  mp.hidden = false; placePopNearMenu(mp);   // hidden 해제 후 배치(폭 측정 요건)
  renderMemoList();
  mmAddBox(!mmGet().length);   // 비었으면 입력칸까지 펼쳐 첫 기록 유도(kwpop 미러) · 이미 있으면 목록만(+ 로 열기)
}
function closeMemo(restore) {   // X 닫힘 = 전단계 설정메뉴 복원(msgclose 패턴) · 바깥클릭·화면전환은 복원 없음
  const mp = $('#mmpop'); if (!mp) return;
  mp.hidden = true; mmAddBox(false); mmShowList();
  if (restore) { linkpop.hidden = false; placeHeadPop(linkpop, $('#profile')); }
}
function mmAddBox(show) {   // 입력칸 = 헤더 + 로 여닫는다(kwAddBox 미러) · 미지정 = 토글 · 접으면 쓰던 값·수정모드 해제
  const box = $('#mmpop .mm-add'), inp = $('#mmIn'); if (!box) return;
  const next = (show === undefined) ? box.hidden : !!show;
  box.hidden = !next;
  const b = $('#mmAddOpen'); if (b) b.setAttribute('aria-expanded', next ? 'true' : 'false');
  if (next) { setTimeout(() => { try { inp.focus(); } catch (_) {} }, 40); }
  else if (inp) { inp.value = ''; mmEditCancel(); }
}
function renderMemoList() {
  const list = $('#mmpopList'); if (!list) return;
  const items = mmGet();
  if (!items.length) { list.innerHTML = '<div class="qempty">기록된 메모 없음</div>'; return; }
  list.innerHTML = items.map((it, i) => {
    const one = String(it.text || '').replace(/\s+/g, ' ').trim(), cp = [...one];
    const s = cp.length > 60 ? cp.slice(0, 60).join('') + '…' : one;   // 목록 = 한 줄 요약 60자컷(메시지함 정본 동값) · 전문은 행 클릭
    return '<div class="qrow msgrow mmrow" data-i="' + i + '">'
      + '<span class="qt">' + qEsc(kwDate(it.ts)) + '</span>'
      + '<span class="qmain" title="' + qEsc(one) + '">' + qEsc(s) + '</span>'
      + '<span class="qact mm-a1"><button class="pub-ico mm-edit" type="button" title="수정" aria-label="메모 수정">' + EDIT_SVG + '</button></span>'
      + '<span class="qact"><button class="pub-ico pub-rm mm-del" type="button" title="삭제" aria-label="메모 삭제">' + _TRASHSVG + '</button></span></div>';
  }).join('');
  list.querySelectorAll('.mm-del').forEach(b => b.onclick = (e) => { e.stopPropagation(); const row = b.closest('.qrow'); animateRowOut(row, () => mmRemove(+row.dataset.i)); });
  list.querySelectorAll('.mm-edit').forEach(b => b.onclick = (e) => { e.stopPropagation(); mmEdit(+b.closest('.mmrow').dataset.i); });
  [...list.querySelectorAll('.mmrow')].forEach(row => row.onclick = (e) => { if (e.target.closest('button')) return; openMemoDetail(+row.dataset.i); });   // 행 클릭(버튼 제외) = 전문(renderMsgList 미러)
}
function openMemoDetail(i) {   // 전문 화면 = 목록 대신 표시(openMsgDetail 미러 — 시각 + 전문 잘림 없음 + 뒤로)
  const it = mmGet()[i]; if (!it) return;
  const d = $('#mmdetail'), l = $('#mmpopList'); if (!d || !l) return;
  const t = $('#mmTime'); if (t) t.textContent = mmWhen(it.ts);
  const b = $('#mmBody'); if (b) b.textContent = it.text || '';
  mmAddBox(false);   // 전문 보는 동안 입력칸은 접음(창이 두 겹으로 길어지지 않게)
  l.hidden = true; d.hidden = false; d.scrollTop = 0;
}
let _mmEditIdx = -1;
function mmAdd(raw) {   // 저장 = 새 메모(맨 위) 또는 수정 모드면 그 자리 덮어쓰기(kwAdd 미러 · 작성 시각은 유지)
  const text = String(raw || '').slice(0, MEMO_LEN).trim(); if (!text) return false;
  const items = mmGet().slice(), inp = $('#mmIn');
  if (_mmEditIdx >= 0 && items[_mmEditIdx]) { const i = _mmEditIdx; mmEditCancel(); items[i] = { ...items[i], text }; }
  else { if (items.length >= MEMO_CAP) return false; items.unshift({ id: crypto.randomUUID(), ts: Date.now(), text }); }   // 새 메모 = 목록 맨 위(최근 것부터 보이게)
  mmSave(items); renderMemoList();
  if (inp) inp.value = '';
  mmAddBox(false);   // 저장 완료 = 입력칸 접기(목록이 바로 보이게 · 연속 작성은 + 재클릭)
  return true;
}
function mmEdit(i) {   // 수정 = 새 입력 UI를 만들지 않는다 — + 로 여는 그 칸을 재사용(값 채우고 포커스 · kwEdit 미러)
  const items = mmGet(); if (!items[i]) return;
  _mmEditIdx = i; mmShowList(); mmAddBox(true);
  const inp = $('#mmIn'); if (inp) { inp.value = items[i].text; setTimeout(() => { try { inp.focus(); inp.select(); } catch (_) {} }, 50); }
  const b = $('#mmAddBtn'); if (b) b.textContent = '수정';
}
function mmEditCancel() { _mmEditIdx = -1; const b = $('#mmAddBtn'); if (b) b.textContent = '저장'; }
function mmRemove(i) { const items = mmGet().slice(); if (i < 0 || i >= items.length) return; items.splice(i, 1); mmSave(items); renderMemoList(); }
{
  const _memoBtn = $('#memoBtn'); if (_memoBtn) _memoBtn.addEventListener('click', (e) => { e.stopPropagation(); openMemo(); });   // 설정메뉴 안 버튼 = msgbtn 패턴(stopPropagation)
  const _mmAddOpen = $('#mmAddOpen'); if (_mmAddOpen) _mmAddOpen.addEventListener('click', (e) => { e.stopPropagation(); mmShowList(); mmAddBox(); });   /* 헤더 + = 입력칸 토글(전문 보던 중이면 목록으로 복귀 후) */
  const _mmpopX = $('#mmpopX'); if (_mmpopX) _mmpopX.addEventListener('click', (e) => { e.stopPropagation(); closeMemo(true); });
  const _mmBack = $('#mmBack'); if (_mmBack) _mmBack.addEventListener('click', (e) => { e.stopPropagation(); mmShowList(); });
  const _mmAddBtn = $('#mmAddBtn'), _mmIn = $('#mmIn');
  if (_mmAddBtn) _mmAddBtn.addEventListener('click', (e) => { e.stopPropagation(); mmAdd(_mmIn ? _mmIn.value : ''); });
  if (_mmIn) _mmIn.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); mmAdd(_mmIn.value); } });   /* 메모장이라 Enter = 줄바꿈 · 저장 = 저장 버튼 또는 ⌘/Ctrl+Enter */
  ['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, () => { const mp = $('#mmpop'); if (mp && !mp.hidden) placePopNearMenu(mp); }, { passive: true }));   // 회전·리사이즈 재배치(placeMsgpop 대칭)
  document.addEventListener('click', (e) => { const mp = $('#mmpop'); if (mp && !mp.hidden && !mp.contains(e.target) && !$('#profile').contains(e.target)) mp.hidden = true; });   // 바깥클릭 닫기(kwpop·msgpop 패턴)
}
// ── 설정 ▸ 구독 기기(운영자 260819) — 알림 켠 기기 명단 보기 · 기기별 발송 중단 · 삭제.
//   ⚠ 열쇠(keys)는 서버가 절대 안 내려준다(그 값이 있으면 제3자가 그 기기로 발송을 시도할 수 있다) = 화면은 주소 꼬리 24자로만 기기를 지목한다.
const _DEV_BR = [['SamsungBrowser', '삼성 인터넷'], ['Samsung Internet', '삼성 인터넷'], ['Edg', '엣지'], ['Microsoft Edge', '엣지'], ['OPR', '오페라'], ['Opera', '오페라'], ['Whale', '웨일'], ['FxiOS', '파이어폭스'], ['Firefox', '파이어폭스'], ['CriOS', '크롬'], ['Google Chrome', '크롬'], ['Chrome', '크롬'], ['Chromium', '크로미엄'], ['Safari', '사파리']];   // 순서가 계약 = 삼성·엣지 문자열은 크롬 문자열을 함께 담는다(먼저 만나는 쪽이 답)
const _DEV_PLAT = [['Android', '안드로이드'], ['iOS', '아이폰'], ['iPadOS', '아이패드'], ['Windows', '윈도우'], ['macOS', '맥'], ['Chrome OS', '크롬북'], ['Chromium OS', '크롬북'], ['Linux', '리눅스']];
const _DEV_HOST = { 'fcm.googleapis.com': '크롬 계열', 'android.googleapis.com': '크롬 계열', 'web.push.apple.com': '사파리(애플)', 'updates.push.services.mozilla.com': '파이어폭스' };
function _devKo(tbl, v) { const t = String(v || ''); for (const [k, ko] of tbl) if (t.indexOf(k) >= 0) return ko; return ''; }
function _devMajor(v) { return String(v || '').split('.')[0] || ''; }
function nmDevName(it) {   // 기기 한 줄 = "SM-S928N · 안드로이드 14 · 크롬 126" — 값은 전부 등록 때 받아둔 문자열에서 뽑는다(모델 사전 창작 0)
  const ua = String((it && it.ua) || ''), hn = (it && it.hint) || null, out = [];
  let model = (hn && hn.model) || '', os = '', br = '';
  if (hn && hn.plat) { const ko = _devKo(_DEV_PLAT, hn.plat) || hn.plat; os = (ko + ' ' + _devMajor(hn.pv)).trim(); }
  if (hn && hn.br) { const ko = _devKo(_DEV_BR, hn.br); br = ko ? (ko + ' ' + _devMajor((hn.br.match(/(\d[\d.]*)\s*$/) || [])[1])).trim() : hn.br; }
  if (!model) { const m = ua.match(/Android[^;)]*;\s*([^;)]+?)(?:\s+Build)?\)/); if (m && m[1] && m[1].trim() !== 'wv') model = m[1].trim(); }
  if (!os) {
    let m;
    if ((m = ua.match(/Android\s+([\d.]+)/))) os = '안드로이드 ' + _devMajor(m[1]);
    else if ((m = ua.match(/(iPhone|iPad);.*?OS\s+([\d_]+)/))) os = (m[1] === 'iPad' ? '아이패드 ' : '아이폰 ') + _devMajor(m[2].replace(/_/g, '.'));
    else if (/Windows NT/.test(ua)) os = '윈도우';
    else if (/Mac OS X/.test(ua)) os = '맥';
    else if (/CrOS/.test(ua)) os = '크롬북';
    else if (/Linux/.test(ua)) os = '리눅스';
  }
  if (!br) { for (const [k, ko] of _DEV_BR) { const m = ua.match(new RegExp(k + '\\/(\\d+)')); if (m) { br = ko + ' ' + m[1]; break; } if (ua.indexOf(k) >= 0) { br = ko; break; } } }
  if (/^사파리/.test(br)) { const v = ua.match(/Version\/(\d+)/); br = '사파리' + (v ? ' ' + v[1] : ''); }   /* ⚠ 사파리만 `Safari/604.1`이 브라우저 판이 아니라 엔진 빌드 번호다 = 판은 `Version/18.5` 쪽(실측 봉합 — 안 가르면 「사파리 604」로 뜬다) */
  if (model) out.push(model);
  if (os) out.push(os);
  if (br) out.push(br);
  if (out.length) return out.join(' · ');
  const h = _DEV_HOST[(it && it.host) || ''] || '';   // 등록 때 값을 안 받아둔 옛 기기 = 주소 계열까지가 한계
  return h ? ('이름 미상 · ' + h) : '이름 미상';
}
let _devItems = [], _devMe = '';
async function devApi(body) {
  const r = await fetch('api/push', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
  if (!r.ok) throw new Error('서버 응답 ' + r.status);
  return r.json();
}
function renderDevList(state) {
  const list = $('#devpopList'); if (!list) return;
  if (state === 'load') { list.innerHTML = '<div class="qempty">불러오는 중…</div>'; return; }
  if (state === 'err') { list.innerHTML = '<div class="qempty">목록을 못 불러왔어<small>잠시 뒤 다시 열어봐</small></div>'; return; }
  if (!_devItems.length) { list.innerHTML = '<div class="qempty">알림을 켠 기기 없음</div>'; return; }
  // 행 = 등록일 · 기기 · 비활성 체크 · 휴지통(운영자 260819 지목 4열) — 셀 문법은 kwrow 정본 100% 미러
  list.innerHTML = _devItems.map((it, i) => {
    const nm = nmDevName(it), me = it.id && it.id === _devMe;
    return '<div class="qrow devrow' + (it.off ? ' dev-off' : '') + '" data-i="' + i + '">'
      + '<span class="qt">' + qEsc(kwDate(it.ts)) + '</span>'
      + '<span class="qmain" title="' + qEsc(nm) + '">' + qEsc(nm) + (me ? '<em class="dev-me"> · 이 기기</em>' : '') + '</span>'
      + '<span class="qact"><button class="pub-ico dev-bell" type="button" title="' + (it.off ? '알림 재개 — 이 기기에도 다시 보낸다' : '알림 중단 — 이 기기엔 안 보낸다') + '" aria-label="' + (it.off ? '알림 재개' : '알림 중단') + '" aria-pressed="' + (it.off ? 'true' : 'false') + '">' + (it.off ? BELL_OFF_SVG : BELL_SVG) + '</button></span>'
      + '<span class="qact"><button class="pub-ico pub-rm dev-del" type="button" title="삭제" aria-label="구독 삭제">' + _TRASHSVG + '</button></span></div>';
  }).join('');
  list.querySelectorAll('.dev-bell').forEach(b => b.onclick = async (e) => {   // 종 = 그 기기 발송 중단·재개(구독은 목록에 남는다 · 해제 = 빗금 종 + 무채)
    e.stopPropagation();
    const i = +b.closest('.devrow').dataset.i, it = _devItems[i]; if (!it) return;
    b.disabled = true;
    try { await devApi({ action: 'toggle', endpoint: it.id }); it.off = !it.off; renderDevList(); }
    catch (err) { b.disabled = false; qFlash('바꾸지 못했어 — ' + err.message); }
  });
  list.querySelectorAll('.dev-del').forEach(b => b.onclick = async (e) => {   // 휴지통 = 명단에서 제거(그 기기에서 다시 켜면 새로 등록된다)
    e.stopPropagation();
    const row = b.closest('.devrow'), i = +row.dataset.i, it = _devItems[i]; if (!it) return;
    b.disabled = true;
    try { await devApi({ action: 'remove', endpoint: it.id }); animateRowOut(row, () => { _devItems.splice(i, 1); renderDevList(); }); }
    catch (err) { b.disabled = false; qFlash('삭제하지 못했어 — ' + err.message); }
  });
}
async function devLoad() {
  renderDevList('load');
  try { _devMe = await (async () => { const reg = await navigator.serviceWorker.getRegistration(); const s = reg && await reg.pushManager.getSubscription(); return s ? String(s.endpoint).slice(-24) : ''; })(); } catch (e) { _devMe = ''; }
  try {
    const j = await devApi({ action: 'list' });
    _devItems = (j.items || []).slice().sort((a, b) => (b.ts || 0) - (a.ts || 0));   // 최근 등록이 위(대기열 시간순 관례)
    renderDevList();
  } catch (e) { renderDevList('err'); }
}
function openDevpop() {   // 열기 = 설정 팝업 자리에 촤르륵(openKwpop 미러)
  const dp = $('#devpop'), prof = $('#profile'); if (!dp) return;
  closeOverlays('devpop');
  dp.hidden = false;
  if (prof) placeHeadPop(dp, prof);
  devLoad();
}
{
  const _devBtn = $('#devBtn'); if (_devBtn) _devBtn.addEventListener('click', (e) => { e.stopPropagation(); openDevpop(); });
  const _devX = $('#devpopX'); if (_devX) _devX.addEventListener('click', (e) => { e.stopPropagation(); const dp = $('#devpop'); if (dp) dp.hidden = true; });
  ['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, () => { const dp = $('#devpop'); if (dp && !dp.hidden) placeHeadPop(dp, $('#profile')); }, { passive: true }));
  document.addEventListener('click', (e) => { const dp = $('#devpop'); if (dp && !dp.hidden && !dp.contains(e.target) && !$('#profile').contains(e.target)) dp.hidden = true; });   // 바깥클릭 닫기(kwpop·mmpop 패턴)
}
$('#askText').addEventListener('paste', e => { const imgs = [...(e.clipboardData?.items || [])].filter(i => i.type.startsWith('image/')).map(i => i.getAsFile()).filter(Boolean); if (imgs.length) { e.preventDefault(); addAskImages(imgs); } });
async function addAskImages(files) {
  for (const f of [...files]) {
    if (!f.type || !f.type.startsWith('image/')) continue;
    if (askImages.length >= ASK_MAX) { shakeAskAttach(); break; }   // 3장 초과 = 픽토 빨강+흔들림(메시지 없음·운영자 260702)
    try { askImages.push(await compressImg(f)); } catch {}
  }
  renderAskImgs();
}
function shakeAskAttach() { const a = $('#askAttach'); if (!a) return; a.classList.remove('over'); void a.offsetWidth; a.classList.add('over'); setTimeout(() => a.classList.remove('over'), 700); }
// CONTRACT: check_ask_img_legible — 요약 요청에 붙인 사진은 **글자가 읽히는 크기로** 나간다(긴 변 ≥1280 · 화질 ≥0.6 · 서버 재압축 0).
//   ⚠ 이 두 값을 낮추지 마라. 토큰은 줄지만 **세로로 긴 기사 캡처가 먼저 죽는다** — 긴 변 기준 축소라
//   세로가 길수록 가로가 좁아진다(운영자 260812 질문 = "글자 못 읽을 만큼 압축돼서 왜곡될까봐").
//   260812 실측(폰 기사 스크롤 캡처 1080폭 · 본문 36px 기준 · 압축 후 실판독):
//     세로 3000 → 461×1280(본문 15.4px) 또렷 · 5700 → 243×1280(8.1px) 읽힘 · 9000 → 154×1280(5.1px) 읽히나 흐림.
//   ⚠ 나빠져도 이 화면은 똑같이 동작한다(축소 미리보기 + KB 배지만 뜬다) → 증상은 한참 뒤 요약 품질로만
//   나오고 원인이 사진인지 기사인지 구분이 안 된다 = 사람 눈이 검출기가 못 되는 자리라 게이트가 유일한 방어.
async function compressImg(file, max = 1280, q = 0.6) {   // 토큰 절약: 긴 변 1280px·JPEG로 압축(고품질 해석 불필요)
  const url = URL.createObjectURL(file);
  const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = url; });
  let w = img.width, h = img.height; const s = Math.max(w, h);
  if (s > max) { w = Math.round(w * max / s); h = Math.round(h * max / s); }
  const cv = document.createElement('canvas'); cv.width = w; cv.height = h; cv.getContext('2d').drawImage(img, 0, 0, w, h);
  URL.revokeObjectURL(url);
  const blob = await new Promise(r => cv.toBlob(r, 'image/jpeg', q));   // q-ok: 산출물 아님 = 요약요청 첨부 압축(기본 q0.6·긴변 1280 — 고품질 해석이 불필요한 입력이라 토큰을 아낀다 · 파일로 안 나간다)
  const dataUrl = await new Promise(r => { const fr = new FileReader(); fr.onload = () => r(fr.result); fr.readAsDataURL(blob); });
  return { dataUrl, kb: Math.round(blob.size / 1024) };
}
function renderAskImgs() {
  const host = $('#askImgs');
  host.innerHTML = askImages.map((im, i) => `<div class="askimg"><img src="${im.dataUrl}" alt=""><button class="askimg-x" type="button" data-i="${i}" aria-label="삭제" title="삭제"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6 18 18M18 6 6 18"/></svg></button><span class="askimg-kb">${im.kb}KB</span></div>`).join('');
  host.querySelectorAll('.askimg-x').forEach(b => b.onclick = e => { e.stopPropagation(); askImages.splice(+b.dataset.i, 1); renderAskImgs(); });
  host.querySelectorAll('.askimg > img').forEach((im, i) => { im.onclick = () => openLightbox(askImages.map(x => ({ img: x.dataUrl })), i, '첨부 이미지'); });   // 탭=확대(창 유지·기존 openLightbox·폰 뒤로가기로 닫기·평의회)
  updateAskPh();   // 이미지 추가/제거 시 빈 입력 안내 토글
  updateAskAttach();   // 첨부 픽토 위 ✓·장수 배지(기존 askattach-badge 계승)
}
let _askAttachN = 0;
function updateAskAttach() {   // 첨부 완료 = 첨부 버튼 우상단 코너 ✓·장수 배지(3안·증가 시에만 팝·운영자 260622)
  const lab = $('#askAttach'), badge = $('#askAttachBadge'), cnt = $('#askAttachCnt');
  if (!lab || !badge) return;
  const n = askImages.length;
  lab.classList.toggle('has', n > 0);
  if (n > 0) {
    cnt.textContent = n; badge.hidden = false;
    if (n > _askAttachN) { badge.classList.remove('pop'); void badge.offsetWidth; badge.classList.add('pop'); }   // 새로 첨부될 때만 팝
  } else { badge.hidden = true; badge.classList.remove('pop'); }
  _askAttachN = n;
}
// 전송 완료 체크(시안2 팝 스프링) — 게이지 후 글자 위에 ✓ 팝으로 그림(asksend·revsend 공용·260622)
function askShowCheck(btn){ if (!btn || btn.querySelector('.ack')) return; btn.classList.add('checked');
  const d = document.createElement('span'); d.className = 'ack';
  d.innerHTML = '<svg viewBox="0 0 24 24" role="img" aria-label="완료"><path d="M5 13l4 4L19 7"/></svg>'; btn.appendChild(d); }
function askHideCheck(btn){ if (!btn) return; btn.classList.remove('checked'); const d = btn.querySelector('.ack'); if (d) d.remove(); }
// 라이브 게이지 헬퍼(전송·수정 3종·기록·발행 공용 · 운영자 260702) — fetch 전에 start(게이지가 응답까지 점근 진행 = 멈춤·무반응 제거), 성공 시 gaugeDone(현위치→100% 급속·askShowCheck는 호출부서 ~200ms 뒤), 실패·정리 시 gaugeClear.
function gaugeStart(btn){ if (!btn) return; btn.classList.add('glive', 'firing'); requestAnimationFrame(() => requestAnimationFrame(() => { if (btn.classList.contains('glive')) btn.classList.add('grun'); })); }   // 2중 rAF = scaleX(0) 한 프레임 페인트 후 .9 트리거(같은 프레임이면 transition 무시됨) · glive 가드 = 즉시 실패로 gaugeClear가 먼저 돌면 rAF가 grun을 도로 붙이던 잔류 차단(실측 260727)
function gaugeDone(btn){ if (btn) btn.classList.add('gdone'); }
function gaugeClear(btn){ if (btn) btn.classList.remove('glive', 'firing', 'grun', 'gdone'); }
$('#askSend').addEventListener('click', async () => {
  const text = $('#askText').value.trim();
  const link = askLinkVal();   // 링크(운영자 260731) — 기사면 원문 활용 · 영상·음성이면 large-v3 전사 활용(ask.sh 링크 레일이 판별)
  if (link && !/^https?:\/\//i.test(link)) { qFlash('링크는 http(s)로 시작해야 해'); const lr = $('#askLinkRow'); askLinkOpen(true); if (lr) { lr.classList.remove('shake'); void lr.offsetWidth; lr.classList.add('shake'); setTimeout(() => lr.classList.remove('shake'), 620); } return; }   // 형식 게이트 = nb.html 'URL은 http(s)로 시작' 문법 계승(흔들림 = 빈 입력 문법)
  if (!text && !askImages.length && !link) {   // 빈 입력(텍스트·이미지·링크 없음) = 입력창 흔들림 + placeholder 강조 1회 점등 + 전송버튼 흔들림(동시 · 운영자 260622)
    updateAskPh();
    const wrap = $('#askText').closest('.asktawrap'), ph = $('#askPh'), sb = $('#askSend');
    [[wrap, 'shake'], [ph, 'flash'], [sb, 'shake']].forEach(([el, c]) => { if (el) { el.classList.remove(c); void el.offsetWidth; el.classList.add(c); setTimeout(() => el.classList.remove(c), 620); } });
    $('#askText').focus();
    return;
  }
  const btn = $('#askSend'); btn.disabled = true; askHideCheck(btn); gaugeStart(btn);   // 게이지 = 응답까지 진행(grun=0→90% · 응답 시 gdone서 100% = '다 찬 후 멈춤' 제거 · 공용 헬퍼) · 상태텍스트 폐지(운영자 260622·260702)
  try {
    const r = await fetch('api/submit', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ text, link: link || undefined, linkForce: (link && askLinkForce) ? 1 : undefined, images: askImages.map(im => im.dataUrl), nothumb: (askPreset.noai || !genImgEff()) ? 1 : 0, preset: askPreset, retryOf: _askRetryOf || undefined }) });   // preset = 요약요청 스트립 값(h24·fp·mj·og → ask.sh 프롬프트 · noai → 아래 nothumb) → asks/*.json   // nothumb=1이면 제미나이 썸네일 생성 skip(검색 og:image는 무관·항상 수집) · 실효값 = 「AI 미제작」 켜짐이면 무조건 skip, 아니면 종전대로 설정 디폴트 ?? 건별 오버라이드(운영자 260709·260727) · retryOf=재시도면 옛 실패 id(submit 이 옛 asks/failed 삭제)·운영자 260702·260704
    const d = await r.json().catch(() => ({}));
    if (r.ok && d.ok) { btn.classList.remove('done'); void btn.offsetWidth; btn.classList.add('done', 'gdone');   // 성공 = done팝 + gdone(게이지 현재위치→100% 급속 마무리 = 멈춤 없이 응답 즉시 채움) · 입력 리셋은 닫은 뒤(아래)로 — 즉시 비우면 1.6s 빈화면(운영자 260622)
      setTimeout(() => askShowCheck(btn), 300);   // 게이지 채움완료(gdone .3s)와 물려 ✓ 팝(멈칫 제거·시안2·운영자 260703)
      setTimeout(loadPending, 1200); setTimeout(loadPending, 4000);   // 접수 즉시 대기열 배지 갱신(60s 폴링 안 기다림 · asks/ 표면화 = '처리중' 확인 · GitHub 전파 대비 2회 · 운영자 260622)
      if (!qpop.hidden) { setTimeout(loadQueue, 1300); setTimeout(loadQueue, 4200); }   // 대기열 열린 채면(재시도 재오픈 = closeQueueUser 안 함) 리스트도 재fetch → 옛 실패행 소멸·새 '처리중' 표시(loadPending 은 배지만 · 평의회 260704 R4 스테일)
      if (_askResolveId) { pfAddResolved(_askResolveId); _askResolveId = null; markPickFailSeen(); if (CURTAB === 'scrap') renderScrap(); }   // 실패 픽 복구 전송 완료 → '분석 실패' 표시·링 소거
      _askRetryOf = null;   // 재시도 재제출 접수 완료 → 옛 실패 id 소비(submit 이 옛 asks/failed 삭제 처리)
      setTimeout(() => { closeAskSurface(); gaugeClear(btn); askHideCheck(btn); btn.disabled = false;   // 닫기 = 표면 자동 판별(도구 셸 vs 레거시 askdlg · 운영자 260712 요약 셸)
        $('#askText').value = ''; updateAskClip(); askImages = []; renderAskImgs(); if ($('#askLink')) { $('#askLink').value = ''; $('#askLink').dispatchEvent(new Event('input', { bubbles: true })); askLinkOpen(false); askLinkForce = false; } _genImgOvr = null; paintGenImgTg();   // 리셋(링크 = input 디스패치로 클립·✓배지 리드백까지 정본 경로 갱신 · 운영자 260731) = 닫은 뒤(빈 초기화면 깜빡임 차단 · 운영자 260622) · AI 썸네일 건별 오버라이드도 소비(다음 건 = 설정 디폴트 · 운영자 260709)
      }, 1600); return; }   // 성공 = 닫힐 때까지 disabled 유지(1.6s 내 중복전송 차단)
    else { qFlash(d.error || `서버 ${r.status}`); btn.classList.add('shake'); setTimeout(() => btn.classList.remove('shake'), 420); }   // 에러 = qFlash 토스트(팝업 내 상태문자열 폐지 · 운영자 260720 "문자열 말고 포스트 알림") · 버튼 흔들림은 유지
  } catch { qFlash('전송 실패 (백엔드 배선 전이면 예상된 동작)'); btn.classList.add('shake'); setTimeout(() => btn.classList.remove('shake'), 420); }
  gaugeClear(btn); btn.disabled = false;
});
// ── Failed 칩 컨텍스트 메뉴(실패 사유·내용 입력) + 전문 직접 입력 모달 ──
$('#failmenu').addEventListener('click', e => {
  const it = e.target.closest('.failmenu-it'); if (!it) return;
  e.stopPropagation();
  const c = _failMenuC; closeFailMenu();
  if (!c) return;
  if (it.dataset.act === 'diag') failDownload(c);
  else if (it.dataset.act === 'paste') openPaste(c);
});
document.addEventListener('click', e => { const m = $('#failmenu'); if (m && !m.hidden && !m.contains(e.target)) closeFailMenu(); });
window.addEventListener('scroll', closeFailMenu, { capture: true, passive: true });   // 스크롤=위치 stale → 닫기(캡처=스크롤 컨테이너 포함·passive=메인 스크롤 성능 유지)
window.addEventListener('resize', closeFailMenu);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeFailMenu(); });
// 전문 직접 입력 모달 — askdlg UIUX 계승(.sbtn 클립 컨텍스트 1버튼·X·전송). 전송=api/pick body 경로(재분석) → Failed→Picking.
$('#pasteX').addEventListener('click', () => pastedlg.close());
pastedlg.addEventListener('click', e => { if (e.target === pastedlg) pastedlg.close(); });   // 백드롭 닫기
pastedlg.addEventListener('close', () => { if (pastedlg._minimizing) { pastedlg._minimizing = false; showRestoreNav(); try { $('#toolRestore').focus(); } catch (_) {} } });   // 최소화 대칭(전문은 close 시 파괴적 리셋 없음·플래그만 소비 → 4모달 일관·운영자 260628)
function updatePasteClip() { const t = $('#pasteText'); if (t) t.dispatchEvent(new Event('input', { bubbles: true })); }   // 클립 = attachCopyPaste 이식(복사/붙여넣기/지우개/되돌리기) → input 디스패치로 갱신(운영자 260628)
$('#pasteSend').addEventListener('click', async () => {
  const c = _pasteC; if (!c || !c.url) { qFlash('대상 정보 없음 — 메뉴를 다시 열어줘'); return; }   // 전 상태문구 = qFlash 토스트(팝업 내 문자열 폐지 · 운영자 260720)
  const text = $('#pasteText').value.trim();
  if (text.length < 30) { qFlash('기사 전문을 붙여넣어줘 (너무 짧음)'); return; }
  const btn = $('#pasteSend'); btn.disabled = true; qFlash('보내는 중…');
  const alt = pickAlt(c).slice(0, 8);   // 대체 fetch 후보(메이저 우선·원매체 403 우회 보조)
  try {
    const r = await fetch('api/pick', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: c.url, title: c.title || '', alt, body: text, event_key: c.event_key || '' }) });
    const d = await r.json().catch(() => ({}));
    if (r.ok && d.ok) {
      qFlash('재분석 시작 — 곧 Picking…으로, 완료되면 PICKED');   // 성공 안내도 qFlash(호스트 모달 1.3s 뒤 닫혀도 close 캡처가 body 귀환 = 잔여 표시 보존)
      const id = candId(c);
      saveRating(id, { picked: true, pickedAt: Date.now() });   // pickedAt 리셋 → pickTimedOut 해제(새 분석창)
      pfAddResub(id);                                            // pfailHas 억제 → Failed→Picking(임시창)
      markPickFailSeen();                                        // 실패 알림 링/토스트 소거
      setTimeout(() => { pastedlg.close(); btn.disabled = false; if (CURTAB === 'scrap') renderScrap(); pollPicking(); }, 1300);
      return;
    }
    qFlash(d.error || `서버 ${r.status}`);
  } catch { qFlash('전송 실패'); }
  btn.disabled = false;
});
// ── 요약 수정 배선 — FAB(콘텐츠 초안~시사점 구간 점등)→팝업(좌측 펼침·즉시 포커스) · 클립(.sbtn 캐러셀) · 전송(1차 재확인→2차 PICK 게이지 발사) ──
let revConfirmT = null;
function resetRevSend() {   // 발사 버튼 원복(재확인 해제)
  clearTimeout(revConfirmT);
  const btn = $('#revSend'); if (!btn) return;
  btn.classList.remove('confirm');
  const lbl = btn.querySelector('span'); if (lbl) lbl.textContent = '수정';
}
function openRev() {
  if (!CUR) { return; }
  if (isRevising(CUR)) { return; }   // 수정 중 = FAB 눌러도 입력 팝업 안 열림(무반응) · 시각 표식(revving/locked·'수정 중' 힌트)은 그대로 유지 — 운영자 260626(옛 260623 '그냥 팝업 열기' 폐기: 팝업이 떠 전송 가능해 보이는 게 문제)
  resetRevSend();
  $('#revSend').classList.remove('firing'); $('#revSend').disabled = false;   // (revStatus 잔상 리셋 소멸 — 상태문자열 폐지·qFlash 위임 260720)
  updateRevClip(); openComposeDlg(revdlg);   // 폰 뒤로가기 칸(입력 손실 방지·260627)
  $('#revFab').classList.remove('show');         // 팝업 열림 → FAB 숨김(닫히면 updateRevFab가 복원)
  setTimeout(() => $('#revText').focus(), 60);   // 열리자마자 커서 활성(askdlg 패턴)
}
function updateRevClip() { const t = $('#revText'); if (t) t.dispatchEvent(new Event('input', { bubbles: true })); }   // 클립 = attachCopyPaste 이식(이미지 제작 동일) → input 디스패치로 [복사][붙여넣기][지우개/되돌리기] 갱신(운영자 260627)
